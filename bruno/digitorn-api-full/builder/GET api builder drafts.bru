meta {
  name: list_drafts
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/builder/drafts
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

params:query {
  status: 
  limit: 
  offset: 
}

docs {
  List the caller's drafts, most recently updated first.
  
  Optional ``status`` filter (e.g. ``in_progress``, ``deployed``).
  ``limit`` is clamped to ``MAX_DRAFTS_PER_USER`` server-side.
}
