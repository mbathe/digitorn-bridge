meta {
  name: refresh
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/refresh
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "refresh_token": "{{refresh_token}}"
  }
}

script:post-response {
  if (res.status >= 200 && res.status < 300 && res.body) {
    if (res.body?.access_token != null) bru.setEnvVar("access_token", String(res.body?.access_token));
    if (res.body?.refresh_token != null) bru.setEnvVar("refresh_token", String(res.body?.refresh_token));
  }
}

docs {
  Exchange a refresh token for a new access token.
}
