meta {
  name: execute_action
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/modules/{{module_id}}/execute
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "action": "",
    "params": {},
    "app_id": "{{app_id}}",
    "session_id": "{{session_id}}",
    "agent_id": "{{agent_id}}"
  }
}

docs {
  Execute an action on a module.
}
