meta {
  name: clear_background_session_payload
  type: http
  seq: 131
}

delete {
  url: {{base_url}}/api/apps/{{app_id}}/background-sessions/{{bg_session_id}}/payload
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Remove the entire payload (prompt + metadata + all files) for a session.
}
