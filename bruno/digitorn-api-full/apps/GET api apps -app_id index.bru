get {
  url: {{base_url}}/api/apps/{{app_id}}/index
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Get full tool index structure for the app.
  
  Returns all categories, tools, aliases, and metadata.
  Useful for SDK clients to build local caches or UI.
}
