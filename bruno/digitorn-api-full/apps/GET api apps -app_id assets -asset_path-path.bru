meta {
  name: get_app_asset
  type: http
  seq: 13
}

get {
  url: {{base_url}}/api/apps/{{app_id}}/assets/{{asset_path:path}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Serve any file from an installed app's directory.
  
  Use this to fetch README.md, CHANGELOG.md, skill files, images,
  or any other companion file declared in the package dir.
  
  Guarded against path traversal — the resolved path must stay
  inside the app's install directory. Hidden files under
  ``.digitorn/`` are explicitly denied (they're daemon-managed
  state, not author content).
}
