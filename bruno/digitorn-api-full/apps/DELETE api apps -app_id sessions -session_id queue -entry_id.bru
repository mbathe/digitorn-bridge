meta {
  name: cancel_queued_message
  type: http
  seq: 140
}

delete {
  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/queue/{{entry_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Cancel a queued (not yet running) message. Running messages must
  be aborted via ``POST /abort``.
}
