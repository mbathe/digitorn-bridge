meta {
  name: revoke_mcp_oauth
  type: http
  seq: 134
}

delete {
  url: {{base_url}}/api/apps/{{app_id}}/mcp/{{mcp_server_id}}/oauth-token
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Revoke an MCP server's OAuth token — disconnect and delete from DB.
  
  The server entry is kept in the pool (with status reset) so /connect
  can re-authorize later.
}
