meta {
  name: run_app
  type: http
  seq: 93
}

post {
  url: {{base_url}}/api/apps/{{app_id}}/run
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "input": "",
    "input_type": "text"
  }
}

docs {
  Run a deployed one-shot app.
  
  Returns the agent's response. Only works for one_shot mode apps.
  For conversation mode, use WebSocket/Socket.IO.
}
