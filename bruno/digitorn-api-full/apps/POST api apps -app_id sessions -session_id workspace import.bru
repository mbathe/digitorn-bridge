meta {
  name: import_session_workspace
  type: http
  seq: 110
}

post {
  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/import
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "replace": true
  }
}

docs {
  Import a snapshot into an existing session.
  
  Overwrites (``replace=True``) or merges (``replace=False``) the
  current in-memory state and force-flushes to DB so reopening the
  session yields the imported view.
}
