meta {
  name: validate_app
  type: http
  seq: 76
}

post {
  url: {{base_url}}/api/apps/validate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "yaml_path": "{{yaml_path}}"
  }
}

docs {
  Validate an app YAML file without deploying it.
  
  Compiles the YAML against the loaded module registry and returns
  app metadata (modules, agents, security) or compilation errors.
}
