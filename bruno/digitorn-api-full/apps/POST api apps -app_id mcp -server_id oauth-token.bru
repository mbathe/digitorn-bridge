meta {
  name: inject_oauth_token
  type: http
  seq: 87
}

post {
  url: {{base_url}}/api/apps/{{app_id}}/mcp/{{mcp_server_id}}/oauth-token
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "access_token": "{{access_token}}",
    "token_type": "bearer",
    "refresh_token": "{{refresh_token}}",
    "expires_in": 0,
    "scope": ""
  }
}

docs {
  Inject an OAuth token into an MCP server and persist it in DB.
  
  Used by the CLI after completing a local OAuth flow.
}
