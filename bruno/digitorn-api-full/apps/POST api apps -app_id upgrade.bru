meta {
  name: upgrade_app
  type: http
  seq: 115
}

post {
  url: {{base_url}}/api/apps/{{app_id}}/upgrade
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "source_type": "local",
    "source_uri": "",
    "accept_permissions": false
  }
}

docs {
  Upgrade an installed app to a new version.
  
  Same permissions consent flow as install. On compile/deploy
  failure the InstallFlow rolls back to the previous version
  automatically (locked design D8).
}
