get {
  url: {{base_url}}/api/apps/{{app_id}}/widgets/validate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Lint endpoint — recompiles the widgets block and returns errors.
  
  Used by the builder UI for live validation. Read-only — does not
  redeploy the app.
}
