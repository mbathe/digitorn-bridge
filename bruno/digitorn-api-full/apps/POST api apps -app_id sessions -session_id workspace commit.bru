meta {
  name: commit_session_endpoint
  type: http
  seq: 103
}

post {
  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/commit
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "message": "{{message}}",
    "files": [
      ""
    ],
    "push": false
  }
}

docs {
  Commit approved files to git — one-shot ship to the session's repo.
}
