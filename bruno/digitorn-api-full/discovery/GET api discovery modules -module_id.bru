}

get {
  url: {{base_url}}/api/discovery/modules/{{module_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

vars:pre-request {
  access_token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..EVprq8FPPg38fKpeAQBJ2u6QLELGBnb7yqxkwrlFEho
