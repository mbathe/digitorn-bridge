meta {
  name: list_modules
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/discovery/modules
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

vars:pre-request {
  access_token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..EVprq8FPPg38fKpeAQBJ2u6QLELGBnb7yqxkwrlFEho
}

docs {
  List every loaded module with a short summary.
  
  Used by the builder agent to enumerate what's available before
  composing a YAML. Excludes failed-to-load modules — they would
  only confuse the LLM with names it can't actually use.
}
