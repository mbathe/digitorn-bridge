meta {
  name: upsert_grant
  type: http
  seq: 5
}

put {
  url: {{base_url}}/api/security/profiles/{{app_id}}/grants/{{module_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "module_id": "",
    "visibility": "full",
    "default_action_policy": "approve",
    "action_overrides": {}
  }
}

docs {
  Create or update a module grant for an app's security profile.
}
