meta {
  name: create_profile
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/security/profiles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "app_id": "{{app_id}}",
    "is_active": true,
    "default_policy": "approve",
    "granted_permissions": [],
    "max_risk_level": "medium",
    "risk_approval_rules": {
      "low": "auto",
      "medium": "approve",
      "high": "block"
    },
    "approval_timeout": 300.0
  }
}

docs {
  Create a security profile for an application.
  
  The application must already exist in the ``applications`` table.
}
