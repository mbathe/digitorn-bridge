meta {
  name: update_my_profile
  type: http
  seq: 17
}

put {
  url: {{base_url}}/api/users/me/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "display_name": "{{display_name}}",
    "email": "{{email}}",
    "phone":"+33 775751908"
  }
}

