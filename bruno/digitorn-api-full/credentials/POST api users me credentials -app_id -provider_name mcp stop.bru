meta {
  name: mcp_stop
  type: http
  seq: 17
}

post {
  url: {{base_url}}/api/users/me/credentials/{{app_id}}/{{provider_name}}/mcp/stop
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Stop an MCP server without deleting its credential.
  
  The credential row stays intact so the user can click "Start
  again" without re-filling the form.
}
