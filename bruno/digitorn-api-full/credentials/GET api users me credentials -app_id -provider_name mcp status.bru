meta {
  name: mcp_status
  type: http
  seq: 10
}

get {
  url: {{base_url}}/api/users/me/credentials/{{app_id}}/{{provider_name}}/mcp/status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Return the current runtime status of an MCP server.
  
  Shape::
  
      { provider, running, status, tools_count, last_error }
}
