meta {
  name: oauth_status
  type: http
  seq: 11
}

get {
  url: {{base_url}}/api/users/me/credentials/{{app_id}}/{{provider_name}}/oauth/status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

params:query {
  state: 
}

docs {
  Poll the state of an in-progress OAuth flow.
  
  Returns one of:
  
      { status: "pending" }                     — still waiting
      { status: "connected", credential_id }    — done, token stored
      { status: "error", error }                — failed
      { status: "expired" }                     — flow TTL elapsed
}
