meta {
  name: oauth_refresh
  type: http
  seq: 18
}

post {
  url: {{base_url}}/api/users/me/credentials/{{app_id}}/{{provider_name}}/oauth/refresh
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

script:post-response {
  if (res.status >= 200 && res.status < 300 && res.body) {
    if (res.body?.access_token != null) bru.setEnvVar("access_token", String(res.body?.access_token));
    if (res.body?.refresh_token != null) bru.setEnvVar("refresh_token", String(res.body?.refresh_token));
  }
}

docs {
  Manually trigger a token refresh for an existing OAuth credential.
  
  Looks up the stored credential, calls the handler's ``refresh``
  (which hits the provider's /token endpoint with
  grant_type=refresh_token), and writes the new access_token back
  to the store.
}
