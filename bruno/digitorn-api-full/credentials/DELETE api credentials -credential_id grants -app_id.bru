meta {
  name: revoke_credential_grant
  type: http
  seq: 24
}

delete {
  url: {{base_url}}/api/credentials/{{credential_id}}/grants/{{app_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Revoke an app's access to a credential.
  
  Soft delete — the grant row stays with ``revoked_at`` set for
  audit. Use ``?hard=true`` to actually remove the row.
}
