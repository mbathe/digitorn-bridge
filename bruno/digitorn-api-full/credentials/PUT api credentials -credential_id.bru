meta {
  name: update_my_credential
  type: http
  seq: 20
}

put {
  url: {{base_url}}/api/credentials/{{credential_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "label": "",
    "fields": {}
  }
}

docs {
  Overwrite label and/or fields on an existing credential.
}
