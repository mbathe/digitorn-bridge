meta {
  name: List modules
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/discovery/modules
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Ground truth for every module registered in the daemon (21 in the current build). Use this when writing an app.yaml to confirm a module id exists before granting its actions.
}
