meta {
  name: Compile YAML
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/discovery/compile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "yaml": "app:\n  app_id: probe\n  name: Probe\nagents:\n  - id: main\n    brain:\n      provider: anthropic\n      model: claude-haiku-4-5-20251001\n      config:\n        api_key: claude-code\n    system_prompt: Hi.\nexecution:\n  mode: conversation\n  entry_agent: main\ncapabilities:\n  default_policy: auto\n  max_risk_level: low\n  grant: []\n",
    "source_path": "<bruno>"
  }
}

docs {
  Dry-run compile: returns the resolved config + errors list without persisting anything. Ideal to verify a YAML draft before calling /deploy.
}
