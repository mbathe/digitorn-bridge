meta {
  name: List deployed
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/apps
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  All apps visible to the caller (user-scoped + system-scoped). Admins can pass `?include_disabled=true` to also see disabled apps.
}
