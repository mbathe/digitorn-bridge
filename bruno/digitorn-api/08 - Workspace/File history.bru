meta {
  name: File history
  type: http
  seq: 8
}

get {
  url: {{base_url}}/api/apps/{{workspace_app_id}}/sessions/{{workspace_session_id}}/workspace/files/notes.md/history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Every approved revision of a file: revision number, approved_at, approved_by, tokens_delta (ins/del). Revisions persist under `{ws}/.digitorn/sessions/{sid}/baselines/{path}.history/`.
}
