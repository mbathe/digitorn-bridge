meta {
  name: Approve hunks
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/apps/{{workspace_app_id}}/sessions/{{workspace_session_id}}/workspace/files/approve-hunks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "path": "notes.md",
    "hunks": [0]
  }
}

docs {
  Partial approve — stage only the specified hunks. `hunks` accepts either integer indices (0-based) or 12-char SHA-256 identifiers (stable across concurrent writes). Hunks are applied in reverse position order so earlier indices aren't perturbed.

  To have hunks to approve, make a change to notes.md first (via the agent or a "Writeback file" call with new content) while a baseline is approved.
}
