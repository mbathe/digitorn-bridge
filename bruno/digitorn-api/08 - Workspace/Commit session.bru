meta {
  name: Commit session
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/apps/{{workspace_app_id}}/sessions/{{workspace_session_id}}/workspace/commit
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "message": "Session work — written via Bruno",
    "files": null,
    "push": false
  }
}

docs {
  `git add` + `git commit` over the session's approved files. `files: null` commits every approved file; pass an explicit list to commit only a subset. Set `push: true` to also `git push`.
}
