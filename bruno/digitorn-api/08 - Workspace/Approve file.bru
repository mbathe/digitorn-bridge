meta {
  name: Approve file
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/apps/{{workspace_app_id}}/sessions/{{workspace_session_id}}/workspace/files/approve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "path": "notes.md"
  }
}

docs {
  Snapshot the file's current content as the new baseline. Future edits will show pending diffs against this snapshot. Resets `insertions_pending` / `deletions_pending` to 0.
}
