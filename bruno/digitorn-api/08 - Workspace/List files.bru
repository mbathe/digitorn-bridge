meta {
  name: List files
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/apps/{{workspace_app_id}}/sessions/{{workspace_session_id}}/workspace
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  All files currently in the session's workspace (virtual FS + sync_to_disk mirrored files). Each entry has pending/approved status, git status, baseline line count, and cumulative insert/delete totals.

  Run "0 — Deploy workspace demo" then "0b — Create workspace session" before this.
}
