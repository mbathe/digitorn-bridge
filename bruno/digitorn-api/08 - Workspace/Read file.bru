meta {
  name: Read file
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/apps/{{workspace_app_id}}/sessions/{{workspace_session_id}}/workspace/files/notes.md?include_baseline=true
  body: none
  auth: bearer
  query: true
}

params:query {
  include_baseline: true
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Content of a workspace file (path is URL-encoded after `/files/`). Add `?include_baseline=true` to get the last-approved version + `unified_diff_pending` (parseable by difflib.PatchSet).

  Run "Writeback file" first so notes.md exists.
}
