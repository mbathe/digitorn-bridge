meta {
  name: Resolve approval
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/apps/{{test_app_id}}/approve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "request_id": "req_abc123",
    "approved": true,
    "message": "OK"
  }
}

docs {
  Approve or deny a pending approval request. `request_id` comes from /approvals list. `approved: false` denies (the tool returns an error to the agent). The optional `message` (aliases: `response`, `answer`, `value`, `reply`) lets the user attach a note — useful for ask_user responses.
}
