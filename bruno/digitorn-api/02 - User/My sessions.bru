meta {
  name: My sessions
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/users/me/sessions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Every session the caller currently owns, across all apps. Useful to find orphaned sessions to clean up, or to resume a session whose id was lost.
}
