meta {
  name: My profile
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/users/me/profile
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Full user profile (more than /auth/me): preferences, avatar URL, theme, etc. Real route is /api/users/me/profile (the router is mounted at /api/users/me and defines /profile internally).
}
