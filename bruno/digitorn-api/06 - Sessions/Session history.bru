meta {
  name: Session history
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/apps/{{test_app_id}}/sessions/{{session_id}}/history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Message history only — lighter than /sessions/{sid} when you just need the transcript. Supports `?limit=N&before=TURN_ID` for paging.
}
