meta {
  name: Get credential
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/users/me/credentials/_global/deepseek
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Metadata + masked preview of one credential. Returns `{filled: false}` if the credential doesn't exist. Never returns plaintext values.
}
