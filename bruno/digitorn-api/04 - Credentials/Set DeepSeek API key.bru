meta {
  name: Set DeepSeek API key
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/users/me/credentials/_global/deepseek
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "fields": {
      "api_key": "sk-your-deepseek-api-key"
    },
    "scope": "per_user"
  }
}

docs {
  Stores a credential globally for the user (`_global` app_id = applies to every app the user runs). Use `per_app_per_user` scope + a real app_id to scope the key to one app instead.

  The `fields` dict is encrypted at rest with the daemon's master.key.
}
