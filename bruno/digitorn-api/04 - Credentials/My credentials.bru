meta {
  name: My credentials
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/users/me/credentials
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  All credentials stored by the authenticated user (per-user and per-app-per-user). Values are masked — only previews + metadata.
}
