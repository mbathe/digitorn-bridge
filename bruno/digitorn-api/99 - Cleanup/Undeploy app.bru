meta {
  name: Undeploy app
  type: http
  seq: 1
}

delete {
  url: {{base_url}}/api/apps/{{test_app_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Stops the app, releases modules, tears down sessions. The DB row + bundle remain on disk — call POST /api/apps/deploy with the same YAML to redeploy. Use DELETE /api/apps/{id}?purge=true to also wipe the DB row.

  **If you get 401 Unauthorized**: your access_token probably expired (default TTL: 900s = 15 min). Re-run `01 - Auth → Refresh` to get a new one — or just re-run Login.
}
