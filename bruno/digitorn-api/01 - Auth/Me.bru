meta {
  name: Me
  type: http
  seq: 4
}

get {
  url: {{base_url}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Returns the authenticated caller's profile: user_id, email, roles, permissions, is_admin, avatar_url, etc. Quick way to verify your token is still valid.
}
