{
  "version": 1,
  "entries": [
    {
      "server_id": "github",
      "display_name": "GitHub",
      "description": "GitHub API (repos, issues, PRs, search, code)",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "runtime": "npm",
      "package": "@modelcontextprotocol/server-github",
      "env_mapping": {
        "token": "GITHUB_PERSONAL_ACCESS_TOKEN"
      },
      "key_descriptions": {
        "token": "Personal access token (Settings \u2192 Developer settings \u2192 Tokens)"
      },
      "timeout": 30.0
    },
    {
      "server_id": "notion",
      "display_name": "Notion",
      "description": "Notion workspace (pages, databases, search)",
      "transport": "stdio",
      "command": "mcp-notion",
      "runtime": "pip",
      "package": "mcp-notion",
      "env_mapping": {
        "token": "NOTION_API_KEY"
      },
      "key_descriptions": {
        "token": "API key or OAuth token (Settings \u2192 Connections \u2192 Develop)"
      },
      "oauth_provider": "notion",
      "oauth_env_token_var": "NOTION_API_KEY",
      "oauth_style": "env_token",
      "timeout": 30.0
    },
