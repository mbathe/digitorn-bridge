/* Digitorn TUI — Light theme */

Screen {
    background: #f8fafc;
    layout: vertical;
}

#header {
    height: 1;
    background: #e2e8f0;
    color: #1e293b;
    padding: 0 2 0 4;
}

#chat-log {
    height: 1fr;
    background: #f8fafc;
    padding: 0 0 2 0;
    scrollbar-size: 1 1;
}

#chat-log > Static {
    padding: 0 2 0 4;
    margin: 0;
}

#chat-log > .rail-response {
    margin: 0 0 0 4;
    padding: 0 2 0 1;
    border-left: solid #94a3b8;
}

#chat-log > .thinking {
    margin: 0 0 0 4;
    padding: 0 2 0 1;
    border-left: dashed #cbd5e1;
    color: #64748b;
}

#chat-log > .tool-running {
    text-opacity: 90%;
}

#main-content {
    height: 1fr;
    layout: horizontal;
}

#sidebar {
    width: 34;
    background: #f1f5f9;
    border-left: tall #e2e8f0;
    padding: 1 1;
    scrollbar-size: 1 1;
}

#sidebar.hidden {
    display: none;
}

.sidebar-section { padding: 0; margin: 0; }
.sidebar-item { padding: 0 0 0 1; margin: 0; }
.sidebar-spacer { height: 1; padding: 0; margin: 0; }

#spinner-bar {
    height: 1;
    background: #e2e8f0;
    padding: 0 2 0 4;
}

#input-area {
    height: auto;
    max-height: 6;
    background: #f1f5f9;
    border-top: tall #e2e8f0;
    layout: horizontal;
    padding: 0 1;
}

#input-area:focus-within {
    border-top: tall #3b82f6;
}

#prompt-icon {
    width: 6;
    height: 1;
    color: #16a34a;
    text-style: bold;
    padding: 0 0 0 3;
    background: #f1f5f9;
}

#prompt-input {
    width: 1fr;
    min-height: 1;
    max-height: 8;
    background: #f1f5f9;
    color: #1e293b;
    border: none;
    padding: 0;
}

#prompt-input:focus {
    border: none;
}

#status-footer {
    height: 1;
    background: #e2e8f0;
    padding: 0 2;
}

ScrollBar { background: #f1f5f9; }
ScrollBar > .scrollbar--bar { background: #94a3b8; }
ScrollBar > .scrollbar--bar:hover { background: #64748b; }
