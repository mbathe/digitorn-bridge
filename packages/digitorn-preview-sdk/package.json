{
  "name": "@digitorn/preview-sdk",
  "version": "1.0.0",
  "description": "SDK React pour créer des previews live Digitorn",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite/index.js",
      "types": "./dist/vite/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "peerDependencies": {
    "esbuild-wasm": ">=0.20.0",
    "react": ">=18.0.0",
    "socket.io-client": ">=4.7.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "esbuild-wasm": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "esbuild-wasm": "^0.24.2",
    "typescript": "^5.0.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "socket.io-client": ">=4.7.0"
  }
}
