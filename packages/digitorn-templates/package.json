{
  "name": "@digitorn/templates",
  "version": "0.1.0",
  "description": "Curated template library for Digitorn apps — drop into <TemplateEmptyState> from any consumer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    },
    "./seeds/*": "./seeds/*"
  },
  "files": [
    "dist",
    "seeds"
  ],
  "scripts": {
    "build": "tsc"
  },
  "peerDependencies": {
    "@digitorn/preview-sdk": "*",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@digitorn/preview-sdk": "file:../digitorn-preview-sdk",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "react": "^18.3.1",
    "typescript": "^5.0.0"
  }
}
