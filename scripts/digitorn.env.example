# /etc/digitorn/digitorn.env — production env file (NOT in git).
#
# Copy this template to /etc/digitorn/digitorn.env on the Hetzner box,
# fill in the secrets, then ``chmod 600`` and ``chown root:digitorn``.
# Both the daemon (digitorn-daemon.service) and the gateway
# (digitorn-gateway.service) read this file at boot via systemd's
# ``EnvironmentFile=-/etc/digitorn/digitorn.env``.
#
# Layout: lower-case dot-separated variables in YAML get UPPER_CASE
# double-underscore env vars (pydantic-settings convention with
# ``env_nested_delimiter="__"``).

# ── Daemon: shared Postgres on Neon ─────────────────────────────────
DIGITORN_DATABASE__URL=postgresql+asyncpg://USER:PASS@HOST/digitorn?ssl=require

# ── Daemon: master key that encrypts/decrypts the credentials table ─
# 32-byte b64url. KEEP. Rotating it invalidates every stored credential.
DIGITORN_MASTER_KEY=PASTE_BASE64URL_32_BYTES

# ── Daemon: public base URL (used in OAuth redirect URIs etc.) ──────
DIGITORN_OAUTH__PUBLIC_BASE_URL=https://api.digitorn.ai
DIGITORN_OAUTH__WEB_ORIGIN=https://app.digitorn.ai

# ── Daemon: run-tracker backend ─────────────────────────────────────
# Cloud mode (default). Switch to ``jsonfile`` / ``sqlite`` / ``kv`` /
# ``null`` for the local-only deployment story.
DIGITORN_RUNTIME__TRACKING__BACKEND=postgres

# ── Gateway: same Postgres (gateway tables coexist with daemon) ─────
# IMPORTANT: SINGLE underscore between DATABASE and URL (gateway has a
# flat ``database_url`` field, NOT a nested ``database.url`` like the
# daemon). Wrong number of underscores = silent fallback to default
# = boot crash on first DB call.
DIGITORN_GATEWAY_DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/digitorn?ssl=require

# ── Gateway: master key for the credentials vault ───────────────────
# 32-byte b64url. Encrypts the ``gateway_credentials.encrypted_value``
# column (provider API keys, OAuth tokens, etc.). DISTINCT from the
# daemon's ``DIGITORN_MASTER_KEY`` -- the gateway has its own vault.
# Empty disables the admin writable-config endpoints (the dispatch
# path still works, but no CRUD on credentials from the dashboard).
# Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DIGITORN_GATEWAY_MASTER_KEY=PASTE_BASE64URL_32_BYTES

# ── Gateway: where to fetch JWKS to verify daemon-issued tokens ─────
# In single-machine deployments the daemon's auth service IS the
# gateway's auth service - they share the same key set.
DIGITORN_GATEWAY_AUTH_JWKS_URL=https://api.digitorn.ai/.well-known/jwks.json
DIGITORN_GATEWAY_AUTH_ISSUER=https://api.digitorn.ai

# ── Gateway: CORS for the dashboard / web client ────────────────────
DIGITORN_GATEWAY_CORS_ALLOW_ORIGINS=https://app.digitorn.ai,https://dashboard.digitorn.ai

# ── Gateway: model catalogue (optional, off by default) ─────────────
# Set this only after creating /opt/digitorn-gateway/config/models.yaml
# from the .example. Without the file, the gateway passes alias names
# straight through to LiteLLM (works for every upstream that LiteLLM
# knows: anthropic/*, openai/*, deepseek/*, …).
# DIGITORN_GATEWAY_MODELS_CONFIG_PATH=/opt/digitorn-gateway/config/models.yaml

# ── Gateway: quota engine ───────────────────────────────────────────
DIGITORN_GATEWAY_QUOTA_ENABLED=true
DIGITORN_GATEWAY_QUOTA_FLUSH_INTERVAL_SECONDS=10

# ── Gateway: cross-worker quota coordination via Redis ─────────────
# Mandatory when the gateway runs with ``--workers > 1`` or behind a
# load balancer with multiple pods. The hot path (pre-call
# ``is_blocked()`` check) stays in-memory and sub-microsecond; Redis
# is used ONLY by the post-call BackgroundTask to atomically INCR the
# cluster-wide counter and broadcast sticky blocks via Pub/Sub.
# Empty value = single-process mode (legacy, leak risk).
# Use a dedicated Redis DB number so we don't collide with the
# daemon's message queue (DB 0).
DIGITORN_GATEWAY_QUOTA_REDIS_URL=redis://localhost:6379/2

# ── Provider API keys (gateway uses these as the meta-credential) ───
# These are the "default" keys the gateway uses when a user has not
# configured their own credentials. Per-user overrides come from the
# encrypted credentials table.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
GOOGLE_API_KEY=...
MISTRAL_API_KEY=...

# ── Optional: caddy domain overrides (defaults are fine for prod) ───
# DIGITORN_DOMAIN=api.digitorn.ai
# DIGITORN_GATEWAY_DOMAIN=gateway.digitorn.ai
