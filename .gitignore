*.py[codz]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
sdist/
wheels/
*.manifest
*.spec
MANIFEST
.installed.cfg
.claude/

# ── Virtual environments ──────────────────────────────
.venv/
.venv*/
venv/
env/
ENV/
.Python
.pixi/
.pdm-python
.pdm-build/
__pypackages__/

# ── Runtime databases ─────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# ── Logs ──────────────────────────────────────────────
*.log
*.ndjson
daemon_output.log
daemon_stress.log

# ── Test artifacts ────────────────────────────────────
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.hypothesis/
nosetests.xml
coverage.xml
*.cover
*.py.cover
cover/
test_workspace/
# ── IDE ───────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.cursorignore
.cursorindexingignore

# ── Linters / type checkers ───────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
cython_debug/

# ── Frontend / Node.js ────────────────────────────────
node_modules/
.vite/
.next/
**/.next/
bun.lock

# ── OS files ──────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.bak

# ── Temp test files ───────────────────────────────────
test1.txt
test2.txt
test_sse_event.txt
test_wb_*.txt
countries.json
events.ndjson

# ── Secrets / credentials ────────────────────────────
.env
.env.*
.envrc
*.pem
*.key
!server.key.example

# ── Build artifacts ───────────────────────────────────
develop-eggs/
downloads/
lib/
lib64/
parts/
var/
share/python-wheels/

# ── Documentation build ──────────────────────────────
docs/_build/
/site

# ── Digitorn runtime data ─────────────────────────────
