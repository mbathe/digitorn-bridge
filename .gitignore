tests/functional/.digitorn-test-home/
tests/live/route_audit/route_audit_results.csv
tests/live/route_audit/routes_manifest.json
tests/live/route_audit/coach_trace.log
tests/live/route_audit/*.txt

# ── Generated API specs ──────────────────────────────
docs/openapi.json
tools/openapi.json

# ── TypeScript / Node build caches ────────────────────
*.tsbuildinfo

