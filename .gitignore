.digitorn/state/
.digitorn/models/
.digitorn/server.key

# ── Claude Code local settings ────────────────────────
.claude/settings.local.json

# ── Test runner output ────────────────────────────────
test-results/

# ── Misc ──────────────────────────────────────────────
.ropeproject
.spyderproject
.spyproject
.pybuilder/
target/
.ipynb_checkpoints
profile_default/
ipython_config.py
celerybeat-schedule
celerybeat.pid
