# ═══════════════════════════════════════════════════════
# Digitorn — .gitignore
# ═══════════════════════════════════════════════════════

# ── AI / editor session artifacts ─────────────────────
# Never commit AI-assistant session memory, instructions, or local
# editor caches. ``CLAUDE.md`` lives at the repo root for local AI
# tooling but stays out of the public history.
.claude/
.cursor/
.aider*
.github-copilot/
/CLAUDE.md

# ── Live-test leftovers at the repo root ──────────────
# These can accumulate when running the dev CLI manually against the
# daemon (LaTeX scratch, tiny scripts, event dumps).
/events.ndjson
/hello.py
/main.log
/main.pdf
/main.tex
/main.aux
/main.toc
/main.out

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[codz]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
sdist/
wheels/

# Builtin app dist/ folders must ship in git so the prod daemon can
# serve them statically (template previews, SDK app bundles, etc.).
# Covers any depth under builtins/: ``builtins/foo/dist/``,
# ``builtins/foo/web/dist/``, ``builtins/foo/templates/*/dist/``, etc.
# Total stays small (Vite-minified bundles, ~150 KB per template).
# If a future builtin uses dist/ for a regenerable build cache (not
# meant to ship), add a narrower local ignore inside that builtin.
!packages/digitorn/builtins/**/dist/
!packages/digitorn/builtins/**/dist/**
*.manifest
*.spec
MANIFEST
.installed.cfg
.claude/

# ── Virtual environments ──────────────────────────────
.venv/
.venv*/
venv/
env/
ENV/
.Python
.pixi/
.pdm-python
.pdm-build/
__pypackages__/

# ── Runtime databases ─────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# ── Logs ──────────────────────────────────────────────
*.log
*.ndjson
daemon_output.log
daemon_stress.log

# ── Test artifacts ────────────────────────────────────
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.hypothesis/
nosetests.xml
coverage.xml
*.cover
*.py.cover
cover/
test_workspace/
# ── IDE ───────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.cursorignore
.cursorindexingignore

# ── Linters / type checkers ───────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
cython_debug/

# ── Frontend / Node.js ────────────────────────────────
node_modules/
.vite/
.next/
**/.next/
bun.lock

# ── OS files ──────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.bak

# ── Temp test files ───────────────────────────────────
test1.txt
test2.txt
test_sse_event.txt
test_wb_*.txt
countries.json
events.ndjson

# ── Secrets / credentials ────────────────────────────
.env
.env.*
*.env
.envrc
*.pem
*.key
!server.key.example

# ── Build artifacts ───────────────────────────────────
develop-eggs/
downloads/
lib/
lib64/
parts/
var/
share/python-wheels/

# ── Documentation build ──────────────────────────────
docs/_build/
/site

# ── Digitorn runtime data ─────────────────────────────
.digitorn/
.digitorn/apps/*/sessions/
.digitorn/state/
.digitorn/models/
.digitorn/server.key

# ── Claude Code local settings + worktrees ────────────

# ── Test runner output ────────────────────────────────
test-results/
tests/functional/.digitorn-test-home/
tests/live/route_audit/route_audit_results.csv
tests/live/route_audit/routes_manifest.json
tests/live/route_audit/coach_trace.log
tests/live/route_audit/*.txt

# ── Internal / scratch (not for OSS) ──────────────────
olds_doc/
.logs/
.vscode/settings.json
/package.toml
tools/_*.txt
tools/_*_result.txt
tools/*_result.json
tools/_seq_log.txt

# Internal diagnostic + one-off maintenance scripts
scripts/diag-*.py
scripts/backfill-installed-packages.py
scripts/merge-duplicate-user.py
scripts/reset-apps-direct.py
scripts/reset-apps.ps1
scripts/check-recent-session-events.py
scripts/check-user-history.py

# Scratch / ad-hoc debug runs in tools (underscore-prefixed = private)
tools/_*.py
tools/live_tests/_*.py

# ── Generated API specs ──────────────────────────────
docs/openapi.json
tools/openapi.json

# ── TypeScript / Node build caches ────────────────────
*.tsbuildinfo

# ── Misc ──────────────────────────────────────────────
.ropeproject
.spyderproject
.spyproject
.pybuilder/
target/
.ipynb_checkpoints
profile_default/
ipython_config.py
celerybeat-schedule
celerybeat.pid
*.sage.py
.scrapy
instance/
.webassets-cache
.pypirc
pip-log.txt
pip-delete-this-directory.txt
