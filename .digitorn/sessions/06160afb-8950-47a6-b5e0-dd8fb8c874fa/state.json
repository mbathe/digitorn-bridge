ync", "updated_at": 1778628122.8759959, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2752144}, "bruno/digitorn-api-full/builder/GET api builder drafts.bru": {"content": "meta {\n  name: list_drafts\n  type: http\n  seq: 1\n}\n\nget {\n  url: {{base_url}}/api/builder/drafts\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  status: \n  limit: \n  offset: \n}\n\ndocs {\n  List the caller's drafts, most recently updated first.\n  \n  Optional ``status`` filter (e.g. ``in_progress``, ``deployed``).\n  ``limit`` is clamped to ``MAX_DRAFTS_PER_USER`` server-side.\n}\n", "language": "text", "size": 420, "lines": 29, "operation": "disk_sync", "updated_at": 1778628122.8846617, "validation": "approved", "baseline_lines": 28, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2752144}, "bruno/digitorn-api-full/builder/PATCH api builder drafts -draft_id.bru": {"content": "meta {\n  name: patch_draft\n  type: http\n  seq: 5\n}\n\npatch {\n  url: {{base_url}}/api/builder/drafts/{{draft_id}}\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"name\": \"{{draft_name}}\",\n    \"status\": \"\",\n    \"current_yaml\": \"\",\n    \"chat_history\": [\n      {}\n    ],\n    \"builder_state\": {},\n    \"append_messages\": [\n      {}\n    ]\n  }\n}\n\ndocs {\n  Update one or more fields on a draft.\n  \n  Pass only the fields you want to change. Use ``append_messages``\n  when you just want to add a couple of chat messages without\n  re-sending the entire history.\n}\n", "language": "text", "size": 598, "lines": 39, "operation": "disk_sync", "updated_at": 1778628122.8877175, "validation": "approved", "baseline_lines": 38, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2752144}, "bruno/digitorn-api-full/builder/POST api builder drafts -draft_id deploy.bru": {"content": "meta {\n  name: deploy_draft\n  type: http\n  seq: 4\n}\n\npost {\n  url: {{base_url}}/api/builder/drafts/{{draft_id}}/deploy\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Compile the draft's current YAML and deploy it via the AppManager.\n  \n  On success, the draft's status is updated to ``deployed`` and its\n  ``deployed_app_id`` is set so the dashboard can link the draft to\n  the live app both ways.\n  \n  On compile failure, returns ``success=False`` with the list of\n  errors — the draft itself is NOT modified, so the user can keep\n  iterating from where they were.\n}\n", "language": "text", "size": 604, "lines": 28, "operation": "disk_sync", "updated_at": 1778628122.8877175, "validation": "approved", "baseline_lines": 27, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2752144}, "bruno/digitorn-api-full/builder/POST api builder drafts.bru": {"content": "meta {\n  name: create_draft\n  type: http\n  seq: 3\n}\n\npost {\n  url: {{base_url}}/api/builder/drafts\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"name\": \"{{draft_name}}\",\n    \"initial_yaml\": \"\",\n    \"builder_state\": {}\n  }\n}\n\ndocs {\n  Create a new draft for the caller.\n  \n  Returns 409 if the user is at the per-user cap.\n}\n", "language": "text", "size": 373, "lines": 30, "operation": "disk_sync", "updated_at": 1778628122.9002535, "validation": "approved", "baseline_lines": 29, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2752144}, "bruno/digitorn-api-full/config/folder.bru": {"content": "meta {\n  name: config\n  seq: 110\n}\n", "language": "text", "size": 35, "lines": 5, "operation": "disk_sync", "updated_at": 1778628122.9029467, "validation": "approved", "baseline_lines": 4, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2915487}, "bruno/digitorn-api-full/config/GET api config browse.bru": {"content": "meta {\n  name: browse_directories\n  type: http\n  seq: 2\n}\n\nget {\n  url: {{base_url}}/api/config/browse\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  path: \n}\n\ndocs {\n  List subdirectories at a given path for workspace selection.\n}\n", "language": "text", "size": 276, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.9060261, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2883863}, "bruno/digitorn-api-full/config/GET api config.bru": {"content": "meta {\n  name: get_config\n  type: http\n  seq: 1\n}\n\nget {\n  url: {{base_url}}/api/config\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Return the current runtime configuration.\n}\n", "language": "text", "size": 215, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.9060261, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2883863}, "bruno/digitorn-api-full/config/PATCH api config.bru": {"content": "meta {\n  name: patch_config\n  type: http\n  seq: 3\n}\n\npatch {\n  url: {{base_url}}/api/config\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"server\": {},\n    \"database\": {},\n    \"modules\": {},\n    \"logging\": {}\n  }\n}\n\ndocs {\n  Apply partial configuration changes at runtime.\n  \n  ADMIN ONLY. Any authenticated user could previously issue this and\n  flip `auth_enabled: false` / sandbox settings / CORS origins. That\n  was an immediate privilege escalation — a freshly-registered\n  `developer` user could disable the JWT layer globally and then\n  exfiltrate every other user's apps and sessions.\n  \n  Changes are applied to the in-memory settings singleton.\n  Some fields (server.host, server.port, database.url, …)\n  require a restart to take effect — they are listed in the response.\n}\n", "language": "text", "size": 833, "lines": 39, "operation": "disk_sync", "updated_at": 1778628122.9175615, "validation": "approved", "baseline_lines": 38, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2915487}, "bruno/digitorn-api-full/credentials/DELETE api admin credentials -credential_id.bru": {"content": "meta {\n  name: admin_delete_system_credential\n  type: http\n  seq: 22\n}\n\ndelete {\n  url: {{base_url}}/api/admin/credentials/{{credential_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Delete an admin/system credential by id.\n}\n", "language": "text", "size": 267, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.9260807, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.293559}, "bruno/digitorn-api-full/credentials/DELETE api credentials -credential_id grants -app_id.bru": {"content": "meta {\n  name: revoke_credential_grant\n  type: http\n  seq: 24\n}\n\ndelete {\n  url: {{base_url}}/api/credentials/{{credential_id}}/grants/{{app_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Revoke an app's access to a credential.\n  \n  Soft delete — the grant row stays with ``revoked_at`` set for\n  audit. Use ``?hard=true`` to actually remove the row.\n}\n", "language": "text", "size": 394, "lines": 23, "operation": "disk_sync", "updated_at": 1778628122.9326737, "validation": "approved", "baseline_lines": 22, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.293559}, "bruno/digitorn-api-full/credentials/DELETE api credentials -credential_id.bru": {"content": "meta {\n  name: delete_my_credential\n  type: http\n  seq: 23\n}\n\ndelete {\n  url: {{base_url}}/api/credentials/{{credential_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Delete a credential (and cascade-delete all its grants).\n}\n", "language": "text", "size": 267, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.9341254, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.293559}, "bruno/digitorn-api-full/credentials/DELETE api users me credentials -app_id -provider_name.bru": {"content": "meta {\n  name: delete_credential\n  type: http\n  seq: 25\n}\n\ndelete {\n  url: {{base_url}}/api/users/me/credentials/{{app_id}}/{{provider_name}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Delete the caller's credential for this provider+app.\n}\n", "language": "t