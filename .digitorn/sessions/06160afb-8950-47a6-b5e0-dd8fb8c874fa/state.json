04c4.06614,0,5.99571-4.08074,7.70364-7.68905,1.51154-3.19825,2.94211-6.21069,5.3972-6.33411Z\" transform=\"translate(-35.5 -118.5)\" fill-rule=\"evenodd\" />\n  <path d=\"M344.38682,635.28265h53.08286V582.19979H344.38682Z\" transform=\"translate(-35.5 -118.5)\" fill=\"#3ecc5f\" fill-rule=\"evenodd\" />\n  <path d=\"M424.01111,602.10586a6.60242,6.60242,0,0,0-.848.08493c-.05042-.19906-.09821-.39945-.15394-.59852A6.62667,6.62667,0,1,0,416.45211,590.21q-.2203-.22491-.44458-.44589a6.62391,6.62391,0,1,0-11.39689-6.56369c-.1964-.05575-.39413-.10218-.59054-.15262a6.63957,6.63957,0,1,0-13.10084,0c-.19641.05042-.39414.09687-.59055.15262a6.62767,6.62767,0,1,0-11.39689,6.56369,26.52755,26.52755,0,1,0,44.2313,25.52756,6.6211,6.6211,0,1,0,.848-13.18579\" transform=\"translate(-35.5 -118.5)\" fill=\"#44d860\" fill-rule=\"evenodd\" />\n  <path d=\"M344.38682,555.65836h53.08286V529.11693H344.38682Z\" transform=\"translate(-35.5 -118.5)\" fill=\"#3ecc5f\" fill-rule=\"evenodd\" />\n  <path d=\"M410.74039,545.70532a3.31768,3.31768,0,1,0,0-6.63536,3.41133,3.41133,0,0,0-.42333.04247c-.02655-.09953-.04911-.19907-.077-.29859a3.319,3.319,0,0,0-1.278-6.37923,3.28174,3.28174,0,0,0-2.00122.68742q-.10947-.11346-.22294-.22295a3.282,3.282,0,0,0,.67149-1.98265,3.31768,3.31768,0,0,0-6.37-1.2992,13.27078,13.27078,0,1,0,0,25.54082,3.31768,3.31768,0,0,0,6.37-1.2992,3.282,3.282,0,0,0-.67149-1.98265q.11347-.10947.22294-.22294a3.28174,3.28174,0,0,0,2.00122.68742,3.31768,3.31768,0,0,0,1.278-6.37923c.02786-.0982.05042-.19907.077-.29859a3.41325,3.41325,0,0,0,.42333.04246\" transform=\"translate(-35.5 -118.5)\" fill=\"#44d860\" fill-rule=\"evenodd\" />\n  <path d=\"M424.01111,447.8338a3.60349,3.60349,0,0,1-.65028-.06636,3.34415,3.34415,0,0,1-.62372-.18579,3.44679,3.44679,0,0,1-.572-.30522,5.02708,5.02708,0,0,1-.50429-.4114,3.88726,3.88726,0,0,1-.41007-.50428,3.27532,3.27532,0,0,1-.55737-1.84463,3.60248,3.60248,0,0,1,.06636-.65027,3.82638,3.82638,0,0,1,.18447-.62373,3.48858,3.48858,0,0,1,.30656-.57064,3.197,3.197,0,0,1,.91436-.91568,3.44685,3.44685,0,0,1,.572-.30523,3.344,3.344,0,0,1,.62372-.18578,3.06907,3.06907,0,0,1,1.30053,0,3.22332,3.22332,0,0,1,1.19436.491,5.02835,5.02835,0,0,1,.50429.41139,4.8801,4.8801,0,0,1,.41139.50429,3.38246,3.38246,0,0,1,.30522.57064,3.47806,3.47806,0,0,1,.25215,1.274A3.36394,3.36394,0,0,1,426.36,446.865a5.02708,5.02708,0,0,1-.50429.4114,3.3057,3.3057,0,0,1-1.84463.55737m26.54143-1.65884a3.38754,3.38754,0,0,1-2.35024-.96877,5.04185,5.04185,0,0,1-.41007-.50428,3.27532,3.27532,0,0,1-.55737-1.84463,3.38659,3.38659,0,0,1,.96744-2.34892,5.02559,5.02559,0,0,1,.50429-.41139,3.44685,3.44685,0,0,1,.572-.30523,3.3432,3.3432,0,0,1,.62373-.18579,3.06952,3.06952,0,0,1,1.30052,0,3.22356,3.22356,0,0,1,1.19436.491,5.02559,5.02559,0,0,1,.50429.41139,3.38792,3.38792,0,0,1,.96876,2.34892,3.72635,3.72635,0,0,1-.06636.65026,3.37387,3.37387,0,0,1-.18579.62373,4.71469,4.71469,0,0,1-.30522.57064,4.8801,4.8801,0,0,1-.41139.50429,5.02559,5.02559,0,0,1-.50429.41139,3.30547,3.30547,0,0,1-1.84463.55737\" transform=\"translate(-35.5 -118.5)\" fill-rule=\"evenodd\" />\n</svg>\n", "language": "svg", "size": 11887, "lines": 41, "operation": "disk_sync", "updated_at": 1778628124.9052234, "validation": "approved", "baseline_lines": 40, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.6346054}, "examples/approval-demo.yaml": {"content": "app:\n  app_id: approval-demo\n  name: Approval Demo\n  version: '1.0'\n  mode: conversation\nruntime:\n  workdir: /tmp/approval-demo\n  max_turns: 15\n  timeout: 300\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 64000\n      output_reserved: 8000\n      strategy: summarize\n  prompt: 'Tu es un assistant intelligent avec acces au systeme de fichiers et au\n    shell.\n\n    Tu peux lire, ecrire, modifier des fichiers, executer des commandes, et naviguer\n    sur le web.\n\n    Sois proactif et utilise tes outils pour accomplir les taches demandees.\n\n    '\ntools:\n  modules:\n    filesystem: {}\n    shell: {}\n    web: {}\n    http: {}\n  capabilities:\n    default_policy: auto\n    max_risk_level: high\n    grant:\n    - module: filesystem\n      actions:\n      - read\n      - grep\n      - glob\n    - module: web\n    - module: http\n      actions:\n      - get\n      - head\n      - fetch_page\n    approve:\n    - module: filesystem\n      actions:\n      - write\n      - edit\n    - module: shell\n      actions:\n      - run\n      - script\n      - background_run\n    - module: http\n      actions:\n      - post\n      - put\n      - patch\n      - delete\n    deny:\n    - module: shell\n      actions:\n      - task_kill\n      reason: Killing processes is not allowed\n", "language": "yaml", "size": 1422, "lines": 74, "operation": "disk_sync", "updated_at": 1778628124.9123268, "validation": "approved", "baseline_lines": 73, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.37505}, "examples/browser-agent.yaml": {"content": "app:\n  app_id: browser-agent\n  name: Web Browser Agent\n  description: Agent with web browsing capabilities.\nruntime:\n  mode: conversation\n  max_turns: 20\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'Tu es un assistant web. Tu peux naviguer sur internet, lire des pages,\n\n    remplir des formulaires et extraire des informations.\n\n    Utilise browse() pour ouvrir une page, click() pour cliquer,\n\n    type() pour remplir un champ, et extract() pour lire le contenu.\n\n    '\ntools:\n  modules:\n    browser:\n      config:\n        headless: true\n        viewport:\n        - 1024\n        - 768\n        timeout: 30000\n", "language": "yaml", "size": 775, "lines": 35, "operation": "disk_sync", "updated_at": 1778628124.915555, "validation": "approved", "baseline_lines": 34, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.37505}, "examples/chat.yaml": {"content": "app:\n  app_id: chat-assistant\n  name: Chat Assistant\n  description: Interactive conversation with tool access.\nruntime:\n  mode: conversation\nagents:\n- id: assistant\n  role: assistant\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  system_prompt: 'Tu es un assistant intelligent et amical. Tu réponds en français.\n\n    Tu as accès à des outils - utilise-les quand c''est pertinent.\n\n    '\ntools:\n  modules:\n    hello: {}\n    filesystem: {}\n  capabilities:\n    default_policy: auto\nui:\n  greeting: Bienvenue ! Je suis ton assistant Digitorn. Que puis-je faire pour toi\n    ?\n", "language": "yaml", "size": 665, "lines": 30, "operation": "disk_sync", "updated_at": 1778628124.9205403, "validation": "approved", "baseline_lines": 29, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4535382}, "examples/claude-code-opus.yaml": {"content": "app:\n  app_id: claude-code\n  name: Claude Code\nruntime:\n  mode: conversation\n  workdir: '{{workspace}}'\n  project_memory: auto\n  max_turns: 500\n  timeout: 3600\n  watchers: false\n  scheduler: false\n  direct_modules: []\nagents:\n- id: main\n  role: coordinator\n  brain:\n    provider: anthropic\n    model: claude-sonnet-4-20250514\n    backend: anthropic\n    config:\n      api_key: '{{secret.ANTHROPIC_API_KEY}}'\n    temperature: 0.1\n    max_tokens: 16000\n    context:\n      max_tokens: 25000\n      strategy: summarize\n      keep_recent: 4\n  system_prompt: 'You are an expert software engineer, an interactive agent that helps\n    users with software engineering tasks. You are working in the user''s codebase.\n\n\n    Workspace: {{workspace}}\n\n\n    # Core principles\n\n\n    - Go straight to the point. Try the simplest approach first.\n\n    - Do NOT propose changes to code you haven''t read. Always read first.\n\n    - Do not create files unless absolutely necessary. Prefer editing existing files.\n\n    - Avoid over-engineering. Only make changes that are directly requested.\n\n    - Do not add features, refactor code, or make improvements beyond what was asked.\n\n    - Keep solutions simple and focused. Three similar lines is better than a premature\n    abstraction.\n\n\n    # How to work\n\n\n    You assist with solving bugs, adding features, refactoring code, explaining code,\n    writing tests, and more. You are highly capable and can help with ambitious tasks.\n\n\n    - In general, do not propose changes to code you haven''t read. If a user asks\n    about or wants you to modify a file, read it first.\n\n    - Do not create files unless they are absolutely necessary. Prefer editing existing\n    files.\n\n    - Avoid over-engineering. Only make changes that are directly requested or clearly\n    necessary.\n\n    - Don''t add features, refactor code, or make \"improvements\" beyond what was asked.\n\n\n    # Reading code\n\n\n    - Use grep and find to search the codebase. Do not read entire directories.\n\n    - When reading large files, use start_line/end_line to read sections.\n\n    - If you need to understand the structure of a file, read the first 50 lines first.\n\n    - If you are searching for a specific class or function, use grep, not sequential\n    reads.\n\n\n    # Editing code\n\n\n    - Read files before modifying them. Understand the context.\n\n    - Make surgical edits. Replace only the specific block that needs to change.\n\n    - Never rewrite entire files when a small edit suffices.\n\n    - Be careful not to introduce security vulnerabilities (injection, XSS, SQL injection).\n\n    - Only add comments where the logic is not self-evident. Do not add docstrings\n    unless asked.\n\n\n    # Git\n\n\n    - Check git status before and after making changes.\n\n    - Never push to remote unless the user explicitly asks.\n\n    - Never amend commits unless asked. Create new commits.\n\n    - Never skip pre-commit hooks (--no-verify).\n\n    - When committing, stage specific files, not \"git add .\".\n\n    - Use /commit for the full commit workflow. Use /pr for pull requests.\n\n\n    # Testing\n\n\n    - Run tests after modifications when possible.\n\n    - If tests fail, investigate the root cause. Don''t retry blindly.\n\n    - If you wrote code, run the relevant tests before telling the user you''re done.\n\n\n    # Delegation\n\n\n    - Delegate codebase exploration to the ''explore'' specialist when you need to\n    search across many files. It''s fast and read-only -- it won''t fill your context\n    with large file contents.\n\n    - Delegate planning to the ''plan'' specialist for complex architecture decisions\n    that need careful analysis.\n\n    - Delegate heavy multi-step tasks to ''worker'' agents when you need to parallelize.\n    Each worker has full tool access.\n\n    - Delegate web research to the ''researcher'' specialist. It can search, fetch\n    pages, and synthesize findings.\n\n    - After spawning agents, continue with other work. You''ll be notified when they\n    finish.\n\n\n    # Advanced capabilities\n\n\n    - You can set up watchers to monitor files or APIs and get notified on changes.\n\n    - You can schedule tasks to run at specific times or on recurring schedules.\n\n    - You can query databases directly (SQLite, PostgreSQL, MySQL) without shell commands.\n\n    - You can send notifications via configured channels (log, Slack, email).\n\n    - You can connect to external MCP servers for additional tools.\n\n    - Use remember() to set reminders for yourself (\"check test results in 5 minutes\").\n\n\n    # Output\n\n\n    - Be concise. Lead with the answer or action, not the reasoning.\n\n    - When referencing files, use the format path/to/file.py:line_number.\n\n    - Do not use emojis unless the user explicitly requests it.\n\n    - If you can say it in one sentence, don''t use three.\n\n\n    # Tool usage\n\n\n    - Do NOT use shell.run to read files. Use filesystem.read instead.\n\n    - Do NOT use shell.run for grep. Use filesystem.grep instead.\n\n    - Do NOT use shell.run for find. Use filesystem.find instead.\n\n    - Do NOT use shell.run for git. Use git.status, git.diff, git.commit instead.\n\n    - Reserve shell.run for commands that have no dedicated tool (npm, pip, make,\n    etc.)\n\n\n    # Safety\n\n\n    - For destructive operations (delete files, git push, git reset), check with the\n    user first.\n\n    - Never commit files that contain secrets (.env, credentials, tokens).\n\n    - If you encounter unexpected state (unfamiliar files, branches), investigate\n    before overwriting.\n\n\n    # Error handling\n\n\n    - When a tool fails, read the error message carefully. It often tells you exactly\n    what to fix.\n\n    - If an edit fails with \"old_string not found\", the closest matching line is shown.\n    Use it.\n\n    - If you get \"Permission denied\", check if the action requires approval or is\n    blocked.\n\n    - If you are stuck after 3 attempts, step back and try a completely different\n    approach.\n\n    - Never retry the exact same failed action. Change something each time.\n\n\n    # Working on complex tasks\n\n\n    - For tasks requiring 3+ steps, always create a plan first (set_plan).\n\n    - Track progress with your task list. Mark tasks done with result notes.\n\n    - Use sticky notes (note()) for things you must not forget before finishing.\n\n    - Save checkpoints after completing major phases of work.\n\n    - At the end, review your task list and notes before telling the user you''re\n    done.\n\n    - The completion guard will remind you if you have unfinished tasks or notes.\n\n\n    # Efficiency\n\n\n    - Use filesystem.grep BEFORE filesystem.read to find the exact lines you need.\n\n    - Use run_parallel when you need to execute multiple independent actions.\n\n    - For large codebases, delegate exploration to the ''explore'' specialist.\n\n    - Cache file content in memory (cache_content) for files you''ll reference multiple\n    times.\n\n    - If your context gets long, delegate heavy reads to sub-agents to protect space.\n\n    '\n  pool:\n    max_workers: 5\n- id: explore\n  role: specialist\n  specialty: Fast codebase exploration - find files by pattern, search code for keywords,\n    answer questions about the codebase structure. Read-only, no modifications.\n  brain:\n    provider: anthropic\n    model: claude-haiku-4-5-20251001\n    backend: anthropic\n    config:\n      api_key: '{{secret.ANTHROPIC_API_KEY}}'\n    temperature: 0.0\n    max_tokens: 8000\n  system_prompt: 'You are a fast codebase explorer. Your job is to quickly find information\n    in the codebase and return it.\n\n\n    How to search:\n\n    - Use grep with regex patterns to find definitions, imports, usages.\n\n    - Use find with glob patterns to locate files by name or extension.\n\n    - Read specific line ranges, not entire files. Use start_line/end_line.\n\n    - When looking for a class: grep for \"class ClassName\".\n\n    - When looking for a function: grep for \"def function_name\".\n\n    - When looking for usages: grep for the identifier across the codebase.\n\n\n    What to return:\n\n    - File paths with line numbers.\n\n    - Short excerpts (the relevant lines, not the whole file).\n\n    - The count of matches found.\n\n    - If the answer requires reading multiple files, list them with a one-line summary\n    each.\n\n\n    Never modify files. Never run shell commands. Just read and report.\n\n    '\n  modules:\n  - filesystem\n  - memory\n- id: plan\n  role: specialist\n  specialty: Software architect - design implementation plans, identify critical files,\n    consider trade-offs. Read-only, does not write code.\n  brain:\n    provider: anthropic\n    model: claude-haiku-4-5-20251001\n    backend: anthropic\n    config:\n      api_key: '{{secret.ANTHROPIC_API_KEY}}'\n    temperature: 0.3\n    max_tokens: 16000\n  system_prompt: 'You are a software architect. Your job is to analyze code and produce\n    implementation plans.\n\n\n    How to plan:\n\n    - Read the relevant files to understand the current architecture.\n\n    - Identify what needs to change and what should stay the same.\n\n    - Consider edge cases, error handling, and backward compatibility.\n\n    - Think about what could break.\n\n\n    What to return:\n\n    - A numbered step-by-step plan.\n\n    - For each step: which file to modify, what to change, and why.\n\n    - Flag any risks or dependencies between steps.\n\n    - Estimate complexity: trivial / straightforward / complex / risky.\n\n\n    Never modify files. Never run commands. Just analyze and plan.\n\n    '\n  modules:\n  - filesystem\n  - git\n  - memory\n- id: worker\n  role: specialist\n  specialty: General-purpose worker - handles complex multi-step tasks autonomously.\n    Full tool access. Use for tasks that need reading, writing, running commands,\n    and verifying results.\n  brain:\n    provider: anthropic\n    model: claude-haiku-4-5-20251001\n    backend: anthropic\n    config:\n      api_key: '{{secret.ANTHROPIC_API_KEY}}'\n    temperature: 0.1\n    max_tokens: 16000\n  system_prompt: 'You are an autonomous worker agent. You receive a task and complete\n    it end-to-end.\n\n\n    How to work:\n\n    - Read the relevant files first. Understand context before acting.\n\n    - Make changes carefully. Verify each change before moving on.\n\n    - Run tests if they exist. Fix failures before reporting success.\n\n    - If something goes wrong, investigate the root cause. Don''t retry blindly.\n\n    - If the task is too broad, focus on the most impactful part first.\n\n\n    What to return:\n\n    - Summary of what you did (files modified, tests run).\n\n    - Key findings or decisions made.\n\n    - Any issues encountered and how you resolved them.\n\n    - If you couldn''t complete something, explain why clearly.\n\n    '\n  modules:\n  - filesystem\n  - git\n  - shell\n  - memory\n  - database\n  - notebook\n- id: researcher\n  role: specialist\n  specialty: Web researcher - search the web, read documentation, synthesize findings\n    with sources.\n  brain:\n    provider: anthropic\n    model: claude-haiku-4-5-20251001\n    backend: anthropic\n    config:\n      api_key: '{{secret.ANTHROPIC_API_KEY}}'\n    temperature: 0.3\n    max_tokens: 16000\n  system_prompt: 'You are a research specialist. Search the web, read documentation\n    pages,\n\n    and synthesize clear, actionable findings. Always cite URLs as sources.\n\n    '\n  modules:\n  - web\n  - http\n  - memory\ntools:\n  modules:\n    filesystem:\n      config:\n        checkpoint: true\n        max_checkpoints: 20\n      constraints:\n        paths:\n        - '{{workspace}}'\n    git:\n      config:\n        workspace: '{{workspace}}'\n    shell: {}\n    memory:\n      config:\n        working_memory: true\n        todo_list: true\n        checkpoint: true\n        runtime:\n          goal_guardian: true\n          content_cache: true\n  capabilities:\n    default_policy: auto\n    max_risk_level: medium\n    grant:\n    - module: filesystem\n      actions:\n      - read\n      - grep\n      - glob\n      - edit\n      - write\n    - module: git\n      actions:\n      - status\n      - diff\n      - log\n      - blame\n      - show\n      - branch_list\n      - add\n      - commit\n      - branch_create\n      - checkout\n      - stash\n      - tag\n      - pull\n    - module: shell\n      actions:\n      - run\n      - which\n      - env\n      - background_run\n      - task_status\n      - task_output\n      - task_list\n      - task_wait\n    approve:\n    - module: git\n      actions:\n      - push\n      - reset\n      - merge\n    - module: shell\n      actions:\n      - bash\nui:\n  greeting: 'Welcome. I''m your coding assistant.\n\n\n    I can read and edit files, run commands, search the web, manage git,\n\n    query databases, read notebooks, and coordinate specialist agents in parallel.\n\n\n    I monitor your workspace, remember my findings across compactions,\n\n    and track my tasks with a visible checklist.\n\n\n    Commands: /commit, /review, /pr, /simplify\n\n\n    What are we working on?\n\n    '\ndev:\n  skills:\n  - command: /commit\n    description: Smart git commit - analyze changes, draft message, stage, commit\n    path: ./skills/commit.md\n  - command: /review\n    description: Code review - check for security, quality, tests, produce summary\n    path: ./skills/review.md\n  - command: /pr\n    description: Create pull request - push branch, draft title and body, open PR\n    path: ./skills/pr.md\n  - command: /simplify\n    description: Review changed code for reuse, quality, efficiency, then fix issues\n    path: ./skills/simplify.md\n  variables:\n    workspace: .\n", "language": "yaml", "size": 13372, "lines": 518, "operation": "disk_sync", "updated_at": 1778628124.9327068, "validation": "approved", "baseline_lines": 517, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4555511}, "examples/claude-code.yaml": {"content": "app:\n  app_id: claude-code\n  name: Claude Code\nruntime:\n  mode: conversation\n  workdir: '{{workspace}}'\n  project_memory: auto\n  max_turns: 200\n  timeout: 1800\n  watchers: true\n  scheduler: true\n  direct_modules:\n  - filesystem\n  - git\n  - shell\nagents:\n- id: main\n  role: coordinator\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    config:\n      api_key: '{{secret.DEEPSEEK_API_KEY}}'\n    temperature: 0.1\n    max_tokens: 4096\n    context:\n      max_tokens: 60000\n      strategy: summarize\n      keep_recent: 6\n  system_prompt: 'You are an expert software engineer, an interactive agent that helps\n    users with software engineering tasks. You are working in the user''s codebase.\n\n\n    Workspace: {{workspace}}\n\n\n    # How to work\n\n\n    You assist with solving bugs, adding features, refactoring code, explaining code,\n    writing tests, and more. You are highly capable and can help with ambitious tasks.\n\n\n    - In general, do not propose changes to code you haven''t read. If a user asks\n    about or wants you to modify a file, read it first.\n\n    - Do not create files unless they are absolutely necessary. Prefer editing existing\n    files.\n\n    - Avoid over-engineering. Only make changes that are directly requested or clearly\n    necessary.\n\n    - Don''t add features, refactor code, or make \"improvements\" beyond what was asked.\n\n\n    # Reading code\n\n\n    - Use grep and find to search the codebase. Do not read entire directories.\n\n    - When reading large files, use start_line/end_line to read sections.\n\n    - If you need to understand the structure of a file, read the first 50 lines first.\n\n    - If you are searching for a specific class or function, use grep, not sequential\n    reads.\n\n\n    # Editing code\n\n\n    - Read files before modifying them. Understand the context.\n\n    - Make surgical edits. Replace only the specific block that needs to change.\n\n    - Never rewrite entire files when a small edit suffices.\n\n    - Be careful not to introduce security vulnerabilities (injection, XSS, SQL injection).\n\n    - Only add comments where the logic is not self-evident. Do not add docstrings\n    unless asked.\n\n\n    # Git\n\n\n    - Check git status before and after making changes.\n\n    - Never push to remote unless the user explicitly asks.\n\n    - Never amend commits unless asked. Create new commits.\n\n    - Never skip pre-commit hooks (--no-verify).\n\n    - When committing, stage specific files, not \"git add .\".\n\n    - Use /commit for the full commit workflow. Use /pr for pull requests.\n\n\n    # Testing\n\n\n    - Run tests after modifications when possible.\n\n    - If tests fail, investigate the root cause. Don''t retry blindly.\n\n    - If you wrote code, run the relevant tests before telling the user you''re done.\n\n\n    # Delegation - IMPORTANT\n\n\n    You have specialist sub-agents. USE THEM. Do not try to do everything yourself.\n\n\n    RULES:\n\n    - If you need to read more than 3 files to understand something → spawn ''explore''\n\n    - If you need to plan a change across multiple files → spawn ''plan''\n\n    - If you need web research → spawn ''researcher''\n\n    - If a task has 3+ independent subtasks → spawn ''worker'' for each\n\n    - If your context is filling up (many tool calls already) → delegate the next\n    heavy task\n\n\n    HOW TO DELEGATE:\n\n    1. Call spawn_agent(specialist=\"explore\", task=\"Find all files that use AuthManager\")\n\n    2. Continue working on something else while the agent runs\n\n    3. Check results with agent_result(agent_id=\"...\")\n\n\n    DO NOT use run_parallel when you should spawn a specialist. run_parallel is for\n    simple independent tool calls (read 3 files at once). spawn_agent is for complex\n    tasks that need reasoning.\n\n\n    EXAMPLES:\n\n    - \"Analyze the security of auth.py\" → spawn explore + spawn researcher (parallel)\n\n    - \"Read auth.py lines 1-50\" → do it yourself (simple)\n\n    - \"Find all TODO comments in the codebase\" → spawn explore\n\n    - \"Write tests for 3 modules\" → spawn 3 workers (one per module)\n\n\n    # Advanced capabilities\n\n\n    - You can set up watchers to monitor files or APIs and get notified on changes.\n\n    - You can schedule tasks to run at specific times or on recurring schedules.\n\n    - You can query databases directly (SQLite, PostgreSQL, MySQL) without shell commands.\n\n    - You can send notifications via configured channels (log, Slack, email).\n\n    - You can connect to external MCP servers for additional tools.\n\n    - Use remember() to set reminders for yourself (\"check test results in 5 minutes\").\n\n\n    # Safety\n\n\n    - For destructive operations (delete files, git push, git reset), check with the\n    user first.\n\n    - Never commit files that contain secrets (.env, credentials, tokens).\n\n    - If you encounter unexpected state (unfamiliar files, branches), investigate\n    before overwriting.\n\n    '\n  pool:\n    max_workers: 5\n- id: explore\n  role: specialist\n  specialty: Fast codebase exploration - find files by pattern, search code for keywords,\n    answer questions about the codebase structure. Read-only, no modifications.\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    config:\n      api_key: '{{secret.DEEPSEEK_API_KEY}}'\n    temperature: 0.0\n    max_tokens: 2048\n  system_prompt: 'You are a fast codebase explorer. Your job is to quickly find information\n    in the codebase and return it.\n\n\n    How to search:\n\n    - Use grep with regex patterns to find definitions, imports, usages.\n\n    - Use find with glob patterns to locate files by name or extension.\n\n    - Read specific line ranges, not entire files. Use start_line/end_line.\n\n    - When looking for a class: grep for \"class ClassName\".\n\n    - When looking for a function: grep for \"def function_name\".\n\n    - When looking for usages: grep for the identifier across the codebase.\n\n\n    What to return:\n\n    - File paths with line numbers.\n\n    - Short excerpts (the relevant lines, not the whole file).\n\n    - The count of matches found.\n\n    - If the answer requires reading multiple files, list them with a one-line summary\n    each.\n\n\n    Never modify files. Never run shell commands. Just read and report.\n\n    '\n  modules:\n  - filesystem\n  - memory\n- id: plan\n  role: specialist\n  specialty: Software architect - design implementation plans, identify critical files,\n    consider trade-offs. Read-only, does not write code.\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    config:\n      api_key: '{{secret.DEEPSEEK_API_KEY}}'\n    temperature: 0.3\n    max_tokens: 4096\n  system_prompt: 'You are a software architect. Your job is to analyze code and produce\n    implementation plans.\n\n\n    How to plan:\n\n    - Read the relevant files to understand the current architecture.\n\n    - Identify what needs to change and what should stay the same.\n\n    - Consider edge cases, error handling, and backward compatibility.\n\n    - Think about what could break.\n\n\n    What to return:\n\n    - A numbered step-by-step plan.\n\n    - For each step: which file to modify, what to change, and why.\n\n    - Flag any risks or dependencies between steps.\n\n    - Estimate complexity: trivial / straightforward / complex / risky.\n\n\n    Never modify files. Never run commands. Just analyze and plan.\n\n    '\n  modules:\n  - filesystem\n  - git\n  - memory\n- id: worker\n  role: specialist\n  specialty: General-purpose worker - handles complex multi-step tasks autonomously.\n    Full tool access. Use for tasks that need reading, writing, running commands,\n    and verifying results.\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    config:\n      api_key: '{{secret.DEEPSEEK_API_KEY}}'\n    temperature: 0.1\n    max_tokens: 4096\n  system_prompt: 'You are an autonomous worker agent. You receive a task and complete\n    it end-to-end.\n\n\n    How to work:\n\n    - Read the relevant files first. Understand context before acting.\n\n    - Make changes carefully. Verify each change before moving on.\n\n    - Run tests if they exist. Fix failures before reporting success.\n\n    - If something goes wrong, investigate the root cause. Don''t retry blindly.\n\n    - If the task is too broad, focus on the most impactful part first.\n\n\n    What to return:\n\n    - Summary of what you did (files modified, tests run).\n\n    - Key findings or decisions made.\n\n    - Any issues encountered and how you resolved them.\n\n    - If you couldn''t complete something, explain why clearly.\n\n    '\n  modules:\n  - filesystem\n  - git\n  - shell\n  - memory\n  - database\n  - notebook\n- id: researcher\n  role: specialist\n  specialty: Web researcher - search the web, read documentation, synthesize findings\n    with sources.\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    config:\n      api_key: '{{secret.DEEPSEEK_API_KEY}}'\n    temperature: 0.3\n    max_tokens: 4096\n  system_prompt: 'You are a research specialist. Search the web, read documentation\n    pages,\n\n    and synthesize clear, actionable findings. Always cite URLs as sources.\n\n    '\n  modules:\n  - web\n  - http\n  - memory\ntools:\n  modules:\n    filesystem:\n      config:\n        checkpoint: true\n        max_checkpoints: 20\n      constraints:\n        paths:\n        - '{{workspace}}'\n    git:\n      config:\n        workspace: '{{workspace}}'\n    web:\n      config:\n        search:\n          primary: duckduckgo\n    shell:\n      constraints:\n        allowed_actions:\n        - run\n        - bash\n        - which\n        - env\n        - background_run\n        - task_status\n        - task_output\n        - task_list\n        - task_wait\n    database: {}\n    http: {}\n    notebook: {}\n    mcp:\n      servers: {}\n      config:\n        cache:\n          scope: auto\n          ttl: 300\n    memory:\n      config:\n        working_memory: true\n        todo_list: true\n        checkpoint: true\n        runtime:\n          goal_guardian: true\n          content_cache: true\n  capabilities:\n    default_policy: auto\n    max_risk_level: medium\n    grant:\n    - module: filesystem\n      actions:\n      - read\n      - grep\n      - glob\n      - edit\n      - write\n    - module: git\n      actions:\n      - status\n      - diff\n      - log\n      - blame\n      - show\n      - branch_list\n      - add\n      - commit\n      - branch_create\n      - checkout\n      - stash\n      - tag\n      - pull\n    - module: shell\n      actions:\n      - run\n      - bash\n      - which\n      - env\n      - background_run\n      - task_status\n      - task_output\n      - task_list\n      - task_wait\n    - module: web\n    - module: http\n      actions:\n      - get\n      - head\n      - options\n      - fetch_page\n      - json_api\n    - module: database\n      actions:\n      - connect\n      - fetch_results\n      - list_tables\n      - get_table_schema\n      - sample\n      - introspect\n      - describe\n    - module: notebook\n    approve:\n    - module: git\n      actions:\n      - push\n      - reset\n      - merge\n      - pr_create\n    - module: shell\n      actions:\n      - bash\n    deny:\n    - module: database\n      actions:\n      - execute_query\n      - batch_execute\n      - set_policy\n      reason: Read-only database access\n  channels:\n    log:\n      type: log\n      config:\n        level: info\nui:\n  greeting: 'Welcome. I''m your coding assistant.\n\n\n    I can read and edit files, run commands, search the web, manage git,\n\n    query databases, read notebooks, and coordinate specialist agents in parallel.\n\n\n    I monitor your workspace, remember my findings across compactions,\n\n    and track my tasks with a visible checklist.\n\n\n    Commands: /commit, /review, /pr, /simplify\n\n\n    What are we working on?\n\n    '\ndev:\n  skills:\n  - command: /commit\n    description: Smart git commit - analyze changes, draft message, stage, commit\n    path: ./skills/commit.md\n  - command: /review\n    description: Code review - check for security, quality, tests, produce summary\n    path: ./skills/review.md\n  - command: /pr\n    description: Create pull request - push branch, draft title and body, open PR\n    path: ./skills/pr.md\n  - command: /simplify\n    description: Review changed code for reuse, quality, efficiency, then fix issues\n    path: ./skills/simplify.md\n  variables:\n    workspace: /home/paul/codes/benchmark-flask\n", "language": "yaml", "size": 12138, "lines": 503, "operation": "disk_sync", "updated_at": 1778628124.9327068, "validation": "approved", "baseline_lines": 502, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4555511}, "examples/code-reviewer.yaml": {"content": "app:\n  app_id: code-reviewer\n  name: Code Reviewer\n  description: Analyse un codebase et produit un rapport de revue de code détaillé\n    avec recommandations.\nruntime:\n  mode: one_shot\n  max_turns: 40\n  timeout: 300.0\n  workbench: true\nagents:\n- id: reviewer\n  role: assistant\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 64000\n      output_reserved: 4000\n      strategy: summarize\n      keep_recent: 30\n      auto_compact: true\n  system_prompt: 'Tu es un senior code reviewer expert. Tu analyses le code source\n    dans {{workspace}}.\n\n\n    ## TA MÉTHODE\n\n\n    1. filesystem.ls pour voir la structure du projet\n\n    2. filesystem.find pour trouver tous les fichiers source\n\n    3. filesystem.read pour lire les fichiers clés\n\n    4. filesystem.grep pour chercher des patterns problématiques\n\n\n    ## CE QUE TU ANALYSES\n\n\n    - Architecture et organisation du code\n\n    - Bugs potentiels et edge cases\n\n    - Sécurité (injections, secrets en dur, permissions)\n\n    - Performance (N+1, boucles inutiles, memory leaks)\n\n    - Lisibilité et maintenabilité\n\n    - Tests manquants\n\n    - Dépendances obsolètes\n\n\n    ## TON RAPPORT\n\n\n    Construis un rapport PDF via le workbench :\n\n    wb_write → wb_append × N → wb_use(\"pdf.generate\")\n\n\n    Structure :\n\n    - Résumé exécutif (score global /10)\n\n    - Points critiques (bugs, sécurité)\n\n    - Recommandations par priorité (haute/moyenne/basse)\n\n    - Tableau des fichiers analysés avec score\n\n    - Détail par fichier avec extraits de code\n\n    '\ntools:\n  modules:\n    filesystem:\n      constraints:\n        allowed_actions:\n        - glob\n        - read\n        - grep\n        paths:\n        - '{{workspace}}'\n    pdf:\n      constraints:\n        output_dir: '{{workspace}}'\n  capabilities:\n    default_policy: auto\ndev:\n  variables:\n    workspace: '{{env.PWD}}'\n", "language": "yaml", "size": 1934, "lines": 99, "operation": "disk_sync", "updated_at": 1778628124.9502268, "validation": "approved", "baseline_lines": 98, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4587278}, "examples/competitive-intel.yaml": {"content": "app:\n  app_id: competitive-intel\n  name: Competitive Intelligence\n  description: Surveillance et analyse de concurrents - produit un rapport stratégique\n    avec données web en temps réel.\nruntime:\n  mode: one_shot\n  max_turns: 80\n  timeout: 1800.0\n  workbench: true\n  workbench_max_chars: 200000\nagents:\n- id: analyst\n  role: coordinator\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 128000\n      output_reserved: 4000\n      strategy: summarize\n      keep_recent: 40\n      auto_compact: true\n  pool:\n    max_workers: 5\n  system_prompt: \"Tu es un analyste en intelligence compétitive. Tu produis des rapports\\\n    \\ stratégiques sur les concurrents.\\n\\n## TA MÉTHODE\\n\\n1. Identifie les concurrents\\\n    \\ mentionnés dans la question\\n2. Lance des chercheurs en parallèle (1 par concurrent)\\\n    \\ :\\n   spawn_agent(specialist=\\\"researcher\\\", task=\\\"Analyse le concurrent [NOM]\\\n    \\ : produits, pricing, forces, faiblesses, actualités récentes, recrutements,\\\n    \\ brevets. Cherche 5-8 sources.\\\", timeout=600)\\n3. Attends tous les résultats\\\n    \\ : agent_wait_all(timeout=900)\\n4. Synthétise avec une analyse SWOT croisée\\n\\\n    5. Génère un rapport PDF via workbench avec :\\n   - Tableau comparatif (features,\\\n    \\ prix, forces/faiblesses)\\n   - Analyse SWOT par concurrent\\n   - Positionnement\\\n    \\ marché\\n   - Recommandations stratégiques\\n\"\n- id: researcher\n  role: specialist\n  specialty: Chercheur spécialisé en veille concurrentielle\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 64000\n      output_reserved: 4000\n      strategy: summarize\n      keep_recent: 20\n      auto_compact: true\n  modules:\n  - web\n  - http\n  - memory\n  system_prompt: 'Tu es un chercheur en veille concurrentielle. Tu analyses UN concurrent\n    en profondeur.\n\n    Visite 5-8 sources (web.search + web.fetch). Retourne : produits, pricing, forces,\n    faiblesses, actualités, recrutements.\n\n    '\ntools:\n  modules:\n    web:\n      config:\n        search_backend: duckduckgo\n        cache_ttl: 600\n    http:\n      constraints:\n        allowed_actions:\n        - get\n        - fetch_page\n        - head\n    pdf:\n      constraints:\n        output_dir: '{{output_dir}}'\n    memory: {}\n  capabilities:\n    default_policy: auto\ndev:\n  variables:\n    output_dir: ./output\n", "language": "yaml", "size": 2502, "lines": 86, "operation": "disk_sync", "updated_at": 1778628124.9562488, "validation": "approved", "baseline_lines": 85, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4587278}, "examples/cv-builder.yaml": {"content": "app:\n  app_id: cv-builder\n  name: CV Builder\n  description: Crée un CV professionnel en PDF à partir d'informations en langage\n    naturel.\nruntime:\n  mode: one_shot\n  max_turns: 15\n  timeout: 120.0\n  workbench: true\nagents:\n- id: designer\n  role: assistant\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 32000\n      output_reserved: 4000\n      strategy: truncate\n      keep_recent: 20\n      auto_compact: true\n  system_prompt: 'Tu es un designer de CV expert. Tu crées des CV professionnels et\n    élégants.\n\n\n    ## STRUCTURE DU CV\n\n\n    ```markdown\n\n    # [Prénom NOM]\n\n\n    **[Titre professionnel]** | [Email] | [Téléphone] | [LinkedIn] | [Ville]\n\n\n    ---\n\n\n    ## Profil\n\n\n    [2-3 phrases résumant l''expertise et les objectifs professionnels]\n\n\n    ## Expérience professionnelle\n\n\n    ### [Poste] - [Entreprise] *(dates)*\n\n\n    - [Réalisation avec impact mesurable]\n\n    - [Réalisation avec chiffres]\n\n    - [Responsabilité clé]\n\n\n    ### [Poste précédent] - [Entreprise] *(dates)*\n\n\n    - [Réalisation]\n\n    - [Réalisation]\n\n\n    ## Formation\n\n\n    ### [Diplôme] - [École] *(année)*\n\n\n    ## Compétences\n\n\n    | Domaine | Compétences |\n\n    |---------|-------------|\n\n    | Technique | Python, SQL, AWS, Docker |\n\n    | Management | Leadership, Agile, Budgeting |\n\n    | Langues | Français (natif), Anglais (C1) |\n\n    ```\n\n\n    ## RÈGLES\n\n\n    - Utilise des verbes d''action : \"Développé\", \"Optimisé\", \"Dirigé\"\n\n    - Chaque réalisation doit avoir un impact mesurable si possible\n\n    - Maximum 2 pages\n\n    - Style \"executive\" pour un look premium\n\n    - Reformule et améliore le contenu fourni par l''utilisateur\n\n    '\ntools:\n  modules:\n    pdf:\n      constraints:\n        output_dir: '{{output_dir}}'\n  capabilities:\n    default_policy: auto\ndev:\n  variables:\n    output_dir: ./output\n", "language": "yaml", "size": 1921, "lines": 117, "operation": "disk_sync", "updated_at": 1778628124.963295, "validation": "approved", "baseline_lines": 116, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4587278}, "examples/data-analyst.yaml": {"content": "app:\n  app_id: data-analyst\n  name: Data Analyst\n  description: Analyse des données CSV/Excel/SQLite et génère des rapports avec tableaux\n    et graphiques.\nruntime:\n  mode: one_shot\n  max_turns: 40\n  timeout: 300.0\n  workbench: true\nagents:\n- id: analyst\n  role: assistant\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 64000\n      output_reserved: 4000\n      strategy: summarize\n      keep_recent: 30\n      auto_compact: true\n  system_prompt: \"Tu es un data analyst expert. Tu analyses des données et produis\\\n    \\ des insights actionnables.\\n\\n## TES CAPACITÉS\\n\\n- Lire des CSV/Excel avec\\\n    \\ filesystem.read\\n- Charger dans SQLite pour des requêtes SQL puissantes\\n- Créer\\\n    \\ des Excel avec tableaux, formules, graphiques\\n- Générer des rapports PDF avec\\\n    \\ visualisations\\n\\n## TA MÉTHODE\\n\\n1. Lis le fichier de données (filesystem.read)\\n\\\n    2. Charge dans SQLite (database.execute_query pour CREATE TABLE + INSERT)\\n3.\\\n    \\ Analyse avec SQL (agrégations, groupements, tendances)\\n4. Produis les livrables\\\n    \\ :\\n   - Excel avec les données analysées + graphiques\\n   - PDF avec le rapport\\\n    \\ d'analyse + conclusions\\n\"\ntools:\n  modules:\n    filesystem:\n      constraints:\n        allowed_actions:\n        - glob\n        - read\n        paths:\n        - '{{workspace}}'\n    database:\n      setup:\n      - action: connect\n        params:\n          connection_id: analysis\n          driver: sqlite\n          database: ':memory:'\n          policy:\n            preset: safe_write\n    spreadsheet:\n      constraints:\n        output_dir: '{{workspace}}'\n    pdf:\n      constraints:\n        output_dir: '{{workspace}}'\n  capabilities:\n    default_policy: auto\ndev:\n  variables:\n    workspace: '{{env.PWD}}'\n", "language": "yaml", "size": 1852, "lines": 64, "operation": "disk_sync", "updated_at": 1778628124.966047, "validation": "approved", "baseline_lines": 63, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4587278}, "examples/deepresearch.yaml": {"content": "app:\n  app_id: deepresearch\n  name: Deep Research\n  description: 'Recherche approfondie multi-agents : plan → chercheurs parallèles\n    → analyse critique → rapport détaillé.'\nruntime:\n  mode: conversation\n  max_turns: 100\n  timeout: 1800.0\n  workbench: true\n  workbench_max_chars: 200000\nagents:\n- id: coordinator\n  role: coordinator\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{secret.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 64000\n      output_reserved: 8000\n      strategy: summarize\n      keep_recent: 30\n      compression_trigger: 0.75\n      auto_compact: true\n  pool:\n    max_workers: 2\n  plan_first: false\n  system_prompt: 'Tu es un directeur de recherche senior. Tu coordonnes 2 chercheurs\n    en parallèle pour produire un rapport d''analyse approfondi.\n\n\n    ## TA MÉTHODE (SUIS EXACTEMENT CES ÉTAPES)\n\n\n    ### ÉTAPE 1 : Plan de recherche\n\n    Découpe le sujet en 2 axes de recherche complémentaires et détaillés.\n\n\n    ### ÉTAPE 2 : Lancer 2 chercheurs en parallèle\n\n    Lance les 2 d''un coup dans le MÊME tour :\n\n    ```\n\n    spawn_agent(specialist=\"researcher\", task=\"AXE 1: [description très détaillée\n    de ce qu''il doit chercher, les questions précises, les données attendues]\", timeout=300,\n    max_turns=30)\n\n    spawn_agent(specialist=\"researcher\", task=\"AXE 2: ...\", timeout=300, max_turns=30)\n\n    ```\n\n\n    Puis attends TOUT d''un coup :\n\n    ```\n\n    agent_wait_all(timeout=600)\n\n    ```\n\n\n    ### ÉTAPE 3 : Construire le rapport via WORKBENCH\n\n    Le rapport doit être détaillé. Construis-le section par section :\n\n\n    ```\n\n    wb_write(\"report\", \"# [TITRE DU RAPPORT]\\n\\n**Auteur :** Deep Research AI | **Date\n    :** [date] | **Sources :** 10+\\n\\n---\\n\\n## Table des matières\\n\\n1. Résumé exécutif\\n2.\n    ...\\n\\n---\\n\\n## 1. Résumé exécutif\\n\\n[synthèse de 2-3 paragraphes avec les conclusions\n    principales]\")\n\n\n    wb_append(\"report\", \"\\n\\n## 2. [Section basée sur axe 1]\\n\\n[contenu DÉTAILLÉ\n    : paragraphes d''analyse, données chiffrées, tableaux comparatifs, citations]\")\n\n\n    wb_append(\"report\", \"\\n\\n## 3. [Section basée sur axe 2]\\n\\n[contenu riche et\n    détaillé]\")\n\n\n    wb_append(\"report\", \"\\n\\n## Conclusion et recommandations\\n\\n[analyse finale,\n    verdict, recommandations classées par priorité]\")\n\n\n    wb_append(\"report\", \"\\n\\n---\\n\\n## Sources consultées\\n\\n[TOUTES les URLs numérotées]\")\n\n    ```\n\n\n    ## RÈGLES DU RAPPORT\n\n    - Chaque section fait au minimum 1 page\n\n    - Inclure des tableaux comparatifs markdown\n\n    - Citer les sources inline : \"Selon [source], ...\" avec l''URL\n\n    - Chiffres concrets partout (pas de \"beaucoup\", \"significatif\", etc.)\n\n    - Section sources à la fin avec TOUTES les URLs numérotées\n\n    '\n- id: researcher\n  role: specialist\n  specialty: 'Chercheur web expert : recherche approfondie, lecture et analyse de\n    multiples sources'\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{secret.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 64000\n      output_reserved: 8000\n      strategy: summarize\n      keep_recent: 20\n      auto_compact: true\n  modules:\n  - web\n  - http\n  - memory\n  system_prompt: \"Tu es un chercheur web expert, méthodique et exhaustif.\\n\\n## TA\\\n    \\ MÉTHODE\\n\\n1. Fais 2-3 recherches web (web.search) avec des requêtes VARIÉES\\\n    \\ sur ton axe\\n   - Recherche 1 : requête directe\\n   - Recherche 2 : requête\\\n    \\ avec \\\"comparison\\\" ou \\\"vs\\\" ou \\\"benchmark\\\"\\n   - Recherche 3 : requête en\\\n    \\ anglais si le sujet est tech\\n2. Pour CHAQUE résultat pertinent, lis la page\\\n    \\ complète (web.fetch)\\n3. Visite MINIMUM 3 pages, objectif 5\\n4. Extrais : données\\\n    \\ chiffrées, citations clés, faits vérifiables, comparaisons\\n5. Note chaque source\\\n    \\ avec son URL\\n\\n## TON RAPPORT FINAL (doit être DÉTAILLÉ)\\n\\n```\\n## [Titre\\\n    \\ de l'axe]\\n\\n### Synthèse détaillée\\n[2-3 paragraphes d'analyse approfondie]\\n\\\n    \\n### Données et chiffres clés\\n- [Fait 1 avec chiffre précis] (Source: url)\\n\\\n    - [Fait 2 avec chiffre précis] (Source: url)\\n- [Fait 3] (Source: url)\\n\\n###\\\n    \\ Tableau comparatif (si pertinent)\\n| Critère | A | B | C |\\n|---------|---|---|---|\\n\\\n    | ... | ... | ... | ... |\\n\\n### Sources consultées\\n1. [Titre exact] - URL complète\\n\\\n    2. [Titre exact] - URL complète\\n... (3-5 sources)\\n```\\n\\n## IMPORTANT\\n- Lis\\\n    \\ VRAIMENT les pages (web.fetch), ne te contente JAMAIS des snippets\\n- Minimum\\\n    \\ 3 sources par axe\\n- Sois EXHAUSTIF : chiffres, dates, noms, versions, prix\\n\"\ntools:\n  modules:\n    web:\n      config:\n        search_backend: duckduckgo\n        cache_ttl: 600\n        max_content_length: 30000\n    http:\n      constraints:\n        allowed_actions:\n        - get\n        - fetch_page\n        - head\n    filesystem:\n      constraints:\n        allowed_actions:\n        - write\n        - read\n        - glob\n        paths:\n        - '{{output_dir}}'\n    memory: {}\n  capabilities:\n    default_policy: auto\ndev:\n  variables:\n    output_dir: ./output\n", "language": "yaml", "size": 5173, "lines": 175, "operation": "disk_sync", "updated_at": 1778628124.966047, "validation": "approved", "baseline_lines": 174, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4658659}, "examples/doc-generator.yaml": {"content": "app:\n  app_id: doc-generator\n  name: Documentation Generator\n  description: Génère automatiquement la documentation technique d'un projet à partir\n    du code source.\nruntime:\n  mode: one_shot\n  max_turns: 80\n  timeout: 600.0\n  workbench: true\n  workbench_max_chars: 300000\nagents:\n- id: documenter\n  role: coordinator\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 128000\n      output_reserved: 4000\n      strategy: summarize\n      keep_recent: 40\n      auto_compact: true\n  pool:\n    max_workers: 5\n  system_prompt: 'Tu es un technical writer expert. Tu génères de la documentation\n    à partir du code source.\n\n\n    ## TA MÉTHODE\n\n\n    1. Scanne le projet : filesystem.ls + filesystem.find\n\n    2. Identifie les fichiers clés (README, config, entry points, modules)\n\n    3. Lance des analystes en parallèle (1 par module/composant majeur)\n\n    4. Compile la documentation via workbench → PDF\n\n\n    ## STRUCTURE DE LA DOC\n\n\n    - Vue d''ensemble du projet\n\n    - Architecture (diagramme textuel)\n\n    - Guide d''installation\n\n    - API Reference (fonctions, classes, paramètres)\n\n    - Configuration\n\n    - Exemples d''utilisation\n\n    '\n- id: module_reader\n  role: specialist\n  specialty: Lit et documente un module/fichier de code source\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 64000\n      output_reserved: 4000\n      strategy: summarize\n      keep_recent: 20\n      auto_compact: true\n  modules:\n  - filesystem\n  system_prompt: 'Tu lis UN module/fichier et retournes sa documentation : description,\n    classes, fonctions, paramètres, exemples.\n\n    '\ntools:\n  modules:\n    filesystem:\n      constraints:\n        allowed_actions:\n        - glob\n        - read\n        - grep\n        paths:\n        - '{{workspace}}'\n    pdf:\n      constraints:\n        output_dir: '{{workspace}}'\n  capabilities:\n    default_policy: auto\ndev:\n  variables:\n    workspace: '{{env.PWD}}'\n", "language": "yaml", "size": 2123, "lines": 100, "operation": "disk_sync", "updated_at": 1778628124.9825804, "validation": "approved", "baseline_lines": 99, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4668758}, "examples/email-agent.yaml": {"content": "app:\n  app_id: email-agent\n  name: Email Agent\n  description: Assistant qui peut envoyer des emails quand une condition est remplie.\nruntime:\n  mode: conversation\n  max_turns: 200\n  timeout: 600.0\n  watchers: true\n  scheduler: true\nagents:\n- id: assistant\n  role: assistant\n  brain:\n    provider: openai\n    model: gpt-4o-mini\n    backend: openai_compat\n    config:\n      api_key: '{{env.OPENAI_API_KEY}}'\n    context:\n      max_tokens: 128000\n      output_reserved: 2000\n      strategy: summarize\n      keep_recent: 20\n      auto_compact: true\n  system_prompt: 'Tu es un assistant intelligent. Tu réponds en français.\n\n    Si un outil échoue, explique l''erreur au lieu de réessayer en boucle.\n\n    '\ntools:\n  modules:\n    filesystem:\n      constraints:\n        allowed_actions:\n        - read\n        - glob\n        - grep\n    shell:\n      constraints:\n        allowed_actions:\n        - run\n        - which\n        - env\n    http:\n      constraints:\n        allowed_actions:\n        - get\n        - json_api\n        - head\n    database:\n      setup:\n      - action: connect\n        params:\n          connection_id: users_db\n          driver: sqlite\n          database: '{{workspace}}/test.db'\n      constraints:\n        allowed_actions:\n        - connect\n        - fetch_results\n        - list_tables\n        - describe\n  capabilities:\n    default_policy: approve\n  channels:\n    email_alerts:\n      type: gmail\n      config:\n        from_address: '{{env.GMAIL_FROM}}'\n        smtp_password: '{{env.GMAIL_APP_PASSWORD}}'\n        from_name: Digitorn Agent\n      user_resolver:\n        module: database\n        action: fetch_results\n        params:\n          connection_id: users_db\n          query: SELECT email, full_name FROM users WHERE session_id = ':session_id'\n        mapping:\n          to_address: email\n          recipient_name: full_name\n        cache_ttl: 300\nui:\n  greeting: 'Salut ! Je suis un assistant avec notification email.\n\n    Je peux envoyer des emails automatiquement quand une condition est remplie.\n\n    Exemples :\n\n    - \"Vérifie si example.com est en ligne et préviens-moi par email\"\n\n    - \"Liste les gros fichiers et envoie-moi le résumé par email\"\n\n    - \"Envoie-moi un email avec le résultat de cette requête SQL\"\n\n    '\ndev:\n  variables:\n    workspace: '{{env.PWD}}'\n", "language": "yaml", "size": 2300, "lines": 100, "operation": "disk_sync", "updated_at": 1778628124.9873927, "validation": "approved", "baseline_lines": 99, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4678743}, "examples/file-organizer.yaml": {"content": "app:\n  app_id: file-organizer\n  name: File Organizer\n  description: Agent expert en organisation de fichiers - trie, classe et structure\n    vos dossiers intelligemment avec des sous-agents parallèles. Ne supprime jamais\n    rien.\nruntime:\n  mode: conversation\n  max_turns: 60\n  timeout: 600.0\nagents:\n- id: organizer\n  role: coordinator\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 64000\n      output_reserved: 4000\n      strategy: summarize\n      keep_recent: 30\n      auto_compact: true\n  pool:\n    max_workers: 5\n  system_prompt: \"Tu es un expert en organisation de fichiers et de dossiers.\\nTu\\\n    \\ travailles UNIQUEMENT dans : {{workspace}}\\n\\n## RÈGLES ABSOLUES\\n\\n1. Tu ne\\\n    \\ SUPPRIMES JAMAIS rien - pas de rm, delete, unlink\\n2. Tu ne touches JAMAIS aux\\\n    \\ fichiers en dehors de {{workspace}}\\n3. Tu DEMANDES confirmation avant de déplacer\\\n    \\ des fichiers\\n4. Tu montres toujours un aperçu AVANT / APRÈS\\n\\n## TA MÉTHODE\\n\\\n    \\n### Étape 1 : Analyse (toi-même)\\n- filesystem.ls(\\\"{{workspace}}\\\") pour voir\\\n    \\ le contenu\\n- filesystem.find(\\\"{{workspace}}\\\") pour la vue récursive\\n- Identifie\\\n    \\ les types, compte par extension, repère le désordre\\n\\n### Étape 2 : Proposition\\n\\\n    Propose la structure de dossiers et ATTENDS la confirmation :\\n```\\n\\U0001F4CA\\\n    \\ Analyse de {{workspace}}\\nTotal : X fichiers, Y dossiers\\n\\nPar type :\\n  \\U0001F4C4\\\n    \\ Documents : 12 fichiers\\n  \\U0001F5BC️ Images : 8 fichiers\\n  ...\\n\\n\\U0001F4A1\\\n    \\ Plan :\\n  Créer X dossiers et déplacer Y fichiers.\\n  Voulez-vous continuer\\\n    \\ ?\\n```\\n\\n### Étape 3 : Création des dossiers (toi-même)\\nCrée tous les dossiers\\\n    \\ nécessaires avec filesystem.mkdir\\n\\n### Étape 4 : Déplacement en PARALLÈLE\\\n    \\ (sous-agents)\\nLance des workers pour déplacer les fichiers par catégorie simultanément\\\n    \\ :\\n\\n```\\nspawn_agent(specialist=\\\"mover\\\", task=\\\"Déplace ces fichiers dans\\\n    \\ Documents/ : fichier1.pdf, fichier2.docx, rapport.txt. Workspace: {{workspace}}\\\"\\\n    , timeout=120)\\nspawn_agent(specialist=\\\"mover\\\", task=\\\"Déplace ces fichiers\\\n    \\ dans Images/ : photo1.jpg, photo2.png, logo.svg. Workspace: {{workspace}}\\\"\\\n    , timeout=120)\\nspawn_agent(specialist=\\\"mover\\\", task=\\\"Déplace ces fichiers\\\n    \\ dans Code/ : main.py, utils.js, app.ts. Workspace: {{workspace}}\\\", timeout=120)\\n\\\n    ```\\n\\nChaque worker reçoit la LISTE EXACTE des fichiers à déplacer et le dossier\\\n    \\ cible.\\nPuis : agent_wait_all(timeout=300)\\n\\n### Étape 5 : Vérification\\nfilesystem.ls\\\n    \\ pour vérifier le résultat final.\\n\\n## CATÉGORIES PAR EXTENSION\\n\\n| Catégorie\\\n    \\ | Extensions |\\n|-----------|-----------|\\n| Documents | .pdf, .doc, .docx,\\\n    \\ .odt, .txt, .md, .rtf |\\n| Tableurs | .xls, .xlsx, .csv, .ods |\\n| Présentations\\\n    \\ | .ppt, .pptx, .odp |\\n| Images | .jpg, .jpeg, .png, .gif, .svg, .webp, .bmp,\\\n    \\ .ico |\\n| Vidéos | .mp4, .avi, .mkv, .mov, .wmv, .flv, .webm |\\n| Audio | .mp3,\\\n    \\ .wav, .flac, .ogg, .aac, .m4a |\\n| Archives | .zip, .tar, .gz, .7z, .rar, .bz2\\\n    \\ |\\n| Code | .py, .js, .ts, .java, .c, .cpp, .go, .rs, .rb, .php, .html, .css\\\n    \\ |\\n| Config | .json, .yaml, .yml, .toml, .ini, .env, .xml |\\n| Données | .sql,\\\n    \\ .db, .sqlite, .parquet |\\n\"\n- id: mover\n  role: specialist\n  specialty: Déplaceur de fichiers - déplace une liste de fichiers vers un dossier\n    cible\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 32000\n      output_reserved: 2000\n      strategy: truncate\n      keep_recent: 20\n      auto_compact: true\n  modules:\n  - filesystem\n  system_prompt: 'Tu es un worker qui déplace des fichiers. Tu reçois :\n\n    - Une liste de fichiers à déplacer\n\n    - Un dossier de destination\n\n\n    Pour CHAQUE fichier de la liste :\n\n    1. filesystem.mv(source=\"chemin/fichier\", destination=\"chemin/dossier/fichier\")\n\n\n    Règles :\n\n    - Ne SUPPRIME ajamais rien\n\n    - Ne crée PAS de dossiers (ils sont déjà créés)\n\n    - Si un fichier n''existe pas, passe au suivant\n\n    - Retourne le nombre de fichiers déplacés avec succès\n\n    '\ntools:\n  modules:\n    filesystem:\n      constraints:\n        allowed_actions:\n        - glob\n        - read\n        paths:\n        - '{{workspace}}'\n    shell:\n      constraints:\n        allowed_actions:\n        - run\n  capabilities:\n    default_policy: auto\ndev:\n  variables:\n    workspace: '{{env.PWD}}'\n", "language": "yaml", "size": 4583, "lines": 119, "operation": "disk_sync", "updated_at": 1778628124.9873927, "validation": "approved", "baseline_lines": 118, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4678743}, "examples/github-agent.yaml": {"content": "app:\n  app_id: github-agent\n  name: GitHub Agent\n  description: Assistant GitHub - explore les repos, issues, PRs et le code.\nruntime:\n  mode: conversation\n  max_turns: 20\n  timeout: 120.0\nagents:\n- id: assistant\n  role: assistant\n  brain:\n    provider: openrouter\n    model: qwen/qwen3-235b-a22b\n    backend: openai_compat\n    max_tokens: 4096\n    config:\n      api_key: '{{secret.OPENROUTER_API_KEY}}'\n      base_url: https://openrouter.ai/api/v1\n    context:\n      max_tokens: 90000\n      output_reserved: 2000\n      strategy: summarize\n      keep_recent: 20\n      auto_compact: true\n  system_prompt: 'Tu es un assistant GitHub. Tu peux explorer des repos, lire du code,\n\n    chercher des issues/PRs, et interagir avec l''API GitHub.\n\n    Reponds en francais. Sois concis et structure tes reponses.\n\n    '\ntools:\n  modules:\n    mcp:\n      config:\n        servers:\n        - github\n", "language": "yaml", "size": 884, "lines": 39, "operation": "disk_sync", "updated_at": 1778628124.9965813, "validation": "approved", "baseline_lines": 38, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4678743}, "examples/gmail-agent.yaml": {"content": "app:\n  app_id: gmail-agent\n  name: Gmail Agent\n  description: Assistant Gmail connecte via MCP - lit, cherche et envoie des emails.\nruntime:\n  mode: conversation\n  max_turns: 20\n  timeout: 120.0\nagents:\n- id: assistant\n  role: assistant\n  brain:\n    provider: openrouter\n    model: qwen/qwen3-235b-a22b\n    backend: openai_compat\n    max_tokens: 4096\n    config:\n      api_key: '{{secret.OPENROUTER_API_KEY}}'\n      base_url: https://openrouter.ai/api/v1\n    context:\n      max_tokens: 90000\n      output_reserved: 2000\n      strategy: summarize\n      keep_recent: 20\n      auto_compact: true\n  system_prompt: 'Tu es un assistant Gmail. Tu peux lire, chercher et envoyer des\n    emails.\n\n    Reponds en francais. Sois concis.\n\n    '\ntools:\n  modules:\n    mcp:\n      config:\n        servers:\n        - gmail\n", "language": "yaml", "size": 807, "lines": 38, "operation": "disk_sync", "updated_at": 1778628124.9965813, "validation": "approved", "baseline_lines": 37, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4678743}, "examples/hello-oneshot.yaml": {"content": "app:\n  app_id: hello-oneshot\n  name: Hello One-Shot\n  description: A simple one-shot app that responds to messages.\nruntime:\n  mode: one_shot\n  input:\n    type: text\n    description: A question or message\n  output:\n    type: text\nagents:\n- id: assistant\n  role: assistant\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  system_prompt: 'You are a friendly assistant. Be concise and helpful.\n\n    You have access to tools - use them when relevant.\n\n    '\ntools:\n  modules:\n    hello: {}\n  capabilities:\n    default_policy: auto\n", "language": "yaml", "size": 618, "lines": 31, "operation": "disk_sync", "updated_at": 1778628125.006015, "validation": "approved", "baseline_lines": 30, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4678743}, "examples/http-agent.yaml": {"content": "app:\n  app_id: http-agent\n  name: HTTP Agent\n  description: Assistant avec capacités HTTP - API calls, web scraping, téléchargements.\nruntime:\n  mode: conversation\n  max_turns: 200\n  timeout: 1200.0\nagents:\n- id: assistant\n  role: assistant\n  brain:\n    provider: openai\n    model: gpt-4o-mini\n    backend: openai_compat\n    config:\n      api_key: '{{env.OPENAI_API_KEY}}'\n    context:\n      max_tokens: 128000\n      output_reserved: 2000\n      strategy: summarize\n      keep_recent: 20\n      compression_trigger: 0.85\n      auto_compact: true\n  system_prompt: 'Tu es un assistant avec accès HTTP complet. Tu peux :\n\n    - Appeler des API REST (json_api)\n\n    - Lire des pages web (fetch_page)\n\n    - Télécharger des fichiers en arrière-plan (download + download_status)\n\n    - Faire des requêtes HTTP de tous types (get, post, head, etc.)\n\n    Si une requête échoue, explique l''erreur clairement.\n\n    '\ntools:\n  modules:\n    http:\n      constraints:\n        allowed_actions:\n        - get\n        - post\n        - json_api\n        - fetch_page\n        - download\n        - download_status\n        - download_cancel\n        - download_list\n        - head\n    filesystem:\n      constraints:\n        allowed_actions:\n        - read\n        - write\n        - glob\n        - grep\n  capabilities:\n    default_policy: auto\n    grant:\n    - net.http\n    - fs.read\n    - fs.write\n    - sys.info\nui:\n  greeting: Salut ! Je suis un assistant avec accès HTTP. Je peux appeler des APIs,\n    lire des pages web, et télécharger des fichiers. Que veux-tu faire ?\ndev:\n  variables:\n    workspace: '{{env.PWD}}'\n", "language": "yaml", "size": 1597, "lines": 72, "operation": "disk_sync", "updated_at": 1778628125.013423, "validation": "approved", "baseline_lines": 71, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4678743}, "examples/invoice-generator.yaml": {"content": "app:\n  app_id: invoice-generator\n  name: Invoice Generator\n  description: Génère des factures professionnelles en PDF à partir d'une description\n    en langage naturel.\nruntime:\n  mode: one_shot\n  max_turns: 10\n  timeout: 60.0\nagents:\n- id: invoicer\n  role: assistant\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 32000\n      output_reserved: 2000\n      strategy: truncate\n      keep_recent: 20\n      auto_compact: true\n  system_prompt: 'Tu es un générateur de factures. Tu crées des factures PDF professionnelles.\n\n\n    ## FORMAT DE LA FACTURE\n\n\n    ```markdown\n\n    # FACTURE\n\n\n    **N° :** [numéro auto-généré]\n\n    **Date :** [date du jour]\n\n    **Échéance :** [date + 30 jours]\n\n\n    ## Émetteur\n\n    [Nom de l''entreprise]\n\n    [Adresse]\n\n    [SIRET/TVA]\n\n\n    ## Client\n\n    [Nom du client]\n\n    [Adresse]\n\n\n    ## Prestations\n\n\n    | Description | Quantité | Prix unitaire HT | Total HT |\n\n    |-------------|:--------:|:----------------:|:--------:|\n\n    | [prestation 1] | 1 | 500,00 € | 500,00 € |\n\n    | [prestation 2] | 2 | 250,00 € | 500,00 € |\n\n\n    ## Totaux\n\n\n    | | Montant |\n\n    |---|---:|\n\n    | **Total HT** | 1 000,00 € |\n\n    | TVA 20% | 200,00 € |\n\n    | **Total TTC** | 1 200,00 € |\n\n\n    ---\n\n\n    *Conditions de paiement : virement bancaire sous 30 jours.*\n\n    *IBAN : FR76 XXXX XXXX XXXX*\n\n    ```\n\n\n    Utilise le style \"financial\" pour un look professionnel.\n\n    Génère directement avec pdf.generate (pas besoin de workbench pour une facture).\n\n    '\ntools:\n  modules:\n    pdf:\n      constraints:\n        output_dir: '{{output_dir}}'\n  capabilities:\n    default_policy: auto\ndev:\n  variables:\n    output_dir: ./output\n", "language": "yaml", "size": 1775, "lines": 110, "operation": "disk_sync", "updated_at": 1778628125.0154862, "validation": "approved", "baseline_lines": 109, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4835527}, "examples/market-research.yaml": {"content": "app:\n  app_id: market-research\n  name: Market Research\n  description: Étude de marché complète avec analyse de la demande, taille du marché,\n    segments et opportunités.\nruntime:\n  mode: one_shot\n  max_turns: 100\n  timeout: 1800.0\n  workbench: true\n  workbench_max_chars: 300000\nagents:\n- id: strategist\n  role: coordinator\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 128000\n      output_reserved: 4000\n      strategy: summarize\n      keep_recent: 40\n      auto_compact: true\n  pool:\n    max_workers: 8\n  system_prompt: \"Tu es un consultant en stratégie spécialisé en études de marché.\\n\\\n    \\n## TA MÉTHODE\\n\\nLance 6-8 chercheurs en parallèle sur les axes suivants :\\n\\\n    1. Taille du marché et croissance (TAM, SAM, SOM)\\n2. Segments et sous-segments\\n\\\n    3. Acteurs clés et parts de marché\\n4. Tendances et drivers de croissance\\n5.\\\n    \\ Barrières à l'entrée et risques\\n6. Analyse géographique\\n7. Pricing et modèles\\\n    \\ économiques\\n8. Régulation et environnement légal\\n\\n## LIVRABLES\\n\\n1. Rapport\\\n    \\ PDF (style: consulting) avec :\\n   - Executive summary\\n   - Market sizing (TAM/SAM/SOM)\\n\\\n    \\   - Competitive landscape (tableau comparatif)\\n   - Segmentation analysis\\n\\\n    \\   - Growth drivers & barriers\\n   - Recommendations\\n\\n2. Excel avec :\\n   -\\\n    \\ Market sizing model\\n   - Competitor comparison matrix\\n   - Segment breakdown\\n\"\n- id: researcher\n  role: specialist\n  specialty: 'Chercheur marché : données quantitatives et qualitatives'\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 64000\n      output_reserved: 4000\n      strategy: summarize\n      keep_recent: 20\n      auto_compact: true\n  modules:\n  - web\n  - http\n  - memory\n  system_prompt: 'Tu es un chercheur de marché. Visite 5-8 sources, extrais les données\n    chiffrées, cite toutes les sources.\n\n    '\ntools:\n  modules:\n    web:\n      config:\n        search_backend: duckduckgo\n    http:\n      constraints:\n        allowed_actions:\n        - get\n        - fetch_page\n        - head\n    pdf:\n      constraints:\n        output_dir: '{{output_dir}}'\n    spreadsheet:\n      constraints:\n        output_dir: '{{output_dir}}'\n    memory: {}\n  capabilities:\n    default_policy: auto\ndev:\n  variables:\n    output_dir: ./output\n", "language": "yaml", "size": 2472, "lines": 85, "operation": "disk_sync", "updated_at": 1778628125.020837, "validation": "approved", "baseline_lines": 84, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4835527}, "examples/mcp-agent.yaml": {"content": "app:\n  app_id: mcp-agent\n  name: MCP Agent\n  description: Agent connecté à des serveurs MCP externes - expose automatiquement\n    leurs tools via le context_builder.\nruntime:\n  mode: conversation\n  max_turns: 200\n  timeout: 1200.0\nagents:\n- id: assistant\n  role: assistant\n  brain:\n    provider: openai\n    model: gpt-4o-mini\n    backend: openai_compat\n    config:\n      api_key: '{{env.OPENAI_API_KEY}}'\n    context:\n      max_tokens: 128000\n      strategy: summarize\n      keep_recent: 20\n      auto_compact: true\n  system_prompt: 'Tu es un assistant connecté à des serveurs MCP externes.\n\n    Leurs outils sont disponibles automatiquement via la recherche.\n\n    Utilise search_tools pour trouver les outils MCP disponibles.\n\n    '\ntools:\n  modules:\n    filesystem:\n      constraints:\n        allowed_actions:\n        - read\n        - glob\n        - grep\n        - write\n    mcp:\n      config:\n        servers:\n          filesystem:\n            path: '{{workspace}}'\nui:\n  greeting: 'Agent MCP prêt ! Les serveurs MCP sont connectés et leurs outils\n\n    sont disponibles comme des outils natifs.\n\n    Utilise search_tools ou list_categories pour découvrir les outils.\n\n    '\ndev:\n  variables:\n    workspace: '{{env.PWD}}'\n", "language": "yaml", "size": 1224, "lines": 56, "operation": "disk_sync", "updated_at": 1778628125.020837, "validation": "approved", "baseline_lines": 55, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4835527}, "examples/meeting-summarizer.yaml": {"content": "app:\n  app_id: meeting-summarizer\n  name: Meeting Summarizer\n  description: Transforme des notes de réunion brutes en compte-rendu professionnel\n    avec actions items et PDF.\nruntime:\n  mode: one_shot\n  max_turns: 20\n  timeout: 120.0\n  workbench: true\nagents:\n- id: summarizer\n  role: assistant\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 64000\n      output_reserved: 4000\n      strategy: summarize\n      keep_recent: 30\n      auto_compact: true\n  system_prompt: 'Tu es un expert en rédaction de comptes-rendus de réunion.\n\n    Tu transformes des notes brutes en documents professionnels.\n\n\n    ## TON OUTPUT\n\n\n    Structure du compte-rendu :\n\n    1. **Informations** : date, participants, durée, objectif\n\n    2. **Résumé exécutif** : 3-5 phrases clés\n\n    3. **Points discutés** : détail par sujet avec décisions prises\n\n    4. **Actions items** : tableau | Qui | Quoi | Deadline | Priorité |\n\n    5. **Prochaines étapes** : date prochaine réunion, points à préparer\n\n\n    Génère un PDF professionnel via workbench (style: consulting).\n\n    Sauvegarde aussi un fichier texte des action items pour suivi.\n\n    '\ntools:\n  modules:\n    filesystem:\n      constraints:\n        allowed_actions:\n        - read\n        - write\n        - glob\n        paths:\n        - '{{output_dir}}'\n    pdf:\n      constraints:\n        output_dir: '{{output_dir}}'\n  capabilities:\n    default_policy: auto\ndev:\n  variables:\n    output_dir: ./output\n", "language": "yaml", "size": 1554, "lines": 70, "operation": "disk_sync", "updated_at": 1778628125.0327723, "validation": "approved", "baseline_lines": 69, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4835527}, "examples/memory-agent.yaml": {"content": "app:\n  app_id: memory-agent\n  name: Memory Agent\n  description: Assistant avec mémoire persistante - knowledge graph pour stocker et\n    retrouver des informations.\nruntime:\n  mode: conversation\n  max_turns: 20\n  timeout: 120.0\nagents:\n- id: assistant\n  role: assistant\n  brain:\n    provider: openrouter\n    model: qwen/qwen3-235b-a22b\n    backend: openai_compat\n    max_tokens: 4096\n    config:\n      api_key: '{{secret.OPENROUTER_API_KEY}}'\n      base_url: https://openrouter.ai/api/v1\n    context:\n      max_tokens: 90000\n      output_reserved: 2000\n      strategy: summarize\n      keep_recent: 20\n      auto_compact: true\n  system_prompt: 'Tu es un assistant avec une mémoire persistante (knowledge graph).\n\n    Tu peux créer des entités, des relations, et retrouver des informations.\n\n    Utilise ta mémoire pour te souvenir de ce qu''on te dit.\n\n    Réponds en français. Sois concis.\n\n    '\ntools:\n  modules:\n    mcp:\n      config:\n        servers:\n        - memory\n", "language": "yaml", "size": 972, "lines": 42, "operation": "disk_sync", "updated_at": 1778628125.0388198, "validation": "approved", "baseline_lines": 41, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4835527}, "examples/notion-agent.yaml": {"content": "app:\n  app_id: notion-agent\n  name: Notion Agent\n  description: Assistant connecté à Notion via OAuth - l'utilisateur autorise son\n    workspace en 1 clic.\nruntime:\n  mode: conversation\n  max_turns: 200\n  timeout: 1200.0\nagents:\n- id: assistant\n  role: assistant\n  brain:\n    provider: openrouter\n    model: qwen/qwen3-235b-a22b\n    backend: openai_compat\n    max_tokens: 4096\n    config:\n      api_key: '{{secret.OPENROUTER_API_KEY}}'\n      base_url: https://openrouter.ai/api/v1\n    context:\n      max_tokens: 90000\n      output_reserved: 2000\n      strategy: summarize\n      keep_recent: 30\n      compression_trigger: 0.9\n      summary_max_tokens: 8192\n      auto_compact: true\n  system_prompt: 'Tu es un assistant Notion. Réponds en français.\n\n    '\ntools:\n  modules:\n    mcp:\n      config:\n        servers:\n          notion:\n            auth:\n              client_id: '{{secret.NOTION_OAUTH_CLIENT_ID}}'\n              client_secret: '{{secret.NOTION_OAUTH_CLIENT_SECRET}}'\n              redirect_uri: http://localhost:8913/callback\n  capabilities:\n    default_policy: approve\nui:\n  greeting: 'Agent Notion prêt !\n\n    Si c''est ta première connexion, je te demanderai d''autoriser l''accès\n\n    à ton workspace Notion (1 clic).\n\n    '\ndev:\n  variables:\n    workspace: '{{env.PWD}}'\n", "language": "yaml", "size": 1287, "lines": 55, "operation": "disk_sync", "updated_at": 1778628125.0388198, "validation": "approved", "baseline_lines": 54, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4835527}, "examples/notion-workbench.yaml": {"content": "app:\n  app_id: notion-workbench\n  name: Notion + Workbench\n  description: 'Agent Notion qui construit les pages bloc par bloc dans le workbench\n    avant de les envoyer - jamais de regénération complète.\n\n    '\nruntime:\n  mode: conversation\n  workbench: true\n  workbench_reflection: true\n  workbench_error_memory: true\n  max_turns: 200\n  timeout: 1200.0\nagents:\n- id: assistant\n  role: assistant\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    max_tokens: 4096\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n      base_url: https://api.deepseek.com/v1\n    context:\n      max_tokens: 90000\n      output_reserved: 2000\n      strategy: summarize\n      keep_recent: 30\n      compression_trigger: 0.9\n      summary_max_tokens: 8192\n      auto_compact: true\n  system_prompt: \"Tu es un assistant Notion. Réponds en français.\\n\\n## RÈGLE ABSOLUE\\\n    \\ : workbench obligatoire pour les blocs\\n\\nTu ne génères JAMAIS les blocs Notion\\\n    \\ directement dans un appel outil.\\nTu construis TOUJOURS dans le workbench d'abord.\\n\\\n    \\n### Workflow pour créer du contenu dans une page\\n\\nÉTAPE 1 - Chercher la page\\\n    \\ cible :\\n  notion_search(query=\\\"...\\\")\\n\\nÉTAPE 2 - Initialiser le buffer :\\n\\\n    \\  wb_write(\\\"blocks\\\", \\\"[]\\\")\\n\\nÉTAPE 3 - Ajouter les blocs avec wb_json_append\\\n    \\ (gère les virgules automatiquement) :\\n  wb_json_append(\\\"blocks\\\", items='{\\\"\\\n    type\\\":\\\"heading_2\\\",\\\"heading_2\\\":{\\\"rich_text\\\":[{\\\"text\\\":{\\\"content\\\":\\\"Titre\\\"\\\n    }}]}}')\\n\\n  Pour plusieurs blocs à la fois (max 3) :\\n  wb_json_append(\\\"blocks\\\"\\\n    , items='[{\\\"type\\\":\\\"paragraph\\\",\\\"paragraph\\\":{\\\"rich_text\\\":[{\\\"text\\\":{\\\"\\\n    content\\\":\\\"Texte 1\\\"}}]}},{\\\"type\\\":\\\"paragraph\\\",\\\"paragraph\\\":{\\\"rich_text\\\"\\\n    :[{\\\"text\\\":{\\\"content\\\":\\\"Texte 2\\\"}}]}}]')\\n\\nÉTAPE 4 - Vérifier :\\n  wb_reflect(\\\"\\\n    blocks\\\")\\n\\nÉTAPE 5 - Envoyer à Notion :\\n  wb_use(\\\"blocks\\\", \\\"notion_append_block_children\\\"\\\n    , \\\"children\\\", {\\\"block_id\\\": \\\"<page_id>\\\"})\\n\\nÉTAPE 6 - Si erreur :\\n  - Lis\\\n    \\ l'erreur attentivement\\n  - Corrige avec wb_edit (NE REFAIS PAS tout le buffer)\\n\\\n    \\  - wb_reflect puis wb_use à nouveau\\n\\n### Format d'un bloc Notion\\n\\n```json\\n\\\n    {\\\"type\\\": \\\"paragraph\\\", \\\"paragraph\\\": {\\\"rich_text\\\": [{\\\"text\\\": {\\\"content\\\"\\\n    : \\\"texte\\\"}}]}}\\n```\\n\\nTexte enrichi :\\n```json\\n{\\\"type\\\": \\\"text\\\", \\\"text\\\"\\\n    : {\\\"content\\\": \\\"gras\\\"}, \\\"annotations\\\": {\\\"bold\\\": true}}\\n```\\n\\nTypes disponibles\\\n    \\ :\\nheading_1, heading_2, heading_3, paragraph, bulleted_list_item,\\nnumbered_list_item,\\\n    \\ to_do, code, quote, callout, divider, toggle,\\ntable (avec table_row enfants)\\n\\\n    \\n### INTERDIT\\n- Appeler notion_append_block_children directement avec un JSON\\\n    \\ inline\\n- Refaire wb_write(\\\"blocks\\\", ...) après une erreur (utilise wb_edit)\\n\\\n    - Produire plus de 5 blocs en un seul wb_json_append\\n\"\ntools:\n  modules:\n    mcp:\n      config:\n        servers:\n          notion:\n            auth:\n              client_id: '{{env.NOTION_CLIENT_ID}}'\n              client_secret: '{{env.NOTION_CLIENT_SECRET}}'\n              redirect_uri: http://localhost:8913/callback\n  capabilities:\n    default_policy: auto\nui:\n  greeting: 'Agent Notion + Workbench prêt !\n\n    Je construis les pages bloc par bloc dans le workbench.\n\n    Dis-moi ce que tu veux créer dans Notion.\n\n    '\ndev:\n  variables:\n    workspace: '{{env.PWD}}'\n", "language": "yaml", "size": 3409, "lines": 81, "operation": "disk_sync", "updated_at": 1778628125.0489497, "validation": "approved", "baseline_lines": 80, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4835527}, "examples/ollama-chat.yaml": {"content": "app:\n  app_id: ollama-chat\n  name: Ollama Chat (text-based tools)\n  description: Test d'un LLM local sans tool use natif - les outils sont injectés\n    dans le prompt.\nruntime:\n  mode: conversation\n  max_turns: 10\n  timeout: 300.0\nagents:\n- id: assistant\n  role: assistant\n  brain:\n    provider: ollama\n    model: qwen2.5:14b-instruct-q4_K_M\n    backend: openai_compat\n    config:\n      base_url: http://localhost:11434/v1\n    context:\n      max_tokens: 8000\n      output_reserved: 1000\n      strategy: truncate\n      keep_recent: 6\n      compression_trigger: 0.6\n      auto_compact: true\n  system_prompt: 'Tu es un assistant intelligent. Tu réponds en français.\n\n    Tu as accès à des outils via un système de découverte.\n\n\n    WORKFLOW EFFICACE pour utiliser un outil :\n\n    1. list_categories → voir les modules disponibles\n\n    2. browse_category(category=\"nom\") → voir les outils d''un module\n\n    3. execute_tool(name=\"module.action\", params={...}) → exécuter directement\n\n\n    IMPORTANT :\n\n    - Va directement à execute_tool dès que tu connais le nom de l''outil.\n\n    - Limite-toi à 3-5 appels d''outils maximum par question.\n\n    - Si un outil échoue, explique l''erreur au lieu de réessayer en boucle.\n\n    '\ntools:\n  modules:\n    hello: {}\n    filesystem:\n      constraints:\n        allowed_actions:\n        - read\n        - glob\n        - grep\n  capabilities:\n    default_policy: auto\nui:\n  greeting: Salut ! Je suis un assistant local (Gemma 4B) avec des outils injectés\n    dans le prompt. Teste-moi !\ndev:\n  variables:\n    workspace: '{{env.PWD}}'\n", "language": "yaml", "size": 1564, "lines": 66, "operation": "disk_sync", "updated_at": 1778628125.0529377, "validation": "approved", "baseline_lines": 65, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4835527}, "examples/presentation-demo.yaml": {"content": "app:\n  app_id: presentation-demo\n  name: Presentation Generator\n  description: Génère des présentations PowerPoint impactantes et professionnelles.\nruntime:\n  mode: one_shot\n  max_turns: 60\n  timeout: 600.0\nagents:\n- id: presenter\n  role: assistant\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 64000\n      output_reserved: 4000\n      strategy: summarize\n      keep_recent: 30\n      compression_trigger: 0.8\n      auto_compact: true\n  system_prompt: \"Tu es un designer expert en présentations PowerPoint de niveau consulting.\\n\\\n    Tu produis des slides IMPACTANTES, AÉRÉES et RICHES en contenu pertinent.\\n\\n\\\n    ## PRINCIPES DE DESIGN\\n\\n1. Chaque slide a UN message principal, clairement visible\\n\\\n    2. Le contenu doit être SUBSTANTIEL - pas juste un titre vide\\n3. Alterne les\\\n    \\ formats : KPIs → liste → tableau → citation → timeline\\n4. Utilise des chiffres\\\n    \\ concrets et des insights actionnables\\n5. Les listes ont 4-6 items avec un vrai\\\n    \\ contenu (pas juste 2-3 mots)\\n6. Les tableaux ont 4-6 lignes avec des données\\\n    \\ pertinentes\\n7. Ajoute toujours une phrase d'accroche sous le <h2> pour donner\\\n    \\ du contexte\\n\\n## STRUCTURE D'UNE SLIDE CONTENT\\n\\nToujours : `<h2>Titre</h2>`\\\n    \\ + `<p>Phrase de contexte qui donne le ton.</p>` + contenu.\\n\\nExemples de bon\\\n    \\ contenu :\\n```html\\n<h2>Adoption par secteur</h2>\\n<p>L'IA transforme tous les\\\n    \\ secteurs, mais à des vitesses très différentes.</p>\\n<table>\\n<thead><tr><th>Secteur</th><th>Adoption</th><th>ROI\\\n    \\ moyen</th><th>Maturité</th></tr></thead>\\n<tbody>\\n<tr><td>Finance</td><td>78%</td><td>320%</td><td>Avancée</td></tr>\\n\\\n    <tr><td>Santé</td><td>62%</td><td>280%</td><td>En cours</td></tr>\\n<tr><td>Retail</td><td>55%</td><td>210%</td><td>Émergente</td></tr>\\n\\\n    <tr><td>Industrie</td><td>48%</td><td>190%</td><td>Pilote</td></tr>\\n</tbody>\\n\\\n    </table>\\n```\\n\\n```html\\n<h2>Indicateurs clés du marché</h2>\\n<p>Le marché de\\\n    \\ l'IA atteint des sommets historiques en 2026.</p>\\n<div class=\\\"columns\\\">\\n\\\n    \\  <div class=\\\"kpi\\\"><span class=\\\"value\\\">$2.5T</span><span class=\\\"label\\\"\\\n    >Marché mondial</span></div>\\n  <div class=\\\"kpi\\\"><span class=\\\"value\\\">+42%</span><span\\\n    \\ class=\\\"label\\\">Croissance YoY</span></div>\\n  <div class=\\\"kpi\\\"><span class=\\\"\\\n    value\\\">85%</span><span class=\\\"label\\\">Entreprises adoptantes</span></div>\\n\\\n    </div>\\n```\\n\\n```html\\n<h2>Défis majeurs à relever</h2>\\n<p>Les entreprises font\\\n    \\ face à des obstacles structurels qu'il faut adresser.</p>\\n<ul>\\n  <li><strong>Talent\\\n    \\ gap :</strong> 3.5M de postes IA non pourvus dans le monde</li>\\n  <li><strong>Coûts\\\n    \\ d'infra :</strong> le compute GPU a triplé en 2 ans</li>\\n  <li><strong>Régulation\\\n    \\ :</strong> l'AI Act européen impose de nouvelles contraintes</li>\\n  <li><strong>Éthique\\\n    \\ :</strong> 68% des modèles présentent des biais mesurables</li>\\n  <li><strong>Sécurité\\\n    \\ :</strong> +300% d'attaques adversariales en 2025</li>\\n</ul>\\n```\\n\\n## CE\\\n    \\ QU'IL NE FAUT PAS FAIRE\\n\\n- PAS de slides avec uniquement un heading et rien\\\n    \\ d'autre\\n- PAS de KPIs avec des labels d'un seul mot sans contexte\\n- PAS de\\\n    \\ listes avec des items trop courts (2-3 mots) ni trop longs (phrase entière)\\n\\\n    - PAS de 3+ types de contenu différents sur la même slide (KPI + tableau + liste\\\n    \\ = trop)\\n- Si beaucoup de contenu → SPLIT en 2 slides\\n\\n## METHODE\\n\\n1. Planifie\\\n    \\ les 20 slides (titre, type, contenu clé)\\n2. new_presentation avec le thème\\n\\\n    3. add_slide pour chaque slide\\n4. finalize_presentation\\n\"\ntools:\n  modules:\n    presentation:\n      constraints:\n        output_dir: '{{output_dir}}'\n  capabilities:\n    default_policy: auto\ndev:\n  variables:\n    output_dir: ./output\n", "language": "yaml", "size": 3895, "lines": 70, "operation": "disk_sync", "updated_at": 1778628125.0529377, "validation": "approved", "baseline_lines": 69, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4835527}, "examples/seo-auditor.yaml": {"content": "app:\n  app_id: seo-auditor\n  name: SEO Auditor\n  description: Audit SEO complet d'un site web - analyse technique, contenu, backlinks\n    et recommandations.\nruntime:\n  mode: one_shot\n  max_turns: 60\n  timeout: 600.0\n  workbench: true\n  workbench_max_chars: 200000\nagents:\n- id: auditor\n  role: coordinator\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 128000\n      output_reserved: 4000\n      strategy: summarize\n      keep_recent: 40\n      auto_compact: true\n  pool:\n    max_workers: 5\n  system_prompt: \"Tu es un expert SEO. Tu réalises des audits complets de sites web.\\n\\\n    \\n## TA MÉTHODE\\n\\n1. Analyse la page d'accueil (http.fetch_page) : titre, meta\\\n    \\ description, H1, structure\\n2. Lance des analystes en parallèle :\\n   - spawn_agent:\\\n    \\ analyse des pages internes (5-10 pages)\\n   - spawn_agent: recherche de la concurrence\\\n    \\ sur les mêmes mots-clés\\n   - spawn_agent: vérification des aspects techniques\\\n    \\ (vitesse, mobile, HTTPS)\\n3. Synthétise et génère :\\n   - Rapport PDF avec score\\\n    \\ SEO global + recommandations\\n   - Excel avec audit détaillé page par page\\n\\\n    \\n## CRITÈRES D'ANALYSE\\n\\n| Catégorie | Points vérifiés |\\n|-----------|----------------|\\n\\\n    | Technique | HTTPS, vitesse, mobile, sitemap, robots.txt |\\n| Contenu | Titres,\\\n    \\ meta, H1-H6, alt images, longueur |\\n| Structure | URLs, liens internes, navigation,\\\n    \\ breadcrumbs |\\n| Autorité | Backlinks, domaines référents, ancres |\\n\"\n- id: page_analyst\n  role: specialist\n  specialty: Analyse SEO d'une page web spécifique\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 32000\n      output_reserved: 2000\n      strategy: truncate\n      keep_recent: 15\n      auto_compact: true\n  modules:\n  - web\n  - http\n  system_prompt: 'Tu analyses UNE page web pour son SEO. Visite la page (web.fetch),\n    analyse : titre, meta, H1, contenu, liens, images.\n\n    '\ntools:\n  modules:\n    web:\n      config:\n        search_backend: duckduckgo\n    http:\n      constraints:\n        allowed_actions:\n        - get\n        - fetch_page\n        - head\n    pdf:\n      constraints:\n        output_dir: '{{output_dir}}'\n    spreadsheet:\n      constraints:\n        output_dir: '{{output_dir}}'\n  capabilities:\n    default_policy: auto\ndev:\n  variables:\n    output_dir: ./output\n", "language": "yaml", "size": 2522, "lines": 84, "operation": "disk_sync", "updated_at": 1778628125.064107, "validation": "approved", "baseline_lines": 83, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.5465572}, "examples/smart-chat.yaml": {"content": "app:\n  app_id: smart-chat\n  name: Smart Chat\n  description: Assistant polyvalent avec filesystem, shell, database, HTTP, exécution\n    parallèle et tâches background.\nruntime:\n  mode: conversation\n  max_turns: 200\n  timeout: 1200.0\n  watchers: true\nagents:\n- id: assistant\n  role: assistant\n  brain:\n    provider: openai\n    model: gpt-4o-mini\n    backend: openai_compat\n    config:\n      api_key: '{{env.OPENAI_API_KEY}}'\n    context:\n      max_tokens: 128000\n      output_reserved: 2000\n      strategy: summarize\n      keep_recent: 20\n      compression_trigger: 0.85\n      summary_max_tokens: 5120\n      auto_compact: true\n  system_prompt: 'Tu es un assistant intelligent et polyvalent. Tu réponds en français.\n\n    Si un outil échoue, explique l''erreur au lieu de réessayer en boucle.\n\n    '\ntools:\n  modules:\n    filesystem:\n      constraints:\n        allowed_actions:\n        - read\n        - glob\n        - grep\n        - write\n    shell:\n      constraints:\n        allowed_actions:\n        - run\n        - script\n        - which\n        - env\n        - background_run\n        - task_status\n        - task_output\n        - task_kill\n        - task_list\n        - task_wait\n        - task_send_input\n    http:\n      constraints:\n        allowed_actions:\n        - get\n        - post\n        - json_api\n        - fetch_page\n        - head\n        - download\n        - download_status\n        - download_cancel\n        - download_list\n    database:\n      setup:\n      - action: connect\n        params:\n          connection_id: test_db\n          driver: sqlite\n          database: '{{workspace}}/test.db'\n          policy:\n            preset: safe_write\n      constraints:\n        allowed_actions:\n        - connect\n        - disconnect\n        - execute_query\n        - fetch_results\n        - list_tables\n        - describe\n        - bulk_insert\n        - upsert\n        - begin_transaction\n        - commit_transaction\n        - rollback_transaction\n  capabilities:\n    default_policy: approve\nui:\n  greeting: 'Salut ! Je suis un assistant polyvalent avec :\n\n    - 📁 Filesystem, 🐚 Shell, 🗄️ Database, 🌐 HTTP\n\n    - ⚡ Exécution parallèle (run_parallel)\n\n    - 🔄 Tâches en arrière-plan (background_run)\n\n    - 👁️ Surveillance persistante (watchers)\n\n    Que veux-tu faire ?\n\n    '\ndev:\n  variables:\n    workspace: '{{env.PWD}}'\n", "language": "yaml", "size": 2332, "lines": 109, "operation": "disk_sync", "updated_at": 1778628125.0654552, "validation": "approved", "baseline_lines": 108, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.5465572}, "examples/spreadsheet-demo.yaml": {"content": "app:\n  app_id: spreadsheet-demo\n  name: Excel Builder\n  description: Crée des tableurs Excel professionnels avec formules, graphiques et\n    analyses.\nruntime:\n  mode: one_shot\n  max_turns: 15\n  timeout: 120.0\n  workbench: true\nagents:\n- id: builder\n  role: assistant\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n    context:\n      max_tokens: 64000\n      output_reserved: 4000\n  system_prompt: \"Tu es un expert Excel. Tu crées des tableurs professionnels avec\\\n    \\ formules et graphiques.\\n\\n## ACTIONS\\n\\n### spreadsheet.create - Créer un workbook\\\n    \\ complet\\n\\n```json\\n{\\n  \\\"name\\\": \\\"rapport\\\",\\n  \\\"sheets\\\": [\\n    {\\n  \\\n    \\    \\\"name\\\": \\\"Ventes\\\",\\n      \\\"columns\\\": [\\\"Produit\\\", \\\"Quantité\\\", \\\"\\\n    Prix\\\", \\\"Total\\\", \\\"Part\\\"],\\n      \\\"data\\\": [\\n        [\\\"Laptop\\\", 45, 1299],\\n\\\n    \\        [\\\"Écran\\\", 120, 349],\\n        [\\\"Clavier\\\", 200, 89]\\n      ],\\n  \\\n    \\    \\\"formulas\\\": {\\n        \\\"D2\\\": \\\"=B2*C2\\\", \\\"D3\\\": \\\"=B3*C3\\\", \\\"D4\\\":\\\n    \\ \\\"=B4*C4\\\",\\n        \\\"E2\\\": \\\"=D2/D$5\\\", \\\"E3\\\": \\\"=D3/D$5\\\", \\\"E4\\\": \\\"=D4/D$5\\\"\\\n    ,\\n        \\\"B5\\\": \\\"=SUM(B2:B4)\\\", \\\"D5\\\": \\\"=SUM(D2:D4)\\\"\\n      },\\n      \\\"\\\n    formats\\\": {\\n        \\\"C2:D5\\\": \\\"#,##0 €\\\",\\n        \\\"E2:E4\\\": \\\"0.0%\\\"\\n \\\n    \\     },\\n      \\\"charts\\\": [\\n        {\\n          \\\"type\\\": \\\"column\\\",\\n  \\\n    \\        \\\"title\\\": \\\"Chiffre d'affaires par produit\\\",\\n          \\\"data_range\\\"\\\n    : \\\"D1:D4\\\",\\n          \\\"categories_range\\\": \\\"A2:A4\\\",\\n          \\\"position\\\"\\\n    : \\\"G2\\\",\\n          \\\"y_axis_title\\\": \\\"CA (€)\\\"\\n        },\\n        {\\n   \\\n    \\       \\\"type\\\": \\\"pie\\\",\\n          \\\"title\\\": \\\"Répartition des ventes\\\",\\n\\\n    \\          \\\"data_range\\\": \\\"D1:D4\\\",\\n          \\\"categories_range\\\": \\\"A2:A4\\\"\\\n    ,\\n          \\\"position\\\": \\\"G14\\\",\\n          \\\"show_data_labels\\\": true\\n  \\\n    \\      }\\n      ]\\n    }\\n  ],\\n  \\\"output_path\\\": \\\"rapport.xlsx\\\"\\n}\\n```\\n\\n\\\n    ### spreadsheet.edit - Modifier et ajouter des graphiques\\n\\n```json\\n{\\n  \\\"\\\n    name\\\": \\\"rapport\\\",\\n  \\\"edits\\\": [\\n    {\\\"cell\\\": \\\"B2\\\", \\\"value\\\": 50},\\n\\\n    \\    {\\\"cell\\\": \\\"A5\\\", \\\"value\\\": \\\"TOTAL\\\"}\\n  ],\\n  \\\"charts\\\": [\\n    {\\n\\\n    \\      \\\"type\\\": \\\"line\\\",\\n      \\\"title\\\": \\\"Tendance\\\",\\n      \\\"data_range\\\"\\\n    : \\\"B1:C4\\\",\\n      \\\"categories_range\\\": \\\"A2:A4\\\",\\n      \\\"position\\\": \\\"G2\\\"\\\n    \\n    }\\n  ],\\n  \\\"output_path\\\": \\\"rapport.xlsx\\\"\\n}\\n```\\n\\n### spreadsheet.read\\\n    \\ - Lire un fichier existant\\n\\n```json\\n{\\\"path\\\": \\\"donnees.xlsx\\\", \\\"sheet\\\"\\\n    : \\\"Feuil1\\\"}\\n```\\n\\n## TYPES DE GRAPHIQUES\\n\\n| type | Description |\\n|------|-------------|\\n\\\n    | column | Barres verticales (le plus courant) |\\n| bar | Barres horizontales\\\n    \\ |\\n| line | Lignes |\\n| pie | Camembert |\\n| doughnut | Anneau |\\n| area | Aires\\\n    \\ |\\n| scatter | Nuage de points XY |\\n| radar | Radar |\\n| bar3d, line3d, pie3d,\\\n    \\ area3d | Versions 3D |\\n\\nOptions graphiques : title, data_range, categories_range,\\\n    \\ position, width, height, y_axis_title, x_axis_title, style (1-48), show_legend,\\\n    \\ show_data_labels, stacked.\\n\\n## RÈGLES\\n\\n1. TOUJOURS utiliser spreadsheet.create\\\n    \\ avec TOUTES les données, formules ET graphiques en un seul appel\\n2. data_range\\\n    \\ DOIT inclure la ligne d'en-tête (ex: \\\"B1:C5\\\" pas \\\"B2:C5\\\")\\n3. categories_range\\\n    \\ = les étiquettes (ex: \\\"A2:A5\\\"), SANS l'en-tête\\n4. Les formules utilisent\\\n    \\ la syntaxe Excel : =SUM(), =IF(), =VLOOKUP(), etc.\\n5. Si des erreurs sont retournées,\\\n    \\ corriger avec spreadsheet.edit\\n6. output_path pour sauvegarder le fichier .xlsx\\n\\\n    7. NE PAS inventer des actions qui n'existent pas\\n8. NE PAS écrire du texte pour\\\n    \\ \\\"décrire\\\" un graphique - utiliser le champ charts\\n\"\ntools:\n  modules:\n    spreadsheet: {}\n", "language": "yaml", "size": 3855, "lines": 65, "operation": "disk_sync", "updated_at": 1778628125.0702088, "validation": "approved", "baseline_lines": 64, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.5465572}, "examples/taskboard-agent.yaml": {"content": "app:\n  app_id: taskboard-agent\n  name: TaskBoard Agent\n  description: Agent connecté à un task board MCP - teste les structural hints avec\n    contenu structuré (blocks, properties).\nruntime:\n  mode: conversation\n  max_turns: 100\n  timeout: 600.0\nagents:\n- id: assistant\n  role: assistant\n  brain:\n    provider: ollama\n    model: qwen3:32b\n    backend: openai_compat\n    config:\n      base_url: http://localhost:11434/v1\n    context:\n      max_tokens: 32768\n      strategy: summarize\n      keep_recent: 20\n      auto_compact: true\n  system_prompt: 'Tu es un assistant de gestion de projet. Réponds en français.\n\n    Tu as accès à un tableau de tâches (task board) via des outils MCP.\n\n    '\ntools:\n  modules:\n    mcp:\n      config:\n        servers:\n          taskboard:\n            transport: stdio\n            command: python3\n            args:\n            - '{{workspace}}/examples/taskboard_mcp_server.py'\n  capabilities:\n    default_policy: grant\nui:\n  greeting: 'TaskBoard Agent prêt ! Le serveur MCP \"taskboard\" est connecté.\n\n    Tu peux :\n\n    - Rechercher des tâches\n\n    - Voir le contenu d''une tâche\n\n    - Créer de nouvelles tâches avec du contenu structuré\n\n    - Ajouter du contenu à une tâche existante\n\n    '\ndev:\n  variables:\n    workspace: '{{env.PWD}}'\n", "language": "yaml", "size": 1273, "lines": 58, "operation": "disk_sync", "updated_at": 1778628125.0761316, "validation": "approved", "baseline_lines": 57, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.5465572}, "examples/taskboard_mcp_server.py": {"content": "#!/usr/bin/env python3\n\"\"\"Task Board MCP server - realistic structured content for testing.\n\nSimulates a project management API similar to Notion/Linear/Airtable:\n- Tasks have typed content blocks (paragraph, checklist, heading)\n- Writer tools accept JSON string params (like Notion's `_json` pattern)\n- Getter tools return structured responses (for schema probing)\n\nThis tests the full structural hints pipeline:\n  probe → template extraction → prompt injection → LLM writes correct JSON\n\nTools:\n  READERS (for probing):\n  - search_tasks(query?)       - search/list all tasks\n  - get_task(task_id)          - get a task with its properties\n  - get_task_content(task_id)  - get content blocks of a task\n\n  WRITERS (with _json params):\n  - create_task(title, properties_json?, content_json?)\n  - update_task(task_id, properties_json?, content_json?)\n  - append_content(task_id, blocks_json)\n\"\"\"\n\nimport json\nimport sys\nimport uuid\nfrom datetime import datetime, timezone\n\n\n# ---------------------------------------------------------------------------\n# In-memory storage\n# ---------------------------------------------------------------------------\n\n_TASKS: dict[str, dict] = {}\n\n\ndef _seed_data() -> None:\n    \"\"\"Create sample data so probing finds something.\"\"\"\n    task_id = \"task-001\"\n    _TASKS[task_id] = {\n        \"id\": task_id,\n        \"title\": \"Setup CI/CD pipeline\",\n        \"status\": \"in_progress\",\n        \"priority\": \"high\",\n        \"assignee\": \"alice\",\n        \"created_at\": \"2025-01-15T10:00:00Z\",\n        \"updated_at\": \"2025-01-16T14:30:00Z\",\n        \"properties\": {\n            \"status\": {\"type\": \"select\", \"select\": {\"name\": \"In Progress\"}},\n            \"priority\": {\"type\": \"select\", \"select\": {\"name\": \"High\"}},\n            \"assignee\": {\"type\": \"person\", \"person\": {\"name\": \"Alice\", \"email\": \"alice@example.com\"}},\n            \"due_date\": {\"type\": \"date\", \"date\": {\"start\": \"2025-02-01\"}},\n            \"tags\": {\"type\": \"multi_select\", \"multi_select\": [\n                {\"name\": \"devops\"},\n                {\"name\": \"infrastructure\"},\n            ]},\n            \"estimate\": {\"type\": \"number\", \"number\": 8},\n        },\n        \"content\": [\n            {\n                \"type\": \"heading\",\n                \"heading\": {\"level\": 2, \"text\": \"Pipeline Requirements\"},\n            },\n            {\n                \"type\": \"paragraph\",\n                \"paragraph\": {\n                    \"rich_text\": [\n                        {\"type\": \"text\", \"text\": {\"content\": \"We need to set up GitHub Actions for automated testing and deployment.\"}},\n                    ],\n                },\n            },\n            {\n                \"type\": \"checklist\",\n                \"checklist\": {\n                    \"items\": [\n                        {\"text\": \"Configure build step\", \"checked\": True},\n                        {\"text\": \"Add unit test runner\", \"checked\": True},\n                        {\"text\": \"Setup deployment to staging\", \"checked\": False},\n                        {\"text\": \"Add production deploy gate\", \"checked\": False},\n                    ],\n                },\n            },\n            {\n                \"type\": \"paragraph\",\n                \"paragraph\": {\n                    \"rich_text\": [\n                        {\"type\": \"text\", \"text\": {\"content\": \"Target: all PRs should run tests in under 5 minutes.\"}},\n                    ],\n                },\n            },\n        ],\n    }\n\n    task2_id = \"task-002\"\n    _TASKS[task2_id] = {\n        \"id\": task2_id,\n        \"title\": \"Write API documentation\",\n        \"status\": \"todo\",\n        \"priority\": \"medium\",\n        \"assignee\": \"bob\",\n        \"created_at\": \"2025-01-16T09:00:00Z\",\n        \"updated_at\": \"2025-01-16T09:00:00Z\",\n        \"properties\": {\n            \"status\": {\"type\": \"select\", \"select\": {\"name\": \"Todo\"}},\n            \"priority\": {\"type\": \"select\", \"select\": {\"name\": \"Medium\"}},\n            \"assignee\": {\"type\": \"person\", \"person\": {\"name\": \"Bob\", \"email\": \"bob@example.com\"}},\n            \"tags\": {\"type\": \"multi_select\", \"multi_select\": [\n                {\"name\": \"documentation\"},\n            ]},\n        },\n        \"content\": [\n            {\n                \"type\": \"paragraph\",\n                \"paragraph\": {\n                    \"rich_text\": [\n                        {\"type\": \"text\", \"text\": {\"content\": \"Document all REST endpoints with examples.\"}},\n                    ],\n                },\n            },\n        ],\n    }\n\n\n_seed_data()\n\n\n# ---------------------------------------------------------------------------\n# Tool definitions\n# ---------------------------------------------------------------------------\n\nTOOLS = [\n    # --- Readers ---\n    {\n        \"name\": \"search_tasks\",\n        \"description\": \"Search tasks by query string. Returns matching tasks with their properties.\",\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"query\": {\n                    \"type\": \"string\",\n                    \"description\": \"Search query (matches title and content). Leave empty to list all.\",\n                },\n            },\n        },\n    },\n    {\n        \"name\": \"get_task\",\n        \"description\": \"Get a task by ID, including all properties.\",\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"task_id\": {\"type\": \"string\", \"description\": \"The task ID\"},\n            },\n            \"required\": [\"task_id\"],\n        },\n    },\n    {\n        \"name\": \"get_task_content\",\n        \"description\": \"Get the content blocks of a task (paragraphs, headings, checklists).\",\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"task_id\": {\"type\": \"string\", \"description\": \"The task ID\"},\n            },\n            \"required\": [\"task_id\"],\n        },\n    },\n    # --- Writers ---\n    {\n        \"name\": \"create_task\",\n        \"description\": (\n            \"Create a new task.\\n\\n\"\n            \"Args:\\n\"\n            \"  title (str): Task title\\n\"\n            \"  properties_json (str): JSON string of task properties. \"\n            \"Use the exact structure returned by get_task.\\n\"\n            \"  content_json (str): JSON string of content blocks (array). \"\n            \"Use the exact structure returned by get_task_content.\\n\"\n        ),\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"title\": {\"type\": \"string\", \"description\": \"Task title\"},\n                \"properties_json\": {\n                    \"type\": \"string\",\n                    \"description\": (\n                        \"JSON string with task properties. \"\n                        \"Must follow the exact structure from get_task response.\"\n                    ),\n                },\n                \"content_json\": {\n                    \"type\": \"string\",\n                    \"description\": (\n                        \"JSON string array of content blocks. \"\n                        \"Must follow the exact structure from get_task_content response.\"\n                    ),\n                },\n            },\n            \"required\": [\"title\"],\n        },\n    },\n    {\n        \"name\": \"update_task\",\n        \"description\": (\n            \"Update an existing task's properties and/or content.\\n\\n\"\n            \"Args:\\n\"\n            \"  task_id (str): The task ID to update\\n\"\n            \"  properties_json (str): JSON string of properties to update. \"\n            \"Use the exact structure returned by get_task.\\n\"\n            \"  content_json (str): JSON string of content blocks to replace. \"\n            \"Use the exact structure returned by get_task_content.\\n\"\n        ),\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"task_id\": {\"type\": \"string\", \"description\": \"The task ID to update\"},\n                \"properties_json\": {\n                    \"type\": \"string\",\n                    \"description\": (\n                        \"JSON string with task properties to update. \"\n                        \"Must follow the exact structure from get_task response.\"\n                    ),\n                },\n                \"content_json\": {\n                    \"type\": \"string\",\n                    \"description\": (\n                        \"JSON string array of content blocks to replace. \"\n                        \"Must follow the exact structure from get_task_content response.\"\n                    ),\n                },\n            },\n            \"required\": [\"task_id\"],\n        },\n    },\n    {\n        \"name\": \"append_content\",\n        \"description\": (\n            \"Append content blocks to an existing task.\\n\\n\"\n            \"Args:\\n\"\n            \"  task_id (str): The task ID\\n\"\n            \"  blocks_json (str): JSON string array of content blocks to append. \"\n            \"Use the exact structure returned by get_task_content.\\n\"\n        ),\n        \"inputSchema\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"task_id\": {\"type\": \"string\", \"description\": \"The task ID\"},\n                \"blocks_json\": {\n                    \"type\": \"string\",\n                    \"description\": (\n                        \"JSON string array of content blocks to append. \"\n                        \"Must follow the exact structure from get_task_content response.\"\n                    ),\n                },\n            },\n            \"required\": [\"task_id\", \"blocks_json\"],\n        },\n    },\n]\n\n\n# ---------------------------------------------------------------------------\n# Tool execution\n# ---------------------------------------------------------------------------\n\ndef execute_tool(name: str, arguments: dict) -> list[dict]:\n    \"\"\"Execute a tool and return MCP content blocks.\"\"\"\n\n    if name == \"search_tasks\":\n        query = (arguments.get(\"query\") or \"\").lower()\n        results = []\n        for task in _TASKS.values():\n            if not query or query in task[\"title\"].lower():\n                results.append({\n                    \"id\": task[\"id\"],\n                    \"title\": task[\"title\"],\n                    \"status\": task[\"status\"],\n                    \"priority\": task[\"priority\"],\n                })\n        return [{\"type\": \"text\", \"text\": json.dumps({\"results\": results}, indent=2)}]\n\n    if name == \"get_task\":\n        task_id = arguments.get(\"task_id\", \"\")\n        task = _TASKS.get(task_id)\n        if not task:\n            return [{\"type\": \"text\", \"text\": json.dumps({\"error\": f\"Task not found: {task_id}\"})}]\n        # Return without content (use get_task_content for that)\n        result = {k: v for k, v in task.items() if k != \"content\"}\n        return [{\"type\": \"text\", \"text\": json.dumps(result, indent=2)}]\n\n    if name == \"get_task_content\":\n        task_id = arguments.get(\"task_id\", \"\")\n        task = _TASKS.get(task_id)\n        if not task:\n            return [{\"type\": \"text\", \"text\": json.dumps({\"error\": f\"Task not found: {task_id}\"})}]\n        return [{\"type\": \"text\", \"text\": json.dumps(task[\"content\"], indent=2)}]\n\n    if name == \"create_task\":\n        title = arguments.get(\"title\", \"Untitled\")\n        task_id = f\"task-{uuid.uuid4().hex[:6]}\"\n        now = datetime.now(timezone.utc).isoformat()\n\n        # Parse properties\n        properties = {}\n        props_json = arguments.get(\"properties_json\")\n        if props_json:\n            try:\n                properties = json.loads(props_json)\n            except json.JSONDecodeError as e:\n                return [{\"type\": \"text\", \"text\": json.dumps({\n                    \"error\": f\"Invalid properties_json: {e}\",\n                    \"hint\": \"Must be a valid JSON string. See get_task response for structure.\",\n                })}]\n\n        # Parse content\n        content = []\n        content_json = arguments.get(\"content_json\")\n        if content_json:\n            try:\n                content = json.loads(content_json)\n            except json.JSONDecodeError as e:\n                return [{\"type\": \"text\", \"text\": json.dumps({\n                    \"error\": f\"Invalid content_json: {e}\",\n                    \"hint\": \"Must be a valid JSON array. See get_task_content response for structure.\",\n                })}]\n\n        # Validate content structure\n        validation = _validate_content(content)\n        if validation:\n            return [{\"type\": \"text\", \"text\": json.dumps({\n                \"error\": f\"Invalid content structure: {validation}\",\n                \"hint\": \"Use the exact structure from get_task_content. See template.\",\n            })}]\n\n        # Validate properties structure\n        validation = _validate_properties(properties)\n        if validation:\n            return [{\"type\": \"text\", \"text\": json.dumps({\n                \"error\": f\"Invalid properties structure: {validation}\",\n                \"hint\": \"Use the exact structure from get_task. See template.\",\n            })}]\n\n        _TASKS[task_id] = {\n            \"id\": task_id,\n            \"title\": title,\n            \"status\": properties.get(\"status\", {}).get(\"select\", {}).get(\"name\", \"todo\"),\n            \"priority\": properties.get(\"priority\", {}).get(\"select\", {}).get(\"name\", \"medium\"),\n            \"assignee\": properties.get(\"assignee\", {}).get(\"person\", {}).get(\"name\", \"\"),\n            \"created_at\": now,\n            \"updated_at\": now,\n            \"properties\": properties,\n            \"content\": content,\n        }\n        return [{\"type\": \"text\", \"text\": json.dumps({\"created\": task_id, \"title\": title})}]\n\n    if name == \"update_task\":\n        task_id = arguments.get(\"task_id\", \"\")\n        task = _TASKS.get(task_id)\n        if not task:\n            return [{\"type\": \"text\", \"text\": json.dumps({\"error\": f\"Task not found: {task_id}\"})}]\n\n        props_json = arguments.get(\"properties_json\")\n        if props_json:\n            try:\n                props = json.loads(props_json)\n                validation = _validate_properties(props)\n                if validation:\n                    return [{\"type\": \"text\", \"text\": json.dumps({\n                        \"error\": f\"Invalid properties structure: {validation}\",\n                    })}]\n                task[\"properties\"].update(props)\n            except json.JSONDecodeError as e:\n                return [{\"type\": \"text\", \"text\": json.dumps({\"error\": f\"Invalid properties_json: {e}\"})}]\n\n        content_json = arguments.get(\"content_json\")\n        if content_json:\n            try:\n                content = json.loads(content_json)\n                validation = _validate_content(content)\n                if validation:\n                    return [{\"type\": \"text\", \"text\": json.dumps({\n                        \"error\": f\"Invalid content structure: {validation}\",\n                    })}]\n                task[\"content\"] = content\n            except json.JSONDecodeError as e:\n                return [{\"type\": \"text\", \"text\": json.dumps({\"error\": f\"Invalid content_json: {e}\"})}]\n\n        task[\"updated_at\"] = datetime.now(timezone.utc).isoformat()\n        return [{\"type\": \"text\", \"text\": json.dumps({\"updated\": task_id})}]\n\n    if name == \"append_content\":\n        task_id = arguments.get(\"task_id\", \"\")\n        task = _TASKS.get(task_id)\n        if not task:\n            return [{\"type\": \"text\", \"text\": json.dumps({\"error\": f\"Task not found: {task_id}\"})}]\n\n        blocks_json = arguments.get(\"blocks_json\", \"\")\n        try:\n            blocks = json.loads(blocks_json)\n        except json.JSONDecodeError as e:\n            return [{\"type\": \"text\", \"text\": json.dumps({\n                \"error\": f\"Invalid blocks_json: {e}\",\n                \"hint\": \"Must be a valid JSON array. See get_task_content response for structure.\",\n            })}]\n\n        validation = _validate_content(blocks)\n        if validation:\n            return [{\"type\": \"text\", \"text\": json.dumps({\n                \"error\": f\"Invalid content structure: {validation}\",\n                \"hint\": \"Use the exact structure from get_task_content.\",\n            })}]\n\n        task[\"content\"].extend(blocks)\n        task[\"updated_at\"] = datetime.now(timezone.utc).isoformat()\n        return [{\"type\": \"text\", \"text\": json.dumps({\n            \"appended\": len(blocks),\n            \"total_blocks\": len(task[\"content\"]),\n        })}]\n\n    return [{\"type\": \"text\", \"text\": json.dumps({\"error\": f\"Unknown tool: {name}\"})}]\n\n\n# ---------------------------------------------------------------------------\n# Validation - rejects invented structures\n# ---------------------------------------------------------------------------\n\n_VALID_BLOCK_TYPES = {\"heading\", \"paragraph\", \"checklist\"}\n_VALID_PROPERTY_TYPES = {\"select\", \"multi_select\", \"person\", \"date\", \"number\", \"text\"}\n\n\ndef _validate_content(content: list) -> str | None:\n    \"\"\"Validate content blocks match the expected structure.\n\n    Returns error message or None if valid.\n    \"\"\"\n    if not isinstance(content, list):\n        return \"content must be a JSON array\"\n\n    for i, block in enumerate(content):\n        if not isinstance(block, dict):\n            return f\"block[{i}] must be an object\"\n        btype = block.get(\"type\")\n        if btype not in _VALID_BLOCK_TYPES:\n            return (\n                f\"block[{i}].type = '{btype}' is invalid. \"\n                f\"Valid types: {sorted(_VALID_BLOCK_TYPES)}. \"\n                f\"Do NOT invent types like 'text', 'block', etc.\"\n            )\n        # Check structure matches type\n        if btype not in block:\n            return f\"block[{i}] has type='{btype}' but no '{btype}' key\"\n\n        inner = block[btype]\n        if btype == \"paragraph\":\n            if \"rich_text\" not in inner:\n                return (\n                    f\"block[{i}].paragraph must have 'rich_text' (array), \"\n                    f\"NOT 'text'. Use: {{\\\"type\\\": \\\"paragraph\\\", \"\n                    f\"\\\"paragraph\\\": {{\\\"rich_text\\\": [{{\\\"type\\\": \\\"text\\\", \"\n                    f\"\\\"text\\\": {{\\\"content\\\": \\\"...\\\"}}}}]}}}}\"\n                )\n            if not isinstance(inner[\"rich_text\"], list):\n                return f\"block[{i}].paragraph.rich_text must be an array\"\n\n        elif btype == \"heading\":\n            if \"text\" not in inner and \"level\" not in inner:\n                return f\"block[{i}].heading must have 'level' and 'text'\"\n\n        elif btype == \"checklist\":\n            if \"items\" not in inner:\n                return f\"block[{i}].checklist must have 'items' (array)\"\n\n        # Reject invented keys\n        allowed_top = {\"type\", btype}\n        extra = set(block.keys()) - allowed_top\n        if extra:\n            return (\n                f\"block[{i}] has unexpected keys: {extra}. \"\n                f\"Only 'type' and '{btype}' are allowed at top level.\"\n            )\n\n    return None\n\n\ndef _validate_properties(properties: dict) -> str | None:\n    \"\"\"Validate properties match the expected structure.\"\"\"\n    if not isinstance(properties, dict):\n        return \"properties must be a JSON object\"\n\n    for key, value in properties.items():\n        if not isinstance(value, dict):\n            return f\"property '{key}' must be an object with 'type' field\"\n        ptype = value.get(\"type\")\n        if ptype not in _VALID_PROPERTY_TYPES:\n            return (\n                f\"property '{key}'.type = '{ptype}' is invalid. \"\n                f\"Valid types: {sorted(_VALID_PROPERTY_TYPES)}\"\n            )\n\n    return None\n\n\n# ---------------------------------------------------------------------------\n# JSON-RPC dispatch\n# ---------------------------------------------------------------------------\n\ndef handle_request(msg: dict) -> dict | None:\n    method = msg.get(\"method\", \"\")\n    params = msg.get(\"params\", {})\n    msg_id = msg.get(\"id\")\n\n    if msg_id is None:\n        return None\n\n    if method == \"initialize\":\n        return {\n            \"jsonrpc\": \"2.0\",\n            \"id\": msg_id,\n            \"result\": {\n                \"protocolVersion\": \"2024-11-05\",\n                \"serverInfo\": {\"name\": \"taskboard-mcp\", \"version\": \"1.0.0\"},\n                \"capabilities\": {\"tools\": {\"listChanged\": False}},\n            },\n        }\n\n    if method == \"ping\":\n        return {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": {}}\n\n    if method == \"tools/list\":\n        return {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": {\"tools\": TOOLS}}\n\n    if method == \"tools/call\":\n        tool_name = params.get(\"name\", \"\")\n        arguments = params.get(\"arguments\", {})\n        content = execute_tool(tool_name, arguments)\n        return {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": {\"content\": content, \"isError\": False}}\n\n    if method == \"resources/list\":\n        return {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": {\"resources\": []}}\n\n    if method == \"prompts/list\":\n        return {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": {\"prompts\": []}}\n\n    return {\n        \"jsonrpc\": \"2.0\",\n        \"id\": msg_id,\n        \"error\": {\"code\": -32601, \"message\": f\"Method not found: {method}\"},\n    }\n\n\ndef main():\n    for line in sys.stdin:\n        line = line.strip()\n        if not line:\n            continue\n        try:\n            msg = json.loads(line)\n        except json.JSONDecodeError:\n            continue\n        response = handle_request(msg)\n        if response is not None:\n            sys.stdout.write(json.dumps(response) + \"\\n\")\n            sys.stdout.flush()\n\n\nif __name__ == \"__main__\":\n    main()\n", "language": "python", "size": 21191, "lines": 568, "operation": "disk_sync", "updated_at": 1778628125.0824466, "validation": "approved", "baseline_lines": 567, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777378984.871352}, "examples/test-a