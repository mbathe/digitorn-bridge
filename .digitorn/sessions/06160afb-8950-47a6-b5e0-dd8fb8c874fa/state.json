            \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/widgets/data/{binding}\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get Widget Data\",\n        \"description\": \"Resolve and return one named data binding from the app's widgets.\\n\\nThe widget tree references data via ``items: '{{sources}}'`` etc.\\nEach name maps to an entry under the zone's ``data:`` block:\\n\\n.. code-block:: yaml\\n\\n    widgets:\\n      chat_side:\\n        data:\\n          sources:\\n            type: http\\n            url: /rag/sources\\n            poll: 10s\\n\\nThe client calls ``GET /api/apps/{id}/widgets/data/sources`` to\\nhydrate the binding. Supported source types:\\n\\n- ``http``    \\u2014 HTTP request (relative to daemon, app-scoped)\\n- ``tool``    \\u2014 invoke a module action with args\\n- ``static``  \\u2014 return the value verbatim\\n- ``stream``  \\u2014 opens an SSE stream (delegated to the SSE route;\\n                this endpoint just returns a placeholder)\\n- ``local``   \\u2014 client-side only, returns the default value\\n\\nQuery params (any) are forwarded to HTTP source requests as the\\nrequest query string, and to tool source as additional args.\",\n        \"operationId\": \"get_widget_data_api_apps__app_id__widgets_data__binding__get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"binding\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Binding\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/widgets/upload\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Widgets Upload\",\n        \"description\": \"Generic multipart upload endpoint for ``file_upload`` widgets.\\n\\nStores the file under\\n``~/.local/share/digitorn/uploads/{user_id}/{session_id}/{file_id}/{filename}``\\nand returns a ``{file_id, url, size, content_type}`` payload the\\nclient can echo into the form value (so the next form submission\\nreferences the uploaded file by id, not by content).\\n\\nApps that need custom upload handling (validation, virus scan,\\nindexing) can provide their own ``upload_to.url`` in the\\n``file_upload`` primitive \\u2014 the daemon only handles the generic\\ncase when no custom URL is set.\",\n        \"operationId\": \"widgets_upload_api_apps__app_id__widgets_upload_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"multipart/form-data\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/Body_widgets_upload_api_apps__app_id__widgets_upload_post\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/widgets/upload/{user_id}/{sid}/{file_id}/{filename}\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Widgets Download\",\n        \"description\": \"Serve a previously uploaded file back to the client.\\n\\nPer-user scoped: only the owning user (or admin) can read it.\",\n        \"operationId\": \"widgets_download_api_apps__app_id__widgets_upload__user_id___sid___file_id___filename__get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"user_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"User Id\"\n            }\n          },\n          {\n            \"name\": \"sid\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Sid\"\n            }\n          },\n          {\n            \"name\": \"file_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"File Id\"\n            }\n          },\n          {\n            \"name\": \"filename\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Filename\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/widgets/data/{binding}/stream\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Stream Widget Data\",\n        \"description\": \"SSE bridge for ``type: stream`` data sources.\\n\\nThe widget's ``data: { live_metrics: { type: stream, url: ... } }``\\nblock declares an upstream URL serving SSE. The daemon proxies\\neach frame to the client so the dashboard updates live without\\na full re-fetch.\\n\\nTwo upstream contracts are supported:\\n\\n1. **SSE upstream** \\u2014 the URL serves ``text/event-stream``. The\\n   daemon parses ``data:`` lines and forwards them.\\n2. **HTTP poll upstream** \\u2014 the URL serves JSON. The daemon\\n   polls every ``poll`` seconds (from the data spec) and emits\\n   a frame per response.\\n\\nReducer hint (``replace`` / ``append`` / ``merge``) is sent in\\nthe first frame so the client knows how to integrate updates.\",\n        \"operationId\": \"stream_widget_data_api_apps__app_id__widgets_data__binding__stream_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"binding\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Binding\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/widgets/validate\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Validate Widgets\",\n        \"description\": \"Lint endpoint \\u2014 recompiles the widgets block and returns errors.\\n\\nUsed by the builder UI for live validation. Read-only \\u2014 does not\\nredeploy the app.\",\n        \"operationId\": \"validate_widgets_api_apps__app_id__widgets_validate_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/widgets/action\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Widgets Action\",\n        \"description\": \"Dispatch a user widget action.\\n\\nAction handling matrix:\\n\\n- ``tool``        \\u2192 run the named tool through the agent loop\\n- ``http``        \\u2192 execute an app-scoped HTTP call\\n- ``chat``        \\u2192 inject the message into the session as a user turn\\n- ``set_state``   \\u2192 mutate the per-session widget state map\\n- ``refresh``     \\u2192 re-fetch the listed data bindings\\n- ``sequence``    \\u2192 run multiple steps inside a single dispatch\\n- ``close`` / ``open_modal`` / ``open_workspace`` \\u2192 effect echo\\n  (the client handles the UI side; this just ACKs)\\n\\nThe route returns ``{ok, effect}`` so the client can chain\\nfollow-up actions (toast, refresh, navigation, \\u2026).\",\n        \"operationId\": \"widgets_action_api_apps__app_id__widgets_action_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/WidgetActionRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/interact\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Interact Widget\",\n        \"description\": \"Handle a bidirectional widget interaction from the frontend.\\n\\nRoutes the action to the module that owns the widget via the service bus.\\nThe module processes the action and can update state, which triggers\\nSSE events back to the frontend for live UI updates.\\n\\nThe module must implement a `widget_interact(widget, action, state)` method.\",\n        \"operationId\": \"interact_widget_api_apps__app_id__interact_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/InteractRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/disable\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Disable App\",\n        \"description\": \"Disable a scoped app install \\u2014 hide it + refuse interaction.\\n\\nScope resolution mirrors DELETE: the caller's JWT targets their\\nown user install by default. Admins can pass ``?scope=system`` to\\ndisable the system install instead.\\n\\nBuilt-in apps cannot be disabled.\",\n        \"operationId\": \"disable_app_api_apps__app_id__disable_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"scope\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"anyOf\": [\n                {\n                  \"type\": \"string\"\n                },\n                {\n                  \"type\": \"null\"\n                }\n              ],\n              \"title\": \"Scope\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"anyOf\": [\n                  {\n                    \"$ref\": \"#/components/schemas/DisableRequest\"\n                  },\n                  {\n                    \"type\": \"null\"\n                  }\n                ],\n                \"title\": \"Body\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/enable\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Enable App\",\n        \"description\": \"Re-enable a disabled app (ADMIN ONLY) and redeploy it.\\n\\nScope-aware: when ``?scope=user&user_id=<uid>`` is supplied the\\nadmin re-enables that user's install. Otherwise the system\\ninstall is targeted. Fails if the bundle was wiped.\",\n        \"operationId\": \"enable_app_api_apps__app_id__enable_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"scope\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"anyOf\": [\n                {\n                  \"type\": \"string\"\n                },\n                {\n                  \"type\": \"null\"\n                }\n              ],\n              \"title\": \"Scope\"\n            }\n          },\n          {\n            \"name\": \"user_id\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"anyOf\": [\n                {\n                  \"type\": \"string\"\n                },\n                {\n                  \"type\": \"null\"\n                }\n              ],\n              \"title\": \"User Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/approvals\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"List Approvals\",\n        \"description\": \"List pending approval requests for an app.\",\n        \"operationId\": \"list_approvals_api_apps__app_id__approvals_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/approve\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Resolve Approval\",\n        \"description\": \"Approve or deny a pending approval request.\",\n        \"operationId\": \"resolve_approval_api_apps__app_id__approve_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/ApprovalResolveRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/quota\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get App Quota\",\n        \"description\": \"Get current rate limit usage for an app.\",\n        \"operationId\": \"get_app_quota_api_apps__app_id__quota_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"put\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Set App Quota\",\n        \"description\": \"Set a custom rate limit for an app (requests per minute).\",\n        \"operationId\": \"set_app_quota_api_apps__app_id__quota_put\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/QuotaRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"delete\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Remove App Quota\",\n        \"description\": \"Remove custom rate limit (reverts to global default).\",\n        \"operationId\": \"remove_app_quota_api_apps__app_id__quota_delete\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/quota/user/{user_id}\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get User Quota\",\n        \"description\": \"Get rate limit usage for a specific user on an app.\",\n        \"operationId\": \"get_user_quota_api_apps__app_id__quota_user__user_id__get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"user_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"User Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"put\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Set User Quota\",\n        \"description\": \"Set a custom rate limit for a user on an app.\",\n        \"operationId\": \"set_user_quota_api_apps__app_id__quota_user__user_id__put\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"user_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"User Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/QuotaRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"delete\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Remove User Quota\",\n        \"description\": \"Remove custom quota for a user (reverts to app default).\",\n        \"operationId\": \"remove_user_quota_api_apps__app_id__quota_user__user_id__delete\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"user_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"User Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/reload\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Reload App\",\n        \"description\": \"Hot-reload a deployed app from its current bundle.\\n\\nUse this after updating a secret (e.g. rotating an API key) or when\\nyou want to force the in-memory instance to pick up persistent\\nchanges without restarting the whole daemon.\\n\\nWhat it does:\\n  - Re-reads the app's frozen bundle from disk\\n  - Re-reads the current secrets from the secret store\\n  - Stops the running in-memory instance (drops active sessions)\\n  - Rebuilds the app with the fresh secrets and puts it back in\\n    the pool of deployed apps\\n\\nWhat it does NOT do:\\n  - Does not modify any DB row (Application, AppBundle, AppProfile)\\n  - Does not change the bundle on disk\\n  - Does not bump the version\\n\\nPermission: ``apps:deploy`` (same as deploy, because reload is\\nfunctionally a redeploy of the same content).\",\n        \"operationId\": \"reload_app_api_apps__app_id__reload_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/secrets\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"List Secrets\",\n        \"description\": \"List secret key names for an app (values are never returned).\",\n        \"operationId\": \"list_secrets_api_apps__app_id__secrets_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"put\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Set Secrets Bulk\",\n        \"description\": \"Set many secrets in one request, then optionally hot-reload.\\n\\nThis is the convenience endpoint to use when rotating several keys\\nat the same time. It writes each secret through ``SecretStore``\\n(same code path as the per-key PUT) and then, if ``reload=true``\\n(the default), triggers a single ``reload_app`` so every new value\\ntakes effect together. Without bulk, rotating N keys would cost N\\nreloads which is wasteful and can momentarily break the app between\\ntwo updates.\",\n        \"operationId\": \"set_secrets_bulk_api_apps__app_id__secrets_put\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"reload\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"boolean\",\n              \"default\": true,\n              \"title\": \"Reload\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/SecretsBulkSetRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/required-secrets\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Required Secrets\",\n        \"description\": \"List the secrets the app's YAML REQUIRES and their current status.\\n\\nReturns everything the UI needs to render a \\\"manage credentials\\\"\\nscreen for an app with multiple providers:\\n\\n- ``key``       : the secret name (e.g. ``ANTHROPIC_API_KEY``)\\n- ``used_by``   : list of dotted YAML paths where the secret is\\n                  referenced \\u2014 so the UI can group by agent/module\\n                  or at least show \\\"this key is used in 2 places\\\"\\n- ``is_set``    : ``true`` if the secret is already defined in\\n                  ``SecretStore`` or matches an env var on the daemon\\n- ``reference_type``: ``\\\"env\\\"`` or ``\\\"secret\\\"`` depending on the\\n                  template style (``{{env.X}}`` vs ``{{secret.X}}``)\\n\\nThe response also includes:\\n\\n- ``missing_count`` : how many required secrets have no value yet\\n- ``unused_keys``   : secrets stored in SecretStore that are NOT\\n                     referenced by the current YAML (orphans from\\n                     an old version of the app \\u2014 the UI can offer\\n                     to clean them up)\\n\\nThis route reads from the app's **current bundle** on disk \\u2014 so the\\nlist reflects the deployed version, not the live memory state (they\\nshould match, but if someone fiddled with secrets manually the\\n``is_set`` column will reveal the drift).\",\n        \"operationId\": \"required_secrets_api_apps__app_id__required_secrets_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/secrets/{key}\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Check Secret\",\n        \"description\": \"Check if a secret exists (value is never returned).\",\n        \"operationId\": \"check_secret_api_apps__app_id__secrets__key__get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"key\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Key\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"put\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Set Secret\",\n        \"description\": \"Set (or update) an encrypted secret for an app.\\n\\nBy default the running app is **hot-reloaded** immediately so the\\nnew value takes effect without a daemon restart \\u2014 the typical use\\ncase is rotating an API key and wanting the next request to use it.\\nPass ``?reload=false`` when you want to stage multiple secret\\nupdates and trigger a single reload at the end via\\n``POST /api/apps/{app_id}/reload`` or the bulk ``PUT /secrets``.\",\n        \"operationId\": \"set_secret_api_apps__app_id__secrets__key__put\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"key\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Key\"\n            }\n          },\n          {\n            \"name\": \"reload\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"boolean\",\n              \"default\": true,\n              \"title\": \"Reload\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/SecretSetRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"delete\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Delete Secret\",\n        \"description\": \"Delete a secret.\",\n        \"operationId\": \"delete_secret_api_apps__app_id__secrets__key__delete\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"key\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Key\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/oauth/authorize\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Oauth Authorize\",\n        \"description\": \"Start an OAuth2 authorization flow for an MCP server.\\n\\nReturns the authorization URL the user should open in their browser.\",\n        \"operationId\": \"oauth_authorize_api_apps__app_id__oauth_authorize_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"server_id\",\n            \"in\": \"query\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Server Id\"\n            }\n          },\n          {\n            \"name\": \"session_id\",\n            \"in\": \"query\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Session Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/oauth/callback\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Oauth Callback\",\n        \"description\": \"OAuth2 callback endpoint \\u2014 exchanges authorization code for tokens.\\n\\nThis is the redirect_uri that the OAuth provider redirects to after\\nthe user authorizes. Exchanges the code for tokens and stores them.\",\n        \"operationId\": \"oauth_callback_api_apps__app_id__oauth_callback_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"code\",\n            \"in\": \"query\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Code\"\n            }\n          },\n          {\n            \"name\": \"state\",\n            \"in\": \"query\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"State\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/mcp/pending-oauth\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"List Pending Oauth\",\n        \"description\": \"List MCP servers that need OAuth authorization (no valid token yet).\",\n        \"operationId\": \"list_pending_oauth_api_apps__app_id__mcp_pending_oauth_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/mcp/{server_id}/oauth-token\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Inject Oauth Token\",\n        \"description\": \"Inject an OAuth token into an MCP server and persist it in DB.\\n\\nUsed by the CLI after completing a local OAuth flow.\",\n        \"operationId\": \"inject_oauth_token_api_apps__app_id__mcp__server_id__oauth_token_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"server_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Server Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/InjectOAuthTokenRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"delete\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Revoke Mcp Oauth\",\n        \"description\": \"Revoke an MCP server's OAuth token \\u2014 disconnect and delete from DB.\\n\\nThe server entry is kept in the pool (with status reset) so /connect\\ncan re-authorize later.\",\n        \"operationId\": \"revoke_mcp_oauth_api_apps__app_id__mcp__server_id__oauth_token_delete\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"server_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Server Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/inbox\": {\n      \"get\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"List Inbox\",\n        \"description\": \"Return the caller's inbox items, newest first.\\n\\nPagination via ``since=<item_id>`` (cursor). Default page size\\n100, max 500. Each item is enriched with the app's visual\\nmetadata (``app_name``, ``app_icon``, ``app_color``) so the\\nclient renders without an extra /api/apps/{id} fetch per row.\",\n        \"operationId\": \"list_inbox_api_users_me_inbox_get\",\n        \"parameters\": [\n          {\n            \"name\": \"limit\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"default\": 100,\n              \"title\": \"Limit\"\n            }\n          },\n          {\n            \"name\": \"since\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"string\",\n              \"default\": \"\",\n              \"title\": \"Since\"\n            }\n          },\n          {\n            \"name\": \"include_archived\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"boolean\",\n              \"default\": false,\n              \"title\": \"Include Archived\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/inbox/unread_count\": {\n      \"get\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Inbox Unread Count\",\n        \"description\": \"Return the unread item count. Used by the bell badge.\",\n        \"operationId\": \"inbox_unread_count_api_users_me_inbox_unread_count_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/inbox/{item_id}/read\": {\n      \"post\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Inbox Mark Read\",\n        \"operationId\": \"inbox_mark_read_api_users_me_inbox__item_id__read_post\",\n        \"parameters\": [\n          {\n            \"name\": \"item_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Item Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/inbox/read_all\": {\n      \"post\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Inbox Mark All Read\",\n        \"operationId\": \"inbox_mark_all_read_api_users_me_inbox_read_all_post\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/inbox/{item_id}\": {\n      \"delete\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Inbox Archive\",\n        \"operationId\": \"inbox_archive_api_users_me_inbox__item_id__delete\",\n        \"parameters\": [\n          {\n            \"name\": \"item_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Item Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/sessions\": {\n      \"get\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"List User Sessions Cross App\",\n        \"description\": \"Return the caller's recent sessions **across every app** sorted\\nby ``last_active`` descending.\\n\\nThis is the backing route for the \\\"Recent conversations\\\" view in\\nthe Flutter client \\u2014 the one that aggregates work in progress\\nindependently of which app is currently open. Each row carries\\nthe app's visual metadata (icon, color, name) so the list\\nrenders without an extra /api/apps/{id} fetch per row.\",\n        \"operationId\": \"list_user_sessions_cross_app_api_users_me_sessions_get\",\n        \"parameters\": [\n          {\n            \"name\": \"limit\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"default\": 50,\n              \"title\": \"Limit\"\n            }\n          },\n          {\n            \"name\": \"offset\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"default\": 0,\n              \"title\": \"Offset\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/approvals\": {\n      \"get\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"List User Approvals\",\n        \"description\": \"Return every pending approval request belonging to the caller,\\nacross all deployed apps.\\n\\nPowers the \\\"pending approvals\\\" section of the inbox and lets\\nthe Flutter client resync after a reload without iterating\\n``/api/apps/{id}/approvals`` per app.\",\n        \"operationId\": \"list_user_approvals_api_users_me_approvals_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/devices\": {\n      \"get\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"List Devices\",\n        \"operationId\": \"list_devices_api_users_me_devices_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"post\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Register Device\",\n        \"description\": \"Register a device for future push-notification delivery.\\n\\n**Stub**: the row is persisted so we keep the token, but the\\ndaemon doesn't actually push anything yet. Return shape is\\nstable so the client can wire `unregister` without changes.\",\n        \"operationId\": \"register_device_api_users_me_devices_post\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/DeviceRegisterRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/devices/{device_id}\": {\n      \"delete\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Unregister Device\",\n        \"operationId\": \"unregister_device_api_users_me_devices__device_id__delete\",\n        \"parameters\": [\n          {\n            \"name\": \"device_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Device Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/notification-prefs\": {\n      \"get\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Get Notification Prefs\",\n        \"operationId\": \"get_notification_prefs_api_users_me_notification_prefs_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"put\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Put Notification Prefs\",\n        \"operationId\": \"put_notification_prefs_api_users_me_notification_prefs_put\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/NotificationPrefs\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/usage\": {\n      \"get\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Get My Usage\",\n        \"description\": \"Complete usage summary for the authenticated user.\\n\\nPowers the Settings \\u2192 Usage screen. Combines monthly totals,\\ncost by model, 24h hourly time series, 30d daily time series,\\na per-app breakdown, and the caller's active quota status.\\n\\nThe response is computed on the fly from ``usage_events`` \\u2014\\nno caching in v1. SQLite can easily handle the aggregation\\nfor the scale we target (single-daemon multi-user).\",\n        \"operationId\": \"get_my_usage_api_users_me_usage_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/quotas\": {\n      \"get\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"List My Quotas\",\n        \"description\": \"Return every quota applicable to the caller (self-set + admin-set).\",\n        \"operationId\": \"list_my_quotas_api_users_me_quotas_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/profile\": {\n      \"get\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Get My Profile\",\n        \"description\": \"Return the caller's full profile row, including avatar_url,\\ncreated_at, last_seen_at \\u2014 the extra fields the Flutter settings\\nscreen needs beyond the basic /auth/me response.\",\n        \"operationId\": \"get_my_profile_api_users_me_profile_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"put\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Update My Profile\",\n        \"description\": \"Update display_name and/or email on the caller's User row.\",\n        \"operationId\": \"update_my_profile_api_users_me_profile_put\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/digitorn__core__api__user__ProfileUpdateRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/password\": {\n      \"post\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Change My Password\",\n        \"description\": \"Change the caller's password. Verifies the current password\\nbefore applying the new one. Works only for local-provider users\\n\\u2014 OAuth-managed accounts cannot have a local password.\",\n        \"operationId\": \"change_my_password_api_users_me_password_post\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/PasswordChangeRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/avatar\": {\n      \"post\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Upload My Avatar\",\n        \"description\": \"Upload an avatar image. Accepts a multipart file upload,\\nwrites it to ``~/.digitorn/avatars/<user_id>.<ext>``, and\\nreturns the URL the client should use in the UI.\",\n        \"operationId\": \"upload_my_avatar_api_users_me_avatar_post\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/avatar/{filename}\": {\n      \"get\": {\n        \"tags\": [\n          \"user\"\n        ],\n        \"summary\": \"Serve My Avatar\",\n        \"description\": \"Serve a stored avatar file.\\n\\nNo auth beyond existence \\u2014 avatars are user-public by design\\n(they show up in chat headers). The filename includes the\\nuser_id so enumeration isn't interesting.\",\n        \"operationId\": \"serve_my_avatar_api_users_me_avatar__filename__get\",\n        \"parameters\": [\n          {\n            \"name\": \"filename\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Filename\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/packages\": {\n      \"get\": {\n        \"tags\": [\n          \"packages\"\n        ],\n        \"summary\": \"List Packages\",\n        \"description\": \"List packages visible to the caller.\\n\\nA regular user sees: their own user-scoped installs + every\\nsystem-scoped install that isn't shadowed by a user install of\\nthe same ``package_id``. User packages belonging to OTHER\\nusers are never returned.\\n\\nAdmins can pass ``?all=true`` to list every install across\\nevery user \\u2014 useful for a management dashboard.\",\n        \"operationId\": \"list_packages_api_packages_get\",\n        \"parameters\": [\n          {\n            \"name\": \"source_type\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"anyOf\": [\n                {\n                  \"type\": \"string\"\n                },\n                {\n                  \"type\": \"null\"\n                }\n              ],\n              \"title\": \"Source Type\"\n            }\n          },\n          {\n            \"name\": \"status\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"anyOf\": [\n                {\n                  \"type\": \"string\"\n                },\n                {\n                  \"type\": \"null\"\n                }\n              ],\n              \"title\": \"Status\"\n            }\n          },\n          {\n            \"name\": \"all\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"boolean\",\n              \"default\": false,\n              \"title\": \"All\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/packages/{package_id}\": {\n      \"get\": {\n        \"tags\": [\n          \"packages\"\n        ],\n        \"summary\": \"Get Package\",\n        \"description\": \"Get the package install the caller sees for ``package_id``.\\n\\nResolution: the caller's own user-scoped install wins over a\\nsystem install with the same id (shadow pattern). Users never\\nsee packages belonging to other users. 404 when there's no\\nvisible install.\",\n        \"operationId\": \"get_package_api_packages__package_id__get\",\n        \"parameters\": [\n          {\n            \"name\": \"package_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Package Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/packages/{package_id}/check-update\": {\n      \"get\": {\n        \"tags\": [\n          \"packages\"\n        ],\n        \"summary\": \"Check Update\",\n        \"description\": \"Report whether an updated version of the package is available.\\n\\nOnly built-in packages currently support this \\u2014 the wheel ships\\na possibly-newer version of each builtin and the registry tracks\\nthe installed hash. Hub and git sources will support this in v2.\",\n        \"operationId\": \"check_update_api_packages__package_id__check_update_get\",\n        \"parameters\": [\n          {\n            \"name\": \"package_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Package Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/packages/install\": {\n      \"post\": {\n        \"tags\": [\n          \"packages\"\n        ],\n        \"summary\": \"Install Package\",\n        \"description\": \"Install a new package.\\n\\nFirst call (without ``accept_permissions``) returns ``409`` with\\nthe permissions payload so the client can show a consent dialog.\\nSecond call (with ``accept_permissions=true``) actually installs.\\n\\nHub and git sources return 501 \\u2014 their fetch implementations\\nare stubs in v1.\",\n        \"operationId\": \"install_package_api_packages_install_post\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/digitorn__core__api__packages__InstallRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/packages/{package_id}/upgrade\": {\n      \"post\": {\n        \"tags\": [\n          \"packages\"\n        ],\n        \"summary\": \"Upgrade Package\",\n        \"description\": \"Upgrade an installed package to a new version.\\n\\nSame permissions consent flow as install. On compile/deploy\\nfailure the InstallFlow rolls back to the previous version\\nautomatically (locked design D8).\",\n        \"operationId\": \"upgrade_package_api_packages__package_id__upgrade_post\",\n        \"parameters\": [\n          {\n            \"name\": \"package_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Package Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/UpgradeRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/packages/{package_id}/assets/{asset_path}\": {\n      \"get\": {\n        \"tags\": [\n          \"packages\"\n        ],\n        \"summary\": \"Get Package Asset\",\n        \"description\": \"Serve any file from an installed package's directory.\\n\\nUse this to fetch README.md, CHANGELOG.md, skill files\\n(``skills/commit.md``), images referenced by ``assets/``,\\nor any other companion file declared in the package dir.\\n\\nGuarded against path traversal \\u2014 the resolved path must stay\\ninside the package's install directory. Hidden files under\\n``.digitorn/`` are explicitly denied (they're daemon-managed\\nstate, not author content).\\n\\nThis is the \\\"generic\\\" counterpart of ``/api/packages/{id}/icon``\\n\\u2014 that one reads the manifest's ``icon`` field and serves it;\\nthis one takes an explicit relative path.\",\n        \"operationId\": \"get_package_asset_api_packages__package_id__assets__asset_path__get\",\n        \"parameters\": [\n          {\n            \"name\": \"package_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Package Id\"\n            }\n          },\n          {\n            \"name\": \"asset_path\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Asset Path\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/packages/{package_id}/icon\": {\n      \"get\": {\n        \"tags\": [\n          \"packages\"\n        ],\n        \"summary\": \"Get Package Icon\",\n        \"description\": \"Stream the icon file declared by a package's manifest.\\n\\nThe manifest's ``package.icon`` field is a path relative to the\\npackage's install directory. This route resolves it to a real\\nfile and streams it with proper Content-Type detection.\\n\\nFalls back to 404 when the package has no icon, the field\\npoints outside the package dir (path traversal guard), or the\\nfile doesn't exist on disk.\",\n        \"operationId\": \"get_package_icon_api_packages__package_id__icon_get\",\n        \"parameters\": [\n          {\n            \"name\": \"package_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Package Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/packages/{package_id}/uninstall\": {\n      \"post\": {\n        \"tags\": [\n          \"packages\"\n        ],\n        \"summary\": \"Uninstall Package\",\n        \"description\": \"Uninstall a package.\\n\\nBuilt-in packages refuse without ``force=true`` AND admin\\npermission (locked design D9). The package files on disk are\\nwiped, the deployed app is undeployed, the registry row is\\ndeleted. User data (workspaces, credentials, drafts) is\\npreserved.\",\n        \"operationId\": \"uninstall_package_api_packages__package_id__uninstall_post\",\n        \"parameters\": [\n          {\n            \"name\": \"package_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Package Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"anyOf\": [\n                  {\n                    \"$ref\": \"#/components/schemas/UninstallRequest\"\n                  },\n                  {\n                    \"type\": \"null\"\n                  }\n                ],\n                \"title\": \"Body\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/discovery/modules\": {\n      \"get\": {\n        \"tags\": [\n          \"discovery\"\n        ],\n        \"summary\": \"List Modules\",\n        \"description\": \"List every loaded module with a short summary.\\n\\nUsed by the builder agent to enumerate what's available before\\ncomposing a YAML. Excludes failed-to-load modules \\u2014 they would\\nonly confuse the LLM with names it can't actually use.\",\n        \"operationId\": \"list_modules_api_discovery_modules_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/discovery/modules/{module_id}\": {\n      \"get\": {\n        \"tags\": [\n          \"discovery\"\n        ],\n        \"summary\": \"Get Module\",\n        \"description\": \"Return the full action surface of one module.\\n\\nIncludes every visible (non-internal) ``@action`` with its params,\\npermissions, risk level, and tool prompt. This is what the builder\\nagent consults when it needs to know \\\"exactly which params does\\n``database.sql`` take?\\\".\",\n        \"operationId\": \"get_module_api_discovery_modules__module_id__get\",\n        \"parameters\": [\n          {\n            \"name\": \"module_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Module Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/discovery/triggers\": {\n      \"get\": {\n        \"tags\": [\n          \"discovery\"\n        ],\n        \"summary\": \"List Triggers\",\n        \"description\": \"Return every supported trigger type with its category and key fields.\\n\\nThe builder consults this to pick the right trigger before\\ncomposing the YAML. Categorised as ``scheduler`` (cron-like),\\n``channel`` (chat/email/voice), ``http`` (webhook), and ``system``\\n(queue, log).\",\n        \"operationId\": \"list_triggers_api_discovery_triggers_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/discovery/triggers/configured\": {\n      \"get\": {\n        \"tags\": [\n          \"discovery\"\n        ],\n        \"summary\": \"List Configured Triggers\",\n        \"description\": \"Return every trigger declared by a currently-deployed app.\\n\\nComplements ``GET /api/discovery/triggers`` (which lists trigger\\n*types*). The dashboard uses this route to render \\\"Automations\\nactives\\\" across every app without having to fan-out one\\n``GET /api/apps/{id}/triggers`` per app.\\n\\nEach entry: ``{app_id, trigger_id, type, schedule?, path?, method?}``.\",\n        \"operationId\": \"list_configured_triggers_api_discovery_triggers_configured_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/discovery/templates\": {\n      \"get\": {\n        \"tags\": [\n          \"discovery\"\n        ],\n        \"summary\": \"List Templates\",\n        \"description\": \"List every starter template available in ``knowledge_base/examples``.\\n\\nThe builder consults this BEFORE generating from scratch \\u2014 if a\\ntemplate matches the user's intent, it adapts the template\\ninstead, which is dramatically more reliable.\",\n        \"operationId\": \"list_templates_api_discovery_templates_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/discovery/templates/{template_id}\": {\n      \"get\": {\n        \"tags\": [\n          \"discovery\"\n        ],\n        \"summary\": \"Get Template\",\n        \"description\": \"Return the raw YAML of one template by id.\\n\\nThe builder copies this YAML and then mutates it (replaces\\nfields, swaps modules, edits the system prompt) before passing it\\nback to ``/compile`` for validation.\",\n        \"operationId\": \"get_template_api_discovery_templates__template_id__get\",\n        \"parameters\": [\n          {\n            \"name\": \"template_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Template Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/discovery/compile\": {\n      \"post\": {\n        \"tags\": [\n          \"discovery\"\n        ],\n        \"summary\": \"Compile Yaml\",\n        \"description\": \"Compile a YAML app definition without deploying it.\\n\\nThis is the **single most important tool** for the App Builder\\nagent. The builder loops:\\n\\n    1. generate YAML\\n    2. POST /compile\\n    3. read errors\\n    4. fix and re-POST\\n    5. converge or give up\\n\\nReturn shape:\\n\\n```json\\n{\\n  \\\"success\\\": true,                  // overall HTTP status\\n  \\\"data\\\": {\\n    \\\"valid\\\": true,                  // does it compile?\\n    \\\"errors\\\": [\\\"...\\\"],              // list of compile errors\\n    \\\"warnings\\\": [\\\"...\\\"],\\n    \\\"summary\\\": {                    // present iff valid==true\\n      \\\"app_id\\\": \\\"...\\\",\\n      \\\"name\\\": \\\"...\\\",\\n      \\\"mode\\\": \\\"...\\\",\\n      \\\"agents\\\": 3,\\n      \\\"modules\\\": [\\\"filesystem\\\", \\\"memory\\\"],\\n      \\\"trigger_types\\\": [\\\"cron\\\"],\\n      \\\"session_mode\\\": \\\"mono\\\",\\n      \\\"has_payload_schema\\\": false\\n    }\\n  }\\n}\\n```\\n\\nThis route is **side-effect free** \\u2014 it never persists, deploys,\\nor touches the disk. It's safe to call hundreds of times during a\\nbuilder iteration loop.\",\n        \"operationId\": \"compile_yaml_api_discovery_compile_post\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/CompileRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/discovery/prompt-preview\": {\n      \"post\": {\n        \"tags\": [\n          \"discovery\"\n        ],\n        \"summary\": \"Prompt Preview\",\n        \"description\": \"Compile a single prompt without deploying an app.\\n\\nUsed by the Builder agent and IDE tooling to iterate on\\nprompts live: the client POSTs a bundle path + prompt name\\n(or inline content), the daemon resolves every template\\nnamespace against the bundle, runs the markdown rewrite,\\nand returns the final text + token estimate + list of\\nreferenced variables / assets.\\n\\nResponse shape::\\n\\n    {\\n        \\\"compiled_text\\\": \\\"You are an agent...\\\",\\n        \\\"token_estimate\\\": 187,\\n        \\\"referenced_variables\\\": [\\\"app.name\\\", \\\"user_locale\\\"],\\n        \\\"referenced_assets\\\": [\\\"/api/apps/_preview/assets/logo.png\\\"],\\n        \\\"referenced_prompts\\\": [],\\n        \\\"referenced_skills\\\": [],\\n        \\\"frontmatter\\\": { \\\"version\\\": 2, ... },\\n        \\\"warnings\\\": []\\n    }\",\n        \"operationId\": \"prompt_preview_api_discovery_prompt_preview_post\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/PromptPreviewRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/discovery/generate-package-manifest\": {\n      \"post\": {\n        \"tags\": [\n          \"discovery\"\n        ],\n        \"summary\": \"Generate Package Manifest Route\",\n        \"description\": \"Compile a YAML and emit a best-effort ``package.toml``.\\n\\nUsed by the App Builder agent when a user finishes building an\\napp and wants to wrap it into an installable package, and by\\nthe ``digitorn package init`` CLI command.\\n\\nReturns the rendered TOML text + the structured manifest +\\na list of human-readable warnings (e.g. \\\"no license declared,\\nrequired for hub publication\\\").\\n\\nThe route runs the same compile path as ``/compile`` so any\\nYAML errors are surfaced the same way (in ``errors`` field).\",\n        \"operationId\": \"generate_package_manifest_route_api_discovery_generate_package_manifest_post\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/GeneratePackageManifestRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/credentials/schema\": {\n      \"get\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Get App Credentials Schema\",\n        \"description\": \"Return the app's declared credentials schema + current fill state.\\n\\nThe Flutter form uses this to render the provider cards and tell\\nthe user which fields are required, filled, missing, or expired.\",\n        \"operationId\": \"get_app_credentials_schema_api_apps__app_id__credentials_schema_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/credentials/{app_id}/{provider_name}\": {\n      \"get\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Get Credential\",\n        \"description\": \"Return one credential's metadata for the authenticated user.\\n\\nNever returns plaintext field values \\u2014 only masked previews and\\nstatus info. Use this to drive the form display.\",\n        \"operationId\": \"get_credential_api_users_me_credentials__app_id___provider_name__get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"provider_name\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Provider Name\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"put\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Upsert Credential\",\n        \"description\": \"Create or overwrite a credential for the authenticated user + app.\\n\\nValidates via the declared handler before storing. Use ``app_id=\\\"_global\\\"``\\nto store a per-user credential that is shared across every app the\\nuser runs (the per_user scope).\",\n        \"operationId\": \"upsert_credential_api_users_me_credentials__app_id___provider_name__put\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"provider_name\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Provider Name\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/CredentialUpsertRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"delete\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Delete Credential\",\n        \"description\": \"Delete the caller's credential for this provider+app.\",\n        \"operationId\": \"delete_credential_api_users_me_credentials__app_id___provider_name__delete\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"provider_name\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Provider Name\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/credentials\": {\n      \"get\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"List User Credentials\",\n        \"description\": \"List every credential owned by the authenticated user.\\n\\nUsed by the \\\"My Credentials\\\" global dashboard \\u2014 shows every\\nprovider the user has configured across every app, with their\\nstatus and last_updated.\",\n        \"operationId\": \"list_user_credentials_api_users_me_credentials_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/credentials/{app_id}/{provider_name}/oauth/start\": {\n      \"post\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Oauth Start\",\n        \"description\": \"Begin the OAuth flow \\u2014 returns ``auth_url`` and a ``state`` uuid.\\n\\nThe client opens ``auth_url`` in a browser; the user consents;\\nthe provider redirects back to the daemon's callback route. The\\nclient polls ``oauth/status`` to know when the flow completes.\",\n        \"operationId\": \"oauth_start_api_users_me_credentials__app_id___provider_name__oauth_start_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"provider_name\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Provider Name\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/credentials/{app_id}/{provider_name}/oauth/status\": {\n      \"get\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Oauth Status\",\n        \"description\": \"Poll the state of an in-progress OAuth flow.\\n\\nReturns one of:\\n\\n    { status: \\\"pending\\\" }                     \\u2014 still waiting\\n    { status: \\\"connected\\\", credential_id }    \\u2014 done, token stored\\n    { status: \\\"error\\\", error }                \\u2014 failed\\n    { status: \\\"expired\\\" }                     \\u2014 flow TTL elapsed\",\n        \"operationId\": \"oauth_status_api_users_me_credentials__app_id___provider_name__oauth_status_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"provider_name\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Provider Name\"\n            }\n          },\n          {\n            \"name\": \"state\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"string\",\n              \"default\": \"\",\n              \"title\": \"State\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/credentials/{app_id}/{provider_name}/oauth/refresh\": {\n      \"post\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Oauth Refresh\",\n        \"description\": \"Manually trigger a token refresh for an existing OAuth credential.\\n\\nLooks up the stored credential, calls the handler's ``refresh``\\n(which hits the provider's /token endpoint with\\ngrant_type=refresh_token), and writes the new access_token back\\nto the store.\",\n        \"operationId\": \"oauth_refresh_api_users_me_credentials__app_id___provider_name__oauth_refresh_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"provider_name\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Provider Name\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/credentials/{app_id}/{provider_name}/mcp/start\": {\n      \"post\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Mcp Start\",\n        \"description\": \"Start (or restart) an MCP server from a filled credential.\\n\\nLooks up the credential (per_app_per_user \\u2192 per_user), retrieves\\nits schema declaration, and invokes the\\n``McpServerHandler.on_credential_filled`` hook which talks to the\\nlive ``MCPConnectionPool``.\",\n        \"operationId\": \"mcp_start_api_users_me_credentials__app_id___provider_name__mcp_start_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"provider_name\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Provider Name\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/credentials/{app_id}/{provider_name}/mcp/stop\": {\n      \"post\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Mcp Stop\",\n        \"description\": \"Stop an MCP server without deleting its credential.\\n\\nThe credential row stays intact so the user can click \\\"Start\\nagain\\\" without re-filling the form.\",\n        \"operationId\": \"mcp_stop_api_users_me_credentials__app_id___provider_name__mcp_stop_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"provider_name\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Provider Name\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/users/me/credentials/{app_id}/{provider_name}/mcp/status\": {\n      \"get\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Mcp Status\",\n        \"description\": \"Return the current runtime status of an MCP server.\\n\\nShape::\\n\\n    { provider, running, status, tools_count, last_error }\",\n        \"operationId\": \"mcp_status_api_users_me_credentials__app_id___provider_name__mcp_status_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"provider_name\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Provider Name\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/credentials/providers\": {\n      \"get\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"List Credential Providers\",\n        \"description\": \"Return the catalog of well-known credential providers.\\n\\nUsed by the \\\"Add credential\\\" modal to render a picker with\\nicons and display names instead of a flat text input. The list\\nis static (shipped with the daemon) and stable \\u2014 the Flutter\\nclient can cache it indefinitely.\\n\\nShape per entry::\\n\\n    {\\n      \\\"id\\\": \\\"anthropic\\\",           # provider_name to POST\\n      \\\"display_name\\\": \\\"Anthropic\\\",\\n      \\\"category\\\": \\\"llm\\\",            # llm | productivity | communication | ...\\n      \\\"type\\\": \\\"api_key\\\",            # credential handler type\\n      \\\"icon\\\": \\\"\\ud83e\\udde0\\\",                 # emoji for quick render\\n      \\\"fields\\\": [\\\"api_key\\\"],        # expected field names\\n      \\\"docs_url\\\": \\\"https://...\\\"     # where to get the key (optional)\\n    }\",\n        \"operationId\": \"list_credential_providers_api_credentials_providers_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/credentials\": {\n      \"get\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"List My Credentials\",\n        \"description\": \"List every credential owned by the authenticated user.\\n\\nOptional ``?provider=deepseek`` narrows to one provider \\u2014 this\\nis what the picker dialog uses to show candidates on first-use.\",\n        \"operationId\": \"list_my_credentials_api_credentials_get\",\n        \"parameters\": [\n          {\n            \"name\": \"provider\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"string\",\n              \"default\": \"\",\n              \"title\": \"Provider\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"post\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Create My Credential\",\n        \"description\": \"Create a new user-owned credential.\\n\\nValidates via the declared handler before storing. The credential\\nis NOT attached to any app \\u2014 the user authorizes specific apps\\nlater via ``POST /api/credentials/{id}/grants``.\",\n        \"operationId\": \"create_my_credential_api_credentials_post\",\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/UserCredentialCreateRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/credentials/{credential_id}\": {\n      \"get\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Get My Credential By Id\",\n        \"description\": \"Fetch one credential by id. Never returns plaintext fields.\",\n        \"operationId\": \"get_my_credential_by_id_api_credentials__credential_id__get\",\n        \"parameters\": [\n          {\n            \"name\": \"credential_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Credential Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"put\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Update My Credential\",\n        \"description\": \"Overwrite label and/or fields on an existing credential.\",\n        \"operationId\": \"update_my_credential_api_credentials__credential_id__put\",\n        \"parameters\": [\n          {\n            \"name\": \"credential_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Credential Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/UserCredentialUpdateRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"delete\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Delete My Credential\",\n        \"description\": \"Delete a credential (and cascade-delete all its grants).\",\n        \"operationId\": \"delete_my_credential_api_credentials__credential_id__delete\",\n        \"parameters\": [\n          {\n            \"name\": \"credential_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Credential Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/credentials/{credential_id}/grants\": {\n      \"get\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"List Credential Grants\",\n        \"description\": \"List all grants for a single credential.\",\n        \"operationId\": \"list_credential_grants_api_credentials__credential_id__grants_get\",\n        \"parameters\": [\n          {\n            \"name\": \"credential_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Credential Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"post\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Create Credential Grant\",\n        \"description\": \"Authorize an app to use this credential.\\n\\nThis is the endpoint the picker dialog calls when the user clicks\\n\\\"Use this key\\\" \\u2014 it posts the credential_id + app_id, and from\\nthen on the app can read the credential without prompting.\\n\\nSide effect: when the credential is an ``mcp_server``, this also\\nfires the handler's spawn hook so the subprocess is ready by the\\ntime the first agent turn hits the MCP tool.\",\n        \"operationId\": \"create_credential_grant_api_credentials__credential_id__grants_post\",\n        \"parameters\": [\n          {\n            \"name\": \"credential_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Credential Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/CreateGrantRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/credentials/{credential_id}/grant\": {\n      \"post\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Create Credential Grant Singular\",\n        \"description\": \"Alias for ``POST /credentials/{id}/grants`` \\u2014 singular form.\",\n        \"operationId\": \"create_credential_grant_singular_api_credentials__credential_id__grant_post\",\n        \"parameters\": [\n          {\n            \"name\": \"credential_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Credential Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/CreateGrantRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/credentials/{credential_id}/grants/{app_id}\": {\n      \"delete\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Revoke Credential Grant\",\n        \"description\": \"Revoke an app's access to a credential.\\n\\nSoft delete \\u2014 the grant row stays with ``revoked_at`` set for\\naudit. Use ``?hard=true`` to actually remove the row.\",\n        \"operationId\": \"revoke_credential_grant_api_credentials__credential_id__grants__app_id__delete\",\n        \"parameters\": [\n          {\n            \"name\": \"credential_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Credential Id\"\n            }\n          },\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/credentials-grants\": {\n      \"get\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"List All My Grants\",\n        \"description\": \"List every active grant of the authenticated user.\\n\\nSettings screen calls this to show \\\"Apps that can see my\\ncredentials\\\" \\u2014 grouped by app_id on the client side.\",\n        \"operationId\": \"list_all_my_grants_api_credentials_grants_get\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/admin/credentials\": {\n      \"get\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Admin List System Credentials\",\n        \"description\": \"List every admin-owned credential visible to the daemon.\",\n        \"operationId\": \"admin_list_system_credentials_api_admin_credentials_get\",\n        \"parameters\": [\n          {\n            \"name\": \"provider\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"string\",\n              \"default\": \"\",\n              \"title\": \"Provider\"\n            }\n          },\n          {\n            \"name\": \"app_id\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"string\",\n              \"default\": \"\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"post\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Admin Create System Credential\",\n        \"description\": \"Create a system-owned credential.\\n\\nWhen ``app_id`` is set the credential is restricted to that app\\n(enterprise \\\"shared key for this one app\\\" case). When ``app_id``\\nis None the credential is visible to every app on the daemon.\\n\\nNo grants are needed \\u2014 system credentials are implicitly\\navailable to the apps they cover.\",\n        \"operationId\": \"admin_create_system_credential_api_admin_credentials_post\",\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/SystemCredentialCreateRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/admin/credentials/{credential_id}\": {\n      \"delete\": {\n        \"tags\": [\n          \"credentials\"\n        ],\n        \"summary\": \"Admin Delete System Credential\",\n        \"description\": \"Delete an admin/system credential by id.\",\n        \"operationId\": \"admin_delete_system_credential_api_admin_credentials__credential_id__delete\",\n        \"parameters\": [\n          {\n            \"name\": \"credential_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Credential Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/builder/drafts\": {\n      \"get\": {\n        \"tags\": [\n          \"builder\"\n        ],\n        \"summary\": \"List Drafts\",\n        \"description\": \"List the caller's drafts, most recently updated first.\\n\\nOptional ``status`` filter (e.g. ``in_progress``, ``deployed``).\\n``limit`` is clamped to ``MAX_DRAFTS_PER_USER`` server-side.\",\n        \"operationId\": \"list_drafts_api_builder_drafts_get\",\n        \"parameters\": [\n          {\n            \"name\": \"status\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"anyOf\": [\n                {\n                  \"type\": \"string\"\n                },\n                {\n                  \"type\": \"null\"\n                }\n              ],\n              \"title\": \"Status\"\n            }\n          },\n          {\n            \"name\": \"limit\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"default\": 50,\n              \"title\": \"Limit\"\n            }\n          },\n          {\n            \"name\": \"offset\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"default\": 0,\n              \"title\": \"Offset\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"post\": {\n        \"tags\": [\n          \"builder\"\n        ],\n        \"summary\": \"Create Draft\",\n        \"description\": \"Create a new draft for the caller.\\n\\nReturns 409 if the user is at the per-user cap.\",\n        \"operationId\": \"create_draft_api_builder_drafts_post\",\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/DraftCreateRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/builder/drafts/{draft_id}\": {\n      \"get\": {\n        \"tags\": [\n          \"builder\"\n        ],\n        \"summary\": \"Get Draft\",\n        \"description\": \"Resume a draft \\u2014 returns its full state (yaml, history, builder_state).\",\n        \"operationId\": \"get_draft_api_builder_drafts__draft_id__get\",\n        \"parameters\": [\n          {\n            \"name\": \"draft_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Draft Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"patch\": {\n        \"tags\": [\n          \"builder\"\n        ],\n        \"summary\": \"Patch Draft\",\n        \"description\": \"Update one or more fields on a draft.\\n\\nPass only the fields you want to change. Use ``append_messages``\\nwhen you just want to add a couple of chat messages without\\nre-sending the entire history.\",\n        \"operationId\": \"patch_draft_api_builder_drafts__draft_id__patch\",\n        \"parameters\": [\n          {\n            \"name\": \"draft_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Draft Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/DraftPatchRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"delete\": {\n        \"tags\": [\n          \"builder\"\n        ],\n        \"summary\": \"Delete Draft\",\n        \"description\": \"Delete a draft (DB row + on-disk YAML directory).\",\n        \"operationId\": \"delete_draft_api_builder_drafts__draft_id__delete\",\n        \"parameters\": [\n          {\n            \"name\": \"draft_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Draft Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/builder/drafts/{draft_id}/deploy\": {\n      \"post\": {\n        \"tags\": [\n          \"builder\"\n        ],\n        \"summary\": \"Deploy Draft\",\n        \"description\": \"Compile the draft's current YAML and deploy it via the AppManager.\\n\\nOn success, the draft's status is updated to ``deployed`` and its\\n``deployed_app_id`` is set so the dashboard can link the draft to\\nthe live app both ways.\\n\\nOn compile failure, returns ``success=False`` with the list of\\nerrors \\u2014 the draft itself is NOT modified, so the user can keep\\niterating from where they were.\",\n        \"operationId\": \"deploy_draft_api_builder_drafts__draft_id__deploy_post\",\n        \"parameters\": [\n          {\n            \"name\": \"draft_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Draft Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/mcp/catalog\": {\n      \"get\": {\n        \"tags\": [\n          \"mcp\"\n        ],\n        \"summary\": \"List Catalog Entries\",\n        \"description\": \"List every entry in the static MCP catalog.\\n\\nThis is what the Flutter Hub \\u2192 MCP Servers tab calls to\\npopulate the \\\"Browse\\\" view without having to do a search.\\nReturns a compact card-ready shape for each entry \\u2014 enough\\nto render a grid of installable servers.\\n\\nUse ``GET /api/mcp/catalog/{server_id}`` for the full\\nCatalogEntry with ``env_mapping`` + ``key_descriptions`` so\\nthe client can render the install form fields.\",\n        \"operationId\": \"list_catalog_entries_api_mcp_catalog_get\",\n        \"parameters\": [\n          {\n            \"name\": \"category\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"anyOf\": [\n                {\n                  \"type\": \"string\"\n                },\n                {\n                  \"type\": \"null\"\n                }\n              ],\n              \"title\": \"Category\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"type\": \"object\",\n                  \"additionalProperties\": true,\n                  \"title\": \"Response List Catalog Entries Api Mcp Catalog Get\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/mcp/catalog/{server_id}\": {\n      \"get\": {\n        \"tags\": [\n          \"mcp\"\n        ],\n        \"summary\": \"Get Catalog Entry Route\",\n        \"description\": \"Return the full static CatalogEntry for one server_id.\\n\\nThis is the endpoint the install form uses. It returns every\\nfield the client needs to render the correct form:\\n\\n- ``env_mapping``: which logical field name maps to which\\n  env var the subprocess expects (e.g. ``token`` \\u2192 ``GITHUB_PERSONAL_ACCESS_TOKEN``)\\n- ``key_descriptions``: human-readable help text per field,\\n  shown as TextField helperText\\n- ``oauth_provider`` + ``oauth_scopes``: when set, the\\n  server uses OAuth \\u2014 the client should show a \\\"Connect\\\"\\n  button instead of a text field\\n- ``default_env``: pre-filled env vars (e.g. Google Drive\\n  uses ``GOOGLE_APPLICATION_CREDENTIALS`` pointing at a\\n  credential file managed by the daemon)\\n\\nReturns 404 if ``server_id`` is not in the static catalog.\\nFor remote-registry entries the client should use the\\nsearch result fields directly (they do