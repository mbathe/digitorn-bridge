       \"description\": \"Reverse-proxy HTTP traffic to the app's dev server.\\n\\nFlutter points an iframe at ``/api/apps/{app_id}/preview-server/proxy/``\\nto render the dev UI inside the Digitorn admin panel. HMR websockets\\nuse the matching ``/preview-server/ws/{path:path}`` upgrade route.\",\n        \"operationId\": \"preview_server_proxy_api_apps__app_id__preview_server_proxy__path__options\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"path\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Path\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"patch\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Preview Server Proxy\",\n        \"description\": \"Reverse-proxy HTTP traffic to the app's dev server.\\n\\nFlutter points an iframe at ``/api/apps/{app_id}/preview-server/proxy/``\\nto render the dev UI inside the Digitorn admin panel. HMR websockets\\nuse the matching ``/preview-server/ws/{path:path}`` upgrade route.\",\n        \"operationId\": \"preview_server_proxy_api_apps__app_id__preview_server_proxy__path__options\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"path\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Path\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Preview Server Proxy\",\n        \"description\": \"Reverse-proxy HTTP traffic to the app's dev server.\\n\\nFlutter points an iframe at ``/api/apps/{app_id}/preview-server/proxy/``\\nto render the dev UI inside the Digitorn admin panel. HMR websockets\\nuse the matching ``/preview-server/ws/{path:path}`` upgrade route.\",\n        \"operationId\": \"preview_server_proxy_api_apps__app_id__preview_server_proxy__path__options\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"path\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Path\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"put\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Preview Server Proxy\",\n        \"description\": \"Reverse-proxy HTTP traffic to the app's dev server.\\n\\nFlutter points an iframe at ``/api/apps/{app_id}/preview-server/proxy/``\\nto render the dev UI inside the Digitorn admin panel. HMR websockets\\nuse the matching ``/preview-server/ws/{path:path}`` upgrade route.\",\n        \"operationId\": \"preview_server_proxy_api_apps__app_id__preview_server_proxy__path__options\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"path\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Path\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/widgets\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get Widgets\",\n        \"description\": \"Return the app's compiled widgets tree.\\n\\nFlutter calls this once on app open to render Z2 (chat_side) and\\nZ3 (workspace_tabs). Z1 (inline) and Z4 (modals) are addressable\\nby name via SSE / open_modal actions.\",\n        \"operationId\": \"get_widgets_api_apps__app_id__widgets_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/widgets/data/{binding}\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get Widget Data\",\n        \"description\": \"Resolve and return one named data binding from the app's widgets.\\n\\nThe widget tree references data via ``items: '{{sources}}'`` etc.\\nEach name maps to an entry under the zone's ``data:`` block:\\n\\n.. code-block:: yaml\\n\\n    widgets:\\n      chat_side:\\n        data:\\n          sources:\\n            type: http\\n            url: /rag/sources\\n            poll: 10s\\n\\nThe client calls ``GET /api/apps/{id}/widgets/data/sources`` to\\nhydrate the binding. Supported source types:\\n\\n- ``http``    \\u2014 HTTP request (relative to daemon, app-scoped)\\n- ``tool``    \\u2014 invoke a module action with args\\n- ``static``  \\u2014 return the value verbatim\\n- ``stream``  \\u2014 opens an SSE stream (delegated to the SSE route;\\n                this endpoint just returns a placeholder)\\n- ``local``   \\u2014 client-side only, returns the default value\\n\\nQuery params (any) are forwarded to HTTP source requests as the\\nrequest query string, and to tool source as additional args.\",\n        \"operationId\": \"get_widget_data_api_apps__app_id__widgets_data__binding__get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"binding\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Binding\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/widgets/upload\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Widgets Upload\",\n        \"description\": \"Generic multipart upload endpoint for ``file_upload`` widgets.\\n\\nStores the file under\\n``~/.local/share/digitorn/uploads/{user_id}/{session_id}/{file_id}/{filename}``\\nand returns a ``{file_id, url, size, content_type}`` payload the\\nclient can echo into the form value (so the next form submission\\nreferences the uploaded file by id, not by content).\\n\\nApps that need custom upload handling (validation, virus scan,\\nindexing) can provide their own ``upload_to.url`` in the\\n``file_upload`` primitive \\u2014 the daemon only handles the generic\\ncase when no custom URL is set.\",\n        \"operationId\": \"widgets_upload_api_apps__app_id__widgets_upload_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"multipart/form-data\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/Body_widgets_upload_api_apps__app_id__widgets_upload_post\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/widgets/upload/{user_id}/{sid}/{file_id}/{filename}\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Widgets Download\",\n        \"description\": \"Serve a previously uploaded file back to the client.\\n\\nPer-user scoped: only the owning user (or admin) can read it.\",\n        \"operationId\": \"widgets_download_api_apps__app_id__widgets_upload__user_id___sid___file_id___filename__get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"user_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"User Id\"\n            }\n          },\n          {\n            \"name\": \"sid\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Sid\"\n            }\n          },\n          {\n            \"name\": \"file_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"File Id\"\n            }\n          },\n          {\n            \"name\": \"filename\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Filename\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/widgets/data/{binding}/stream\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Stream Widget Data\",\n        \"description\": \"SSE bridge for ``type: stream`` data sources.\\n\\nThe widget's ``data: { live_metrics: { type: stream, url: ... } }``\\nblock declares an upstream URL serving SSE. The daemon proxies\\neach frame to the client so the dashboard updates live without\\na full re-fetch.\\n\\nTwo upstream contracts are supported:\\n\\n1. **SSE upstream** \\u2014 the URL serves ``text/event-stream``. The\\n   daemon parses ``data:`` lines and forwards them.\\n2. **HTTP poll upstream** \\u2014 the URL serves JSON. The daemon\\n   polls every ``poll`` seconds (from the data spec) and emits\\n   a frame per response.\\n\\nReducer hint (``replace`` / ``append`` / ``merge``) is sent in\\nthe first frame so the client knows how to integrate updates.\",\n        \"operationId\": \"stream_widget_data_api_apps__app_id__widgets_data__binding__stream_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"binding\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Binding\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/widgets/validate\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Validate Widgets\",\n        \"description\": \"Lint endpoint \\u2014 recompiles the widgets block and returns errors.\\n\\nUsed by the builder UI for live validation. Read-only \\u2014 does not\\nredeploy the app.\",\n        \"operationId\": \"validate_widgets_api_apps__app_id__widgets_validate_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/widgets/action\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Widgets Action\",\n        \"description\": \"Dispatch a user widget action.\\n\\nAction handling matrix:\\n\\n- ``tool``        \\u2192 run the named tool through the agent loop\\n- ``http``        \\u2192 execute an app-scoped HTTP call\\n- ``chat``        \\u2192 inject the message into the session as a user turn\\n- ``set_state``   \\u2192 mutate the per-session widget state map\\n- ``refresh``     \\u2192 re-fetch the listed data bindings\\n- ``sequence``    \\u2192 run multiple steps inside a single dispatch\\n- ``close`` / ``open_modal`` / ``open_workspace`` \\u2192 effect echo\\n  (the client handles the UI side; this just ACKs)\\n\\nThe route returns ``{ok, effect}`` so the client can chain\\nfollow-up actions (toast, refresh, navigation, \\u2026).\",\n        \"operationId\": \"widgets_action_api_apps__app_id__widgets_action_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/WidgetActionRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/interact\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Interact Widget\",\n        \"description\": \"Handle a bidirectional widget interaction from the frontend.\\n\\nRoutes the action to the module that owns the widget via the service bus.\\nThe module processes the action and can update state, which triggers\\nSSE events back to the frontend for live UI updates.\\n\\nThe module must implement a `widget_interact(widget, action, state)` method.\",\n        \"operationId\": \"interact_widget_api_apps__app_id__interact_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/InteractRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/disable\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Disable App\",\n        \"description\": \"Disable a scoped app install \\u2014 hide it + refuse interaction.\\n\\nScope resolution mirrors DELETE: the caller's JWT targets their\\nown user install by default. Admins can pass ``?scope=system`` to\\ndisable the system install instead.\\n\\nBuilt-in apps cannot be disabled.\",\n        \"operationId\": \"disable_app_api_apps__app_id__disable_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"scope\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"anyOf\": [\n                {\n                  \"type\": \"string\"\n                },\n                {\n                  \"type\": \"null\"\n                }\n              ],\n              \"title\": \"Scope\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"anyOf\": [\n                  {\n                    \"$ref\": \"#/components/schemas/DisableRequest\"\n                  },\n                  {\n                    \"type\": \"null\"\n                  }\n                ],\n                \"title\": \"Body\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/enable\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Enable App\",\n        \"description\": \"Re-enable a disabled app (ADMIN ONLY) and redeploy it.\\n\\nScope-aware: when ``?scope=user&user_id=<uid>`` is supplied the\\nadmin re-enables that user's install. Otherwise the system\\ninstall is targeted. Fails if the bundle was wiped.\",\n        \"operationId\": \"enable_app_api_apps__app_id__enable_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"scope\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"anyOf\": [\n                {\n                  \"type\": \"string\"\n                },\n                {\n                  \"type\": \"null\"\n                }\n              ],\n              \"title\": \"Scope\"\n            }\n          },\n          {\n            \"name\": \"user_id\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"anyOf\": [\n                {\n                  \"type\": \"string\"\n                },\n                {\n                  \"type\": \"null\"\n                }\n              ],\n              \"title\": \"User Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/approvals\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"List Approvals\",\n        \"description\": \"List pending approval requests for an app.\",\n        \"operationId\": \"list_approvals_api_apps__app_id__approvals_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/approve\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Resolve Approval\",\n        \"description\": \"Approve or deny a pending approval request.\",\n        \"operationId\": \"resolve_approval_api_apps__app_id__approve_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/ApprovalResolveRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/quota\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get App Quota\",\n        \"description\": \"Get current rate limit usage for an app.\",\n        \"operationId\": \"get_app_quota_api_apps__app_id__quota_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"put\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Set App Quota\",\n        \"description\": \"Set a custom rate limit for an app (requests per minute).\",\n        \"operationId\": \"set_app_quota_api_apps__app_id__quota_put\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/QuotaRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"delete\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Remove App Quota\",\n        \"description\": \"Remove custom rate limit (reverts to global default).\",\n        \"operationId\": \"remove_app_quota_api_apps__app_id__quota_delete\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/quota/user/{user_id}\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get User Quota\",\n        \"description\": \"Get rate limit usage for a specific user on an app.\",\n        \"operationId\": \"get_user_quota_api_apps__app_id__quota_user__user_id__get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"user_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"User Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"put\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Set User Quota\",\n        \"description\": \"Set a custom rate limit for a user on an app.\",\n        \"operationId\": \"set_user_quota_api_apps__app_id__quota_user__user_id__put\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"user_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"User Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/QuotaRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"delete\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Remove User Quota\",\n        \"description\": \"Remove custom quota for a user (reverts to app default).\",\n        \"operationId\": \"remove_user_quota_api_apps__app_id__quota_user__user_id__delete\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"user_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"User Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/reload\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Reload App\",\n        \"description\": \"Hot-reload a deployed app from its current bundle.\\n\\nUse this after updating a secret (e.g. rotating an API key) or when\\nyou want to force the in-memory instance to pick up persistent\\nchanges without restarting the whole daemon.\\n\\nWhat it does:\\n  - Re-reads the app's frozen bundle from disk\\n  - Re-reads the current secrets from the secret store\\n  - Stops the running in-memory instance (drops active sessions)\\n  - Rebuilds the app with the fresh secrets and puts it back in\\n    the pool of deployed apps\\n\\nWhat it does NOT do:\\n  - Does not modify any DB row (Application, AppBundle, AppProfile)\\n  - Does not change the bundle on disk\\n  - Does not bump the version\\n\\nPermission: ``apps:deploy`` (same as deploy, because reload is\\nfunctionally a redeploy of the same content).\",\n        \"operationId\": \"reload_app_api_apps__app_id__reload_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/secrets\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"List Secrets\",\n        \"description\": \"List secret key names for an app (values are never returned).\",\n        \"operationId\": \"list_secrets_api_apps__app_id__secrets_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"put\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Set Secrets Bulk\",\n        \"description\": \"Set many secrets in one request, then optionally hot-reload.\\n\\nThis is the convenience endpoint to use when rotating several keys\\nat the same time. It writes each secret through ``SecretStore``\\n(same code path as the per-key PUT) and then, if ``reload=true``\\n(the default), triggers a single ``reload_app`` so every new value\\ntakes effect together. Without bulk, rotating N keys would cost N\\nreloads which is wasteful and can momentarily break the app between\\ntwo updates.\",\n        \"operationId\": \"set_secrets_bulk_api_apps__app_id__secrets_put\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"reload\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"boolean\",\n              \"default\": true,\n              \"title\": \"Reload\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/SecretsBulkSetRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/required-secrets\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Required Secrets\",\n        \"description\": \"List the secrets the app's YAML REQUIRES and their current status.\\n\\nReturns everything the UI needs to render a \\\"manage credentials\\\"\\nscreen for an app with multiple providers:\\n\\n- ``key``       : the secret name (e.g. ``ANTHROPIC_API_KEY``)\\n- ``used_by``   : list of dotted YAML paths where the secret is\\n                  referenced \\u2014 so the UI can group by agent/module\\n                  or at least show \\\"this key is used in 2 places\\\"\\n- ``is_set``    : ``true`` if the secret is already defined in\\n                  ``SecretStore`` or matches an env var on the daemon\\n- ``reference_type``: ``\\\"env\\\"`` or ``\\\"secret\\\"`` depending on the\\n                  template style (``{{env.X}}`` vs ``{{secret.X}}``)\\n\\nThe response also includes:\\n\\n- ``missing_count`` : how many required secrets have no value yet\\n- ``unused_keys``   : secrets stored in SecretStore that are NOT\\n                     referenced by the current YAML (orphans from\\n                     an old version of the app \\u2014 the UI can offer\\n                     to clean them up)\\n\\nThis route reads from the app's **current bundle** on disk \\u2014 so the\\nlist reflects the deployed version, not the live memory state (they\\nshould match, but if someone fiddled with secrets manually the\\n``is_set`` column will reveal the drift).\",\n        \"operationId\": \"required_secrets_api_apps__app_id__required_secrets_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/secrets/{key}\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Check Secret\",\n        \"description\": \"Check if a secret exists (value is never returned).\",\n        \"operationId\": \"check_secret_api_apps__app_id__secrets__key__get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"key\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Key\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"put\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Set Secret\",\n        \"description\": \"Set (or update) an encrypted secret for an app.\\n\\nBy default the running app is **hot-reloaded** immediately so the\\nnew value takes effect without a daemon restart \\u2014 the typical use\\ncase is rotating an API key and wanting the next request to use it.\\nPass ``?reload=false`` when you want to stage multiple secret\\nupdates and trigger a single reload at the end via\\n``POST /api/apps/{app_id}/reload`` or the bulk ``PUT /secrets``.\",\n        \"operationId\": \"set_secret_api_apps__app_id__secrets__key__put\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"key\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Key\"\n            }\n          },\n          {\n            \"name\": \"reload\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"boolean\",\n              \"default\": true,\n              \"title\": \"Reload\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/SecretSetRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"delete\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Delete Secret\",\n        \"description\": \"Delete a secret.\",\n        \"operationId\": \"delete_secret_api_apps__app_id__secrets__key__delete\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"key\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Key\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/oauth/authorize\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Oauth Authorize\",\n        \"description\": \"Start an OAuth2 authorization flow for an MCP server.\\n\\nReturns the authorization URL the user should open in their browser.\",\n        \"operationId\": \"oauth_authorize_api_apps__app_id__oauth_authorize_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"server_id\",\n            \"in\": \"query\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Server Id\"\n            }\n          },\n          {\n            \"name\": \"session_id\",\n            \"in\": \"query\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Session Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/oauth/callback\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Oauth Callback\",\n        \"description\": \"OAuth2 callback endpoint \\u2014 exchanges authorization code for tokens.\\n\\nThis is the redirect_uri that the OAuth provider redirects to after\\nthe user authorizes. Exchanges the code for tokens and stores them.\",\n        \"operationId\": \"oauth_callback_api_apps__app_id__oauth_callback_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": 