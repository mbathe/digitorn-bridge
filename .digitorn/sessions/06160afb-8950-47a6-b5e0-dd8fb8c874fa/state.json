    }\n  }\n\n  return (\n    <div className=\"chat-panel\">\n      <div className=\"chat-header\">\n        <Bot size={20} />\n        <span>Assistant IA</span>\n      </div>\n      \n      <div className=\"chat-messages\">\n        {messages.map((message, index) => (\n          <div key={index} className={`message ${message.role}`}>\n            <div className=\"message-icon\">\n              {message.role === 'assistant' ? <Bot size={20} /> : <User size={20} />}\n            </div>\n            <div className=\"message-content\">\n              {message.content}\n            </div>\n          </div>\n        ))}\n        <div ref={messagesEndRef} />\n      </div>\n\n      <form className=\"chat-input-form\" onSubmit={handleSubmit}>\n        <input\n          type=\"text\"\n          className=\"chat-input\"\n          placeholder=\"Décrivez votre application...\"\n          value={input}\n          onChange={(e) => setInput(e.target.value)}\n        />\n        <button type=\"submit\" className=\"send-button\" disabled={!input.trim()}>\n          <Send size={20} />\n        </button>\n      </form>\n    </div>\n  )\n}\n\nexport default ChatPanel\n", "language": "jsx", "size": 1656, "lines": 63, "operation": "disk_sync", "updated_at": 1778628406.2948124, "validation": "approved", "baseline_lines": 62, "insertions": 0, "deletions": 0, "total_insertions": 63, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1778628073.2350156}, "src/components/ChatPanel.css": {"content": ".chat-panel {\n  width: 400px;\n  background: #13131a;\n  border-left: 1px solid #2a2a3a;\n  display: flex;\n  flex-direction: column;\n}\n\n.chat-header {\n  padding: 0.75rem 1rem;\n  border-bottom: 1px solid #2a2a3a;\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  color: #a78bfa;\n  font-weight: 600;\n}\n\n.chat-messages {\n  flex: 1;\n  overflow-y: auto;\n  padding: 1rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.message {\n  display: flex;\n  gap: 0.75rem;\n  animation: slideIn 0.3s ease-out;\n}\n\n@keyframes slideIn {\n  from {\n    opacity: 0;\n    transform: translateY(10px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.message.user {\n  flex-direction: row-reverse;\n}\n\n.message-icon {\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.message.assistant .message-icon {\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n  color: white;\n}\n\n.message.user .message-icon {\n  background: #2a2a3a;\n  color: #a78bfa;\n}\n\n.message-content {\n  background: #1a1a24;\n  padding: 0.75rem 1rem;\n  border-radius: 12px;\n  color: #e5e7eb;\n  line-height: 1.5;\n  max-width: 280px;\n}\n\n.message.user .message-content {\n  background: #a78bfa;\n  color: white;\n}\n\n.chat-input-form {\n  padding: 1rem;\n  border-top: 1px solid #2a2a3a;\n  display: flex;\n  gap: 0.5rem;\n}\n\n.chat-input {\n  flex: 1;\n  background: #1a1a24;\n  border: 1px solid #2a2a3a;\n  border-radius: 8px;\n  padding: 0.75rem;\n  color: #e5e7eb;\n  font-size: 14px;\n  outline: none;\n}\n\n.chat-input:focus {\n  border-color: #a78bfa;\n}\n\n.chat-input::placeholder {\n  color: #6b7280;\n}\n\n.send-button {\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n  color: white;\n  border: none;\n  padding: 0.75rem;\n  border-radius: 8px;\n  cursor: pointer;\n  transition: all 0.3s;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.send-button:hover:not(:disabled) {\n  transform: translateY(-2px);\n  box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);\n}\n\n.send-button:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.chat-messages::-webkit-scrollbar {\n  width: 8px;\n}\n\n.chat-messages::-webkit-scrollbar-track {\n  background: #13131a;\n}\n\n.chat-messages::-webkit-scrollbar-thumb {\n  background: #2a2a3a;\n  border-radius: 4px;\n}\n\n.chat-messages::-webkit-scrollbar-thumb:hover {\n  background: #3a3a4a;\n}\n", "language": "css", "size": 2395, "lines": 148, "operation": "disk_sync", "updated_at": 1778628406.2886825, "validation": "approved", "baseline_lines": 147, "insertions": 0, "deletions": 0, "total_insertions": 148, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1778628073.272592}, "src/main.tsx": {"content": "import React from 'react'\nimport ReactDOM from 'react-dom/client'\nimport App from './App'\nimport './index.css'\n\nReactDOM.createRoot(document.getElementById('root')!).render(\n  <React.StrictMode>\n    <App />\n  </React.StrictMode>,\n)\n", "language": "tsx", "size": 232, "lines": 11, "operation": "disk_sync", "updated_at": 1778628406.270691, "validation": "approved", "baseline_lines": 10, "insertions": 0, "deletions": 0, "total_insertions": 11, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1778628402.101076}, "src/App.tsx": {"content": "import React, { useState } from 'react';\nimport { \n  Code2, \n  Play, \n  MessageSquare, \n  Settings, \n  FileCode,\n  Sparkles,\n  Send\n} from 'lucide-react';\n\nconst App = () => {\n  const [code, setCode] = useState(`<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Mon App</title>\n  <style>\n    body {\n      font-family: system-ui, -apple-system, sans-serif;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      min-height: 100vh;\n      margin: 0;\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    }\n    .container {\n      background: white;\n      padding: 3rem;\n      border-radius: 20px;\n      box-shadow: 0 20px 60px rgba(0,0,0,0.3);\n      text-align: center;\n    }\n    h1 {\n      color: #667eea;\n      margin-bottom: 1rem;\n      font-size: 2.5rem;\n    }\n    p {\n      color: #666;\n      font-size: 1.2rem;\n    }\n    button {\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n      color: white;\n      border: none;\n      padding: 15px 30px;\n      font-size: 1rem;\n      border-radius: 10px;\n      cursor: pointer;\n      margin-top: 20px;\n      transition: transform 0.2s;\n    }\n    button:hover {\n      transform: scale(1.05);\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <h1>✨ Bienvenue sur Lovable Clone</h1>\n    <p>Commencez à créer votre application ici!</p>\n    <button onclick=\"alert('Bonjour! 👋')\">Cliquez-moi</button>\n  </div>\n</body>\n</html>`);\n\n  const [messages, setMessages] = useState([\n    { role: 'assistant', content: '👋 Bonjour! Je suis votre assistant IA. Que souhaitez-vous créer aujourd\\'hui?' }\n  ]);\n  const [input, setInput] = useState('');\n  const [activeTab, setActiveTab] = useState('code');\n\n  const handleSendMessage = () => {\n    if (!input.trim()) return;\n\n    const newMessages = [...messages, { role: 'user', content: input }];\n    setMessages(newMessages);\n\n    // Simulation de réponse IA\n    setTimeout(() => {\n      let response = '';\n      let newCode = code;\n\n      if (input.toLowerCase().includes('todo') || input.toLowerCase().includes('tâche')) {\n        response = '✅ Je crée une application de liste de tâches pour vous!';\n        newCode = `<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Liste de Tâches</title>\n  <style>\n    body {\n      font-family: system-ui, sans-serif;\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n      min-height: 100vh;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      margin: 0;\n      padding: 20px;\n    }\n    .app {\n      background: white;\n      border-radius: 20px;\n      padding: 2rem;\n      box-shadow: 0 20px 60px rgba(0,0,0,0.3);\n      width: 100%;\n      max-width: 500px;\n    }\n    h1 {\n      color: #667eea;\n      margin-bottom: 1.5rem;\n      text-align: center;\n    }\n    .input-group {\n      display: flex;\n      gap: 10px;\n      margin-bottom: 20px;\n    }\n    input {\n      flex: 1;\n      padding: 12px;\n      border: 2px solid #e0e0e0;\n      border-radius: 10px;\n      font-size: 1rem;\n    }\n    button {\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n      color: white;\n      border: none;\n      padding: 12px 24px;\n      border-radius: 10px;\n      cursor: pointer;\n      font-size: 1rem;\n    }\n    .task {\n      background: #f5f5f5;\n      padding: 15px;\n      border-radius: 10px;\n      margin-bottom: 10px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n    }\n    .delete-btn {\n      background: #ff4444;\n      padding: 8px 16px;\n      font-size: 0.9rem;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"app\">\n    <h1>📝 Ma Liste de Tâches</h1>\n    <div class=\"input-group\">\n      <input type=\"text\" id=\"taskInput\" placeholder=\"Nouvelle tâche...\">\n      <button onclick=\"addTask()\">Ajouter</button>\n    </div>\n    <div id=\"taskList\"></div>\n  </div>\n  <script>\n    function addTask() {\n      const input = document.getElementById('taskInput');\n      const task = input.value.trim();\n      if (!task) return;\n      \n      const taskList = document.getElementById('taskList');\n      const taskDiv = document.createElement('div');\n      taskDiv.className = 'task';\n      taskDiv.innerHTML = \\`\n        <span>\\${task}</span>\n        <button class=\"delete-btn\" onclick=\"this.parentElement.remove()\">Supprimer</button>\n      \\`;\n      taskList.appendChild(taskDiv);\n      input.value = '';\n    }\n    \n    document.getElementById('taskInput').addEventListener('keypress', (e) => {\n      if (e.key === 'Enter') addTask();\n    });\n  </script>\n</body>\n</html>`;\n      } else if (input.toLowerCase().includes('calculatrice')) {\n        response = '🧮 Je crée une calculatrice pour vous!';\n        newCode = `<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Calculatrice</title>\n  <style>\n    body {\n      font-family: system-ui, sans-serif;\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n      min-height: 100vh;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      margin: 0;\n    }\n    .calculator {\n      background: white;\n      border-radius: 20px;\n      padding: 2rem;\n      box-shadow: 0 20px 60px rgba(0,0,0,0.3);\n    }\n    .display {\n      background: #f5f5f5;\n      padding: 20px;\n      border-radius: 10px;\n      text-align: right;\n      font-size: 2rem;\n      margin-bottom: 1rem;\n      min-height: 60px;\n    }\n    .buttons {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 10px;\n    }\n    button {\n      padding: 20px;\n      font-size: 1.5rem;\n      border: none;\n      border-radius: 10px;\n      cursor: pointer;\n      background: #f5f5f5;\n      transition: all 0.2s;\n    }\n    button:hover {\n      background: #e0e0e0;\n      transform: scale(1.05);\n    }\n    .operator {\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n      color: white;\n    }\n    .equals {\n      background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);\n      color: white;\n      grid-column: span 2;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"calculator\">\n    <div class=\"display\" id=\"display\">0</div>\n    <div class=\"buttons\">\n      <button onclick=\"clearDisplay()\">C</button>\n      <button onclick=\"appendToDisplay('/')\" class=\"operator\">/</button>\n      <button onclick=\"appendToDisplay('*')\" class=\"operator\">×</button>\n      <button onclick=\"backspace()\">←</button>\n      <button onclick=\"appendToDisplay('7')\">7</button>\n      <button onclick=\"appendToDisplay('8')\">8</button>\n      <button onclick=\"appendToDisplay('9')\">9</button>\n      <button onclick=\"appendToDisplay('-')\" class=\"operator\">-</button>\n      <button onclick=\"appendToDisplay('4')\">4</button>\n      <button onclick=\"appendToDisplay('5')\">5</button>\n      <button onclick=\"appendToDisplay('6')\">6</button>\n      <button onclick=\"appendToDisplay('+')\" class=\"operator\">+</button>\n      <button onclick=\"appendToDisplay('1')\">1</button>\n      <button onclick=\"appendToDisplay('2')\">2</button>\n      <button onclick=\"appendToDisplay('3')\">3</button>\n      <button onclick=\"appendToDisplay('.')\">.</button>\n      <button onclick=\"appendToDisplay('0')\">0</button>\n      <button onclick=\"calculate()\" class=\"equals\">=</button>\n    </div>\n  </div>\n  <script>\n    let display = document.getElementById('display');\n    let currentValue = '0';\n    \n    function appendToDisplay(value) {\n      if (currentValue === '0') currentValue = '';\n      currentValue += value;\n      display.textContent = currentValue;\n    }\n    \n    function clearDisplay() {\n      currentValue = '0';\n      display.textContent = currentValue;\n    }\n    \n    function backspace() {\n      currentValue = currentValue.slice(0, -1) || '0';\n      display.textContent = currentValue;\n    }\n    \n    function calculate() {\n      try {\n        currentValue = eval(currentValue).toString();\n        display.textContent = currentValue;\n      } catch {\n        display.textContent = 'Erreur';\n        currentValue = '0';\n      }\n    }\n  </script>\n</body>\n</html>`;\n      } else {\n        response = 'Je peux vous aider à créer différentes applications! Essayez de me demander:\\n\\n• \"Créer une liste de tâches\"\\n• \"Faire une calculatrice\"\\n• \"Générer un compteur\"';\n      }\n\n      setMessages([...newMessages, { role: 'assistant', content: response }]);\n 