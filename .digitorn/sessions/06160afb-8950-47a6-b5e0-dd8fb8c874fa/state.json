se_provider\n      reason: Prevent the agent from pausing channel providers\n    - module: channels\n      actions:\n      - resume_provider\n      reason: Prevent the agent from resuming channel providers\n    - module: channels\n      actions:\n      - simulate_event\n      reason: Prevent the agent from injecting synthetic events\n", "language": "yaml", "size": 1554, "lines": 62, "operation": "disk_sync", "updated_at": 1778628125.840758, "validation": "approved", "baseline_lines": 61, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4222403}, "examples/channels/32-three-triggers-three-agents.yaml": {"content": "app:\n  app_id: channels-32-three-triggers\n  name: Three Triggers\nruntime:\n  mode: background\nagents:\n- id: monitor\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: Health monitor. Report 'all clear' on heartbeat. Start with [MONITOR].\n- id: doc_processor\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: Documentation processor. Read files and summarize. Start with [DOC].\n- id: deployer\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: Deploy agent. Handle deployment events. Start with [DEPLOY].\ntools:\n  modules:\n    filesystem:\n      constraints:\n        paths:\n        - /tmp/channels-test/docs\n    channels:\n      config:\n        providers:\n          heartbeat:\n            adapter: cron\n            config:\n              schedule: '* * * * *'\n            activation:\n              agent: monitor\n              message: Run a heartbeat check.\n          doc_watcher:\n            adapter: file_watcher\n            config:\n              paths:\n              - /tmp/channels-test/docs/*.md\n              poll_interval: 3\n            activation:\n              agent: doc_processor\n              message: 'New doc: {{event.payload.filename}}. Read and summarize it.'\n          deploy_hook:\n            adapter: webhook\n            config:\n              inbound_path: /hook/deploy\n            activation:\n              agent: deployer\n              message: 'Deploy event: {{event.payload.action}} version {{event.payload.version}}'\n", "language": "yaml", "size": 1855, "lines": 66, "operation": "disk_sync", "updated_at": 1778628125.8568645, "validation": "approved", "baseline_lines": 65, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4222403}, "examples/channels/33-full-pipeline.yaml": {"content": "app:\n  app_id: channels-33-full-pipeline\n  name: Full Pipeline\nruntime:\n  mode: background\nagents:\n- id: tech_agent\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'Technical support agent. Start with [TECH]. Use the client context.\n\n    After resolving, log to the audit channel.\n\n    '\n- id: billing_agent\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'Billing support agent. Start with [BILLING]. Use the client context.\n\n    '\n- id: general_agent\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: General support. Start with [GENERAL].\ntools:\n  modules:\n    database:\n      setup:\n      - action: connect\n        params:\n          connection_id: test_db\n          driver: sqlite\n          url: sqlite:///tmp/channels-test/test.db\n    channels:\n      config:\n        providers:\n          tickets:\n            adapter: webhook\n            config:\n              inbound_path: /hook/tickets\n            activation:\n              filter:\n              - field: event.payload.status\n                equals: new\n              prepare:\n              - action: database.fetch_results\n                params:\n                  query: SELECT name, plan, dept FROM clients WHERE id = {{event.payload.client_id}}\n                as: client\n              route:\n                field: client.0.dept\n                rules:\n                - match: tech\n                  agent: tech_agent\n                - match: billing\n                  agent: billing_agent\n                - default: true\n                  agent: general_agent\n              context: 'Client: {{client.0.name}} (plan: {{client.0.plan}}, dept:\n                {{client.0.dept}})\n\n                '\n              message: '{{event.payload.message}}'\n              session: ticket-{{event.payload.client_id}}\n          audit:\n            adapter: log\n            config:\n              level: info\n              logger: digitorn.audit\n  capabilities:\n    grant:\n    - module: channels\n      actions:\n      - send_message\n      reason: Send audit log entries after processing support tickets\n    - module: channels\n      actions:\n      - list_providers\n      reason: Discover available channel providers\n", "language": "yaml", "size": 2585, "lines": 95, "operation": "disk_sync", "updated_at": 1778628125.8860426, "validation": "approved", "baseline_lines": 94, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4222403}, "examples/channels/34-monitoring-station.yaml": {"content": "app:\n  app_id: channels-34-monitoring\n  name: Monitoring Station\nruntime:\n  mode: background\nagents:\n- id: monitor\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'You are an infrastructure monitoring agent. You:\n\n    - Run periodic health checks and record results in the database\n\n    - Watch for config file changes and report them\n\n    - Handle external alerts from monitoring systems\n\n    - Send important notifications to the \"alerts\" channel\n\n\n    Always use channels.send_message(provider=\"alerts\", text=\"...\") for notifications.\n\n    '\ntools:\n  modules:\n    filesystem:\n      constraints:\n        paths:\n        - /tmp/channels-test/monitoring\n        - /tmp/channels-test/config\n    database:\n      setup:\n      - action: connect\n        params:\n          connection_id: monitoring_db\n          driver: sqlite\n          url: sqlite:///tmp/channels-test/monitoring.db\n    memory: {}\n    channels:\n      config:\n        default_agent: monitor\n        max_turns: 15\n        timeout: 60\n        providers:\n          health_check:\n            adapter: cron\n            config:\n              schedule: '* * * * *'\n            activation:\n              message: 'Run a health check:\n\n                1. Check if /tmp/channels-test/monitoring/ directory is accessible\n                (filesystem.ls)\n\n                2. Insert a check record into the database\n\n                3. Send a status summary to the \"alerts\" channel\n\n                '\n          config_watcher:\n            adapter: file_watcher\n            config:\n              paths:\n              - /tmp/channels-test/config/*\n              poll_interval: 5\n            activation:\n              message: 'Config file changed: {{event.payload.filename}}\n\n                1. Read the file content\n\n                2. Report what changed\n\n                3. Log it to the \"alerts\" channel\n\n                '\n          external_alerts:\n            adapter: webhook\n            config:\n              inbound_path: /hook/alerts\n            activation:\n              filter:\n              - field: event.payload.severity\n                not_equals: info\n              context: 'External alert from {{event.payload.source}}: {{event.payload.alert}}'\n              message: 'Handle this alert: {{event.payload.alert}} (severity: {{event.payload.severity}})'\n          alerts:\n            adapter: log\n            config:\n              level: warning\n              logger: digitorn.monitoring.alerts\n  capabilities:\n    grant:\n    - module: channels\n      actions:\n      - send_message\n      reason: Send health check and alert notifications to the alerts channel\n    - module: channels\n      actions:\n      - list_providers\n      reason: Discover available channel providers\n    - module: channels\n      actions:\n      - stats\n      reason: Read channel delivery statistics for monitoring reports\n", "language": "yaml", "size": 2996, "lines": 110, "operation": "disk_sync", "updated_at": 1778628125.9057636, "validation": "approved", "baseline_lines": 109, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4222403}, "examples/channels/35-it-support-center.yaml": {"content": "app:\n  app_id: channels-35-support\n  name: IT Support Center\n  description: Multi-channel IT support with routing, enrichment, and specialized\n    agents\nruntime:\n  mode: background\nagents:\n- id: receptionist\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'You are the IT support receptionist. Start your responses with [RECEPTIONIST].\n\n    - Greet the client by name (from context)\n\n    - Assess the issue based on their message and open tickets\n\n    - If the client is premium, prioritize their request\n\n    - For simple issues, resolve directly using the procedures\n\n    - For complex issues, acknowledge and explain next steps\n\n    - Send important updates to the \"notifications\" channel\n\n    '\n- id: network_expert\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'You are the network specialist. Start responses with [NETWORK].\n\n    - Diagnose VPN, DNS, firewall, and connectivity issues\n\n    - Reference the IT procedures from context\n\n    - Check client''s open tickets for related issues\n\n    - Insert a new ticket record in the database when needed\n\n    - Send resolution to \"notifications\"\n\n    '\n- id: software_expert\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'You are the software specialist. Start responses with [SOFTWARE].\n\n    - Handle software installation, configuration, and crash issues\n\n    - Check client''s history for recurring problems\n\n    '\n- id: monitor\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'You are the monitoring agent. Start responses with [MONITOR].\n\n    - For daily checks: query the database and report ticket stats\n\n    - For alerts: assess severity and suggest remediation\n\n    - Always send summaries to the \"notifications\" channel\n\n    '\n- id: file_analyst\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'You are the file analyst. Start responses with [FILE].\n\n    - Read uploaded files using filesystem.read\n\n    - Analyze content (logs, reports, data)\n\n    - Report findings\n\n    '\ntools:\n  modules:\n    filesystem:\n      constraints:\n        paths:\n        - /tmp/channels-test/support-docs\n        - /tmp/channels-test/uploads\n    database:\n      setup:\n      - action: connect\n        params:\n          connection_id: support_db\n          driver: sqlite\n          url: sqlite:///tmp/channels-test/support.db\n    memory: {}\n    channels:\n      config:\n        default_agent: receptionist\n        max_turns: 20\n        timeout: 90\n        secret_filter_enabled: true\n        providers:\n          daily_check:\n            adapter: cron\n            config:\n              schedule: '* * * * *'\n            activation:\n              agent: monitor\n              message: 'Daily check:\n\n                1. Query the database for open tickets: SELECT id, title, status,\n                created_at FROM tickets WHERE status=''open''\n\n                2. Report how many open tickets exist\n\n                3. Send a summary to the \"notifications\" channel\n\n                '\n          upload_watcher:\n            adapter: file_watcher\n            config:\n              paths:\n              - /tmp/channels-test/uploads/*\n              poll_interval: 5\n            activation:\n              agent: file_analyst\n              message: 'New upload: {{event.payload.filename}} ({{event.payload.size}}\n                bytes). Read and analyze the file.'\n          support_tickets:\n            adapter: webhook\n            config:\n              inbound_path: /hook/support\n            activation:\n              filter:\n              - field: event.payload.status\n                equals: new\n              prepare:\n              - action: database.fetch_results\n                params:\n                  query: SELECT name, email, plan, department FROM clients WHERE id\n                    = {{event.payload.client_id}}\n                as: client\n              - action: database.fetch_results\n                params:\n                  query: SELECT id, title, status FROM tickets WHERE client_id = {{event.payload.client_id}}\n                    AND status = 'open'\n                as: open_tickets\n              - action: filesystem.read\n                params:\n                  path: /tmp/channels-test/support-docs/procedures.txt\n                as: procedures\n              route:\n                field: event.payload.category\n                rules:\n                - match: network\n                  agent: network_expert\n                - match: software\n                  agent: software_expert\n                - default: true\n                  agent: receptionist\n              session: ticket-{{event.payload.client_id}}\n              context: 'Client: {{client.0.name}} ({{client.0.email}})\n\n                Plan: {{client.0.plan}} | Department: {{client.0.department}}\n\n                Open tickets: {{open_tickets}}\n\n                IT Procedures: {{procedures}}\n\n                '\n              message: '{{event.payload.message}}'\n          monitoring:\n            adapter: webhook\n            config:\n              inbound_path: /hook/monitoring\n            activation:\n              filter:\n              - field: event.payload.severity\n                not_equals: info\n              agent: monitor\n              context: 'ALERT from {{event.payload.source}}: {{event.payload.alert}}\n                ({{event.payload.severity}})'\n              message: 'Handle this alert immediately: {{event.payload.alert}}'\n          notifications:\n            adapter: log\n            config:\n              level: warning\n              logger: digitorn.support.notifications\n  capabilities:\n    grant:\n    - module: channels\n      actions:\n      - send_message\n      reason: Send ticket updates and alerts to the notifications channel\n    - module: channels\n      actions:\n      - list_providers\n      reason: Discover available channel providers\n    - module: channels\n      actions:\n      - stats\n      reason: Read channel delivery statistics for monitoring reports\n    - module: channels\n      actions:\n      - provider_history\n      reason: Access provider message history for audit and diagnostics\n", "language": "yaml", "size": 6763, "lines": 228, "operation": "disk_sync", "updated_at": 1778628125.9362166, "validation": "approved", "baseline_lines": 227, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4222403}, "examples/channels/36-gmail-live.yaml": {"content": "app:\n  app_id: channels-36-gmail\n  name: Gmail Live Test\nruntime:\n  mode: background\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'Tu es un assistant email intelligent. Tu reponds aux emails de maniere\n\n    concise, professionnelle et utile. Tu signes \"Digitorn Assistant\".\n\n    '\ntools:\n  modules:\n    channels:\n      config:\n        default_agent: main\n        max_turns: 10\n        timeout: 60\n        providers:\n          gmail_inbox:\n            adapter: email\n            config:\n              imap:\n                host: imap.gmail.com\n                port: 993\n                user: '{{env.GMAIL_ADDRESS}}'\n                password: '{{secret.GMAIL_APP_PASSWORD}}'\n                folder: INBOX\n              smtp:\n                host: smtp.gmail.com\n                port: 587\n                user: '{{env.GMAIL_ADDRESS}}'\n                password: '{{secret.GMAIL_APP_PASSWORD}}'\n              from_address: '{{env.GMAIL_ADDRESS}}'\n              poll_interval: 30\n            activation:\n              message: 'New email from {{event.payload.from}}:\n\n                Subject: {{event.payload.subject}}\n\n\n                {{event.payload.body}}\n\n                '\n              context: 'You received this email at {{event.timestamp}}.\n\n                Reply concisely and helpfully. Sign as \"Digitorn Assistant\".\n\n                '\n              reply: auto\n              session: email-{{event.payload.from}}\n", "language": "yaml", "size": 1584, "lines": 60, "operation": "disk_sync", "updated_at": 1778628125.9601917, "validation": "approved", "baseline_lines": 59, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4378786}, "examples/channels/37-telegram-live.yaml": {"content": "app:\n  app_id: channels-37-telegram\n  name: Telegram Bot Live\nruntime:\n  mode: background\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'Tu es un assistant Telegram intelligent et amical.\n\n    Tu reponds de maniere concise. Tu peux utiliser du Markdown basique.\n\n    Tu te souviens du contexte de la conversation (session partagee par chat).\n\n    '\ntools:\n  modules:\n    channels:\n      config:\n        default_agent: main\n        max_turns: 10\n        timeout: 60\n        providers:\n          telegram_bot:\n            adapter: telegram\n            config:\n              token: '{{secret.TELEGRAM_BOT_TOKEN}}'\n              poll_timeout: 30\n            activation:\n              message: '{{event.payload.text}}'\n              context: 'Telegram user: {{event.payload.display_name}} (chat {{event.payload.chat_id}})\n\n                Chat type: {{event.payload.chat_type}}\n\n                '\n              reply: auto\n              session: tg-{{event.payload.chat_id}}\n", "language": "yaml", "size": 1133, "lines": 44, "operation": "disk_sync", "updated_at": 1778628125.9814618, "validation": "approved", "baseline_lines": 43, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4378786}, "examples/channels/38-cron-mcp-filesystem.yaml": {"content": "app:\n  app_id: channels-38-cron-mcp\n  name: Cron + MCP Filesystem\nruntime:\n  mode: background\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'Tu es un agent de monitoring. Quand tu recois une alerte cron,\n\n    utilise les outils MCP filesystem pour lire le contenu du dossier\n\n    et faire un rapport concis.\n\n    '\ntools:\n  modules:\n    mcp:\n      config:\n        servers:\n          filesystem:\n            command: npx\n            args:\n            - -y\n            - '@modelcontextprotocol/server-filesystem'\n            - /tmp/digitorn-mcp-test\n            sandbox:\n              permissions:\n              - '*'\n    channels:\n      config:\n        default_agent: main\n        max_turns: 10\n        timeout: 60\n        providers:\n          check:\n            adapter: cron\n            config:\n              schedule: '* * * * *'\n              message: Periodic directory check\n            activation:\n              message: 'Time for your periodic check.\n\n                Use the MCP filesystem tools to list and read files in /tmp/digitorn-mcp-test/.\n\n                Summarize what you find in 2-3 sentences.\n\n                '\n              reply: none\n", "language": "yaml", "size": 1322, "lines": 56, "operation": "disk_sync", "updated_at": 1778628125.9982686, "validation": "approved", "baseline_lines": 55, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4378786}, "examples/channels/39-discord-live.yaml": {"content": "app:\n  app_id: channels-39-discord\n  name: Discord Bot Live\nruntime:\n  mode: background\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'Tu es un assistant Discord intelligent et amical.\n\n    Tu reponds de maniere concise. Tu peux utiliser du Markdown Discord.\n\n    Tu te souviens du contexte de la conversation (session par channel).\n\n    '\ntools:\n  modules:\n    channels:\n      config:\n        default_agent: main\n        max_turns: 10\n        timeout: 60\n        providers:\n          discord_bot:\n            adapter: discord\n            config:\n              token: '{{secret.DISCORD_BOT_TOKEN}}'\n            activation:\n              message: '{{event.payload.text}}'\n              context: 'Discord user: {{event.payload.display_name}} (@{{event.payload.username}})\n\n                Channel: {{event.payload.channel_id}} | Server: {{event.payload.guild_id}}\n\n                '\n              reply: auto\n              session: discord-{{event.payload.channel_id}}\n", "language": "yaml", "size": 1130, "lines": 43, "operation": "disk_sync", "updated_at": 1778628126.0216627, "validation": "approved", "baseline_lines": 42, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4378786}, "examples/channels/40-slack-live.yaml": {"content": "app:\n  app_id: channels-40-slack\n  name: Slack Bot Live\nruntime:\n  mode: background\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'Tu es un assistant Slack intelligent et concis.\n\n    Tu reponds dans le thread du message. Tu peux utiliser le format mrkdwn de Slack.\n\n    Tu te souviens du contexte de la conversation (session par channel).\n\n    '\ntools:\n  modules:\n    channels:\n      config:\n        default_agent: main\n        max_turns: 10\n        timeout: 60\n        providers:\n          slack_bot:\n            adapter: slack\n            config:\n              bot_token: '{{secret.SLACK_BOT_TOKEN}}'\n              app_token: '{{secret.SLACK_APP_TOKEN}}'\n            activation:\n              message: '{{event.payload.text}}'\n              context: 'Slack user: {{event.payload.user_id}}\n\n                Channel: {{event.payload.channel_id}} ({{event.payload.channel_type}})\n\n                '\n              reply: auto\n              session: slack-{{event.payload.channel_id}}\n", "language": "yaml", "size": 1146, "lines": 44, "operation": "disk_sync", "updated_at": 1778628126.0274177, "validation": "approved", "baseline_lines": 43, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4378786}, "examples/channels/41-voice-twilio.yaml": {"content": "app:\n  app_id: channels-41-voice\n  name: Voice Agent (Twilio)\nruntime:\n  mode: background\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'Tu es un assistant telephonique. Tu parles naturellement, de maniere\n\n    concise et claire. Pas de markdown ni de formatage - c''est une\n\n    conversation vocale. Reponds en 1-2 phrases maximum.\n\n    '\ntools:\n  modules:\n    channels:\n      config:\n        default_agent: main\n        max_turns: 10\n        timeout: 60\n        providers:\n          phone:\n            adapter: voice\n            config:\n              backend: twilio_cr\n              language: fr\n              welcome: Bonjour, je suis l'assistant Digitorn. Comment puis-je vous\n                aider ?\n              backend_config:\n                port: 8765\n                tts_provider: google\n                stt_provider: deepgram\n                voice: fr-FR-Standard-A\n                interruptible: speech\n            activation:\n              message: '{{event.payload.transcript}}'\n              context: 'Voice call from {{event.payload.caller}}.\n\n                Direction: {{event.payload.direction}}.\n\n                Language: {{event.payload.language}}.\n\n                Respond naturally and concisely - this is a phone conversation.\n\n                '\n              reply: auto\n              session: call-{{event.payload.call_id}}\n", "language": "yaml", "size": 1516, "lines": 56, "operation": "disk_sync", "updated_at": 1778628126.0482209, "validation": "approved", "baseline_lines": 55, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4378786}, "examples/channels/42-voice-websocket.yaml": {"content": "app:\n  app_id: channels-42-voice-ws\n  name: Voice Agent (WebSocket)\nruntime:\n  mode: background\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'Tu es un assistant vocal. Reponds de maniere concise et naturelle.\n\n    Pas de markdown - c''est une conversation vocale.\n\n    '\ntools:\n  modules:\n    channels:\n      config:\n        default_agent: main\n        max_turns: 10\n        timeout: 60\n        providers:\n          voice_ws:\n            adapter: voice\n            config:\n              backend: websocket\n              language: fr\n              welcome: Bonjour, je suis l'assistant Digitorn.\n              backend_config:\n                port: 8766\n                tts:\n                  provider: edge\n                  voice: fr-FR-DeniseNeural\n                  rate: +5%\n            activation:\n              message: '{{event.payload.transcript}}'\n              reply: auto\n              session: call-{{event.payload.call_id}}\n", "language": "yaml", "size": 1100, "lines": 44, "operation": "disk_sync", "updated_at": 1778628126.0663095, "validation": "approved", "baseline_lines": 43, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4378786}, "examples/channels/43-discord-fullstack.yaml": {"content": "app:\n  app_id: channels-43-discord-full\n  name: Discord Support Bot\nruntime:\n  mode: background\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'Tu es un bot de support Discord pour Digitorn.\n\n    Tu as acces a:\n\n    - Une base de donnees SQLite avec les tables ''clients'' et ''tickets''\n\n    - Le systeme de fichiers dans /tmp/digitorn-demo/\n\n\n    Utilise database.sql pour les requetes SQL.\n\n    Utilise filesystem.read pour lire les fichiers.\n\n    Reponds en francais, de maniere concise.\n\n    '\ntools:\n  modules:\n    filesystem:\n      constraints:\n        paths:\n        - /tmp/digitorn-demo\n    database:\n      setup:\n      - action: connect\n        params:\n          connection_id: main\n          driver: sqlite\n          url: sqlite:///tmp/digitorn-demo/app.db\n    channels:\n      config:\n        default_agent: main\n        max_turns: 15\n        timeout: 90\n        providers:\n          discord:\n            adapter: discord\n            config:\n              token: '{{secret.DISCORD_BOT_TOKEN}}'\n            activation:\n              message: '{{event.payload.text}}'\n              context: 'Discord user: {{event.payload.display_name}}'\n              reply: auto\n              session: discord-{{event.payload.channel_id}}\n", "language": "yaml", "size": 1395, "lines": 59, "operation": "disk_sync", "updated_at": 1778628126.0874455, "validation": "approved", "baseline_lines": 58, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4378786}, "examples/channels/44-call-center.yaml": {"content": "app:\n  app_id: call-center\n  name: Digitorn Call Center\n  description: 'Multi-channel support center: chat (Discord) + voice + knowledge base\n    + tickets DB'\nruntime:\n  mode: background\nagents:\n- id: support\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: 'Tu es l''agent de support du call center Digitorn. Tu geres les demandes\n\n    clients par chat et par telephone.\n\n\n    TES OUTILS:\n\n    - database.sql: requeter la base clients et tickets (tables: clients, tickets)\n\n    - filesystem.read: lire les procedures dans /tmp/digitorn-callcenter/kb/\n\n\n    REGLES:\n\n    1. Identifie le client (demande son nom ou email si necessaire)\n\n    2. Verifie son plan (free/premium/enterprise) pour adapter le niveau de service\n\n    3. Consulte les procedures dans la base de connaissances\n\n    4. Cree ou mets a jour les tickets si necessaire\n\n    5. Enterprise = priorite haute, SLA 4h\n\n    6. Pour le canal vocal: reponds de maniere concise (1-2 phrases)\n\n    7. Pour le chat: tu peux etre plus detaille\n\n\n    EXEMPLES DE REQUETES SQL:\n\n    - SELECT * FROM clients WHERE name LIKE ''%Alice%''\n\n    - SELECT * FROM tickets WHERE client_id = 1 AND status = ''open''\n\n    - INSERT INTO tickets(client_id, subject, category, status, priority) VALUES(...)\n\n    - UPDATE tickets SET status = ''resolved'', notes = ''...'' WHERE id = ...\n\n    '\ntools:\n  modules:\n    filesystem:\n      constraints:\n        paths:\n        - /tmp/digitorn-callcenter/kb\n    database:\n      setup:\n      - action: connect\n        params:\n          connection_id: main\n          driver: sqlite\n          url: sqlite:///tmp/digitorn-callcenter/callcenter.db\n    channels:\n      config:\n        default_agent: support\n        max_turns: 20\n        timeout: 90\n        providers:\n          chat:\n            adapter: discord\n            config:\n              token: '{{secret.DISCORD_BOT_TOKEN}}'\n            activation:\n              message: '{{event.payload.text}}'\n              context: 'Canal: Chat Discord\n\n                Utilisateur: {{event.payload.display_name}} (@{{event.payload.username}})\n\n                '\n              reply: auto\n              session: chat-{{event.payload.author_id}}\n          phone:\n            adapter: voice\n            config:\n              backend: websocket\n              language: fr\n              welcome: Bonjour, bienvenue au support Digitorn. Comment puis-je vous\n                aider ?\n              backend_config:\n                port: 8767\n                tts:\n                  provider: edge\n                  voice: fr-FR-DeniseNeural\n                  rate: +3%\n            activation:\n              message: '{{event.payload.transcript}}'\n              context: 'Canal: Appel telephonique\n\n                Appelant: {{event.payload.caller}}\n\n                '\n              reply: auto\n              session: phone-{{event.payload.call_id}}\n", "language": "yaml", "size": 3006, "lines": 111, "operation": "disk_sync", "updated_at": 1778628126.1101213, "validation": "approved", "baseline_lines": 110, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4378786}, "examples/channels/45-callcenter-glpi.yaml": {"content": "app:\n  app_id: callcenter-glpi\n  name: Call Center + GLPI\n  description: Multi-channel support center integrated with GLPI ticketing\nruntime:\n  mode: background\nagents:\n- id: support\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: \"Tu es l'agent de support du call center Digitorn, connecte a GLPI.\\n\\nOUTILS\\\n    \\ DISPONIBLES:\\n1. http.request - pour interroger l'API GLPI:\\n   - Lister les\\\n    \\ tickets: GET http://localhost:9080/apirest.php/Ticket\\n   - Voir un ticket:\\\n    \\ GET http://localhost:9080/apirest.php/Ticket/{id}\\n   - Creer un ticket: POST\\\n    \\ http://localhost:9080/apirest.php/Ticket avec body JSON {\\\"name\\\":\\\"...\\\", \\\"\\\n    user\\\":\\\"...\\\"}\\n   - Lister les assets: GET http://localhost:9080/apirest.php/Computer\\n\\\n    \\   - Rechercher: GET http://localhost:9080/apirest.php/search?q=motcle\\n\\n2.\\\n    \\ filesystem.read - lire les procedures dans /tmp/digitorn-callcenter/kb/\\n\\n\\\n    PROCEDURE:\\n1. Identifie le client et son probleme\\n2. Cherche dans GLPI s'il\\\n    \\ a des tickets existants\\n3. Consulte les procedures si besoin\\n4. Cree ou mets\\\n    \\ a jour un ticket GLPI si necessaire\\n5. Reponds de maniere concise (surtout\\\n    \\ au telephone)\\n\"\ntools:\n  modules:\n    http:\n      constraints:\n        allowed_hosts:\n        - localhost\n        - 127.0.0.1\n    filesystem:\n      constraints:\n        paths:\n        - /tmp/digitorn-callcenter/kb\n    channels:\n      config:\n        default_agent: support\n        max_turns: 20\n        timeout: 90\n        providers:\n          chat:\n            adapter: discord\n            config:\n              token: '{{secret.DISCORD_BOT_TOKEN}}'\n            activation:\n              message: '{{event.payload.text}}'\n              context: 'Canal: Discord | User: {{event.payload.display_name}}'\n              reply: auto\n              session: chat-{{event.payload.author_id}}\n          phone:\n            adapter: voice\n            config:\n              backend: websocket\n              language: fr\n              welcome: Support Digitorn, comment puis-je vous aider ?\n              backend_config:\n                port: 8767\n                tts:\n                  provider: edge\n                  voice: fr-FR-DeniseNeural\n            activation:\n              message: '{{event.payload.transcript}}'\n              context: 'Canal: Telephone'\n              reply: auto\n              session: phone-{{event.payload.call_id}}\ndev:\n  variables:\n    glpi_url: http://localhost:9080\n", "language": "yaml", "size": 2597, "lines": 73, "operation": "disk_sync", "updated_at": 1778628126.1362376, "validation": "approved", "baseline_lines": 72, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4378786}, "examples/channels/voice-test.html": {"content": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Digitorn Voice — Full Duplex</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body { font-family: system-ui, sans-serif; background: #0a0a12; color: #f0f0f4; height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; }\n  #status { font-size: 14px; color: #737373; margin-bottom: 24px; }\n  #mic { width: 120px; height: 120px; border-radius: 50%; border: 3px solid #333; background: #141414; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }\n  #mic:hover { border-color: #555; }\n  #mic.listening { border-color: #ef4444; background: #1a0a0a; animation: pulse 1.5s infinite; }\n  #mic.speaking { border-color: #2b7fff; background: #0a0a1a; }\n  #mic svg { width: 48px; height: 48px; fill: #737373; transition: fill 0.2s; }\n  #mic.listening svg { fill: #ef4444; }\n  #mic.speaking svg { fill: #2b7fff; }\n  @keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(239,68,68,0.3); } 50% { box-shadow: 0 0 0 20px rgba(239,68,68,0); } }\n  #transcript { margin-top: 32px; max-width: 500px; text-align: center; min-height: 60px; }\n  #transcript .user { color: #737373; font-size: 14px; margin-bottom: 8px; }\n  #transcript .agent { color: #f0f0f4; font-size: 16px; }\n  #log { position: fixed; bottom: 16px; left: 16px; right: 16px; max-height: 120px; overflow-y: auto; font-size: 11px; color: #555; font-family: monospace; }\n  .mode { position: fixed; top: 16px; right: 16px; font-size: 11px; color: #2b7fff; }\n</style>\n</head>\n<body>\n\n<div class=\"mode\">Full-Duplex Streaming</div>\n<div id=\"status\">Connexion...</div>\n\n<div id=\"mic\" onclick=\"toggleMic()\">\n  <svg viewBox=\"0 0 24 24\"><path d=\"M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm-1-9c0-.55.45-1 1-1s1 .45 1 1v6c0 .55-.45 1-1 1s-1-.45-1-1V5zm6 6c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z\"/></svg>\n</div>\n\n<div id=\"transcript\">\n  <div class=\"user\" id=\"userText\"></div>\n  <div class=\"agent\" id=\"agentText\"></div>\n</div>\n\n<div id=\"log\"></div>\n\n<script>\nconst WS_URL = 'ws://localhost:8766/voice'; // Change port to match your app\nlet ws = null;\nlet recognition = null;\nlet listening = false;\nlet callId = '';\n\n// Full-duplex audio: play chunks as they arrive (don't wait for all)\nlet audioCtx = null;\nlet audioQueue = [];      // Queue of ArrayBuffers to play\nlet isPlaying = false;\nlet isSpeaking = false;\n\nfunction log(msg) {\n  const el = document.getElementById('log');\n  el.textContent += msg + '\\n';\n  el.scrollTop = el.scrollHeight;\n}\n\nfunction setStatus(msg) { document.getElementById('status').textContent = msg; }\nfunction setMicState(state) { document.getElementById('mic').className = state; }\n\nfunction connect() {\n  ws = new WebSocket(WS_URL);\n  ws.binaryType = 'arraybuffer';\n\n  ws.onopen = () => {\n    log('Connected');\n    setStatus('Connecte. Cliquez sur le micro pour parler.');\n  };\n\n  ws.onmessage = (e) => {\n    if (e.data instanceof ArrayBuffer) {\n      // Audio chunk arrived — queue it for immediate playback\n      audioQueue.push(e.data);\n      if (!isPlaying) playNext();\n      return;\n    }\n\n    const data = JSON.parse(e.data);\n\n    if (data.type === 'connected') {\n      callId = data.call_id;\n    }\n\n    if (data.type === 'speak_start') {\n      audioQueue = [];\n      isSpeaking = true;\n      setMicState('speaking');\n      setStatus('Agent parle...');\n      if (data.text) document.getElementById('agentText').textContent = data.text;\n    }\n\n    if (data.type === 'speak_end') {\n      isSpeaking = false;\n      if (data.interrupted) {\n        log('Barge-in: agent interrompu');\n        audioQueue = [];  // Drop remaining audio\n        stopAudio();\n      }\n      if (!isPlaying) {\n        setMicState('');\n        setStatus('Cliquez sur le micro pour parler.');\n      }\n    }\n\n    if (data.type === 'speak') {\n      document.getElementById('agentText').textContent = data.text;\n      browserSpeak(data.text);\n    }\n  };\n\n  ws.onclose = () => { setStatus('Deconnecte.'); setMicState(''); };\n  ws.onerror = () => { setStatus('Erreur connexion.'); };\n}\n\nasync function playNext() {\n  if (audioQueue.length === 0) {\n    isPlaying = false;\n    if (!isSpeaking) {\n      setMicState('');\n      setStatus('Cliquez sur le micro pour parler.');\n    }\n    return;\n  }\n\n  isPlaying = true;\n  const buf = audioQueue.shift();\n\n  try {\n    if (!audioCtx) audioCtx = new AudioContext();\n    if (audioCtx.state === 'suspended') await audioCtx.resume();\n\n    const audioBuffer = await audioCtx.decodeAudioData(buf.slice(0));  // slice to detach\n    const source = audioCtx.createBufferSource();\n    source.buffer = audioBuffer;\n    source.connect(audioCtx.destination);\n    source.onended = () => playNext();\n    source.start();\n  } catch (err) {\n    // If individual chunk can't be decoded, skip it\n    log('Audio skip: ' + err.message.substring(0, 50));\n    playNext();\n  }\n}\n\nfunction stopAudio() {\n  audioQueue = [];\n  isPlaying = false;\n  if (audioCtx) {\n    audioCtx.close().catch(() => {});\n    audioCtx = null;\n  }\n}\n\nfunction bargeIn() {\n  // Send interrupt to server\n  if (ws && ws.readyState === WebSocket.OPEN) {\n    ws.send(JSON.stringify({ type: 'interrupt' }));\n  }\n  stopAudio();\n  setMicState('');\n}\n\nfunction browserSpeak(text) {\n  const synth = window.speechSynthesis;\n  synth.cancel();\n  setMicState('speaking');\n  const utt = new SpeechSynthesisUtterance(text);\n  utt.lang = 'fr-FR';\n  const voices = synth.getVoices();\n  const fr = voices.find(v => v.lang.startsWith('fr'));\n  if (fr) utt.voice = fr;\n  utt.onend = () => { setMicState(''); setStatus('Cliquez sur le micro pour parler.'); };\n  synth.speak(utt);\n}\n\nfunction toggleMic() { listening ? stopListening() : startListening(); }\n\nfunction startListening() {\n  if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {\n    setStatus('Speech Recognition non supporte (Chrome/Edge)');\n    return;\n  }\n\n  // Barge-in: if agent is speaking, interrupt it\n  if (isSpeaking || isPlaying) {\n    bargeIn();\n  }\n\n  window.speechSynthesis.cancel();\n\n  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;\n  recognition = new SR();\n  recognition.lang = 'fr-FR';\n  recognition.continuous = false;\n  recognition.interimResults = true;\n\n  recognition.onstart = () => {\n    listening = true;\n    setMicState('listening');\n    setStatus('Parlez...');\n    document.getElementById('userText').textContent = '';\n    document.getElementById('agentText').textContent = '';\n  };\n\n  recognition.onresult = (e) => {\n    let interim = '', final = '';\n    for (let i = 0; i < e.results.length; i++) {\n      if (e.results[i].isFinal) final += e.results[i][0].transcript;\n      else interim += e.results[i][0].transcript;\n    }\n    document.getElementById('userText').textContent = final || interim;\n    if (final) {\n      log('You: ' + final);\n      setStatus('Reflexion...');\n      setMicState('');\n      ws.send(JSON.stringify({ type: 'transcript', text: final }));\n    }\n  };\n\n  recognition.onerror = () => { listening = false; setMicState(''); };\n  recognition.onend = () => { listening = false; };\n  recognition.start();\n}\n\nfunction stopListening() {\n  if (recognition) recognition.stop();\n  listening = false;\n  setMicState('');\n}\n\nspeechSynthesis.onvoiceschanged = () => speechSynthesis.getVoices();\nconnect();\n</script>\n</body>\n</html>\n", "language": "html", "size": 7530, "lines": 239, "operation": "disk_sync", "updated_at": 1778628126.197369, "validation": "approved", "baseline_lines": 238, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.8673844}, "examples/chat-test/app.yaml": {"content": "app:\n  app_id: chat-test\n  name: Chat Test\n  version: \"1.0\"\n\nruntime:\n  mode: conversation\n  workdir_mode: auto\n  max_turns: 5\n  timeout: 60\n\nagents:\n- id: main\n  role: assistant\n  brain:\n    provider: anthropic\n    model: claude-haiku-4-5-20251001\n    backend: anthropic\n    config:\n      api_key: claude-code\n    temperature: 0\n    max_tokens: 1024\n  system_prompt: \"You are a terse echo bot. Reply concisely.\"\n\ntools:\n  modules: {}\n  capabilities:\n    default_policy: auto\n\nui:\n  greeting: \"useChat E2E test bed.\"\n", "language": "yaml", "size": 517, "lines": 32, "operation": "disk_sync", "updated_at": 1778628126.197369, "validation": "approved", "baseline_lines": 31, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1778097983.4425502}, "examples/flow-showcase/app.yaml": {"content": "app:\n  app_id: flow-showcase\n  name: Flow showcase\n  version: 1.0.0\n  description: 'Reference YAML exercising every flow: node type.'\n  category: developer-tools\n  tags:\n  - example\n  - flow\n  - multi-agent\n  - hitl\nruntime:\n  mode: conversation\n  entry_agent: triage\n  max_turns: 30\n  timeout: 300\n  flow:\n    id: support_main\n    entry: triage_node\n    description: Triage incoming request, dispatch to the right squad, run to completion.\n    max_iterations: 50\n    nodes:\n    - id: triage_node\n      type: agent\n      agent: triage\n      description: Classify category in {refund, research, default}.\n      routes:\n      - when: output.category == 'refund'\n        to: refund_squad\n      - when: output.category == 'research'\n        to: research_fanout\n      - when: default\n        to: fallback\n      on_error:\n      - default: true\n        to: fallback\n    - id: refund_squad\n      type: agent\n      agent: refund_specialist\n      routes:\n      - to: refund_gate\n    - id: refund_gate\n      type: approval\n      message: Confirm refund of {{previous.output.amount}} EUR for ticket {{previous.output.ticket_id}}?\n      choices:\n      - approve\n      - reject\n      routes:\n      - when: approvals.refund_gate == 'approve'\n        to: process_refund\n      - when: approvals.refund_gate == 'reject'\n        to: notify_rejection\n      on_error:\n      - match: Timeout\n        to: escalate\n    - id: process_refund\n      type: tool\n      tool: http.post\n      params:\n        url: https://api.stripe.com/v1/refunds\n        body: '{{previous.output.refund_payload}}'\n      routes:\n      - to: notify_success\n      on_error:\n      - match: RateLimit|ServiceUnavailable\n        to: escalate\n      - default: true\n        to: notify_failure\n    - id: research_fanout\n      type: parallel\n      description: Spawn web, docs, vendor researchers concurrently.\n      branches:\n      - to: web_research\n      - to: docs_research\n      - to: vendor_research\n      join:\n        type: all\n        timeout: 60\n      routes:\n      - to: synthesize\n    - id: web_research\n      type: agent\n      agent: web_researcher\n      routes:\n      - to: end\n    - id: docs_research\n      type: agent\n      agent: docs_researcher\n      routes:\n      - to: end\n    - id: vendor_research\n      type: agent\n      agent: vendor_researcher\n      routes:\n      - to: end\n    - id: synthesize\n      type: decision\n      expr: input.priority\n      description: Skip the writer for low-priority requests.\n      routes:\n      - when: input.priority == 'high'\n        to: write_full_report\n      - when: default\n        to: notify_success\n    - id: write_full_report\n      type: agent\n      agent: writer\n      routes:\n      - to: notify_success\n    - id: notify_success\n      type: agent\n      agent: writer\n      routes:\n      - to: end\n    - id: notify_rejection\n      type: agent\n      agent: writer\n      routes:\n      - to: end\n    - id: notify_failure\n      type: agent\n      agent: writer\n      routes:\n      - to: escalate\n    - id: escalate\n      type: agent\n      agent: writer\n      routes:\n      - to: end\n    - id: fallback\n      type: agent\n      agent: writer\n      routes:\n      - to: end\ntools:\n  modules:\n    web: {}\n    http:\n      config:\n        timeout: 30\n        allowed_hosts:\n        - api.stripe.com\n    context_builder: {}\n    agent_spawn: {}\n  capabilities:\n    default_policy: auto\n    grant:\n    - module: web\n      actions:\n      - search\n      - fetch\n    - module: http\n      actions:\n      - post\n    - module: context_builder\n      actions:\n      - ask_user\ndev:\n  variables:\n    workspace: '{{env.PWD}}'\n  include:\n    agents: ./agents/\n", "language": "yaml", "size": 3640, "lines": 163, "operation": "disk_sync", "updated_at": 1778628126.2218204, "validation": "approved", "baseline_lines": 162, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4678743}, "examples/flow-showcase/agents/refund.yaml": {"content": "tools:\n  modules:\n  - http:\n    - post\nid: refund_specialist\nrole: specialist\nspecialty: Inspect a ticket and decide whether to issue a refund.\nbrain:\n  provider: anthropic\n  model: claude-sonnet-4-6\n  credential: anthropic_main\nsystem_prompt: \"You handle refund tickets. Read the ticket payload, decide on an\\n\\\n  amount, and emit:\\n  - amount: number (EUR)\\n  - refund_payload: { customer, amount,\\\n  \\ currency, ticket_id }\\n\\nThe next node is an approval gate. The user confirms\\\n  \\ before money\\nmoves.\\n\"\n", "language": "yaml", "size": 512, "lines": 16, "operation": "disk_sync", "updated_at": 1778628126.231056, "validation": "approved", "baseline_lines": 15, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4678743}, "examples/flow-showcase/agents/researchers.yaml": {"content": "- id: web_researcher\n  role: specialist\n  specialty: \"Search the open web for facts.\"\n  brain:\n    provider: anthropic\n    model: claude-haiku-4-5\n    credential: anthropic_main\n    temperature: 0.2\n  modules:\n    - { web: [search, fetch] }\n  system_prompt: \"Search and return 3-5 sources with citations.\"\n\n- id: docs_researcher\n  role: specialist\n  specialty: \"Search internal documentation.\"\n  brain:\n    provider: anthropic\n    model: claude-haiku-4-5\n    credential: anthropic_main\n    temperature: 0.0\n  modules:\n    - { web: [search] }\n  system_prompt: \"Search internal docs only. Cite the file path.\"\n\n- id: vendor_researcher\n  role: specialist\n  specialty: \"Read vendor documentation.\"\n  brain:\n    provider: anthropic\n    model: claude-haiku-4-5\n    credential: anthropic_main\n    temperature: 0.0\n  modules:\n    - { web: [search, fetch] }\n  system_prompt: \"Find official vendor docs. Cite the URL.\"\n", "language": "yaml", "size": 909, "lines": 36, "operation": "disk_sync", "updated_at": 1778628126.2516408, "validation": "approved", "baseline_lines": 35, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4678743}, "examples/flow-showcase/agents/triage.yaml": {"content": "tools:\n  modules:\n  - context_builder:\n    - ask_user\nid: triage\nrole: coordinator\nspecialty: Classify incoming requests into refund / research / default.\nbrain:\n  provider: anthropic\n  model: claude-haiku-4-5\n  credential: anthropic_main\n  temperature: 0.0\nsystem_prompt: \"You are the triage agent. Read the user's request, classify it, and\\n\\\n  return a JSON object with at least:\\n  - category: 'refund' | 'research' | 'default'\\n\\\n  \\  - ticket_id: string (when category == 'refund')\\n  - priority: 'low' | 'normal'\\\n  \\ | 'high'\\n\\nBe terse. The next node routes on `output.category`.\\n\"\n", "language": "yaml", "size": 593, "lines": 17, "operation": "disk_sync", "updated_at": 1778628126.2653708, "validation": "approved", "baseline_lines": 16, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4678743}, "examples/flow-showcase/agents/writer.yaml": {"content": "id: writer\nrole: specialist\nspecialty: \"Compose the final user-facing message.\"\nbrain:\n  provider: anthropic\n  model: claude-sonnet-4-6\n  credential: anthropic_main\n  temperature: 0.4\nsystem_prompt: |\n  You write the final answer for the user. Adapt the tone to the\n  context (success, rejection, escalation, or fallback). Keep it\n  under 200 words unless the context warrants more.\n", "language": "yaml", "size": 383, "lines": 13, "operation": "disk_sync", "updated_at": 1778628126.286991, "validation": "approved", "baseline_lines": 12, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4678743}, "examples/middleware/french_only.py": {"content": "\"\"\"Example custom app-level middleware: force French responses.\n\nThis middleware demonstrates:\n- Injecting rules into the system prompt (before)\n- Monitoring/transforming the LLM response (after)\n\nPlace this file in a `middleware/` folder next to your app YAML,\nor reference it with a relative path.\n\"\"\"\n\n\nclass FrenchOnlyMiddleware:\n    \"\"\"Force the agent to always respond in French.\"\"\"\n\n    def __init__(self, strict: bool = False):\n        self.strict = strict\n        self._turns_processed = 0\n\n    async def before(self, ctx):\n        \"\"\"Inject French instruction into system prompt.\"\"\"\n        self._turns_processed += 1\n\n        rule = (\n            \"\\n\\n🇫🇷 RÈGLE ABSOLUE: Tu DOIS répondre UNIQUEMENT en français. \"\n            \"Peu importe la langue de l'utilisateur, ta réponse est en français.\"\n        )\n        if rule not in ctx.system_prompt:\n            ctx.system_prompt += rule\n\n        # Return None = continue to LLM call\n        # Return a string = short-circuit (skip LLM, use this as response)\n        return None\n\n    async def after(self, ctx, response, tool_calls):\n        \"\"\"Optionally validate the response is in French.\"\"\"\n        # In strict mode, could add validation here\n        return response\n", "language": "python", "size": 1229, "lines": 38, "operation": "disk_sync", "updated_at": 1778628126.29809, "validation": "approved", "baseline_lines": 37, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.8880763}, "examples/middleware/rate_logger.py": {"content": "\"\"\"Example custom module-level middleware: log every tool call with timing.\n\nModule-level middlewares wrap individual module actions (filesystem.read,\ndatabase.query, etc.) and follow the __call__(ctx, next_) protocol.\n\"\"\"\n\nimport time\n\n\nclass RateLoggerMiddleware:\n    \"\"\"Log every module call with timing and rate info.\"\"\"\n\n    def __init__(self, warn_after_ms: float = 1000.0):\n        self.warn_after_ms = warn_after_ms\n        self._call_count = 0\n        self._slow_calls = 0\n\n    async def __call__(self, ctx, next_):\n        \"\"\"Wrap the module action execution.\n\n        Args:\n            ctx: ModuleCallContext with module_id, action, params, metadata\n            next_: async callable to invoke the next middleware (or the handler)\n        \"\"\"\n        self._call_count += 1\n        start = time.monotonic()\n\n        # Call the actual module action (or next middleware)\n        result = await next_(ctx)\n\n        duration_ms = (time.monotonic() - start) * 1000\n        if duration_ms > self.warn_after_ms:\n            self._slow_calls += 1\n            print(\n                f\"⚠️ SLOW CALL [{duration_ms:.0f}ms] \"\n                f\"{ctx.module_id}.{ctx.action}\"\n            )\n        else:\n            print(\n                f\"✅ [{duration_ms:.0f}ms] \"\n                f\"{ctx.module_id}.{ctx.action}\"\n            )\n\n        return result\n", "language": "python", "size": 1347, "lines": 45, "operation": "disk_sync", "updated_at": 1778628126.321652, "validation": "approved", "baseline_lines": 44, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.8880763}, "examples/opencode/app.yaml": {"content": "app:\n  app_id: opencode\n  name: OpenCode\n  version: '4.0'\n  description: Terminal coding assistant - Claude Code equivalent\nruntime:\n  mode: conversation\n  workdir_mode: required\n  workdir: ''\n  project_memory: auto\n  max_turns: 200\n  timeout: 1800\n  hooks:\n  - id: lint_after_edit\n    true: tool_end\n    condition:\n      type: tool_match\n      tools:\n      - filesystem.edit\n      - filesystem.write\n    action:\n      type: module_action\n      name: lsp.notify_change\n      action_params:\n        path: '{{tool.params.path}}'\n    cooldown: 2\nagents:\n- id: main\n  role: coordinator\n  brain:\n    provider: minimax\n    model: MiniMax-M2.5\n    backend: openai_compat\n    config:\n      api_key: '{{env.MINIMAX_API_KEY}}'\n      base_url: https://api.minimaxi.chat/v1\n    temperature: 0.1\n    max_tokens: 4096\n    context:\n      max_tokens: 800000\n      strategy: summarize\n      keep_recent: 6\n      auto_compact: true\n  plan_first: false\n  system_prompt: \"You are an interactive agent that helps users with software engineering\\\n    \\ tasks. Use the tools available to you to assist the user.\\n\\nWorkspace: {WORKSPACE}\\n\\\n    \\n# System\\n\\n- All text you output is displayed to the user. Output text to communicate.\\n\\\n    - You can call multiple tools in a single response. Make all independent tool\\\n    \\ calls in parallel.\\n- If tool calls depend on each other, call them sequentially\\\n    \\ - do NOT guess missing parameters.\\n\\n# Planning - THINK BEFORE YOU CODE\\n\\n\\\n    For ANY task that is not a simple question or single-file fix, you MUST plan first.\\n\\\n    \\n## Simple tasks (no plan needed)\\n- \\\"What does this function do?\\\" → just read\\\n    \\ and answer\\n- \\\"Fix this typo\\\" → just edit\\n- \\\"Run the tests\\\" → just bash\\n\\\n    \\n## Non-trivial tasks (PLAN REQUIRED)\\nAny task involving 2+ files, architecture\\\n    \\ decisions, or multi-step work:\\n\\n**Step 1 - Research** (do NOT write code yet)\\n\\\n    - Read the relevant files to understand current state\\n- If broad search needed\\\n    \\ → spawn explore agents in parallel\\n- For complex architecture → spawn_agent(specialist=\\\"\\\n    plan\\\", task=\\\"Analyze X and design implementation plan for Y\\\")\\n- Understand\\\n    \\ the existing patterns, conventions, dependencies\\n\\n**Step 2 - Plan** (present\\\n    \\ to user BEFORE coding)\\n- set_goal(\\\"what you need to accomplish\\\")\\n- Write\\\n    \\ a clear plan as text output to the user:\\n  - What files will be created/modified\\n\\\n    \\  - The approach and why\\n  - What won't be changed\\n  - Risks or trade-offs\\n\\\n    - add_todo() for each step of the plan\\n- WAIT for user confirmation before proceeding\\n\\\n    \\n**Step 3 - Execute** (only after user says yes/ok/go/oui)\\n- update_todo(id,\\\n    \\ \\\"in_progress\\\") before each step\\n- Do the work\\n- update_todo(id, \\\"done\\\"\\\n    ) after each step\\n- remember(\\\"key finding\\\") for important discoveries\\n\\n**Step\\\n    \\ 4 - Verify**\\n- Run tests if applicable\\n- Read modified files to confirm correctness\\n\\\n    - Report what was done\\n\\nNEVER skip the plan for non-trivial tasks. If you're\\\n    \\ about to modify 2+ files without having shown a plan, STOP and plan first.\\n\\\n    \\nAfter context compaction, check your memory above before continuing.\\n\\n# Using\\\n    \\ your tools\\n\\nUse the RIGHT tool for the job. Do NOT use bash when a dedicated\\\n    \\ tool exists:\\n  - To read files → read (not bash cat/head/tail)\\n  - To edit\\\n    \\ files → edit (not bash sed/awk)\\n  - To create files → write (not bash echo)\\n\\\n    \\  - To search content → grep (not bash grep/rg)\\n  - To find files → glob (not\\\n    \\ bash find)\\nUse bash for: listing directories, git, build tools, test runners,\\\n    \\ package managers, system commands.\\n\\nYou can call multiple tools in parallel\\\n    \\ when they are independent.\\n\\n# Reading code\\n\\n- grep(pattern, path) is your\\\n    \\ primary search tool. Always grep first, then read the matching lines.\\n- glob(pattern)\\\n    \\ to find files by pattern. Supports '*.py', '**/*.tsx', 'src/**/*.ts'.\\n- read(path)\\\n    \\ with start_line/end_line for specific sections. Never read entire large files.\\n\\\n    - read(path, pattern=\\\"search term\\\") to search within a file and get matching\\\n    \\ lines with context.\\n\\n# Editing code - SURGICAL EDITS ONLY\\n\\nNEVER rewrite\\\n    \\ entire files. Always use surgical edits:\\n- edit(path, old_string, new_string)\\\n    \\ - find and replace exact text. The old_string must be unique in the file.\\n\\\n    - edit(path, old_string, new_string, replace_all=true) - replace all occurrences\\\n    \\ (for renames).\\n- write(path, content) - ONLY for creating brand new files.\\n\\\n    - After each edit, verify by reading the changed section.\\n- If edit fails (old_string\\\n    \\ not found), re-read the file - content may have changed.\\n\\n# Shell\\n\\n- bash(command)\\\n    \\ for one-off commands. CWD persists between calls.\\n- bash_background(command)\\\n    \\ for dev servers and long-running processes. Returns a task_id.\\n- bash_status(task_id)\\\n    \\ to check output of background tasks, or kill them with kill=true.\\n\\n# Sub-agents\\\n    \\ - MANDATORY for broad searches\\n\\nWhen you need to search across many files\\\n    \\ or explore a codebase:\\n- spawn_agent(specialist=\\\"explore\\\", task=\\\"Find all\\\n    \\ X in Y\\\")\\n- For 2+ independent research questions → spawn MULTIPLE explore\\\n    \\ agents in PARALLEL\\n- Collect results with agent_wait_all() and synthesize\\n\\\n    Do NOT do sequential grep-grep-grep when you could delegate to explore agents\\\n    \\ in parallel.\\nDo NOT spawn agents for simple single-file reads - use read()\\\n    \\ directly.\\n\\n# Git\\n\\n- Always git status before and after changes.\\n- Never\\\n    \\ push unless user explicitly asks.\\n- Never amend commits unless asked. Always\\\n    \\ create new commits.\\n- Stage specific files, never git add -A or git add .\\n\\\n    - Never skip hooks (--no-verify) or force push.\\n\\n# Rules\\n\\n- Read code before\\\n    \\ modifying it. Do not propose changes to code you haven't read.\\n- Prefer editing\\\n    \\ existing files over creating new ones.\\n- Do NOT over-engineer: no extra features,\\\n    \\ no unnecessary abstractions, no docstrings on unchanged code.\\n- Be careful\\\n    \\ with security: no command injection, XSS, SQL injection.\\n- For destructive\\\n    \\ actions (delete, git reset, force push) - ask the user first.\\n- After 3 failed\\\n    \\ attempts at the same thing, stop and explain.\\n- Do NOT narrate tool calls.\\\n    \\ Don't say \\\"Let me read...\\\" - just call the tool.\\n- Be concise. Lead with\\\n    \\ the answer, not the reasoning.\\n\"\n  pool:\n    max_workers: 3\n- id: explore\n  role: specialist\n  specialty: Fast codebase exploration. Read-only.\n  brain:\n    provider: minimax\n    model: MiniMax-M2.5\n    backend: openai_compat\n    config:\n      api_key: '{{env.MINIMAX_API_KEY}}'\n      base_url: https://api.minimaxi.chat/v1\n    temperature: 0.0\n    max_tokens: 2048\n  system_prompt: 'You are a fast codebase explorer. Find information quickly in as\n    few tool calls as possible.\n\n\n    How to search:\n\n    - grep(pattern, path) for definitions, imports, usages\n\n    - find(pattern) for files by name\n\n    - read(path, start_line, end_line) for specific sections - never entire large\n    files\n\n\n    Return:\n\n    - File paths with line numbers (file.py:42)\n\n    - Short excerpts (relevant lines only)\n\n    - Match count\n\n    - Be concise. Facts, not commentary.\n\n\n    Never modify files. Never run shell commands.\n\n    '\n  modules:\n  - filesystem\n  - memory\n- id: plan\n  role: specialist\n  specialty: Architecture and implementation planning. Read-only.\n  brain:\n    provider: minimax\n    model: MiniMax-M2.5\n    backend: openai_compat\n    config:\n      api_key: '{{env.MINIMAX_API_KEY}}'\n      base_url: https://api.minimaxi.chat/v1\n    temperature: 0.1\n    max_tokens: 4096\n  system_prompt: 'You are a software architect agent. Your job is to analyze a codebase\n    and design an implementation plan.\n\n\n    Process:\n\n    1. Read the relevant files to understand current architecture\n\n    2. Identify patterns, conventions, and dependencies\n\n    3. Design a step-by-step implementation plan\n\n\n    Your plan must include:\n\n    - Which files to create or modify (with exact paths)\n\n    - The approach and why it fits the existing patterns\n\n    - What NOT to change (boundaries)\n\n    - Risks or trade-offs\n\n    - Ordered steps from first to last\n\n\n    Rules:\n\n    - Never modify files. Read-only.\n\n    - Be specific: name exact files, functions, line ranges.\n\n    - Consider existing conventions - don''t fight the codebase.\n\n    - Keep the plan minimal - only what''s needed, nothing extra.\n\n    - If you see multiple approaches, pick one and explain why.\n\n    '\n  modules:\n  - filesystem\n  - memory\ntools:\n  modules:\n    filesystem: {}\n    shell: {}\n    lsp:\n      config:\n        python: ruff check --output-format=json\n    memory:\n      config:\n        working_memory: true\n        todo_list: true\n        runtime:\n          goal_guardian: true\n    web:\n      config:\n        search:\n          primary: duckduckgo\n  capabilities:\n    default_policy: block\n    max_risk_level: medium\n    grant:\n    - module: filesystem\n      actions:\n      - read\n      - write\n      - edit\n      - grep\n      - glob\n    - module: shell\n      actions:\n      - bash\n      - bash_background\n      - bash_status\n    - module: memory\n      actions:\n      - set_goal\n      - remember\n      - recall\n      - forget\n      - add_todo\n      - update_todo\n    - module: web\n      actions:\n      - search\n      - fetch\n      - extract\n      - download\n    - module: agent_spawn\n      actions:\n      - agent\nui:\n  greeting: 'Ready. What are we working on?\n\n    '\ndev:\n  skills:\n  - command: /commit\n    description: Smart git commit\n    path: ./skills/commit.md\n  - command: /review\n    description: Code review\n    path: ./skills/review.md\n  - command: /pr\n    description: Create pull request\n    path: ./skills/pr.md\n  - command: /test\n    description: Detect and run tests\n    path: ./skills/test.md\n  - command: /init\n    description: Detect project stack\n    path: ./skills/init.md\n  - command: /debug\n    description: Systematic debugging\n    path: ./skills/debug.md\n", "language": "yaml", "size": 10146, "lines": 283, "operation": "disk_sync", "updated_at": 1778628126.4062195, "validation": "approved", "baseline_lines": 282, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4835527}, "examples/opencode/skills/commit.md": {"content": "# Smart Commit\n\nFollow these steps to create a well-formatted git commit:\n\n1. Run `git.status()` to see all changes (staged, unstaged, untracked)\n2. Run `git.diff()` to understand what changed in detail\n3. Run `git.log(limit=5, oneline=true)` to match the repository's commit style\n4. Analyze the changes:\n   - If changes address multiple concerns (bug fix + feature + refactor), group them into separate commits\n   - Each commit should be atomic - one logical change per commit\n5. Draft the commit message:\n   - Focus on WHY the change was made, not WHAT changed\n   - Keep the first line under 72 characters\n   - Use imperative mood (\"Add feature\" not \"Added feature\")\n   - If the change is complex, add a blank line then a detailed body\n6. Stage relevant files with `git.add(files=[...])`\n   - Never stage .env, credentials, node_modules, or large binaries\n   - Stage specific files, not everything\n   - If splitting into multiple commits, stage one group at a time\n7. Run `git.commit(message=\"...\")` with the drafted message\n8. If there are remaining changes for a second commit, repeat from step 5\n9. Run `git.status()` to verify the commit(s) were successful\n", "language": "markdown", "size": 1164, "lines": 23, "operation": "disk_sync", "updated_at": 1778628126.4243913, "validation": "approved", "baseline_lines": 22, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777378984.8153987}, "examples/opencode/skills/debug.md": {"content": "# Systematic Debugging\n\nFollow this process to debug an issue:\n\n1. **Reproduce** - get a clear error message or failing test\n   - If the user describes a bug, ask for the exact error or steps to reproduce\n   - If there's a stack trace, read every file and line mentioned in it\n   - If there's a failing test, run it: `shell.run(\"pytest path/to/test.py::test_name -v\")`\n2. **Isolate** - find the root cause\n   - Use `grep` to find the function or class mentioned in the error\n   - Read the surrounding code (50 lines of context)\n   - Check recent changes: `git.log(limit=10)` and `git.diff()`\n   - Trace the data flow: where does the bad input come from?\n3. **Hypothesize** - state what you think is wrong and why\n   - Be specific: \"Line 42 passes None to foo() which expects a string\"\n   - If unsure, add a diagnostic `shell.run()` to test your hypothesis\n4. **Fix** - make the minimal change\n   - Use `edit()` for surgical fixes\n   - Don't fix unrelated issues you happen to notice\n   - Don't refactor surrounding code\n5. **Verify** - confirm the fix works\n   - Run the failing test or reproduce the scenario\n   - Run the full test suite if the change could have side effects\n   - If the fix doesn't work, go back to step 2 with new information\n6. **Clean up** - leave things tidy\n   - `git.status()` to check what changed\n   - Remove any debug artifacts (print statements, test files)\n   - Verify no unintended changes were made\n", "language": "markdown", "size": 1431, "lines": 29, "operation": "disk_sync", "updated_at": 1778628126.443466, "validation": "approved", "baseline_lines": 28, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777378984.8153987}, "examples/opencode/skills/init.md": {"content": "# Project Detection\n\nDetect the project stack and store it for the session.\n\n1. Scan the workspace root for project files:\n   - `package.json` → read it, extract: name, scripts (test, build, lint, dev), main dependencies\n   - `pyproject.toml` → extract: project name, build system, test config, dependencies\n   - `Cargo.toml` → extract: package name, edition, key dependencies\n   - `go.mod` → extract: module name, go version\n   - `Makefile` → list available targets (test, build, lint, clean, etc.)\n   - `docker-compose.yml` or `Dockerfile` → note containerized setup\n2. Check for linter/formatter config:\n   - `.eslintrc*` / `biome.json` / `.prettierrc` → JS/TS linting\n   - `ruff.toml` / `pyproject.toml [tool.ruff]` / `.flake8` → Python linting\n   - `rustfmt.toml` / `clippy.toml` → Rust linting\n3. Check for CI configuration:\n   - `.github/workflows/` → read CI files for test/build/lint commands\n   - `.gitlab-ci.yml` / `Jenkinsfile` / `.circleci/config.yml`\n4. Check git state:\n   - `git.status()` - current branch, pending changes\n   - `git.log(limit=5, oneline=true)` - recent activity\n5. Look for setup docs:\n   - `README.md` or `CONTRIBUTING.md` - extract setup/install/test instructions\n6. Store all findings with `memory.add_fact()`:\n   - Language and framework\n   - Package manager\n   - Test command, build command, lint command\n   - Any special setup requirements\n7. Report a compact summary to the user:\n   - Stack: language, framework, package manager\n   - Commands: test, build, lint\n   - Branch: current branch, clean/dirty status\n", "language": "markdown", "size": 1550, "lines": 33, "operation": "disk_sync", "updated_at": 1778628126.4591043, "validation": "approved", "baseline_lines": 32, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777378984.8184395}, "examples/opencode/skills/pr.md": {"content": "# Create Pull Request\n\nFollow these steps to create a well-documented pull request:\n\n1. Run `git.status()` to check the current branch and changes\n2. Run `git.log(limit=10, oneline=true)` to see all commits on this branch\n3. Run `git.diff(target=\"main\")` to see the full diff against the base branch\n4. Analyze all commits and changes to understand the scope\n5. Draft the PR:\n   - Title: short, under 70 characters, describes the change\n   - Body: summary (what and why), test plan, breaking changes if any\n6. If there are uncommitted changes, ask the user before proceeding\n7. Run `git.push(set_upstream=true)` to push the branch\n8. Run `git.pr_create(title=\"...\", body=\"...\", base=\"main\")` to create the PR\n9. Report the PR URL to the user\n", "language": "markdown", "size": 742, "lines": 16, "operation": "disk_sync", "updated_at": 1778628126.4644244, "validation": "approved", "baseline_lines": 15, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.8937936}, "examples/opencode/skills/refactor.md": {"content": "# Safe Refactoring\n\nRefactor code with test verification at every step.\n\n1. **Scope** - identify exactly what to refactor and why\n   - Read all affected files first\n   - Count the files that will change\n   - If the scope is large (10+ files), ask the user to confirm before starting\n2. **Safety net** - run the test suite BEFORE starting\n   - Use /test or run the project's test command\n   - If tests already fail, tell the user before proceeding\n   - Store the baseline result with `memory.add_fact(\"baseline tests: X passed, Y failed\")`\n3. **Execute** - make changes one file at a time\n   - After each file: run tests to verify nothing broke\n   - If tests fail after a change: `filesystem.undo(path)` to restore, then investigate\n   - Common refactors:\n     - **Rename**: grep for ALL usages first, then change all at once\n     - **Extract function**: identify the block, create the function, replace the original call\n     - **Move file**: update ALL imports after moving (grep for the old import path)\n     - **Inline**: verify the function is only called in one place before inlining\n4. **Final check** - run the full test suite\n   - `git.diff()` to review all changes\n   - Compare with baseline: same number of tests should pass\n5. **Report** - summarize what was refactored\n   - Files changed\n   - Tests passed (before vs after)\n   - What was refactored and why\n", "language": "markdown", "size": 1369, "lines": 28, "operation": "disk_sync", "updated_at": 1778628126.4904873, "validation": "approved", "baseline_lines": 27, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777378984.8184395}, "examples/opencode/skills/review.md": {"content": "# Code Review\n\nFollow these steps to review code changes:\n\n1. Run `git.diff()` to see all current changes\n2. For each changed file:\n   a. Read the file to understand the full context (not just the diff)\n   b. Check for security issues:\n      - Hardcoded secrets, API keys, tokens\n      - SQL injection, command injection, XSS\n      - Unsafe deserialization, path traversal\n   c. Check for error handling:\n      - Missing try/catch, silent failures\n      - Bare except / catch(e) without handling\n      - Error swallowing (logging but not re-raising when needed)\n   d. Check for code quality:\n      - Naming clarity, duplication, excessive complexity\n      - Magic numbers or strings that should be constants\n      - Functions longer than 50 lines\n   e. Check for common anti-patterns:\n      - Hardcoded values that should be configuration\n      - N+1 query patterns (loop with individual DB/API calls)\n      - Race conditions in async code (missing await, shared mutable state)\n      - Resource leaks (unclosed files, connections, cursors)\n   f. Check if changes are covered by tests\n3. Store each finding with `memory.add_fact()` as you go\n4. Produce a summary:\n   - Number of files reviewed\n   - Issues found by severity (critical, warning, info)\n   - Specific recommendations with file:line references\n   - Overall assessment: approve, request changes, or needs discussion\n", "language": "markdown", "size": 1376, "lines": 32, "operation": "disk_sync", "updated_at": 1778628126.5065513, "validation": "approved", "baseline_lines": 31, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.8937936}, "examples/opencode/skills/simplify.md": {"content": "# Simplify\n\nReview changed code for reuse, quality, and efficiency, then fix any issues found.\n\n1. Run `git.diff()` to see all current changes\n2. For each changed file, read the full file to understand context\n3. Look for:\n   - Duplicated code that could be extracted into a function\n   - Over-engineered abstractions that add complexity without value\n   - Unnecessary error handling for impossible scenarios\n   - Variables or imports that are declared but never used\n   - Functions that are too long (> 50 lines) and should be split\n   - Magic numbers or strings that should be constants\n4. For each issue found:\n   - Fix it directly with a surgical edit\n   - Keep the fix minimal -- don't refactor surrounding code\n5. After all fixes, run `git.diff()` to verify the changes look clean\n6. Report what you simplified and why\n", "language": "markdown", "size": 825, "lines": 19, "operation": "disk_sync", "updated_at": 1778628126.521775, "validation": "approved", "baseline_lines": 18, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.903726}, "examples/opencode/skills/test.md": {"content": "# Test Runner\n\nDetect and run the project's test suite.\n\n1. Detect the test runner by checking for config files:\n   - `package.json` → look for \"test\" script → `shell.run(\"npm test\")` (or yarn/pnpm)\n   - `pyproject.toml` → check for [tool.pytest] → `shell.run(\"pytest -v\")`\n   - `Cargo.toml` → `shell.run(\"cargo test\")`\n   - `go.mod` → `shell.run(\"go test ./...\")`\n   - `Makefile` → check for `test` target → `shell.run(\"make test\")`\n   - If unsure, use `shell.which(\"pytest\")` / `shell.which(\"npm\")` to check availability\n2. If a specific file was just edited, run only related tests:\n   - Python: `pytest path/to/test_file.py -v` or `pytest -k \"test_name\" -v`\n   - JavaScript: `npm test -- --testPathPattern=filename`\n   - Rust: `cargo test module_name`\n   - Go: `go test ./path/to/package/...`\n3. Parse the output:\n   - Count passed, failed, skipped tests\n   - For failures: extract the test name, expected vs actual, and the relevant source line\n4. Report a summary: X passed, Y failed, Z skipped\n5. If tests fail:\n   - Identify the root cause from the error message\n   - Suggest a fix but do NOT auto-fix unless the user asks\n", "language": "markdown", "size": 1131, "lines": 24, "operation": "disk_sync", "updated_at": 1778628126.5300422, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.9044828}, "examples/rag/01-zero-config.yaml": {"content": "app:\n  app_id: rag-01-zero-config\n  name: RAG Zero Config\nruntime:\n  mode: conversation\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    backend: openai_compat\n    model: deepseek-chat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n      base_url: https://api.deepseek.com/v1\n    temperature: 0.1\n    max_tokens: 4096\ntools:\n  modules:\n    rag: {}\nui:\n  greeting: 'Je suis un assistant RAG. Donne-moi des documents à indexer,\n\n    puis pose-moi des questions.\n\n    '\n", "language": "yaml", "size": 480, "lines": 26, "operation": "disk_sync", "updated_at": 1778628126.5478284, "validation": "approved", "baseline_lines": 25, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4835527}, "examples/rag/02-ingest-text.yaml": {"content": "app:\n  app_id: rag-02-ingest-text\n  name: RAG Ingest Text\nruntime:\n  mode: conversation\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    backend: openai_compat\n    model: deepseek-chat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n      base_url: https://api.deepseek.com/v1\n    temperature: 0.1\n  system_prompt: 'Tu es un assistant qui gère une base de connaissances.\n\n    Quand l''utilisateur te donne du texte, indexe-le avec rag.ingest.\n\n    Quand il pose une question, cherche avec rag.query.\n\n    '\ntools:\n  modules:\n    rag: {}\n", "language": "yaml", "size": 549, "lines": 26, "operation": "disk_sync", "updated_at": 1778628126.564239, "validation": "approved", "baseline_lines": 25, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4992666}, "examples/rag/03-ingest-file.yaml": {"content": "app:\n  app_id: rag-03-ingest-file\n  name: RAG File Ingestion\nruntime:\n  mode: conversation\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    backend: openai_compat\n    model: deepseek-chat\n    config:\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n      base_url: https://api.deepseek.com/v1\n    temperature: 0.1\n  system_prompt: 'Tu indexes des fichiers dans une base de connaissances RAG.\n\n    1. Utilise rag.create_knowledge_base pour créer une KB\n\n    2. Utilise rag.ingest_file pour indexer un fichier\n\n    3. Utilise rag.query pour chercher\n\n    '\ntools:\n  modules:\n    filesystem:\n      constraints:\n        allowed_actions:\n        - read\n        - glob\n    rag: {}\n", "language": "yaml", "size": 674, "lines": 33, "operation": "disk_sync", "updated_at": 1778628126.5807211, "validation": "approved", "baseline_lines": 32, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.4992666}, "examples/rag/04-ingest-directory.yaml": {"content": "app:\n  app_id: rag-04-ingest-dir\n  name: RAG Directory Ingestion\nruntime:\n  mode: conversation\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    backend: openai_compat\n    m