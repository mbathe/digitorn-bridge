xy\n  type: http\n  seq: 123\n}\n\nput {\n  url: {{base_url}}/api/apps/{{app_id}}/preview-server/proxy/{{path:path}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Reverse-proxy HTTP traffic to the app's dev server.\n  \n  Flutter points an iframe at ``/api/apps/{app_id}/preview-server/proxy/``\n  to render the dev UI inside the Digitorn admin panel. HMR websockets\n  use the matching ``/preview-server/ws/{path:path}`` upgrade route.\n}\n", "language": "text", "size": 499, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.8178058, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2663715}, "bruno/digitorn-api-full/apps/PUT api apps -app_id quota user -user_id.bru": {"content": "meta {\n  name: set_user_quota\n  type: http\n  seq: 125\n}\n\nput {\n  url: {{base_url}}/api/apps/{{app_id}}/quota/user/{{user_id}}\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"rpm\": 0\n  }\n}\n\ndocs {\n  Set a custom rate limit for a user on an app.\n}\n", "language": "text", "size": 293, "lines": 26, "operation": "disk_sync", "updated_at": 1778628122.8257453, "validation": "approved", "baseline_lines": 25, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2663715}, "bruno/digitorn-api-full/apps/PUT api apps -app_id quota.bru": {"content": "meta {\n  name: set_app_quota\n  type: http\n  seq: 124\n}\n\nput {\n  url: {{base_url}}/api/apps/{{app_id}}/quota\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"rpm\": 0\n  }\n}\n\ndocs {\n  Set a custom rate limit for an app (requests per minute).\n}\n", "language": "text", "size": 287, "lines": 26, "operation": "disk_sync", "updated_at": 1778628122.8292558, "validation": "approved", "baseline_lines": 25, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2663715}, "bruno/digitorn-api-full/apps/PUT api apps -app_id secrets -key.bru": {"content": "meta {\n  name: set_secret\n  type: http\n  seq: 127\n}\n\nput {\n  url: {{base_url}}/api/apps/{{app_id}}/secrets/{{key}}\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  reload: \n}\n\nbody:json {\n  {\n    \"value\": \"\"\n  }\n}\n\ndocs {\n  Set (or update) an encrypted secret for an app.\n  \n  By default the running app is **hot-reloaded** immediately so the\n  new value takes effect without a daemon restart — the typical use\n  case is rotating an API key and wanting the next request to use it.\n  Pass ``?reload=false`` when you want to stage multiple secret\n  updates and trigger a single reload at the end via\n  ``POST /api/apps/{app_id}/reload`` or the bulk ``PUT /secrets``.\n}\n", "language": "text", "size": 709, "lines": 37, "operation": "disk_sync", "updated_at": 1778628122.8341515, "validation": "approved", "baseline_lines": 36, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2711854}, "bruno/digitorn-api-full/apps/PUT api apps -app_id secrets.bru": {"content": "meta {\n  name: set_secrets_bulk\n  type: http\n  seq: 126\n}\n\nput {\n  url: {{base_url}}/api/apps/{{app_id}}/secrets\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  reload: \n}\n\nbody:json {\n  {\n    \"secrets\": {}\n  }\n}\n\ndocs {\n  Set many secrets in one request, then optionally hot-reload.\n  \n  This is the convenience endpoint to use when rotating several keys\n  at the same time. It writes each secret through ``SecretStore``\n  (same code path as the per-key PUT) and then, if ``reload=true``\n  (the default), triggers a single ``reload_app`` so every new value\n  takes effect together. Without bulk, rotating N keys would cost N\n  reloads which is wasteful and can momentarily break the app between\n  two updates.\n}\n", "language": "text", "size": 756, "lines": 38, "operation": "disk_sync", "updated_at": 1778628122.837179, "validation": "approved", "baseline_lines": 37, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.273201}, "bruno/digitorn-api-full/apps/PUT api apps -app_id sessions -session_id workspace files -file_path-path.bru": {"content": "meta {\n  name: writeback_file_endpoint\n  type: http\n  seq: 128\n}\n\nput {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/files/{{file_path:path}}\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"content\": \"\",\n    \"auto_approve\": false,\n    \"source\": \"user\"\n  }\n}\n\ndocs {\n  User-side write — manual edit, conflict resolution, drag-drop import.\n}\n", "language": "text", "size": 416, "lines": 28, "operation": "disk_sync", "updated_at": 1778628122.837179, "validation": "approved", "baseline_lines": 27, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.273201}, "bruno/digitorn-api-full/auth/folder.bru": {"content": "meta {\n  name: auth\n  seq: 10\n}\n", "language": "text", "size": 32, "lines": 5, "operation": "disk_sync", "updated_at": 1778628122.8461647, "validation": "approved", "baseline_lines": 4, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "del