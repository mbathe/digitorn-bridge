rror\": {\n        \"properties\": {\n          \"detail\": {\n            \"items\": {\n              \"$ref\": \"#/components/schemas/ValidationError\"\n            },\n            \"type\": \"array\",\n            \"title\": \"Detail\"\n          }\n        },\n        \"type\": \"object\",\n        \"title\": \"HTTPValidationError\"\n      },\n      \"HunksActionRequest\": {\n        \"properties\": {\n          \"path\": {\n            \"type\": \"string\",\n            \"title\": \"Path\",\n            \"description\": \"Workspace-relative file path.\"\n          },\n          \"hunks\": {\n            \"items\": {},\n            \"type\": \"array\",\n            \"title\": \"Hunks\",\n            \"description\": \"Hunk indices (int) or hashes (12-char str).\"\n          }\n        },\n        \"type\": \"object\",\n        \"required\": [\n          \"path\"\n        ],\n        \"title\": \"HunksActionRequest\"\n      },\n      \"InjectOAuthTokenRequest\": {\n        \"properties\": {\n          \"access_token\": {\n            \"type\": \"string\",\n            \"title\": \"Access Token\"\n          },\n          \"token_type\": {\n            \"type\": \"string\",\n            \"title\": \"Token Type\",\n            \"default\": \"bearer\"\n          },\n          \"refresh_token\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"title\": \"Refresh Token\"\n          },\n          \"expires_in\": {\n            \"anyOf\": [\n              {\n                \"type\": \"integer\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"title\": \"Expires In\"\n          },\n          \"scope\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\