http\n  seq: 11\n}\n\nget {\n  url: {{base_url}}/api/users/me/credentials/{{app_id}}/{{provider_name}}/oauth/status\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  state: \n}\n\ndocs {\n  Poll the state of an in-progress OAuth flow.\n  \n  Returns one of:\n  \n      { status: \"pending\" }                     — still waiting\n      { status: \"connected\", credential_id }    — done, token stored\n      { status: \"error\", error }                — failed\n      { status: \"expired\" }                     — flow TTL elapsed\n}\n", "language": "text", "size": 586, "lines": 31, "operation": "disk_sync", "updated_at": 1778628123.0011103, "validation": "approved", "baseline_lines": 30, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3131773}, "bruno/digitorn-api-full/credentials/GET api users me credentials -app_id -provider_name.bru": {"content": "meta {\n  name: get_credential\n  type: http\n  seq: 9\n}\n\nget {\n  url: {{base_url}}/api/users/me/credentials/{{app_id}}/{{provider_name}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Return one credential's metadata for the authenticated user.\n  \n  Never returns plaintext field values — only masked previews and\n  status info. Use this to drive the form display.\n}\n", "language": "text", "size": 401, "lines": 23, "operation": "disk_sync", "updated_at": 1778628123.0011103, "validation": "approved", "baseline_lines": 22, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3131773}, "bruno/digitorn-api-full/credentials/GET api users me credentials.bru": {"content": "meta {\n  name: list_user_credentials\n  type: http\n  seq: 8\n}\n\nget {\n  url: {{base_url}}/api/users/me/credentials\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  List every credential owned by the authenticated user.\n  \n  Used by the \"My Credentials\" global dashboard — shows every\n  provider the user has configured across every app, with their\n  status and last_updated.\n}\n", "language": "text", "size": 409, "lines": 24, "operation": "disk_sync", "updated_at": 1778628123.0087667, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.316684}, "bruno/digitorn-api-full/credentials/POST api admin credentials.bru": {"content": "meta {\n  name: admin_create_system_credential\n  type: http\n  seq: 12\n}\n\npost {\n  url: {{base_url}}/api/admin/credentials\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"provider_name\": \"{{provider_name}}\",\n    \"provider_type\": \"api_key\",\n    \"label\": \"default\",\n    \"app_id\": \"{{app_id}}\",\n    \"fields\": {}\n  }\n}\n\ndocs {\n  Create a system-owned credential.\n  \n  When ``app_id`` is set the credential is restricted to that app\n  (enterprise \"shared key for this one app\" case). When ``app_id``\n  is None the credential is visible to every app on the daemon.\n  \n  No grants are needed — system credentials are implicitly\n  available to the apps they cover.\n}\n", "language": "text", "size": 704, "lines": 37, "operation": "disk_sync", "updated_at": 1778628123.0087667, "validation": "approved", "baseline_lines": 36, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.316684}, "bruno/digitorn-api-full/credentials/POST api credentials -credential_id grant.bru": {"content": "meta {\n  name: create_credential_grant_singular\n  type: http\n  seq: 14\n}\n\npost {\n  url: {{base_url}}/api/credentials/{{credential_id}}/grant\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"app_id\": \"{{app_id}}\",\n    \"scopes_granted\": [\n      \"\"\n    ]\n  }\n}\n\ndocs {\n  Alias for ``POST /credentials/{id}/grants`` — singular form.\n}\n", "language": "text", "size": 377, "lines": 29, "operation": "disk_sync", "updated_at": 1778628123.017734, "validation": "approved", "baseline_lines": 28, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3184237}, "bruno/digitorn-api-full/credentials/POST api credentials -credential_id grants.bru": {"content": "meta {\n  name: create_credential_grant\n  type: http\n  seq: 15\n}\n\npost {\n  url: {{base_url}}/api/credentials/{{credential_id}}/grants\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"app_id\": \"{{app_id}}\",\n    \"scopes_granted\": [\n      \"\"\n    ]\n  }\n}\n\ndocs {\n  Authorize an app to use this credential.\n  \n  This is the endpoint the picker dialog calls when the user clicks\n  \"Use this key\" — it posts the credential_id + app_id, and from\n  then on the app can read the credential without prompting.\n  \n  Side effect: when the credential is an ``mcp_server``, this also\n  fires the handler's spawn hook so the subprocess is ready by the\n  time the first agent turn hits the MCP tool.\n}\n", "language": "text", "size": 730, "lines": 37, "operation": "disk_sync", "updated_at": 1778628123.017734, "validation": "approved", "baseline_lines": 36, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3184237}, "bruno/digitorn-api-full/credentials/POST api credentials.bru": {"content": "meta {\n  name: create_my_credential\n  type: http\n  seq: 13\n}\n\npost {\n  url: {{base_url}}/api/credentials\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"provider_name\": \"{{provider_name}}\",\n    \"provider_type\": \"api_key\",\n    \"label\": \"default\",\n    \"fields\": {}\n  }\n}\n\ndocs {\n  Create a new user-owned credential.\n  \n  Validates via the declared handler before storing. The credential\n  is NOT attached to any app — the user authorizes specific apps\n  later via ``POST /api/credentials/{id}/grants``.\n}\n", "language": "text", "size": 551, "lines": 33, "operation": "disk_sync", "updated_at": 1778628123.0257409, "validation": "approved", "baseline_lines": 32, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3184237}, "bruno/digitorn-api-full/credentials/POST api users me credentials -app_id -provider_name mcp start.bru": {"content": "meta {\n  name: mcp_start\n  type: http\n  seq: 16\n}\n\npost {\n  url: {{base_url}}/api/users/me/credentials/{{app_id}}/{{provider_name}}/mcp/start\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Start (or restart) an MCP server from a filled credential.\n  \n  Looks up the credential (per_app_per_user → per_user), retrieves\n  its schema declaration, and invokes the\n  ``McpServerHandler.on_credential_filled`` hook which talks to the\n  live ``MCPConnectionPool``.\n}\n", "language": "text", "size": 496, "lines": 25, "operation": "disk_sync", "updated_at": 1778628123.0329254, "validation": "approved", "baseline_lines": 24, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3184237}, "bruno/digitorn-api-full/credentials/POST api users me credentials -app_id -provider_name mcp stop.bru": {"content": "meta {\n  name: mcp_stop\n  type: http\n  seq: 17\n}\n\npost {\n  url: {{base_url}}/api/users/me/credentials/{{app_id}}/{{provider_name}}/mcp/stop\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Stop an MCP server without deleting its credential.\n  \n  The credential row stays intact so the user can click \"Start\n  again\" without re-filling the form.\n}\n", "language": "text", "size": 381, "lines": 23, "operation": "disk_sync", "updated_at": 1778628123.0345817, "validation": "approved", "baseline_lines": 22, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3184237}, "bruno/digitorn-api-full/credentials/POST api users me credentials -app_id -provider_name oauth refresh.bru": {"content": "meta {\n  name: oauth_refresh\n  type: http\n  seq: 18\n}\n\npost {\n  url: {{base_url}}/api/users/me/credentials/{{app_id}}/{{provider_name}}/oauth/refresh\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nscript:post-response {\n  if (res.status >= 200 && res.status < 300 && res.body) {\n    if (res.body?.access_token != null) bru.setEnvVar(\"access_token\", String(res.body?.access_token));\n    if (res.body?.refresh_token != null) bru.setEnvVar(\"refresh_token\", String(res.body?.refresh_token));\n  }\n}\n\ndocs {\n  Manually trigger a token refresh for an existing OAuth credential.\n  \n  Looks up the stored credential, calls the handler's ``refresh``\n  (which hits the provider's /token endpoint with\n  grant_type=refresh_token), and writes the new access_token back\n  to the store.\n}\n", "language": "text", "size": 801, "lines": 32, "operation": "disk_sync", "updated_at": 1778628123.0345817, "validation": "approved", "baseline_lines": 31, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3184237}, "bruno/digitorn-api-full/credentials/POST api users me credentials -app_id -provider_name oauth start.bru": {"content": "meta {\n  name: oauth_start\n  type: http\n  seq: 19\n}\n\npost {\n  url: {{base_url}}/api/users/me/credentials/{{app_id}}/{{provider_name}}/oauth/start\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Begin the OAuth flow — returns ``auth_url`` and a ``state`` uuid.\n  \n  The client opens ``auth_url`` in a browser; the user consents;\n  the provider redirects back to the daemon's callback route. The\n  client polls ``oauth/status`` to know when the flow completes.\n}\n", "language": "text", "size": 496, "lines": 24, "operation": "disk_sync", "updated_at": 1778628123.046042, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3184237}, "bruno/digitorn-api-full/credentials/PUT api credentials -credential_id.bru": {"content": "meta {\n  name: update_my_credential\n  type: http\n  seq: 20\n}\n\nput {\n  url: {{base_url}}/api/credentials/{{credential_id}}\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"label\": \"\",\n    \"fields\": {}\n  }\n}\n\ndocs {\n  Overwrite label and/or fields on an existing credential.\n}\n", "language": "text", "size": 321, "lines": 27, "operation": "disk_sync", "updated_at": 1778628123.0500875, "validation": "approved", "baseline_lines": 26, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3184237}, "bruno/digitorn-api-full/credentials/PUT api users me credentials -app_id -provider_name.bru": {"content": "meta {\n  name: upsert_credential\n  type: http\n  seq: 21\n}\n\nput {\n  url: {{base_url}}/api/users/me/credentials/{{app_id}}/{{provider_name}}\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"fields\": {},\n    \"scope\": \"\"\n  }\n}\n\ndocs {\n  Create or overwrite a credential for the authenticated user + app.\n  \n  Validates via the declared handler before storing. Use ``app_id=\"_global\"``\n  to store a per-user credential that is shared across every app the\n  user runs (the per_user scope).\n}\n", "language": "text", "size": 532, "lines": 31, "operation": "disk_sync", "updated_at": 1778628123.0515013, "validation": "approved", "baseline_lines": 30, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3184237}, "bruno/digitorn-api-full/discovery/folder.bru": {"content": "meta {\n  name: discovery\n  seq: 30\n}\n", "language": "text", "size": 37, "lines": 5, "operation": "disk_sync", "updated_at": 1778628123.0515013, "validation": "approved", "baseline_lines": 4, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3341155}, "bruno/digitorn-api-full/discovery/GET api discovery modules -module_id.bru": {"content": "meta {\n  name: get_module\n  type: http\n  seq: 2\n}\n\nget {\n  url: {{base_url}}/api/discovery/modules/{{module_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nvars:pre-request {\n  access_token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..EVprq8FPPg38fKpeAQBJ2u6QLELGBnb7yqxkwrlFEho\n  module_id: web\n}\n\ndocs {\n  Return the full action surface of one module.\n  \n  Includes every visible (non-internal) ``@action`` with its params,\n  permissions, risk level, and tool prompt. This is what the builder\n  agent consults when it needs to know \"exactly which params does\n  ``database.sql`` take?\".\n}\n", "language": "text", "size": 1133, "lines": 30, "operation": "disk_sync", "updated_at": 1778628123.064746, "validation": "approved", "baseline_lines": 29, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3184237}, "bruno/digitorn-api-full/discovery/GET api discovery modules.bru": {"content": "meta {\n  name: list_modules\n  type: http\n  seq: 1\n}\n\nget {\n  url: {{base_url}}/api/discovery/modules\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nvars:pre-request {\n  access_token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..EVprq8FPPg38fKpeAQBJ2u6QLELGBnb7yqxkwrlFEho\n}\n\ndocs {\n  List every loaded module with a short summary.\n  \n  Used by the builder agent to enumerate what's available before\n  composing a YAML. Excludes failed-to-load modules — they would\n  only confuse the LLM with names it can't actually use.\n}\n", "language": "text", "size": 1061, "lines": 28, "operation": "disk_sync", "updated_at": 1778628123.064746, "validation": "approved", "baseline_lines": 27, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3184237}, "bruno/digitorn-api-full/discovery/GET api discovery templates -template_id.bru": {"content": "meta {\n  name: get_template\n  type: http\n  seq: 4\n}\n\nget {\n  url: {{base_url}}/api/discovery/templates/{{template_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nvars:pre-request {\n  access_token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..EVprq8FPPg38fKpeAQBJ2u6QLELGBnb7yqxkwrlFEho\n}\n\ndocs {\n  Return the raw YAML of one template by id.\n  \n  The builder copies this YAML and then mutates it (replaces\n  fields, swaps modules, edits the system prompt) before passing it\n  back to ``/compile`` for validation.\n}\n", "language": "text", "size": 1056, "lines": 28, "operation": "disk_sync", "updated_at": 1778628123.072762, "validation": "approved", "baseline_lines": 27, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3184237}, "bruno/digitorn-api-full/discovery/GET api discovery templates.bru": {"content": "meta {\n  name: list_templates\n  type: http\n  seq: 3\n}\n\nget {\n  url: {{base_url}}/api/discovery/templates\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nvars:pre-request {\n  access_token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..EVprq8FPPg38fKpeAQBJ2u6QLELGBnb7yqxkwrlFEho\n}\n\ndocs {\n  List every starter template available in ``knowledge_base/examples``.\n  \n  The builder consults this BEFORE generating from scratch — if a\n  template matches the user's intent, it adapts the template\n  instead, which is dramatically more reliable.\n}\n", "language": "text", "size": 1076, "lines": 28, "operation": "disk_sync", "updated_at": 1778628123.0807912, "validation": "approved", "baseline_lines": 27, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3184237}, "bruno/digitorn-api-full/discovery/GET api discovery triggers configured.bru": {"content": "meta {\n  name: list_configured_triggers\n  type: http\n  seq: 6\n}\n\nget {\n  url: {{base_url}}/api/discovery/triggers/configured\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nvars:pre-request {\n  access_token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..EVprq8FPPg38fKpeAQBJ2u6QLELGBnb7yqxkwrlFEho\n}\n\ndocs {\n  Return every trigger declared by a currently-deployed app.\n  \n  Complements ``GET /api/discovery/triggers`` (which lists trigger\n  *types*). The dashboard uses this route to render \"Automations\n  actives\" across every app without having to fan-out one\n  ``GET /api/apps/{id}/triggers`` per app.\n  \n  Each entry: ``{app_id, trigger_id, type, schedule?, path?, method?}``.\n}\n", "language": "text", "size": 1219, "lines": 31, "operation": "disk_sync", "updated_at": 1778628123.084151, "validation": "approved", "baseline_lines": 30, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3341155}, "bruno/digitorn-api-full/discovery/GET api discovery triggers.bru": {"content": "meta {\n  name: list_triggers\n  type: http\n  seq: 5\n}\n\nget {\n  url: {{base_url}}/api/discovery/triggers\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nvars:pre-request {\n  access_token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..EVprq8FPPg38fKpeAQBJ2u6QLELGBnb7yqxkwrlFEho\n}\n\ndocs {\n  Return every supported trigger type with its category and key fields.\n  \n  The builder consults this to pick the right trigger before\n  composing the YAML. Categorised as ``scheduler`` (cron-like),\n  ``channel`` (chat/email/voice), ``http`` (webhook), and ``system``\n  (queue, log).\n}\n", "language": "text", "size": 1109, "lines": 29, "operation": "disk_sync", "updated_at": 1778628123.0882998, "validation": "approved", "baseline_lines": 28, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3341155}, "bruno/digitorn-api-full/discovery/POST api discovery compile.bru": {"content": "meta {\n  name: compile_yaml\n  type: http\n  seq: 7\n}\n\npost {\n  url: {{base_url}}/api/discovery/compile\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"yaml\": \"\",\n    \"source_path\": \"<inline>\"\n  }\n}\n\ndocs {\n  Compile a YAML app definition without deploying it.\n  \n  This is the **single most important tool** for the App Builder\n  agent. The builder loops:\n  \n      1. generate YAML\n      2. POST /compile\n      3. read errors\n      4. fix and re-POST\n      5. converge or give up\n  \n  Return shape:\n  \n  ```json\n  {\n    \"success\": true,                  // overall HTTP status\n    \"data\": {\n      \"valid\": true,                  // does it compile?\n      \"errors\": [\"...\"],              // list of compile errors\n      \"warnings\": [\"...\"],\n      \"summary\": {                    // present iff valid==true\n        \"app_id\": \"...\",\n        \"name\": \"...\",\n        \"mode\": \"...\",\n        \"agents\": 3,\n        \"modules\": [\"filesystem\", \"memory\"],\n        \"trigger_types\": [\"cron\"],\n        \"session_mode\": \"mono\",\n        \"has_payload_schema\": false\n      }\n    }\n  }\n  ```\n  \n  This route is **side-effect free** — it never persists, deploys,\n  or touches the disk. It's safe to call hundreds of times during a\n  builder iteration loop.\n}\n", "language": "text", "size": 1281, "lines": 63, "operation": "disk_sync", "updated_at": 1778628123.0882998, "validation": "approved", "baseline_lines": 62, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3341155}, "bruno/digitorn-api-full/discovery/POST api discovery generate-package-manifest.bru": {"content": "meta {\n  name: generate_package_manifest_route\n  type: http\n  seq: 8\n}\n\npost {\n  url: {{base_url}}/api/discovery/generate-package-manifest\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"yaml\": \"\",\n    \"publisher\": \"\",\n    \"license\": \"\",\n    \"homepage\": \"\"\n  }\n}\n\ndocs {\n  Compile a YAML and emit a best-effort ``package.toml``.\n  \n  Used by the App Builder agent when a user finishes building an\n  app and wants to wrap it into an installable package, and by\n  the ``digitorn package init`` CLI command.\n  \n  Returns the rendered TOML text + the structured manifest +\n  a list of human-readable warnings (e.g. \"no license declared,\n  required for hub publication\").\n  \n  The route runs the same compile path as ``/compile`` so any\n  YAML errors are surfaced the same way (in ``errors`` field).\n}\n", "language": "text", "size": 844, "lines": 40, "operation": "disk_sync", "updated_at": 1778628123.0882998, "validation": "approved", "baseline_lines": 39, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3341155}, "bruno/digitorn-api-full/discovery/POST api discovery prompt-preview.bru": {"content": "meta {\n  name: prompt_preview\n  type: http\n  seq: 9\n}\n\npost {\n  url: {{base_url}}/api/discovery/prompt-preview\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"bundle_dir\": \"\",\n    \"prompt_name\": \"\",\n    \"content\": \"\",\n    \"app_id\": \"{{app_id}}\",\n    \"locale\": \"en\"\n  }\n}\n\ndocs {\n  Compile a single prompt without deploying an app.\n  \n  Used by the Builder agent and IDE tooling to iterate on\n  prompts live: the client POSTs a bundle path + prompt name\n  (or inline content), the daemon resolves every template\n  namespace against the bundle, runs the markdown rewrite,\n  and returns the final text + token estimate + list of\n  referenced variables / assets.\n  \n  Response shape::\n  \n      {\n          \"compiled_text\": \"You are an agent...\",\n          \"token_estimate\": 187,\n          \"referenced_variables\": [\"app.name\", \"user_locale\"],\n          \"referenced_assets\": [\"/api/apps/_preview/assets/logo.png\"],\n          \"referenced_prompts\": [],\n          \"referenced_skills\": [],\n          \"frontmatter\": { \"version\": 2, ... },\n          \"warnings\": []\n      }\n}\n", "language": "text", "size": 1110, "lines": 50, "operation": "disk_sync", "updated_at": 1778628123.1037903, "validation": "approved", "baseline_lines": 49, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3341155}, "bruno/digitorn-api-full/environments/Local.bru": {"content": "vars {\n  base_url: http://127.0.0.1:8000\n  email: admin@digitorn.local\n  password: changeme-12345\n  username: admin\n  display_name: Admin\n  refresh_token: \n  user_id: \n  app_id: tutorial-hello-world\n  session_id: \n  provider_name: deepseek\n  agent_id: main\n  task_id: \n  credential_id: \n  draft_id: \n  request_id: \n  mcp_server_id: \n  image_id: \n  revision: \n  last_correlation_id: \n  message: Hello from Bruno\n  query: hello\n  draft_name: Bruno draft\n  yaml_path: C:/Users/ASUS/Documents/digitorn-bridge/knowledge_base/tutorials/01-hello-world.yaml\n}\nvars:secret [\n  access_token,\n  password\n]\n", "language": "text", "size": 595, "lines": 30, "operation": "disk_sync", "updated_at": 1778628123.1037903, "validation": "approved", "baseline_lines": 29, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3341155}, "bruno/digitorn-api-full/mcp/DELETE api mcp servers -server_id.bru": {"content": "meta {\n  name: remove_server\n  type: http\n  seq: 13\n}\n\ndelete {\n  url: {{base_url}}/api/mcp/servers/{{mcp_server_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Remove an installed MCP server. **Admin-only.**\n}\n", "language": "text", "size": 251, "lines": 20, "operation": "disk_sync", "updated_at": 1778628123.1158159, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3341155}, "bruno/digitorn-api-full/mcp/folder.bru": {"content": "meta {\n  name: mcp\n  seq: 60\n}\n", "language": "text", "size": 31, "lines": 5, "operation": "disk_sync", "updated_at": 1778628123.1201537, "validation": "approved", "baseline_lines": 4, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.357821}, "bruno/digitorn-api-full/mcp/GET api mcp catalog -server_id.bru": {"content": "meta {\n  name: get_catalog_entry_route\n  type: http\n  seq: 2\n}\n\nget {\n  url: {{base_url}}/api/mcp/catalog/{{mcp_server_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Return the full static CatalogEntry for one server_id.\n  \n  This is the endpoint the install form uses. It returns every\n  field the client needs to render the correct form:\n  \n  - ``env_mapping``: which logical field name maps to which\n    env var the subprocess expects (e.g. ``token`` → ``GITHUB_PERSONAL_ACCESS_TOKEN``)\n  - ``key_descriptions``: human-readable help text per field,\n    shown as TextField helperText\n  - ``oauth_provider`` + ``oauth_scopes``: when set, the\n    server uses OAuth — the client should show a \"Connect\"\n    button instead of a text field\n  - ``default_env``: pre-filled env vars (e.g. Google Drive\n    uses ``GOOGLE_APPLICATION_CREDENTIALS`` pointing at a\n    credential file managed by the daemon)\n  \n  Returns 404 if ``server_id`` is not in the static catalog.\n  For remote-registry entries the client should use the\n  search result fields directly (they don't have env_mapping\n  metadata — remote servers declare their config via their\n  MCP manifest when connected).\n}\n", "language": "text", "size": 1213, "lines": 40, "operation": "disk_sync", "updated_at": 1778628123.1201537, "validation": "approved", "baseline_lines": 39, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3341155}, "bruno/digitorn-api-full/mcp/GET api mcp catalog.bru": {"content": "meta {\n  name: list_catalog_entries\n  type: http\n  seq: 1\n}\n\nget {\n  url: {{base_url}}/api/mcp/catalog\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  category: \n}\n\ndocs {\n  List every entry in the static MCP catalog.\n  \n  This is what the Flutter Hub → MCP Servers tab calls to\n  populate the \"Browse\" view without having to do a search.\n  Returns a compact card-ready shape for each entry — enough\n  to render a grid of installable servers.\n  \n  Use ``GET /api/mcp/catalog/{server_id}`` for the full\n  CatalogEntry with ``env_mapping`` + ``key_descriptions`` so\n  the client can render the install form fields.\n}\n", "language": "text", "size": 658, "lines": 33, "operation": "disk_sync", "updated_at": 1778628123.1282263, "validation": "approved", "baseline_lines": 32, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.3341155}, "bruno/digitorn-api-full/mcp/GET api mcp pool health.bru": {"content": "meta {\n  name: pool_health\n  type: http\n  seq: 4\n}\n\nget {\n  url: {{base_url}}/api/mcp/pool/health\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Run health check on all connected servers in the pool.\n  \n  BUG-067: wrapped in the standard ``{success, data, error}``\n  envelope so clients don't need special-case parsing for this one\n  endpoint.\n}\n", "language": "text", "size": 382, "lines": 24, "operatio