p8�99\t:\u001d\u0003��c��{s�&���%�'��\u001b��5r�\"�ܹ�^�\u0001�\u001e�eOii����;w��.�\u0004����\u000b\u000b���ּ�\u0011����d���\t��C/�|����s缧O�TW�8P\n\u000b�/\u0017�fs��{=�7����_XTÅ���\u0019b��%\u0000\u0001\u0000\u0004\u0000\u0010\u0000@\u0000\u0000\u0001\u0000\u0004\u0000\u0010\u0000@\u0000\u0000\u0001\u0000\u0004\u0000\u0010\u0000@\u0000\u0000\u0001\u0000\u0004\u0000\u0010\u0000@\u0000\u0000\u0001\u0000\u0004\u0000\u0010\u0000@\u0000\u0000\u0001\u0000\u0004\u0000\u0010\u0000@\u0000\u0000\u0001\u0000\u0004\u0000\u0010\u0000@\u0000\u0000\u0001\u0000\u0004\u0000\u0010\u0000@\u0000\u0000\u0001\u0000\u0004\u0000\u0010\u0000@\u0000\u0000\u0001\u0000\u0004\u0000\u0010\u0000@\u0000\u0000\u0001\u0000\u0004\u0000\u0010\u0000@\u0000\u0000\u0001\u0000\u0004\u0000\u0010\u0000@\u0000\u0000\u0001\u0000\u0004\u0000$$�\u000b���c�\u001c�\u0000\u0000\u0000\u0000IEND�B`�", "language": "text", "size": 2987, "lines": 20, "operation": "disk_sync", "updated_at": 1778628118.7806113, "validation": "approved", "baseline_lines": 86, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.0809665}, "apps/digitorn-official/smart-rss-digest/package.toml": {"content": "# ────────────────────────────────────────────────────────────────────\n# Smart RSS Digest — Official Digitorn application\n# ────────────────────────────────────────────────────────────────────\n\n[package]\nid = \"smart-rss-digest\"\nname = \"Smart RSS Digest\"\nversion = \"1.0.1\"\ndescription = \"Aggregates RSS feeds, clusters articles by topic with an LLM, and produces a 5-minute morning brief. Multi-feed, multilingual (FR/EN), conversational follow-ups.\"\nauthor = \"Digitorn\"\nlicense = \"Apache-2.0\"\nicon = \"icon.png\"\ncategory = \"productivity\"\n\n[package.source]\ntype = \"official\"\nverified = true\npublisher = \"digitorn-official\"\n\n[package.compatibility]\ndigitorn_min = \">=1.0.0\"\npython_min = \">=3.12\"\nplatforms = []\n\n[package.requirements]\nmodules = [\"http\", \"memory\", \"context_builder\"]\nrecommended_models = [\n  \"deepseek-chat\",\n  \"claude-haiku-4-5\",\n  \"gpt-4o-mini\",\n]\nexternal_tools = []\nmin_disk_mb = 0\nmin_memory_mb = 64\n\n[package.credentials]\nrequired = []\noptional = [\"deepseek\", \"anthropic\", \"openai\"]\n\n[package.permissions]\nrisk_level = \"low\"\nnetwork_access = true\nfilesystem_access = []\nfilesystem_scopes = []\nrequires_approval = []\n\n[package.hub]\ntags = [\"rss\", \"news\", \"digest\", \"summarization\", \"multilingual\", \"productivity\"]\nscreenshots = []\ndemo_video = \"\"\n\n[package.release]\nreleased_at = \"2026-04-26\"\nrelease_notes = \"Initial release. Single-agent multilingual RSS digester with topic clustering.\"\nbreaking = false\n", "language": "toml", "size": 1425, "lines": 56, "operation": "disk_sync", "updated_at": 1778628118.7911377, "validation": "approved", "baseline_lines": 55, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.086947}, "apps/digitorn-official/smart-rss-digest/README.md": {"content": "# Smart RSS Digest\n\n> Aggregates RSS/Atom feeds, clusters articles by topic with an LLM, and delivers a tight 5-minute brief in your language.\n\n## What it does\n\nYou give it a list of feed URLs (or save them once for re-use). It fetches them, drops anything older than 36 h, clusters the rest into topical groups, and returns a markdown digest you can read in five minutes.\n\nIt's conversational: ask follow-ups (\"more about X\", \"translate to French\", \"drop ycombinator from my list\"), and it remembers your preferences across runs.\n\n## Quick start\n\nAfter installing on your daemon :\n\n```\n/digest                         # use your saved feeds\n/feeds add https://...          # add a feed for next time\n/dive <feed_url> <topic>        # expand on one topic\n```\n\nOr just talk to it :\n\n> \"Build me a brief from these AI feeds: anthropic.com/news/rss.xml, openai.com/blog/rss.xml. French please, max 6 bullets.\"\n\n## What it can NOT do\n\n- It does not crawl arbitrary websites - feeds only.\n- It does not save digests to disk (output stays in chat). If you want disk output, install with `filesystem` granted.\n- It does not send the brief by email/Slack - pair it with a channel module if you need that.\n\n## Architecture\n\n- **One agent**, conversational mode.\n- **Brain**: DeepSeek `deepseek-chat` by default (fast, multilingual, cheap). Anthropic Haiku and OpenAI gpt-4o-mini are also recommended.\n- **Modules**: `http` (feed fetching), `memory` (saved feeds + preferences), `context_builder`.\n- **Permissions**: `risk_level: low`, network only, no filesystem, no shell.\n\n## Provenance\n\nBuilt and maintained by the Digitorn team. Source: `apps/digitorn-official/smart-rss-digest/` in the [digitorn-bridge repo](https://github.com/digitorn/digitorn-bridge).\n", "language": "markdown", "size": 1751, "lines": 41, "operation": "disk_sync", "updated_at": 1778628118.7954416, "validation": "approved", "baseline_lines": 40, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777378984.5527935}, "apps/digitorn-official/smart-rss-digest/prompts/system.md": {"content": "You are **Smart RSS Digest**, a multilingual news curator. Your job is to turn a pile of raw RSS/Atom feeds into a tight, scannable brief that a busy person can read in under five minutes.\n\n## How you work\n\n1. The user gives you one or more **feed URLs** (or asks you to use the feeds saved in memory).\n2. For each URL, call **`http.get`** with the URL. Set `parse_as: \"text\"` so you receive the raw XML.\n3. Parse the feed inline - Atom and RSS 2.0 are both XML, both have `<item>` (RSS) or `<entry>` (Atom) elements with `<title>`, `<link>`, `<pubDate>`/`<published>`, and `<description>`/`<summary>`/`<content>`.\n4. **Filter** :\n   - Keep only items published in the last 36 hours unless the user says otherwise.\n   - Drop pure-image / pure-video items with no text body.\n5. **Cluster** the remaining items into 4–8 topical groups using your own reasoning. Topics emerge from the content (e.g. \"Model releases\", \"Funding rounds\", \"Open-source\", \"Regulation\"), not from a fixed taxonomy.\n6. **Produce the digest** in this exact markdown shape :\n\n   ```\n   # 📰 <Title - e.g. \"Today's AI brief\">\n\n   _<N feeds, M articles, generated <timestamp>>_\n\n   ## <Topic 1>\n   - **<Headline>** - <Source, time ago>\n     <one sentence summary, neutral tone>\n     <link>\n\n   ## <Topic 2>\n   ...\n   ```\n\n7. End with a **single-line key takeaway** (\"**TL;DR:** …\") summarising the most important news of the run.\n\n## Language\n\n- Detect the user's language from their message and reply in it (FR or EN by default).\n- The digest body uses the user's language, even if a feed is in a different language. Translate headlines if needed (mark the original language in italic).\n\n## Memory\n\n- When the user says **\"save these feeds\"** or equivalent → call `memory.remember` with `key=\"rss.feeds\"` and the list of URLs.\n- When the user says **\"use my saved feeds\"** → call `memory.recall` with `key=\"rss.feeds\"` to retrieve them.\n- When the user gives feedback like *\"keep it shorter\"*, *\"group by date instead\"*, *\"always include the source domain\"* → store it under `key=\"rss.preferences\"` and apply on subsequent runs.\n\n## Constraints\n\n- **Never invent** items. If a feed returns nothing recent, say so explicitly: \"*<source>: no new items in the last 36h.*\"\n- **Never fabricate** quotes from articles you have only seen the title of. Summaries must be derived from `<description>` / `<summary>` content, not extrapolation.\n- If a URL fails (404, timeout, malformed XML), report which one failed and continue with the rest. Don't hide errors.\n- Cap the brief at **10 bullets** unless the user asks for more.\n- Keep each bullet to **one sentence** of summary plus the link. No paragraphs.\n- If a story spans multiple feeds (deduplicate), pick the most authoritative source and mention \"*also covered by <X>, <Y>*\" at the end of the bullet.\n\n## Tools you have\n\n- `http.get(url, parse_as=\"text\")` - fetch a feed\n- `memory.remember(key, value)` / `memory.recall(key)` - persist & retrieve user feeds + preferences\n- (No filesystem, no shell - read-only network agent.)\n\n## Tone\n\nNeutral, concise, no marketing fluff. Treat the user as a smart reader who hates clickbait.\n", "language": "markdown", "size": 3146, "lines": 59, "operation": "disk_sync", "updated_at": 1778628118.7954416, "validation": "approved", "baseline_lines": 58, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777378984.5551465}, "apps/digitorn-official/smart-rss-digest/skills/digest.md": {"content": "# /digest - Build today's brief from saved feeds\n\nFetch every URL stored under `memory.recall(\"rss.feeds\")`, build the topic-clustered digest as defined in your system prompt, and return it.\n\nIf the user has no saved feeds, ask them to provide URLs or use one of the quick prompts.\n\nIf the user added arguments after `/digest` (e.g. `/digest --topic AI`), interpret them:\n- `--topic <kw>` → keep only items matching the keyword in the headline or summary\n- `--lang fr|en` → force the digest language\n- `--max <N>` → cap total bullets at N (default 10)\n- `--since <hours>` → time window in hours (default 36)\n\nAlways end with the TL;DR line.\n", "language": "markdown", "size": 641, "lines": 14, "operation": "disk_sync", "updated_at": 1778628118.8055053, "validation": "approved", "baseline_lines": 13, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777378984.5551465}, "apps/digitorn-official/smart-rss-digest/skills/dive.md": {"content": "# /dive - Deep dive on one topic in one feed\n\nUsage: `/dive <feed_url> <topic_keyword>`\n\nSteps :\n1. Re-fetch the feed via `http.get`.\n2. Filter items whose title OR summary contains the topic keyword (case-insensitive, FR/EN).\n3. Return up to 5 items with **expanded** summaries (3–5 sentences each, derived from `<description>`/`<content>`).\n4. End with \"Suggested follow-ups: <bullet list of related search queries>\".\n\nIf 0 items match, say so and suggest broader keywords found in the feed.\n", "language": "markdown", "size": 494, "lines": 12, "operation": "disk_sync", "updated_at": 1778628118.8090942, "validation": "approved", "baseline_lines": 11, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777378984.5551465}, "apps/digitorn-official/smart-rss-digest/skills/feeds.md": {"content": "# /feeds - Manage saved feed URLs\n\nSub-commands :\n\n- `/feeds list` → recall and pretty-print the list stored under `rss.feeds`.\n- `/feeds add <url> [<url> ...]` → recall the current list, append the new URL(s), dedupe, store back.\n- `/feeds remove <url>` → recall, drop the URL, store back.\n- `/feeds clear` → confirm with the user, then store an empty list.\n- `/feeds preferences` → show current `rss.preferences` (max bullets, lang, etc.) and let the user update them.\n\nAlways report back the resulting list count: \"✓ Saved 7 feeds. (was 5)\".\n", "language": "markdown", "size": 545, "lines": 12, "operation": "disk_sync", "updated_at": 1778628118.8123457, "validation": "approved", "baseline_lines": 11, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777378984.5551465}, "bruno/digitorn-api/bruno.json": {"content": "{\n  \"version\": \"1\",\n  \"name\": \"Digitorn API\",\n  \"type\": \"collection\",\n  \"ignore\": [\"node_modules\", \".git\"]\n}\n", "language": "json", "size": 109, "lines": 7, "operation": "disk_sync", "updated_at": 1778628118.8184538, "validation": "approved", "baseline_lines": 6, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4930832}, "bruno/digitorn-api/collection.bru": {"content": "", "language": "text", "size": 0, "lines": 1, "operation": "disk_sync", "updated_at": 1778628118.8184538, "validation": "approved", "baseline_lines": 0, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4930832}, "bruno/digitorn-api/Logout.bru": {"content": "meta {\n  name: Logout\n  type: http\n  seq: 5\n}\n\npost {\n  url: {{base_url}}/auth/logout\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"refresh_token\": \"{{refresh_token}}\"\n  }\n}\n\nscript:post-response {\n  if (res.status === 200) {\n    bru.setEnvVar(\"access_token\", \"\");\n    bru.setEnvVar(\"refresh_token\", \"\");\n  }\n}\n\ndocs {\n  Revokes both the access token (read from the Authorization header) and the refresh token (from the body). Env vars are cleared on success.\n\n  If you get \"Invalid character in header content\", it's a client-side issue — your stored access_token likely has a trailing newline. See Fix: strip the token before setting Bruno env var.\n}\n", "language": "text", "size": 702, "lines": 35, "operation": "disk_sync", "updated_at": 1778628118.8184538, "validation": "approved", "baseline_lines": 34, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4930832}, "bruno/digitorn-api/README.md": {"content": "# Digitorn API - Bruno collection\n\nA curated set of ~35 requests covering the daemon's most-used routes. Every payload and field name was extracted from the actual Pydantic request models in `packages/digitorn/core/api/` - no guessing.\n\n## Install\n\n1. Open Bruno → **Open Collection** → pick this `digitorn-api/` folder.\n2. Select the **Local** environment (top-right).\n3. Edit `environments/Local.bru` - set `email` + `password` for your daemon.\n\n## Intended run order\n\nVariables chain automatically via `script:post-response`:\n\n| Phase | Folder | What it captures |\n|-------|--------|------------------|\n| 0 | `00 - Health` | - |\n| 1 | `01 - Auth` → **Login** | `access_token`, `refresh_token`, `user_id` |\n| 2 | `03 - Discovery` | - |\n| 3 | `04 - Credentials` | - |\n| 4 | `05 - Apps` → **Deploy** | `test_app_id` |\n| 5 | `06 - Sessions` → **Create session** | `session_id` |\n| 6 | `07 - Messages` → **Send message** | - |\n| 7 | `08 - Workspace` | - |\n| 8 | `99 - Cleanup` → **Undeploy** | - |\n\nAll subsequent requests use `Authorization: Bearer {{access_token}}` automatically.\n\n## Beyond the curated set\n\nThe daemon exposes **375 routes** in total. For the exhaustive list, run the **OpenAPI schema** request (`00 - Health/OpenAPI schema.bru`) - that returns the authoritative OpenAPI 3.x JSON which can be imported into Bruno's OpenAPI converter for 1:1 coverage.\n\n## Socket.IO events (not in Bruno)\n\nBruno is HTTP-only - it can't do the Socket.IO handshake. For streamed events (tool_call, message_delta, agent_spawn, approval_request, etc.), open **`socket-io-tester.html`** in your browser instead.\n\nWhat it does:\n- Namespace `/events`, JWT auth via handshake (paste your `access_token` from Login)\n- Click **Connect**, then **Join app room** or **Join session room** (needs app_id + session_id)\n- Every server event is color-coded by kind (turn / tool / agent / approval / compact / system / error) with expandable JSON payloads and running counts\n\nEvent names observed in the code (from `core/events/envelope.py`):\n- **turn**: `message_started`, `message_done`, `token`, `thinking_started`, `thinking_delta`, `assistant_stream_snapshot`\n- **tool**: `tool_start`, `tool_call`, `tool_end`\n- **agent**: `agent_spawn`, `agent_progress`, `agent_result`, `agent_cancel`\n- **approval**: `approval_request`, `approval_resolved`, `approval_progress`\n- **compact**: `compact_started`, `compact_done`\n- **system**: `connected`, `status`, `error`, `abort`\n\nServer emits on a single event name - `\"event\"` - with envelope `{type, kind, app_id, session_id, payload, ts, seq}`. Client emits `join_app` / `leave_app` / `join_session` / `leave_session` with ack callbacks.\n\n**Typical flow to test a full turn:**\n1. Login in Bruno (captures `access_token`)\n2. Open `socket-io-tester.html` → paste base_url + token → Connect\n3. Back in Bruno → Deploy → Create session (captures `session_id`)\n4. In the HTML tester → paste app_id + session_id → **Join session room**\n5. In Bruno → Send message\n6. Watch the stream of `message_started` → `tool_start` → `tool_call` → `tool_end` → `message_done` in the HTML tester\n\n## Common gotchas\n\n- **`503 Retry-After: 2` on `/api/apps/{id}`** - daemon is still warming up after start. Poll `/health` until `warming_up: false`.\n- **`401 Missing Authorization header` on `/docs`** - pre-patch daemon. Restart after the auth middleware fix.\n- **`422` rejecting `audio` field on `/messages`** - POST your audio to `/api/transcribe` first, embed the returned text in `message`.\n- **`Invalid character in header content`** on logout - client-side issue: your stored token has a trailing `\\n`. Strip it before setting the Bruno env var.\n", "language": "markdown", "size": 3657, "lines": 66, "operation": "disk_sync", "updated_at": 1778628118.8184538, "validation": "approved", "baseline_lines": 65, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777378984.5551465}, "bruno/digitorn-api/socket-io-tester.html": {"content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Digitorn — Socket.IO events tester</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body { font: 14px/1.45 system-ui, sans-serif; background: #0d1117; color: #c9d1d9; padding: 16px; }\n  h1 { font-size: 18px; margin-bottom: 12px; color: #e6edf3; }\n  .row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; align-items: center; }\n  label { min-width: 110px; color: #8b949e; font-size: 13px; }\n  input { background: #161b22; border: 1px solid #30363d; color: #c9d1d9; padding: 6px 10px; border-radius: 6px; min-width: 280px; font-family: ui-monospace, monospace; font-size: 13px; }\n  input:focus { border-color: #58a6ff; outline: none; }\n  button { background: #238636; color: white; border: 0; padding: 7px 14px; border-radius: 6px; cursor: pointer; font-weight: 600; }\n  button:hover { background: #2ea043; }\n  button.secondary { background: #30363d; color: #c9d1d9; }\n  button.secondary:hover { background: #484f58; }\n  button.danger { background: #da3633; }\n  .status { padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }\n  .status.disconnected { background: #30363d; color: #8b949e; }\n  .status.connecting { background: #d29922; color: #000; }\n  .status.connected { background: #238636; color: white; }\n  #log { background: #010409; border: 1px solid #30363d; border-radius: 6px; padding: 12px; margin-top: 12px; height: calc(100vh - 280px); overflow-y: auto; font-family: ui-monospace, monospace; font-size: 12px; line-height: 1.5; white-space: pre-wrap; }\n  .event { padding: 6px 8px; margin-bottom: 4px; border-left: 3px solid transparent; }\n  .event.system  { border-color: #8b949e; color: #8b949e; }\n  .event.turn    { border-color: #58a6ff; }\n  .event.tool    { border-color: #d29922; color: #e6edf3; }\n  .event.agent   { border-color: #bc8cff; color: #e6edf3; }\n  .event.approval { border-color: #f85149; color: #ffa198; background: #2d0f0f; }\n  .event.error   { border-color: #f85149; color: #ffa198; background: #2d0f0f; }\n  .event.compact { border-color: #6e7681; color: #8b949e; }\n  .event .time { color: #6e7681; margin-right: 8px; }\n  .event .type { font-weight: 700; margin-right: 8px; }\n  .event details { margin-top: 4px; }\n  .event summary { cursor: pointer; color: #8b949e; font-size: 11px; }\n  .event pre { margin-top: 4px; color: #8b949e; font-size: 11px; max-height: 220px; overflow: auto; }\n  .counts { display: flex; gap: 12px; margin-top: 8px; font-size: 12px; color: #8b949e; }\n  .counts span b { color: #c9d1d9; }\n  .hint { color: #6e7681; font-size: 12px; margin: 6px 0; }\n</style>\n</head>\n<body>\n\n<h1>Digitorn — Socket.IO events tester</h1>\n\n<div class=\"row\">\n  <label>Base URL</label>\n  <input id=\"base\" value=\"http://127.0.0.1:8000\" style=\"min-width: 220px\" />\n  <label style=\"min-width:60px\">Token</label>\n  <input id=\"token\" placeholder=\"Paste JWT access_token (from /auth/login)\" style=\"flex: 1\" />\n</div>\n\n<div class=\"row\">\n  <label>App id</label>\n  <input id=\"appId\" value=\"tutorial-hello-world\" style=\"min-width: 220px\" />\n  <label style=\"min-width:78px\">Session id</label>\n  <input id=\"sessionId\" placeholder=\"(optional, from POST /sessions)\" style=\"flex: 1\" />\n</div>\n\n<div class=\"row\">\n  <button id=\"connect\">Connect</button>\n  <button id=\"joinApp\" class=\"secondary\">Join app room</button>\n  <button id=\"joinSession\" class=\"secondary\">Join session room</button>\n  <button id=\"disconnect\" class=\"danger\">Disconnect</button>\n  <button id=\"clear\" class=\"secondary\">Clear log</button>\n  <span id=\"status\" class=\"status disconnected\">disconnected</span>\n</div>\n\n<div class=\"hint\">\n  Namespace: <code>/events</code>. Auth: JWT via <code>auth: {token}</code> on handshake.\n  Rooms: <code>user:{user_id}</code> (auto), <code>app:{app_id}</code>, <code>session:{sid}</code>.\n  Server emits on a single event name: <code>\"event\"</code>.\n</div>\n\n<div class=\"counts\">\n  <span>Total: <b id=\"cTotal\">0</b></span>\n  <span>system <b id=\"cSystem\">0</b></span>\n  <span>turn <b id=\"cTurn\">0</b></span>\n  <span>tool <b id=\"cTool\">0</b></span>\n  <span>agent <b id=\"cAgent\">0</b></span>\n  <span>approval <b id=\"cApproval\">0</b></span>\n  <span>error <b id=\"cError\">0</b></span>\n  <span>compact <b id=\"cCompact\">0</b></span>\n</div>\n\n<div id=\"log\"></div>\n\n<script src=\"https://cdn.socket.io/4.7.5/socket.io.min.js\"></script>\n<script>\nconst $ = (id) => document.getElementById(id);\nconst log = $(\"log\");\nconst counts = { total: 0, system: 0, turn: 0, tool: 0, agent: 0, approval: 0, error: 0, compact: 0 };\nconst updateCounts = () => {\n  for (const k of Object.keys(counts)) {\n    const el = $(\"c\" + k.charAt(0).toUpperCase() + k.slice(1));\n    if (el) el.textContent = counts[k];\n  }\n};\n\nconst setStatus = (txt, cls) => {\n  const s = $(\"status\");\n  s.textContent = txt;\n  s.className = \"status \" + cls;\n};\n\nlet socket = null;\n\n$(\"connect\").onclick = () => {\n  if (socket && socket.connected) return;\n  const base = $(\"base\").value.trim().replace(/\\/$/, \"\");\n  const token = $(\"token\").value.trim();\n  if (!token) return alert(\"Paste a JWT access_token first.\");\n\n  setStatus(\"connecting…\", \"connecting\");\n  socket = io(base + \"/events\", {\n    transports: [\"websocket\", \"polling\"],\n    auth: { token },\n    reconnection: true,\n    reconnectionAttempts: 3,\n  });\n\n  socket.on(\"connect\", () => {\n    setStatus(\"connected · sid=\" + socket.id, \"connected\");\n    append({ type: \"connected\", kind: \"system\", payload: { sid: socket.id } });\n  });\n\n  socket.on(\"disconnect\", (reason) => {\n    setStatus(\"disconnected (\" + reason + \")\", \"disconnected\");\n    append({ type: \"disconnect\", kind: \"system\", payload: { reason } });\n  });\n\n  socket.on(\"connect_error\", (err) => {\n    setStatus(\"error · \" + err.message, \"disconnected\");\n    append({ type: \"connect_error\", kind: \"error\", payload: { message: err.message } });\n  });\n\n  // The single event fan-out. Envelope is {type, kind, app_id, session_id, payload, ts, seq, ...}\n  socket.on(\"event\", (env) => append(env));\n};\n\n$(\"disconnect\").onclick = () => {\n  if (socket) socket.disconnect();\n  socket = null;\n};\n\n$(\"joinApp\").onclick = () => {\n  if (!socket?.connected) return alert(\"Connect first.\");\n  const app_id = $(\"appId\").value.trim();\n  if (!app_id) return alert(\"Set app_id first.\");\n  socket.emit(\"join_app\", { app_id }, (ack) => {\n    append({ type: \"join_app_ack\", kind: \"system\", payload: ack });\n  });\n};\n\n$(\"joinSession\").onclick = () => {\n  if (!socket?.connected) return alert(\"Connect first.\");\n  const app_id = $(\"appId\").value.trim();\n  const session_id = $(\"sessionId\").value.trim();\n  if (!app_id || !session_id) return alert(\"Set app_id and session_id first.\");\n  socket.emit(\"join_session\", { app_id, session_id }, (ack) => {\n    append({ type: \"join_session_ack\", kind: \"system\", payload: ack });\n  });\n};\n\n$(\"clear\").onclick = () => {\n  log.innerHTML = \"\";\n  for (const k of Object.keys(counts)) counts[k] = 0;\n  updateCounts();\n};\n\nfunction append(env) {\n  const kind = env.kind || \"system\";\n  counts.total++;\n  if (counts[kind] != null) counts[kind]++;\n  updateCounts();\n\n  const row = document.createElement(\"div\");\n  row.className = \"event \" + kind;\n  const t = env.ts || new Date().toISOString();\n  const short = t.split(\"T\")[1]?.replace(/\\..*/, \"\") || t;\n  const payload = JSON.stringify(env.payload || env.data || env, null, 2);\n  row.innerHTML = `<span class=\"time\">${short}</span><span class=\"type\">${env.type || \"?\"}</span>` +\n    `<span>${env.session_id ? \" · sid=\" + env.session_id.slice(0, 8) : \"\"}</span>` +\n    `<details><summary>payload</summary><pre></pre></details>`;\n  row.querySelector(\"pre\").textContent = payload;\n  log.appendChild(row);\n  log.scrollTop = log.scrollHeight;\n}\n</script>\n</body>\n</html>\n", "language": "html", "size": 7741, "lines": 192, "operation": "disk_sync", "updated_at": 1778628118.8184538, "validation": "approved", "baseline_lines": 191, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4930832}, "bruno/digitorn-api/00 - Health/folder.bru": {"content": "meta {\n  name: 00 - Health\n  seq: 2\n}\n", "language": "text", "size": 38, "lines": 5, "operation": "disk_sync", "updated_at": 1778628118.8345337, "validation": "approved", "baseline_lines": 4, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4280386}, "bruno/digitorn-api/00 - Health/Health.bru": {"content": "meta {\n  name: Health\n  type: http\n  seq: 1\n}\n\nget {\n  url: {{base_url}}/health\n  body: none\n  auth: none\n}\n\ndocs {\n  Public endpoint — no auth. Returns daemon status, event loop lag, worker pool stats, and `warming_up: bool` (true while apps are still reloading after daemon start).\n}\n", "language": "text", "size": 286, "lines": 16, "operation": "disk_sync", "updated_at": 1778628118.8345337, "validation": "approved", "baseline_lines": 15, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.42653}, "bruno/digitorn-api/00 - Health/OpenAPI schema.bru": {"content": "meta {\n  name: OpenAPI schema\n  type: http\n  seq: 2\n}\n\nget {\n  url: {{base_url}}/openapi.json\n  body: none\n  auth: none\n}\n\ndocs {\n  Full OpenAPI 3.x schema of every route. Public since the middleware fix. Import into Bruno/Postman/Insomnia to get the 375-route exhaustive list.\n}\n", "language": "text", "size": 280, "lines": 16, "operation": "disk_sync", "updated_at": 1778628118.8453736, "validation": "approved", "baseline_lines": 15, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4280386}, "bruno/digitorn-api/01 - Auth/folder.bru": {"content": "meta {\n  name: 01 - Auth\n  seq: 3\n}\n", "language": "text", "size": 36, "lines": 5, "operation": "disk_sync", "updated_at": 1778628118.8512838, "validation": "approved", "baseline_lines": 4, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4280386}, "bruno/digitorn-api/01 - Auth/Login.bru": {"content": "meta {\n  name: Login\n  type: http\n  seq: 2\n}\n\npost {\n  url: {{base_url}}/auth/login\n  body: json\n  auth: none\n}\n\nbody:json {\n  {\n    \"username\": \"{{username}}\",\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n  }\n}\n\nvars:pre-request {\n  email: mbathepaul@gmail.com\n  password: @#Fa22raptor\n  username: mouchard\n}\n\nscript:post-response {\n  if (res.status === 200 && res.body?.access_token) {\n    bru.setEnvVar(\"access_token\", res.body.access_token);\n    bru.setEnvVar(\"refresh_token\", res.body.refresh_token || \"\");\n    bru.setEnvVar(\"user_id\", res.body.user_id || \"\");\n  }\n}\n\ndocs {\n  Exchanges credentials for a JWT. Response is captured into env vars (`access_token`, `refresh_token`, `user_id`) so every following request uses `Authorization: Bearer {{access_token}}` automatically.\n\n  The body sends BOTH `username` and `email`. The backend accepts either:\n  - if `username` is non-empty, it looks up by external_id = username\n  - else if `email` is non-empty, it looks up by email OR external_id = email\n  - else returns \"Username or email is required\"\n\n  So you only need ONE of the two vars to be set to a real account value. The other can stay as an empty env var — the server ignores empty fields.\n\n  **Troubleshooting** — if you get \"Username or email is required\" even though vars are set: `vars:pre-request` doesn't always substitute into body:json depending on Bruno version. Canonical fix: edit `environments/Local.bru` and put your real credentials there (replace `admin@digitorn.local` + `changeme-12345`).\n}\n", "language": "text", "size": 1534, "lines": 47, "operation": "disk_sync", "updated_at": 1778628118.855711, "validation": "approved", "baseline_lines": 46, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4280386}, "bruno/digitorn-api/01 - Auth/Me.bru": {"content": "meta {\n  name: Me\n  type: http\n  seq: 4\n}\n\nget {\n  url: {{base_url}}/auth/me\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Returns the authenticated caller's profile: user_id, email, roles, permissions, is_admin, avatar_url, etc. Quick way to verify your token is still valid.\n}\n", "language": "text", "size": 316, "lines": 20, "operation": "disk_sync", "updated_at": 1778628118.8583515, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4280386}, "bruno/digitorn-api/01 - Auth/Refresh.bru": {"content": "meta {\n  name: Refresh\n  type: http\n  seq: 3\n}\n\npost {\n  url: {{base_url}}/auth/refresh\n  body: json\n  auth: none\n}\n\nbody:json {\n  {\n    \"refresh_token\": \"{{refresh_token}}\"\n  }\n}\n\nscript:post-response {\n  if (res.status === 200 && res.body?.access_token) {\n    bru.setEnvVar(\"access_token\", res.body.access_token);\n    if (res.body.refresh_token) {\n      bru.setEnvVar(\"refresh_token\", res.body.refresh_token);\n    }\n  }\n}\n\ndocs {\n  Exchanges a refresh token for a new access token. Call when the access token expires (default TTL: 15 minutes). The refresh token itself is long-lived (7 days) and rotated on each use.\n}\n", "language": "text", "size": 621, "lines": 31, "operation": "disk_sync", "updated_at": 1778628118.8649826, "validation": "approved", "baseline_lines": 30, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4280386}, "bruno/digitorn-api/01 - Auth/Register.bru": {"content": "meta {\n  name: Register\n  type: http\n  seq: 1\n}\n\npost {\n  url: {{base_url}}/auth/register\n  body: json\n  auth: none\n}\n\nbody:json {\n  {\n    \"username\": \"mouchard\",\n    \"password\": \"{{password}}\",\n    \"email\": \"{{email}}\",\n    \"display_name\": \"Admin\"\n  }\n}\n\nvars:pre-request {\n  password: @#Fa22raptor\n  email: paul.mbathe1@gmail.com\n  base_url: http://127.0.0.1:8000\n}\n\ndocs {\n  Creates a local user account. Password must be 12-128 chars. First user on a fresh daemon typically gets admin role. Skip if your daemon already has users.\n}\n", "language": "text", "size": 536, "lines": 31, "operation": "disk_sync", "updated_at": 1778628118.8661482, "validation": "approved", "baseline_lines": 30, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4280386}, "bruno/digitorn-api/02 - User/folder.bru": {"content": "meta {\n  name: 02 - User\n  seq: 4\n}\n", "language": "text", "size": 36, "lines": 5, "operation": "disk_sync", "updated_at": 1778628118.870682, "validation": "approved", "baseline_lines": 4, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4373314}, "bruno/digitorn-api/02 - User/My profile.bru": {"content": "meta {\n  name: My profile\n  type: http\n  seq: 1\n}\n\nget {\n  url: {{base_url}}/api/users/me/profile\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Full user profile (more than /auth/me): preferences, avatar URL, theme, etc. Real route is /api/users/me/profile (the router is mounted at /api/users/me and defines /profile internally).\n}\n", "language": "text", "size": 370, "lines": 20, "operation": "disk_sync", "updated_at": 1778628118.875458, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4373314}, "bruno/digitorn-api/02 - User/My sessions.bru": {"content": "meta {\n  name: My sessions\n  type: http\n  seq: 2\n}\n\nget {\n  url: {{base_url}}/api/users/me/sessions\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Every session the caller currently owns, across all apps. Useful to find orphaned sessions to clean up, or to resume a session whose id was lost.\n}\n", "language": "text", "size": 331, "lines": 20, "operation": "disk_sync", "updated_at": 1778628118.8826303, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4373314}, "bruno/digitorn-api/03 - Discovery/Compile YAML.bru": {"content": "meta {\n  name: Compile YAML\n  type: http\n  seq: 5\n}\n\npost {\n  url: {{base_url}}/api/discovery/compile\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"yaml\": \"app:\\n  app_id: probe\\n  name: Probe\\nagents:\\n  - id: main\\n    brain:\\n      provider: anthropic\\n      model: claude-haiku-4-5-20251001\\n      config:\\n        api_key: claude-code\\n    system_prompt: Hi.\\nexecution:\\n  mode: conversation\\n  entry_agent: main\\ncapabilities:\\n  default_policy: auto\\n  max_risk_level: low\\n  grant: []\\n\",\n    \"source_path\": \"<bruno>\"\n  }\n}\n\ndocs {\n  Dry-run compile: returns the resolved config + errors list without persisting anything. Ideal to verify a YAML draft before calling /deploy.\n}\n", "language": "text", "size": 735, "lines": 27, "operation": "disk_sync", "updated_at": 1778628121.9184265, "validation": "approved", "baseline_lines": 26, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4393425}, "bruno/digitorn-api/03 - Discovery/folder.bru": {"content": "meta {\n  name: 03 - Discovery\n  seq: 5\n}\n", "language": "text", "size": 41, "lines": 5, "operation": "disk_sync", "updated_at": 1778628121.926771, "validation": "approved", "baseline_lines": 4, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4439235}, "bruno/digitorn-api/03 - Discovery/Inspect module.bru": {"content": "meta {\n  name: Inspect module\n  type: http\n  seq: 2\n}\n\nget {\n  url: {{base_url}}/api/discovery/modules/filesystem\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Full action catalogue for a module: name, description, params (name, type, required, default), risk_level. The canonical source the architect should query before declaring grants.\n}\n", "language": "text", "size": 379, "lines": 20, "operation": "disk_sync", "updated_at": 1778628121.926771, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4393425}, "bruno/digitorn-api/03 - Discovery/List modules.bru": {"content": "meta {\n  name: List modules\n  type: http\n  seq: 1\n}\n\nget {\n  url: {{base_url}}/api/discovery/modules\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Ground truth for every module registered in the daemon (21 in the current build). Use this when writing an app.yaml to confirm a module id exists before granting its actions.\n}\n", "language": "text", "size": 361, "lines": 20, "operation": "disk_sync", "updated_at": 1778628121.9354851, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4419105}, "bruno/digitorn-api/03 - Discovery/List templates.bru": {"content": "meta {\n  name: List templates\n  type: http\n  seq: 4\n}\n\nget {\n  url: {{base_url}}/api/discovery/templates\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n", "language": "text", "size": 178, "lines": 16, "operation": "disk_sync", "updated_at": 1778628121.9354851, "validation": "approved", "baseline_lines": 15, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.4419105}, "bruno/digitorn-api/03 - Discovery/List triggers.bru": {"content": "meta {\n  name: List triggers\n  type: http\n  seq: 3\n}\n\nget {\n  url: {{base_url}}/api/discovery/triggers\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Returns the