nd\nruntime:\n  mode: background\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: You process incoming webhook events. Describe each event and suggest an appropriate\n    action.\ntools:\n  modules:\n    channels:\n      config:\n        providers:\n          events:\n            adapter: webhook\n            config:\n              inbound_path: /hook/events\n            activation:\n              message: 'Webhook received: {{event.payload.action}} - {{event.payload.item}}'\n", "language": "yaml", "size": 682, "lines": 28, "operation": "disk_sync", "updated_at": 1778628125.3117993, "validation": "approved", "baseline_lines": 27, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777969771.3907459}, "examples/channels/06-webhook-auth-hmac.yaml": {"content": "app:\n  app_id: channels-06-hmac\n  name: Webhook HMAC Auth\nruntime:\n  mode: background\nagents:\n- id: main\n  brain:\n    provider: deepseek\n    model: deepseek-chat\n    backend: openai_compat\n    config:\n      base_url: https://api.deepseek.com/v1\n      api_key: '{{env.DEEPSEEK_API_KEY}}'\n  role: You process authenticated webhook events. Confirm receipt and describe the\n    event.\ntools:\n  modules:\n    channels:\n      config:\n        providers:\n          secure:\n            adapter: webhook\n            config:\n              inbound_path: /hook/secure\n              auth: signature\n              signature_secret: '{{webhook_secret}}'\n              signature_header: X-Signature-256\n            activation:\n              message: 'Authenticated event: {{event.payload.event}} - status: {{event.payload.status}}'\ndev:\n  variables:\n    webhook_secret: '{{env.WEBHOOK_SECRET}}'\n", "language": "yaml", "size": 8