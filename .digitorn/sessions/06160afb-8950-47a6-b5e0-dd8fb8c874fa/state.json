sion Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/background-sessions/{bg_session_id}/resume\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Resume Background Session\",\n        \"description\": \"Resume a paused background session.\",\n        \"operationId\": \"resume_background_session_api_apps__app_id__background_sessions__bg_session_id__resume_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"bg_session_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Bg Session Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/payload-schema\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get App Payload Schema\",\n        \"description\": \"Return the declarative payload schema for a background app.\\n\\nThe Flutter dashboard calls this once per app to render a typed\\nform (instead of a generic key/value editor) and to know which\\nfields/files are required before a session can be activated.\\n\\nReturns ``data: null`` when the app has no schema declared \\u2014 the\\ndashboard should fall back to the free-form editor in that case.\",\n        \"operationId\": \"get_app_payload_schema_api_apps__app_id__payload_schema_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/background-sessions/