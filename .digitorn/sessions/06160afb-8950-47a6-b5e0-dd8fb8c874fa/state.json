00\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/sessions/{session_id}/workspace/commit\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Commit Session Endpoint\",\n        \"description\": \"Commit approved files to git \\u2014 one-shot ship to the session's repo.\",\n        \"operationId\": \"commit_session_endpoint_api_apps__app_id__sessions__session_id__workspace_commit_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"session_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Session Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/CommitRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/sessions/{session_id}/workspace/git-status\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Refresh Git Status\",\n        \"description\": \"Trigger a git status refresh \\u2014 emits `resource_patched` for every file.\",\n        \"operationId\": \"refresh_git_status_api_apps__app_id__sessions__session_id__workspace_git_status_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"session_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Session Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/sessions/{session_id}/lsp/request\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Lsp Rpc Request\",\n        \"description\": \"Forward an LSP RPC to the language server backing the given file.\\n\\nThis is the sole entry point clients (Monaco, ``useLspRequest`` Flutter\\nhook, custom tooling) use for hover / goto / references / completion /\\nrename / signature help. The daemon doesn't reshape payloads \\u2014 LSP\\nspec semantics are the contract.\\n\\nReturns::\\n\\n    {\\\"success\\\": true, \\\"data\\\": {\\\"server\\\": \\\"pyright\\\", \\\"method\\\": \\\"...\\\",\\n                                \\\"result\\\": <lsp response>}}\\n\\nError responses map cleanly to HTTP semantics:\\n\\n- 404 \\u2014 app not deployed or has no LSP module\\n- 400 \\u2014 file extension has no registered server, or server not\\n         installed, or method unsupported (protocol=compiler/linter)\\n- 504 \\u2014 server responded with None (timeout)\",\n        \"operationId\": \"lsp_rpc_request_api_apps__app_id__sessions__session_id__lsp_request_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"session_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Session Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/LspRpcRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/sessions/{session_id}/lsp/cancel\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Lsp Rpc Cancel\",\n        \"description\": \"Cancel an in-flight LSP request by ``request_id``.\\n\\nSafe to call on already-completed requests (returns ``cancelled:\\nfalse, already_done: true``). Returns ``request not found`` if the\\nid never existed or was already cleaned up.\\n\\nTypical UX: Monaco fires an abort token on a completion request,\\nthe client catches it and hits this endpoint with the correlation\\nid it sent in the original /lsp/request call.\",\n        \"operationId\": \"lsp_rpc_cancel_api_apps__app_id__sessions__session_id__lsp_cancel_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"session_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Session Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/LspCancelRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/triggers\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"App Triggers\",\n        \"description\": \"Get the status of all triggers and channels for a background app.\\n\\nShows configured triggers, active listeners, last activation times,\\nand any errors. Useful for monitoring background apps.\",\n        \"operationId\": \"app_triggers_api_apps__app_id__triggers_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/background-sessions\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Create Background Session\",\n        \"description\": \"Create a new background session for the authenticated user.\\n\\nIn multi mode, each user can create multiple sessions with custom params\\n(e.g. different CVs, different configs). In mono mode, this is a no-op \\u2014\\nthe session is auto-created on first trigger.\",\n        \"operationId\": \"create_background_session_api_apps__app_id__background_sessions_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/BackgroundSessionCreateRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"List Background Sessions\",\n        \"description\": \"List background sessions for the authenticated user.\",\n        \"operationId\": \"list_background_sessions_api_apps__app_id__background_sessions_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"limit\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"default\": 50,\n              \"title\": \"Limit\"\n            }\n          },\n          {\n            \"name\": \"offset\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"default\": 0,\n              \"title\": \"Offset\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/