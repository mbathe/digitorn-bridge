{"format": "digitorn.workspace.snapshot", "version": 2, "app_id": "digitorn-lovable", "user_id": "3cab19cab19f4d588a5b121972989a9d", "session_id": "06160afb-8950-47a6-b5e0-dd8fb8c874fa", "state": {"workspace": {"render_mode": "react", "entry_file": "src/App.tsx", "is_git_repo": true, "title": "Digitorn Lovable"}, "files:warned": true}, "resources": {"files": {"package.json": {"content": "{\n  \"name\": \"lovable-clone\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"tsc && vite build\",\n    \"preview\": \"vite preview\"\n  },\n  \"dependencies\": {\n    \"react\": \"^18.2.0\",\n    \"react-dom\": \"^18.2.0\",\n    \"lucide-react\": \"^0.294.0\"\n  },\n  \"devDependencies\": {\n    \"@types/react\": \"^18.2.43\",\n    \"@types/react-dom\": \"^18.2.17\",\n    \"@vitejs/plugin-react\": \"^4.2.1\",\n    \"typescript\": \"^5.2.2\",\n    \"vite\": \"^5.0.8\"\n  }\n}\n", "language": "json", "size": 485, "lines": 24, "operation": "disk_sync", "updated_at": 1778628406.0105205, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 46, "total_deletions": 9, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1778628402.0011811}, "index.html": {"content": "<!doctype html>\n<html lang=\"fr\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/vite.svg\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Lovable Clone</title>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n", "language": "html", "size": 362, "lines": 14, "operation": "disk_sync", "updated_at": 1778628405.984872, "validation": "approved", "baseline_lines": 13, "insertions": 0, "deletions": 0, "total_insertions": 27, "total_deletions": 12, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1778628402.052086}, "src/App.jsx": {"content": "import React, { useState } from 'react'\nimport Header from './components/Header'\nimport Sidebar from './components/Sidebar'\nimport Editor from './components/Editor'\nimport Preview from './components/Preview'\nimport ChatPanel from './components/ChatPanel'\nimport './App.css'\n\nfunction App() {\n  const [code, setCode] = useState(`<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Mon Application</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      min-height: 100vh;\n      margin: 0;\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    }\n    .container {\n      text-align: center;\n      background: white;\n      padding: 3rem;\n      border-radius: 20px;\n      box-shadow: 0 20px 60px rgba(0,0,0,0.3);\n    }\n    h1 {\n      color: #333;\n      margin-bottom: 1rem;\n    }\n    button {\n      background: #667eea;\n      color: white;\n      border: none;\n      padding: 12px 30px;\n      font-size: 16px;\n      border-radius: 8px;\n      cursor: pointer;\n      transition: all 0.3s;\n    }\n    button:hover {\n      background: #764ba2;\n      transform: translateY(-2px);\n      box-shadow: 0 5px 15px rgba(0,0,0,0.2);\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <h1>🎉 Bienvenue sur votre application!</h1>\n    <p>Créée avec Lovable Clone</p>\n    <button onclick=\"alert('Hello World!')\">Cliquez-moi!</button>\n  </div>\n</body>\n</html>`)\n\n  const [messages, setMessages] = useState([\n    {\n      role: 'assistant',\n      content: 'Bonjour! 👋 Je suis votre assistant IA. Décrivez-moi l\\'application que vous souhaitez créer et je vais la générer pour vous!'\n    }\n  ])\n\n  const [showPreview, setShowPreview] = useState(true)\n  const [showChat, setShowChat] = useState(true)\n\n  const handleSendMessage = (message) => {\n    setMessages([...messages, { role: 'user', content: message }])\n    \n    // Simulation d'une réponse IA\n    setTimeout(() => {\n      const response = generateAIResponse(message)\n      setMessages(prev => [...prev, { role: 'assistant', content: response }])\n      \n      // Si le message demande de créer quelque chose, mettre à jour le code\n      if (message.toLowerCase().includes('créer') || message.toLowerCase().includes('faire') || message.toLowerCase().includes('génér')) {\n        setTimeout(() => {\n          const newCode = generateCode(message)\n          setCode(newCode)\n        }, 500)\n      }\n    }, 1000)\n  }\n\n  const generateAIResponse = (message) => {\n    const lowerMessage = message.toLowerCase()\n    \n    if (lowerMessage.includes('todo') || lowerMessage.includes('tâche')) {\n      return \"Parfait! Je vais créer une application de liste de tâches pour vous avec un design moderne. ✨\"\n    } else if (lowerMessage.includes('calculatrice') || lowerMessage.includes('calcul')) {\n      return \"Excellent choix! Je crée une calculatrice élégante pour vous. 🧮\"\n    } else if (lowerMessage.includes('compteur') || lowerMessage.includes('counter')) {\n      return \"Super! Voici un compteur interactif avec des animations. 🔢\"\n    } else if (lowerMessage.includes('formulaire') || lowerMessage.includes('form')) {\n      return \"Je génère un formulaire stylisé pour vous. 📝\"\n    } else {\n      return \"Je comprends! Laissez-moi créer cela pour vous... 🚀\"\n    }\n  }\n\n  const generateCode = (message) => {\n    const lowerMessage = message.toLowerCase()\n    \n    if (lowerMessage.includes('todo') || lowerMessage.includes('tâche')) {\n      return `<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Liste de Tâches</title>\n  <style>\n    body {\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n      min-height: 100vh;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      padding: 20px;\n    }\n    .container {\n      background: white;\n      border-radius: 15px;\n      box-shadow: 0 20px 60px rgba(0,0,0,0.3);\n      padding: 2rem;\n      width: 100%;\n      max-width: 500px;\n    }\n    h1 {\n      color: #667eea;\n      margin-bottom: 1.5rem;\n      text-align: center;\n    }\n    .input-group {\n      display: flex;\n      gap: 10px;\n      margin-bottom: 1.5rem;\n    }\n    input {\n      flex: 1;\n      padding: 12px;\n      border: 2px solid #e0e0e0;\n      border-radius: 8px;\n      font-size: 16px;\n    }\n    input:focus {\n      outline: none;\n      border-color: #667eea;\n    }\n    button {\n      background: #667eea;\n      color: white;\n      border: none;\n      padding: 12px 24px;\n      border-radius: 8px;\n      cursor: pointer;\n      font-size: 16px;\n      transition: all 0.3s;\n    }\n    button:hover {\n      background: #764ba2;\n      transform: translateY(-2px);\n    }\n    .todo-list {\n      list-style: none;\n    }\n    .todo-item {\n      background: #f8f9fa;\n      padding: 15px;\n      margin-bottom: 10px;\n      border-radius: 8px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      transition: all 0.3s;\n    }\n    .todo-item:hover {\n      transform: translateX(5px);\n      box-shadow: 0 5px 15px rgba(0,0,0,0.1);\n    }\n    .todo-item.completed {\n      opacity: 0.6;\n      text-decoration: line-through;\n    }\n    .delete-btn {\n      background: #ff4757;\n      padding: 8px 16px;\n      font-size: 14px;\n    }\n    .delete-btn:hover {\n      background: #ee5a6f;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <h1>📝 Ma Liste de Tâches</h1>\n    <div class=\"input-group\">\n      <input type=\"text\" id=\"taskInput\" placeholder=\"Ajouter une nouvelle tâche...\">\n      <button onclick=\"addTask()\">Ajouter</button>\n    </div>\n    <ul class=\"todo-list\" id=\"todoList\"></ul>\n  </div>\n\n  <script>\n    let tasks = [];\n\n    function addTask() {\n      const input = document.getElementById('taskInput');\n      const task = input.value.trim();\n      \n      if (task) {\n        tasks.push({ text: task, completed: false });\n        input.value = '';\n        renderTasks();\n      }\n    }\n\n    function toggleTask(index) {\n      tasks[index].completed = !tasks[index].completed;\n      renderTasks();\n    }\n\n    function deleteTask(index) {\n      tasks.splice(index, 1);\n      renderTasks();\n    }\n\n    function renderTasks() {\n      const list = document.getElementById('todoList');\n      list.innerHTML = tasks.map((task, index) => \\`\n        <li class=\"todo-item \\${task.completed ? 'completed' : ''}\" onclick=\"toggleTask(\\${index})\">\n          <span>\\${task.text}</span>\n          <button class=\"delete-btn\" onclick=\"event.stopPropagation(); deleteTask(\\${index})\">Supprimer</button>\n        </li>\n      \\`).join('');\n    }\n\n    document.getElementById('taskInput').addEventListener('keypress', (e) => {\n      if (e.key === 'Enter') addTask();\n    });\n  </script>\n</body>\n</html>`\n    } else if (lowerMessage.includes('calculatrice') || lowerMessage.includes('calcul')) {\n      return `<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Calculatrice</title>\n  <style>\n    body {\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);\n      min-height: 100vh;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n    }\n    .calculator {\n      background: white;\n      border-radius: 20px;\n      box-shadow: 0 20px 60px rgba(0,0,0,0.3);\n      padding: 20px;\n      width: 320px;\n    }\n    .display {\n      background: #1e3c72;\n      color: white;\n      font-size: 2.5rem;\n      padding: 20px;\n      border-radius: 10px;\n      text-align: right;\n      margin-bottom: 20px;\n      min-height: 60px;\n      word-wrap: break-word;\n    }\n    .buttons {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 10px;\n    }\n    button {\n      padding: 20px;\n      font-size: 1.5rem;\n      border: none;\n      border-radius: 10px;\n      cursor: pointer;\n      transition: all 0.3s;\n      background: #f0f0f0;\n    }\n    button:hover {\n      background: #e0e0e0;\n      transform: scale(1.05);\n    }\n    button:active {\n      transform: scale(0.95);\n    }\n    .operator {\n      background: #2a5298;\n      color: white;\n    }\n    .operator:hover {\n      background: #1e3c72;\n    }\n    .equals {\n      background: #27ae60;\n      color: white;\n      grid-column: span 2;\n    }\n    .equals:hover {\n      background: #229954;\n    }\n    .clear {\n      background: #e74c3c;\n      color: white;\n      grid-column: span 2;\n    }\n    .clear:hover {\n      background: #c0392b;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"calculator\">\n    <div class=\"display\" id=\"display\">0</div>\n    <div class=\"buttons\">\n      <button class=\"clear\" onclick=\"clearDisplay()\">C</button>\n      <button class=\"operator\" onclick=\"appendOperator('/')\">/</button>\n      <button class=\"operator\" onclick=\"appendOperator('*')\">×</button>\n      <button onclick=\"appendNumber('7')\">7</button>\n      <button onclick=\"appendNumber('8')\">8</button>\n      <button onclick=\"appendNumber('9')\">9</button>\n      <button class=\"operator\" onclick=\"appendOperator('-')\">-</button>\n      <button onclick=\"appendNumber('4')\">4</button>\n      <button onclick=\"appendNumber('5')\">5</button>\n      <button onclick=\"appendNumber('6')\">6</button>\n      <button class=\"operator\" onclick=\"appendOperator('+')\">+</button>\n      <button onclick=\"appendNumber('1')\">1</button>\n      <button onclick=\"appendNumber('2')\">2</button>\n      <button onclick=\"appendNumber('3')\">3</button>\n      <button class=\"equals\" onclick=\"calculate()\">=</button>\n      <button onclick=\"appendNumber('0')\" style=\"grid-column: span 2;\">0</button>\n      <button onclick=\"appendNumber('.')\">.</button>\n    </div>\n  </div>\n\n  <script>\n    let display = document.getElementById('display');\n    let currentValue = '0';\n\n    function appendNumber(num) {\n      if (currentValue === '0') {\n        currentValue = num;\n      } else {\n        currentValue += num;\n      }\n      display.textContent = currentValue;\n    }\n\n    function appendOperator(op) {\n      currentValue += ' ' + op + ' ';\n      display.textContent = currentValue;\n    }\n\n    function clearDisplay() {\n      currentValue = '0';\n      display.textContent = currentValue;\n    }\n\n    function calculate() {\n      try {\n        currentValue = eval(currentValue).toString();\n        display.textContent = currentValue;\n      } catch (e) {\n        display.textContent = 'Erreur';\n        currentValue = '0';\n      }\n    }\n  </script>\n</body>\n</html>`\n    } else if (lowerMessage.includes('compteur') || lowerMessage.includes('counter')) {\n      return `<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Compteur</title>\n  <style>\n    body {\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);\n      min-height: 100vh;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n    }\n    .container {\n      background: white;\n      border-radius: 20px;\n      box-shadow: 0 20px 60px rgba(0,0,0,0.3);\n      padding: 3rem;\n      text-align: center;\n    }\n    h1 {\n      color: #333;\n      margin-bottom: 2rem;\n    }\n    .counter {\n      font-size: 6rem;\n      font-weight: bold;\n      color: #f5576c;\n      margin: 2rem 0;\n      transition: all 0.3s;\n    }\n    .buttons {\n      display: flex;\n      gap: 1rem;\n      justify-content: center;\n    }\n    button {\n      padding: 15px 30px;\n      font-size: 1.2rem;\n      border: none;\n      border-radius: 10px;\n      cursor: pointer;\n      transition: all 0.3s;\n      font-weight: bold;\n    }\n    .increment {\n      background: #27ae60;\n      color: white;\n    }\n    .increment:hover {\n      background: #229954;\n      transform: translateY(-3px);\n      box-shadow: 0 10px 20px rgba(0,0,0,0.2);\n    }\n    .decrement {\n      background: #e74c3c;\n      color: white;\n    }\n    .decrement:hover {\n      background: #c0392b;\n      transform: translateY(-3px);\n      box-shadow: 0 10px 20px rgba(0,0,0,0.2);\n    }\n    .reset {\n      background: #3498db;\n      color: white;\n    }\n    .reset:hover {\n      background: #2980b9;\n      transform: translateY(-3px);\n      box-shadow: 0 10px 20px rgba(0,0,0,0.2);\n    }\n    button:active {\n      transform: translateY(-1px);\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <h1>🔢 Compteur Interactif</h1>\n    <div class=\"counter\" id=\"counter\">0</div>\n    <div class=\"buttons\">\n      <button class=\"decrement\" onclick=\"decrement()\">- Décrémenter</button>\n      <button class=\"reset\" onclick=\"reset()\">↻ Reset</button>\n      <button class=\"increment\" onclick=\"increment()\">+ Incrémenter</button>\n    </div>\n  </div>\n\n  <script>\n    let count = 0;\n    const counterElement = document.getElementById('counter');\n\n    function updateDisplay() {\n      counterElement.textContent = count;\n      counterElement.style.transform = 'scale(1.2)';\n      setTimeout(() => {\n        counterElement.style.transform = 'scale(1)';\n      }, 200);\n    }\n\n    function increment() {\n      count++;\n      updateDisplay();\n    }\n\n    function decrement() {\n      count--;\n      updateDisplay();\n    }\n\n    function reset() {\n      count = 0;\n      updateDisplay();\n    }\n  </script>\n</body>\n</html>`\n    }\n    \n    return code\n  }\n\n  return (\n    <div className=\"app\">\n      <Header />\n      <div className=\"main-content\">\n        <Sidebar \n          showPreview={showPreview} \n          setShowPreview={setShowPreview}\n          showChat={showChat}\n          setShowChat={setShowChat}\n        />\n        <div className=\"workspace\">\n          <Editor code={code} setCode={setCode} />\n          {showPreview && <Preview code={code} />}\n        </div>\n        {showChat && <ChatPanel messages={messages} onSendMessage={handleSendMessage} />}\n      </div>\n    </div>\n  )\n}\n\nexport default App\n", "language": "jsx", "size": 14151, "lines": 536, "operation": "disk_sync", "updated_at": 1778628406.1061115, "validation": "approved", "baseline_lines": 535, "insertions": 0, "deletions": 0, "total_insertions": 536, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1778628072.8715365}, "src/App.css": {"content": ".app {\n  display: flex;\n  flex-direction: column;\n  height: 100vh;\n  overflow: hidden;\n}\n\n.main-content {\n  display: flex;\n  flex: 1;\n  overflow: hidden;\n}\n\n.workspace {\n  display: flex;\n  flex: 1;\n  overflow: hidden;\n  gap: 1px;\n  background: #1a1a24;\n}\n", "language": "css", "size": 255, "lines": 21, "operation": "disk_sync", "updated_at": 1778628406.0998032, "validation": "approved", "baseline_lines": 20, "insertions": 0, "deletions": 0, "total_insertions": 21, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1778628072.900667}, "package-lock.json": {"content": "{\n  \"name\