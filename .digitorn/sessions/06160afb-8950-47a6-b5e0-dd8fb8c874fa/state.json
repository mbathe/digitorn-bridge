questBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/PayloadSetRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"delete\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Clear Background Session Payload\",\n        \"description\": \"Remove the entire payload (prompt + metadata + all files) for a session.\",\n        \"operationId\": \"clear_background_session_payload_api_apps__app_id__background_sessions__bg_session_id__payload_delete\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"bg_session_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Bg Session Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/background-sessions/{bg_session_id}/payload/files\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Upload Background Session Payload File\",\n        \"description\": \"Attach a file to a session payload (multipart upload).\\n\\nThe file bytes are stored on disk under\\n``~/.digitorn/apps/<app_id>/sessions/<sid>/payload/`` and an entry\\nis added to the payload's ``files`` list so the injection layer can\\nsurface its path to the agent at trigger time.\",\n        \"operationId\": \"upload_background_session_payload_file_api_apps__app_id__background_sessions__bg_session_id__payload_files_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"bg_session_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Bg Session Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"multipart/form-data\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/Body_upload_background_session_payload_file_api_apps__app_id__background_sessions__bg_session_id__payload_files_post\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/background-sessions/{bg_session_id}/payload/files/{filename}\": {\n      \"delete\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Delete Background Session Payload File\",\n        \"description\": \"Remove a single file from a session payload.\",\n        \"operationId\": \"delete_background_session_payload_file_api_apps__app_id__background_sessions__bg_session_id__payload_files__filename__delete\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"bg_session_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Bg Session Id\"\n            }\n          },\n          {\n            \"name\": \"filename\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Filename\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/activations\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"List Activations\",\n        \"description\": \"List activation history for a background app.\\n\\nReturns a paginated list of trigger activations with timing, result,\\nand token usage. Filter by trigger_id or status (running/completed/failed).\",\n        \"operationId\": \"list_activations_api_apps__app_id__activations_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"limit\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"default\": 20,\n              \"title\": \"Limit\"\n            }\n          },\n          {\n            \"name\": \"offset\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"default\": 0,\n              \"title\": \"Offset\"\n            }\n          },\n          {\n            \"name\": \"trigger_id\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"anyOf\": [\n                {\n                  \"type\": \"string\"\n                },\n                {\n                  \"type\": \"null\"\n                }\n              ],\n              \"title\": \"Trigger Id\"\n            }\n          },\n          {\n            \"name\": \"status\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"anyOf\": [\n                {\n                  \"type\": \"string\"\n                },\n                {\n                  \"type\": \"null\"\n                }\n              ],\n              \"title\": \"Status\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/activations/stats\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Activation Stats\",\n        \"description\": \"Get aggregated activation statistics.\\n\\nReturns: total count, success rate, avg duration, total tokens, total cost.\",\n        \"operationId\": \"activation_stats_api_apps__app_id__activations_stats_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/channels/health\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Channels Health\",\n        \"description\": \"Return the live health of every channel registered for an app.\\n\\nWalks the ``ChannelRegistry`` of the deployed app, calls\\n``health_check()`` on each instance and returns a structured dict\\nthe Flutter dashboard can render as a status badge per channel.\\n\\nResponse::\\n\\n    {\\n      \\\"success\\\": true,\\n      \\\"data\\\": {\\n        \\\"app_id\\\": \\\"newsletter-digest\\\",\\n        \\\"channel_count\\\": 3,\\n        \\\"channels\\\": {\\n          \\\"email\\\": {\\n            \\\"status\\\": \\\"ok\\\",\\n            \\\"latency_ms\\\": 124.5,\\n            \\\"last_error\\\": null,\\n            \\\"last_success_at\\\": \\\"2026-04-13T10:35:45Z\\\",\\n            \\\"deliveries_total\\\": 12,\\n            \\\"deliveries_failed\\\": 0,\\n            \\\"details\\\": {\\\"smtp_host\\\": \\\"smtp.sendgrid.net\\\"}\\n          },\\n          \\\"slack\\\": {\\\"status\\\": \\\"ok\\\", ...},\\n          \\\"failing_webhook\\\": {\\n            \\\"status\\\": \\\"down\\\",\\n            \\\"last_error\\\": \\\"HTTP 503 Service Unavailable\\\",\\n            ...\\n          }\\n        }\\n      }\\n    }\\n\\nStatus values: ``ok`` (happy path), ``degraded`` (working but\\nflaky \\u2014 retries needed), ``down`` (last attempt failed and the\\nchannel is considered unreachable). The dashboard maps each to a\\ndot color.\",\n        \"operationId\": \"channels_health_api_apps__app_id__channels_health_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/assets/{asset_path}\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get App Asset\",\n        \"description\": \"Serve any file from a deployed app's companion directory.\\n\\nCovers README.md, CHANGELOG.md, LICENSE, skills/*.md,\\nassets/*, workspace defaults \\u2014 anything the YAML references\\nvia a relative path. Guarded against path traversal; denies\\n``.digitorn/*`` (daemon-managed area).\\n\\n**``?size=N``** \\u2014 when Pillow is installed and the asset is\\na raster image (PNG/JPG/WebP), serve a resized variant of N\\npixels on the longest side. Results are cached on disk under\\n``.digitorn/resized/`` so repeated requests don't re-encode.\\nWhen Pillow isn't installed or the asset isn't an image,\\n``size`` is ignored and the original is served.\\n\\nUse this route over ``/api/packages/{id}/assets/...`` for\\ndeployed apps \\u2014 it doesn't require the app to also be\\ninstalled as a package.\",\n        \"operationId\": \"get_app_asset_api_apps__app_id__assets__asset_path__get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"asset_path\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Asset Path\"\n            }\n          },\n          {\n            \"name\": \"size\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"default\": 0,\n              \"title\": \"Size\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/files\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"List App Files\",\n        \"description\": \"List files available in a deployed app's companion directory.\\n\\nLets the Flutter client discover what assets / skills / prompts\\nship with an app without guessing filenames. ``subdir`` narrows\\nthe listing to a subdirectory (e.g. ``?subdir=skills`` or\\n``?subdir=assets``). Empty = root.\\n\\nReturns a shallow listing (one directory level) \\u2014 call again\\nwith a subdir query to drill down.\",\n        \"operationId\": \"list_app_files_api_apps__app_id__files_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"subdir\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"string\",\n              \"default\": \"\",\n              \"title\": \"Subdir\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/icon\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get App Icon\",\n        \"description\": \"Stream a deployed app's icon file.\\n\\nReads the bundle store where the compiler persists the\\ncompanion files next to the YAML. Returns 404 when the app\\nhas no icon declared or the file doesn't exist.\\n\\nThis is the route Flutter should use for app cards in the Hub\\nApps tab, chat headers, and anywhere else the app needs a\\nvisual identity. Prefer this over ``/api/packages/{id}/icon``\\nfor deployed apps \\u2014 they're the same file but this endpoint\\ndoesn't require the app to also be installed as a package.\",\n        \"operationId\": \"get_app_icon_api_apps__app_id__icon_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/status\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"App Status\",\n        \"description\": \"Hero-stats endpoint for the Flutter background app dashboard.\\n\\nOne round-trip returns everything the top of the dashboard needs:\\n\\n- ``live``          \\u2192 current run state (``running`` / ``idle``) +\\n                      number of activations in status='running'\\n- ``stats``         \\u2192 all-time aggregated stats (same as\\n                      ``/activations/stats``) so the UI doesn't have\\n                      to chain two requests on page load\\n- ``hourly``        \\u2192 the 24-hour sparkline bucket list, one row per\\n                      hour, oldest first, including empty hours\\n- ``trend_24h``     \\u2192 total runs + failed runs in the last 24 h\\n                      (convenience aggregate on top of ``hourly``)\\n- ``triggers_summary`` \\u2192 light summary of trigger + channel state so\\n                      the dashboard header can show \\\"2 triggers \\u00b7 3\\n                      channels active\\\" without a second call to\\n                      ``/triggers``\\n\\nThis is what the dashboard should call at page load and whenever\\nthe user hits the \\u21bb refresh button. Everything else (activation\\nlist, trigger details, channel details) is lazy-loaded on demand.\",\n        \"operationId\": \"app_status_api_apps__app_id__status_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/activations/{activation_id}\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get Activation\",\n        \"description\": \"Get full details of a single activation.\\n\\nIncludes message, response, tool calls, timing, tokens.\",\n        \"operationId\": \"get_activation_api_apps__app_id__activations__activation_id__get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"activation_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Activation Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/activations/{activation_id}/events\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get Activation Events\",\n        \"description\": \"Return the full timeline of events for an activation.\\n\\nEvents are ordered by ``sequence`` (monotonically assigned when\\neach event was recorded) so the frontend can render them without\\nworrying about wall-clock ties. Every event has the shape::\\n\\n    {\\n      \\\"id\\\": \\\"abcd...\\\",\\n      \\\"sequence\\\": 7,\\n      \\\"timestamp\\\": \\\"2026-04-13T10:35:44.102Z\\\",\\n      \\\"event_type\\\": \\\"tool_call\\\",\\n      \\\"data\\\": {\\n         \\\"call_id\\\": \\\"call_xyz\\\",\\n         \\\"name\\\": \\\"filesystem.read\\\",\\n         \\\"params\\\": {\\\"file_path\\\": \\\"/data/news.json\\\"},\\n         \\\"success\\\": true,\\n         \\\"error\\\": \\\"\\\",\\n         \\\"result_preview\\\": {...}\\n      }\\n    }\\n\\nKnown ``event_type`` values currently emitted by the background\\nruntime: ``tool_call``, ``thinking``, ``channel_sent``,\\n``artifact``, ``turn_start``, ``turn_end``.\\n\\nPass ``?event_type=tool_call`` (or any of the above) to filter.\",\n        \"operationId\": \"get_activation_events_api_apps__app_id__activations__activation_id__events_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"activation_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Activation Id\"\n            }\n          },\n          {\n            \"name\": \"event_type\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"anyOf\": [\n                {\n                  \"type\": \"string\"\n                },\n                {\n                  \"type\": \"null\"\n                }\n              ],\n              \"title\": \"Event Type\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/activations/{activation_id}/artifacts\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get Activation Artifacts\",\n        \"description\": \"List every artifact (file) produced by an activation.\\n\\nAn artifact is a file-writing tool call (``filesystem.write``,\\n``filesystem.edit``, ``notebook.*``, ``spreadsheet.*``, ``pdf.*``,\\n``presentation.*``) that succeeded. The background runtime emits a\\ndedicated ``artifact`` event for each of these at activation time,\\nso this route just reads the already-persisted rows.\\n\\nResponse::\\n\\n    {\\n      \\\"success\\\": true,\\n      \\\"data\\\": {\\n        \\\"activation_id\\\": \\\"...\\\",\\n        \\\"count\\\": 2,\\n        \\\"artifacts\\\": [\\n          {\\n            \\\"sequence\\\": 7,\\n            \\\"timestamp\\\": \\\"2026-04-13T10:35:44.783Z\\\",\\n            \\\"path\\\": \\\"/workspace/out/report.pdf\\\",\\n            \\\"action\\\": \\\"pdf.create\\\",\\n            \\\"size_bytes\\\": 124567\\n          },\\n          ...\\n        ]\\n      }\\n    }\\n\\nThe Flutter dashboard drawer uses this endpoint to populate its\\n\\\"Artifacts\\\" section. Click on an artifact opens the viewer\\nregistered for that file type (CSV, PDF, Notebook, \\u2026).\",\n        \"operationId\": \"get_activation_artifacts_api_apps__app_id__activations__activation_id__artifacts_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"activation_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Activation Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/artifacts/{event_id}/download\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Download Artifact\",\n        \"description\": \"Stream an artifact file to the client.\\n\\nThe ``event_id`` MUST be the id of an ``ActivationEvent`` row with\\n``event_type='artifact'`` \\u2014 in other words, a file that was\\npreviously recorded by the background runtime when a tool wrote it\\nto disk. This is enforced strictly to prevent any form of path\\ninjection: the client never passes a filesystem path, it passes an\\nopaque id that the daemon resolves to a path it already knows and\\ntrusted at recording time.\\n\\nSecurity pipeline:\\n\\n1. Look up the event by id.\\n2. Verify the event belongs to an activation of this ``app_id``\\n   (cross-app lookup is blocked).\\n3. Verify the event_type is ``artifact``.\\n4. Read the path from the event's ``data.path``.\\n5. Verify the file exists, is a regular file (not a dir/symlink to\\n   a dir), and is within the size limit.\\n6. Stream it with the right Content-Type.\\n\\nA failure at any step returns 404 with a generic message \\u2014 the\\nclient should never be able to tell the difference between \\\"path\\ndoesn't exist\\\", \\\"not an artifact\\\", and \\\"doesn't belong to this app\\\"\\nbecause those distinctions leak info about other users' data.\",\n        \"operationId\": \"download_artifact_api_apps__app_id__artifacts__event_id__download_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"event_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Event Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"head\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Download Artifact Head\",\n        \"description\": \"HEAD equivalent of the download endpoint.\\n\\nReturns only the response headers \\u2014 Content-Type, Content-Length,\\nX-Artifact-* \\u2014 so the client can decide whether to proceed with\\nthe full GET (e.g. to avoid downloading a 49 MB file into memory\\nwhen the user only wanted to see the size in a tooltip). Same\\nsecurity pipeline as the GET.\",\n        \"operationId\": \"download_artifact_head_api_apps__app_id__artifacts__event_id__download_head\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"event_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Event Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/errors\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"App Errors\",\n        \"description\": \"Get recent failed activations with error details.\",\n        \"operationId\": \"app_errors_api_apps__app_id__errors_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"limit\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"default\": 10,\n              \"title\": \"Limit\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/triggers/{trigger_id}/fire\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Fire Trigger\",\n        \"description\": \"Manually fire a trigger (for testing/debugging).\\n\\nActivates the agent as if the trigger had fired naturally.\\nThe activation is recorded in the history.\",\n        \"operationId\": \"fire_trigger_api_apps__app_id__triggers__trigger_id__fire_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"trigger_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Trigger Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/triggers/{trigger_id}/test\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Test Trigger\",\n        \"description\": \"Test a trigger with a custom payload (dry-run style).\\n\\nFires the trigger synchronously and returns the agent's full response.\\nUseful for debugging webhook payloads.\",\n        \"operationId\": \"test_trigger_api_apps__app_id__triggers__trigger_id__test_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"trigger_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Trigger Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"anyOf\": [\n                  {\n                    \"type\": \"object\",\n                    \"additionalProperties\": true\n                  },\n                  {\n                    \"type\": \"null\"\n                  }\n                ],\n                \"title\": \"Body\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/diagnostics\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"App Diagnostics\",\n        \"description\": \"Run diagnostics checks for a deployed app.\",\n        \"operationId\": \"app_diagnostics_api_apps__app_id__diagnostics_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/background-tasks\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Launch Background Task\",\n        \"description\": \"Launch a tool as a background task.\\n\\nThe tool runs asynchronously. Poll status via GET or subscribe\\nto the session via Socket.IO for completion events.\\n\\nReturns the task_id for tracking.\",\n        \"operationId\": \"launch_background_task_api_apps__app_id__background_tasks_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/BackgroundTaskRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"List Background Tasks App\",\n        \"description\": \"List all background tasks (running + completed).\",\n        \"operationId\": \"list_background_tasks_app_api_apps__app_id__background_tasks_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/background-tasks/{task_id}\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get Background Task\",\n        \"description\": \"Get status and result of a background task.\",\n        \"operationId\": \"get_background_task_api_apps__app_id__background_tasks__task_id__get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"task_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Task Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"delete\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Cancel Background Task App\",\n        \"description\": \"Cancel a running background task.\",\n        \"operationId\": \"cancel_background_task_app_api_apps__app_id__background_tasks__task_id__delete\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"task_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Task Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/backgro