": 878, "operation": "disk_sync", "updated_at": 1778628124.6787934, "validation": "approved", "baseline_lines": 877, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1778500782.84114}, "docs-site/src/pages/index.module.css": {"content": "/* ==========================================================\n *  Homepage - Digitorn brand\n *  Mirrors the in-app DS tokens and the BrandMark feel.\n * ========================================================== */\n\n/* ─── Hero ────────────────────────────────────────────────── */\n\n.hero {\n  position: relative;\n  padding: 6rem 0 4rem;\n  text-align: center;\n  background:\n    radial-gradient(\n      ellipse at 50% -20%,\n      rgba(167, 139, 250, 0.16),\n      transparent 60%\n    ),\n    radial-gradient(\n      ellipse at 50% 100%,\n      rgba(59, 130, 246, 0.10),\n      transparent 50%\n    );\n  overflow: hidden;\n}\n\n.heroBrandWrap {\n  display: flex;\n  justify-content: center;\n  margin-bottom: 1.5rem;\n}\n\n/* Composite brand mark, mirrors the BrandMark component used by Flutter\n   and the web client: gradient tile + soft top-left highlight + the brain\n   logo tinted to onAccent (white). */\n.heroBrand {\n  position: relative;\n  overflow: hidden;\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow:\n    0 18px 48px -10px rgba(59, 130, 246, 0.45),\n    0 4px 14px -4px rgba(167, 139, 250, 0.3);\n}\n\n.heroBrandTile {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    135deg,\n    #A78BFA 0%,\n    #7E94F0 50%,\n    #5B7BF0 100%\n  );\n}\n\n.heroBrandGloss {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    135deg,\n    rgba(255, 255, 255, 0.22) 0%,\n    rgba(255, 255, 255, 0) 50%\n  );\n}\n\n.heroBrandMark {\n  position: relative;\n  object-fit: contain;\n  filter: brightness(0) invert(1);\n}\n\n.heroTitle {\n  font-size: 3.75rem;\n  font-weight: 800;\n  letter-spacing: -0.04em;\n  margin-bottom: 1rem;\n  background: linear-gradient(\n    135deg,\n    #A78BFA 0%,\n    #8B5CF6 35%,\n    #5B7BF0 70%,\n    #3B82F6 100%\n  );\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  line-height: 1.05;\n}\n\n.heroSubtitle {\n  font-size: 1.2rem;\n  line-height: 1.55;\n  color: var(--digi-text-muted);\n  max-width: 640px;\n  margin: 0 auto 2.5rem;\n}\n\n.heroButtons {\n  display: inline-flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 0.75rem;\n}\n\n.heroCta {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.75rem 1.4rem;\n  border-radius: 11px;\n  font-weight: 600;\n  font-size: 0.95rem;\n  letter-spacing: -0.005em;\n  transition:\n    transform 120ms ease,\n    box-shadow 200ms ease,\n    background 120ms ease,\n    border-color 120ms ease;\n  text-decoration: none !important;\n}\n\n.heroCtaPrimary {\n  color: #FFFFFF !important;\n  background: linear-gradient(135deg, #A78BFA 0%, #5B7BF0 100%);\n  box-shadow:\n    0 12px 32px -8px rgba(59, 130, 246, 0.55),\n    0 4px 10px -2px rgba(167, 139, 250, 0.4);\n}\n\n.heroCtaPrimary:hover {\n  transform: translateY(-1px);\n  box-shadow:\n    0 16px 38px -8px rgba(59, 130, 246, 0.65),\n    0 6px 14px -3px rgba(167, 139, 250, 0.5);\n}\n\n.heroCtaGhost {\n  color: var(--digi-text-bright) !important;\n  background: var(--digi-surface);\n  border: 1px solid var(--digi-border);\n}\n\n.heroCtaGhost:hover {\n  border-color: var(--digi-border-hover);\n  background: var(--digi-surface-alt);\n  transform: translateY(-1px);\n}\n\n/* ─── Feature grid ────────────────────────────────────────── */\n\n.features {\n  padding: 5rem 0 4rem;\n}\n\n.featureGrid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n  gap: 1.25rem;\n  max-width: 1100px;\n  margin: 0 auto;\n}\n\n.featureCard {\n  display: block;\n  padding: 1.6rem;\n  border-radius: 14px;\n  border: 1px solid var(--digi-border);\n  background: var(--digi-surface);\n  text-decoration: none !important;\n  color: inherit;\n  transition:\n    transform 200ms ease,\n    border-color 200ms ease,\n    box-shadow 200ms ease;\n}\n\n.featureCard:hover {\n  border-color: rgba(167, 139, 250, 0.6);\n  box-shadow: 0 14px 36px -10px rgba(59, 130, 246, 0.32);\n  transform: translateY(-2px);\n}\n\n.featureIcon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  border-radius: 11px;\n  font-size: 1.35rem;\n  background: linear-gradient(135deg, #A78BFA 0%, #5B7BF0 100%);\n  box-shadow: 0 8px 20px -6px rgba(59, 130, 246, 0.42);\n  margin-bottom: 1rem;\n}\n\n.featureTitle {\n  font-size: 1.05rem;\n  font-weight: 600;\n  margin: 0 0 0.4rem;\n  letter-spacing: -0.01em;\n  color: var(--digi-text-bright);\n}\n\n.featureDescription {\n  font-size: 0.9rem;\n  line-height: 1.55;\n  color: var(--digi-text-muted);\n  margin: 0;\n}\n\n/* ─── Quick example section ───────────────────────────────── */\n\n.example {\n  padding: 4rem 0 5rem;\n  border-top: 1px solid var(--digi-border);\n  background: var(--digi-surface);\n}\n\n.exampleGrid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 3rem;\n  align-items: center;\n  max-width: 1100px;\n  margin: 0 auto;\n}\n\n.exampleTitle {\n  font-size: 2rem;\n  font-weight: 700;\n  letter-spacing: -0.025em;\n  margin-bottom: 1rem;\n  color: var(--digi-text-bright);\n}\n\n.exampleLead {\n  font-size: 1.025rem;\n  color: var(--digi-text-muted);\n  line-height: 1.6;\n  margin-bottom: 1.75rem;\n}\n\n.exampleBullets {\n  display: flex;\n  flex-direction: column;\n  gap: 0.85rem;\n  margin-bottom: 1.75rem;\n}\n\n.exampleBullets > div {\n  display: flex;\n  gap: 0.75rem;\n  align-items: flex-start;\n  font-size: 0.95rem;\n  color: var(--digi-text);\n  line-height: 1.55;\n}\n\n.exampleBullets strong {\n  color: var(--digi-text-bright);\n  font-weight: 600;\n}\n\n.bulletDot {\n  flex-shrink: 0;\n  display: inline-block;\n  width: 8px;\n  height: 8px;\n  margin-top: 0.6rem;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #A78BFA, #5B7BF0);\n  box-shadow: 0 0 0 4px rgba(167, 139, 250, 0.12);\n}\n\n.exampleActions {\n  display: flex;\n  gap: 1rem;\n}\n\n.exampleLink {\n  font-size: 0.95rem;\n  font-weight: 600;\n  color: var(--ifm-color-primary);\n  text-decoration: none;\n}\n\n.exampleLink:hover {\n  text-decoration: underline;\n  text-underline-offset: 3px;\n}\n\n/* Code mockup */\n\n.exampleCode {\n  border-radius: 14px;\n  overflow: hidden;\n  background: #0F0F0F;\n  border: 1px solid #1A1A1A;\n  box-shadow:\n    0 24px 60px -20px rgba(59, 130, 246, 0.32),\n    0 8px 24px -8px rgba(0, 0, 0, 0.5);\n}\n\n.exampleCodeHeader {\n  display: flex;\n  align-items: center;\n  gap: 0.4rem;\n  padding: 0.7rem 1rem;\n  background: #161616;\n  border-bottom: 1px solid #1A1A1A;\n}\n\n.exampleCodeDot {\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background: #2A2A2A;\n}\n\n.exampleCodeDot:nth-child(1) { background: #FF5F56; }\n.exampleCodeDot:nth-child(2) { background: #FFBD2E; }\n.exampleCodeDot:nth-child(3) { background: #27C93F; }\n\n.exampleCodeFile {\n  margin-left: 0.75rem;\n  font-family: var(--ifm-font-family-monospace);\n  font-size: 0.78rem;\n  color: #8A8A8A;\n}\n\n.exampleCodeBody {\n  margin: 0;\n  padding: 1.2rem 1.4rem;\n  background: #0F0F0F;\n  color: #E6E6E6;\n  font-family: var(--ifm-font-family-monospace);\n  font-size: 0.85rem;\n  line-height: 1.65;\n  overflow-x: auto;\n  white-space: pre;\n}\n\n.exampleCodeBody code {\n  background: transparent !important;\n  border: none !important;\n  padding: 0 !important;\n  color: inherit !important;\n  font-size: inherit !important;\n}\n\n/* ─── Stability section ───────────────────────────────────── */\n\n.stability {\n  padding: 4rem 0 6rem;\n}\n\n.stabilityCard {\n  max-width: 1100px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 2.5rem;\n  padding: 2.5rem;\n  border-radius: 18px;\n  background: linear-gradient(\n    135deg,\n    rgba(167, 139, 250, 0.06),\n    rgba(59, 130, 246, 0.04) 100%\n  );\n  border: 1px solid var(--digi-border);\n}\n\n.stabilityCol {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.stabilityTitle {\n  font-size: 1.35rem;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  color: var(--digi-text-bright);\n  margin: 0;\n}\n\n.stabilityBody {\n  font-size: 0.95rem;\n  line-height: 1.6;\n  color: var(--digi-text);\n  margin: 0;\n}\n\n/* ─── Responsive ─────────────────────────────────────────── */\n\n@media (max-width: 996px) {\n  .hero {\n    padding: 4rem 0 3rem;\n  }\n  .heroTitle {\n    font-size: 2.4rem;\n  }\n  .heroSubtitle {\n    font-size: 1.05rem;\n  }\n  .features {\n    padding: 3rem 0;\n  }\n  .example,\n  .stability {\n    padding: 3rem 0;\n  }\n  .exampleGrid,\n  .stabilityCard {\n    grid-template-columns: 1fr;\n    gap: 2rem;\n  }\n  .exampleTitle {\n    font-size: 1.6rem;\n  }\n}\n\n@media (max-width: 640px) {\n  .heroTitle {\n    font-size: 2rem;\n  }\n  .heroButtons {\n    flex-direction: column;\n    width: 100%;\n  }\n  .heroCta {\n    justify-content: center;\n  }\n}\n", "language": "css", "size": 8465, "lines": 437, "operation": "disk_sync", "updated_at": 1778628124.6942065, "validation": "approved", "baseline_lines": 436, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1778163147.5114315}, "docs-site/src/pages/index.tsx": {"content": "import type { ReactNode } from \"react\";\nimport Link from \"@docusaurus/Link\";\nimport useDocusaurusContext from \"@docusaurus/useDocusaurusContext\";\nimport Layout from \"@theme/Layout\";\nimport Heading from \"@theme/Heading\";\n\nimport styles from \"./index.module.css\";\n\nfunction HeroBrandMark({ size = 64 }: { size?: number }) {\n  const radius = Math.round(size * 0.24);\n  const inner = Math.round(size * 0.54);\n  return (\n    <div\n      className={styles.heroBrand}\n      style={{ width: size, height: size, borderRadius: radius }}\n      aria-hidden=\"true\"\n    >\n      <div\n        className={styles.heroBrandTile}\n        style={{ borderRadius: radius }}\n      />\n      <div\n        className={styles.heroBrandGloss}\n        style={{ borderRadius: radius }}\n      />\n      <img\n        src=\"/img/logo.png\"\n        alt=\"\"\n        width={inner}\n        height={inner}\n        className={styles.heroBrandMark}\n      />\n    </div>\n  );\n}\n\nfunction Hero() {\n  const { siteConfig } = useDocusaurusContext();\n  return (\n    <section className={styles.hero}>\n      <div className=\"container\">\n        <div className={styles.heroBrandWrap}>\n          <HeroBrandMark size={72} />\n        </div>\n        <Heading as=\"h1\" className={styles.heroTitle}>\n          {siteConfig.title}\n        </Heading>\n        <p className={styles.heroSubtitle}>\n          A declarative framework for building AI agent applications.\n          Define what your agents do, how they think, and what tools\n          they use - entirely in YAML.\n        </p>\n        <div className={styles.heroButtons}>\n          <Link\n            className={`${styles.heroCta} ${styles.heroCtaPrimary}`}\n            to=\"/docs/language/getting-started\"\n          >\n            Get started\n            <span aria-hidden=\"true\">→</span>\n          </Link>\n          <Link\n            className={`${styles.heroCta} ${styles.heroCtaGhost}`}\n            to=\"/docs/language/\"\n          >\n            Read the language reference\n          </Link>\n        </div>\n      </div>\n    </section>\n  );\n}\n\nfunction FeatureCard({\n  icon,\n  title,\n  description,\n  href,\n}: {\n  icon: string;\n  title: string;\n  description: string;\n  href: string;\n}) {\n  return (\n    <Link to={href} className={styles.featureCard}>\n      <div className={styles.featureIcon} aria-hidden=\"true\">\n        {icon}\n      </div>\n      <h3 className={styles.featureTitle}>{title}</h3>\n      <p className={styles.featureDescription}>{description}</p>\n    </Link>\n  );\n}\n\nfunction Features() {\n  const features = [\n    {\n      icon: \"📐\",\n      title: \"8-block YAML\",\n      description:\n        \"One canonical schema. Every field has exactly one home. \" +\n        \"Pydantic validates with extra: forbid - typos don't ship.\",\n      href: \"/docs/language/grammar\",\n    },\n    {\n      icon: \"🧩\",\n      title: \"23 modules out of the box\",\n      description:\n        \"Filesystem, shell, web, database, memory, RAG, MCP, \" +\n        \"channels, widgets, workspace... drop them under tools.modules.\",\n      href: \"/docs/reference/modules/\",\n    },\n    {\n      icon: \"🤖\",\n      title: \"Multi-provider brains\",\n      description:\n        \"OpenAI, Anthropic, DeepSeek, Groq, Ollama, vLLM, LM Studio, \" +\n        \"and 10+ more. Native or text-based tool calling, auto-detected.\",\n      href: \"/docs/language/agents\",\n    },\n    {\n      icon: \"🛡\",\n      title: \"Security in three layers\",\n      description:\n        \"Capabilities (grant / deny / approve), behavior engine \" +\n        \"(14 built-in rules), OS-level sandbox (Landlock / seccomp).\",\n      href: \"/docs/language/security\",\n    },\n    {\n      icon: \"👥\",\n      title: \"Multi-agent built-in\",\n      description:\n        \"Coordinator + specialists, parallel sub-agent orchestration, \" +\n        \"isolated contexts, eight Agent() modes via one tool.\",\n      href: \"/docs/language/multi-agent\",\n    },\n    {\n      icon: \"🚀\",\n      title: \"Background, channels, flows\",\n      description:\n        \"Cron, webhooks, file-watch, email, Slack, Telegram, RSS - \" +\n        \"11 channel adapters. Declarative orchestration graphs.\",\n      href: \"/docs/language/channels\",\n    },\n  ];\n  return (\n    <section className={styles.features}>\n      <div className=\"container\">\n        <div className={styles.featureGrid}>\n          {features.map((f) => (\n            <FeatureCard key={f.title} {...f} />\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}\n\nfunction QuickExample() {\n  return (\n    <section className={styles.example}>\n      <div className=\"container\">\n        <div className={styles.exampleGrid}>\n          <div>\n            <Heading as=\"h2\" className={styles.exampleTitle}>\n              An app in twenty lines\n            </Heading>\n            <p className={styles.exampleLead}>\n              Drop this YAML next to a daemon and chat with it. The\n              same schema scales to multi-agent coordinators with\n              channels, sub-agent fan-out, hooks, and credentials.\n            </p>\n            <div className={styles.exampleBullets}>\n              <div>\n                <span className={styles.bulletDot} />\n                <span>\n                  <strong>Declare, don't code.</strong> Modules, tools,\n                  policies, hooks all in YAML.\n                </span>\n              </div>\n              <div>\n                <span className={styles.bulletDot} />\n                <span>\n                  <strong>One canonical grammar.</strong> Eight blocks,\n                  formal spec, frozen v1.\n                </span>\n              </div>\n              <div>\n                <span className={styles.bulletDot} />\n                <span>\n                  <strong>Live event stream.</strong> Socket.IO with\n                  per-turn snapshots and replay.\n                </span>\n              </div>\n            </div>\n            <div className={styles.exampleActions}>\n              <Link\n                to=\"/docs/language/getting-started\"\n                className={styles.exampleLink}\n              >\n                Walk through the tutorial →\n              </Link>\n            </div>\n          </div>\n          <div className={styles.exampleCode}>\n            <div className={styles.exampleCodeHeader}>\n              <span className={styles.exampleCodeDot} />\n              <span className={styles.exampleCodeDot} />\n              <span className={styles.exampleCodeDot} />\n              <span className={styles.exampleCodeFile}>hello.yaml</span>\n            </div>\n            <pre className={styles.exampleCodeBody}>\n              <code>{`app:\n  app_id: hello\n  name: \"Hello\"\n\nagents:\n  - id: assistant\n    role: assistant\n    brain:\n      provider: ollama\n      model: qwen25-7b-gpu:latest\n      backend: openai_compat\n      config:\n        base_url: http://localhost:11434/v1\n        api_key: ollama\n    system_prompt: |\n      You are a helpful assistant.\n      Reply concisely.\n\ntools:\n  modules:\n    memory: {}\n  capabilities:\n    default_policy: auto`}</code>\n            </pre>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n\nfunction Stability() {\n  return (\n    <section className={styles.stability}>\n      <div className=\"container\">\n        <div className={styles.stabilityCard}>\n          <div className={styles.stabilityCol}>\n            <Heading as=\"h3\" className={styles.stabilityTitle}>\n              Documentation as a contract\n            </Heading>\n            <p className={styles.stabilityBody}>\n              Claims in this documentation are cross-checked against\n              the source code, and YAML examples are deployed against a\n              live daemon before they ship. If you spot a divergence\n              between what's written here and the running system, the\n              doc is the bug; open an issue.\n            </p>\n          </div>\n          <div className={styles.stabilityCol}>\n            <Heading as=\"h3\" className={styles.stabilityTitle}>\n              v1 stability\n            </Heading>\n            <p className={styles.stabilityBody}>\n              The 8-block YAML is frozen. Required fields are not\n              added, existing field types are not narrowed, and\n              default values stay the same across minor and patch\n              releases. New optional fields land additively.\n            </p>\n            <Link to=\"/docs/versioning\" className={styles.exampleLink}>\n              Read the stability guarantees →\n            </Link>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n\nexport default function Home(): ReactNode {\n  const { siteConfig } = useDocusaurusContext();\n  return (\n    <Layout\n      title=\"Home\"\n      description={\n        siteConfig.tagline ||\n        \"Digitorn - declarative AI agent framework. Build apps in YAML.\"\n      }\n    >\n      <main>\n        <Hero />\n        <Features />\n        <QuickExample />\n        <Stability />\n      </main>\n    </Layout>\n  );\n}\n", "language": "tsx", "size": 8886, "lines": 300, "operation": "disk_sync", "updated_at": 1778628124.725985, "validation": "approved", "baseline_lines": 299, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1778168658.0362475}, "docs-site/static/.nojekyll": {"content": "", "language": "text", "size": 0, "lines": 1, "operation": "disk_sync", "updated_at": 1778628124.7330387, "validation": "approved", "baseline_lines": 0, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.5865335}, "docs-site/static/img/docusaurus-social-card.jpg": {"content": "����\u0000\u0010JFIF\u0000\u0001\u0001\u0000\u0000\u0001\u0000\u0001\u0000\u0000��\u0000�\u0000\u0005\u0005\u0005\u0005\u0005\u0005\u0005\u0006\u0006\u0005\b\b\u0007\b\b\u000b\n\t\t\n\u000b\u0011\f\n\f\n\f\u0011\u001a\u0010\u0013\u0010\u0010\u0013\u00