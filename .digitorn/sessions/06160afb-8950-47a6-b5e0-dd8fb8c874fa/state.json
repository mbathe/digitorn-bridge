me_seconds (float), allow_transactions (bool), blocked_operations (list, MongoDB), blocked_commands (list, Redis). Use presets: {'preset': 'readonly'}, {'preset': 'safe_write'}, or custom dict.\\\", 'enum': None}, {'name': 'role', 'type': 'string', 'required': False, 'default': None, 'description': \\\"Connection role for read replica routing: 'primary' (read+write), 'replica' (read-only, auto-routed for SELECT queries). Omit for standalone connections.\\\", 'enum': None}, {'name': 'group', 'type': 'string', 'required': False, 'default': None, 'description': \\\"Connection group name for replica routing. Connections in the same group are treated as a primary + replica set. E.g. group='production' with role='primary' and role='replica'.\\\", 'enum': None}]\",\n    \"evidence\": {},\n    \"timestamp\": 1776670436.5867646\n  },\n  \"BUG-099\": {\n    \"verdict\": \"FIXED\",\n    \"detail\": \"snake_case type present: ['file_watcher']\",\n    \"evidence\": {},\n    \"timestamp\": 1776670436.5867646\n  },\n  \"BUG-100\": {\n    \"verdict\": \"NOT_FIXED\",\n    \"detail\": \"error: {\\\"success\\\":false,\\\"error\\\":\\\"BuiltinSource: built-in package 'builtin:echo-chatbot' not found in C:\\\\\\\\Users\\\\\\\\ASUS\\\\\\\\Documents\\\\\\\\digitorn-bridge\\\\\\\\packages\\\\\\\\d\",\n    \"evidence\": {},\n    \"timestamp\": 1776670436.5867646\n  },\n  \"BUG-021\": {\n    \"verdict\": \"FIXED\",\n    \"detail\": \"POST on missing app returns 404\",\n    \"evidence\": {},\n    \"timestamp\": 1776670719.1380277\n  },\n  \"BUG-022\": {\n    \"verdict\": \"FIXED\",\n    \"detail\": \"list and diagnostics agree for builtins\",\n    \"evidence\": {},\n    \"timestamp\": 1776670719.1380277\n  },\n  \"BUG-036\": {\n    \"verdict\": \"FIXED\",\n    \"detail\": \"digitorn-chat reports ok: {'name': 'App', 'ok': True, 'detail': 'Digitorn Chat'}\",\n    \"evidence\": {},\n    \"timestamp\": 1776670719.1380277\n  },\n  \"BUG-037\": {\n    \"verdict\": \"FIXED\",\n    \"detail\": \"reje