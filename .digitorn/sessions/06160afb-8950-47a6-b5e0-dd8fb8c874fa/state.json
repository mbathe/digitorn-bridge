tent\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/preview-server/status\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Preview Server Status\",\n        \"description\": \"Return the current state of an app's preview dev server.\\n\\nResponse shape matches :meth:`PreviewManager.status().as_dict()` with\\nthe tailing log buffer. Flutter polls (or opens an SSE stream) to\\nreflect the status in the admin panel.\\n\\nWhen the app ships a pre-built ``web/dist/`` (production mode) the\\nendpoint reports ``enabled: true`` + ``state: \\\"running\\\"`` even if\\nno Vite dev server is alive \\u2014 the proxy will serve the static\\nbundle directly. This makes the Flutter client display the iframe\\ninstead of \\\"no preview block declared\\\".\",\n        \"operationId\": \"preview_server_status_api_apps__app_id__preview_server_status_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/js