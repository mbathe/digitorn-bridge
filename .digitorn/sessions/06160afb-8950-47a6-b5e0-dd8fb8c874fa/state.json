omponents/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/tools/{tool_name}/execute\": {\n      \"post\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Execute Tool\",\n        \"description\": \"Execute a tool directly by qualified name.\\n\\nBypasses the agent \\u2014 runs the tool and returns the raw result.\\nSecurity policies (grant/approve/deny) still apply.\",\n        \"operationId\": \"execute_tool_api_apps__app_id__tools__tool_name__execute_post\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"tool_name\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Tool Name\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/ToolExecuteRequest\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/index\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Get App Index\",\n        \"description\": \"Get full tool index structure for the app.\\n\\nReturns all categories, tools, aliases, and metadata.\\nUseful for SDK clients to build local caches or UI.\",\n        \"operationId\": \"get_app_index_api_apps__app_id__index_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppResponse\"\n                }\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/preview/{buffer_key}\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Preview Buffer\",\n        \"description\": \"Serve the app's static preview (web/dist/).\\n\\nWhen ``buffer_key`` is empty (e.g. ``/preview/?session_id=...``), serves\\nthe static dist bundle so the Flutter client can load the app's web UI\\nin an iframe at ``/api/apps/{app_id}/preview/``.\\n\\nQuery params:\\n    session_id: Forwarded to the static dist's index.html.\",\n        \"operationId\": \"preview_buffer_api_apps__app_id__preview__buffer_key__get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"buffer_key\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"Buffer Key\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/preview-server/status\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Preview Server Status\",\n        \"description\": \"Return the current state of an app's preview dev server.\\n\\nResponse shape matches :meth:`PreviewManager.status().as_dict()` with\\nthe tailing log buffer. Flutter polls (or opens an SSE stream) to\\nreflect the status in the admin panel.\\n\\nWhen the app ships a pre-built ``web/dist/`` (production mode) the\\nendpoint reports ``enabled: true`` + ``state: \\\"running\\\"`` even if\\nno Vite dev server is alive \\u2014 the proxy will serve the static\\nbundle directly. This makes the Flutter client display the iframe\\ninstead of \\\"no preview block declared\\\".\",\n        \"operationId\": \"preview_server_status_api_apps__app_id__preview_server_status_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {}\n              }\n            }\n          },\n          \"422\": {\n            \"description\": \"Validation Error\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HTTPValidationError\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/apps/{app_id}/preview-server/logs\": {\n      \"get\": {\n        \"tags\": [\n          \"apps\"\n        ],\n        \"summary\": \"Preview Server Logs\",\n        \"description\": \"Return the last ``limit`` log lines captured from the dev server.\",\n        \"operationId\": \"preview_server_logs_api_apps__app_id__preview_server_logs_get\",\n        \"parameters\": [\n          {\n            \"name\": \"app_id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"title\": \"App Id\"\n            }\n          },\n          {\n            \"name\": \"limit\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"default\": 200,\n              \"title\": \"Limit\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Successful Response\",\n            \"content\": {\n              \"application/json\": {\n               