  {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"title\": \"Username\",\n            \"description\": \"Username (for local/LDAP)\"\n          },\n          \"email\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"title\": \"Email\",\n            \"description\": \"Email (alternative to username)\"\n          },\n          \"password\": {\n            \"type\": \"string\",\n            \"title\": \"Password\",\n            \"description\": \"Password\"\n          },\n          \"provider\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"title\": \"Provider\",\n            \"description\": \"Auth provider (default: local)\"\n          }\n        },\n        \"type\": \"object\",\n        \"required\": [\n          \"password\"\n        ],\n        \"title\": \"LoginRequest\"\n      },\n      \"LogoutRequest\": {\n        \"properties\": {\n          \"refresh_token\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"title\": \"Refresh Token\"\n          }\n        },\n        \"type\": \"object\",\n        \"title\": \"LogoutRequest\",\n        \"description\": \"Logout body \\u2014 everything is optional.\\n\\nCallers typically POST an empty body and rely on the Authorization\\nheader to identify the access token to revoke. Older SDKs that pass\\na refresh_token keep working; both get revoked atomically.\"\n      },\n      \"LspCancelRequest\": {\n        \"properties\": {\n          \"request_id\": {\n            \"type\": \"string\",\n            \"title\": \"Request Id\",\n            \"description\": \"Correlation id returned by /lsp/request.\"\n          }\n        },\n        \"type\": \"object\",\n        \"required\": [\n          \"request_id\"\n        ],\n        \"title\": \"LspCancelRequest\",\n        \"description\": \"Body for ``POST /lsp/cancel`` \\u2014 cancel an in-flight LSP request.\"\n      },\n      \"LspRpcRequest\": {\n        \"properties\": {\n          \"path\": {\n            \"type\": \"string\",\n            \"title\": \"Path\",\n            \"description\": \"File path. Absolute or workspace-relative. Used to route to the right language server via its registered extensions.\"\n          },\n          \"method\": {\n            \"type\": \"string\",\n            \"title\": \"Method\",\n            \"description\": \"LSP method name (e.g. 'textDocument/hover').\"\n          },\n          \"params\": {\n            \"additionalProperties\": true,\n            \"type\": \"object\",\n            \"title\": \"Params\",\n            \"description\": \"Raw LSP request params. ``textDocument.uri`` auto-filled from ``path`` if omitted; everything else is passed through.\"\n          },\n          \"timeout_seconds\": {\n            \"type\": \"number\",\n            \"maximum\": 60.0,\n            \"minimum\": 0.1,\n            \"title\": \"Timeout Seconds\",\n            \"description\": \"Server-side timeout for the RPC call.\",\n            \"default\": 10.0\n          },\n          \"request_id\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"title\": \"Request Id\",\n            \"description\": \"Client correlation id \\u2014 use it to cancel this specific request later. Daemon mints one if omitted.\"\n          },\n          \"supersede_previous\": {\n            \"type\": \"boolean\",\n            \"title\": \"Supersede Previous\",\n            \"description\": \"When True, a new request for the same (session, path, method) triple cancels any in-flight request for that triple. Right default for keystroke methods; set False for user-initiated ones (references, rename).\",\n            \"default\": true\n          }\n        },\n        \"type\": \"object\",\n        \"required\": [\n          \"path\",\n          \"method\"\n        ],\n        \"title\": \"LspRpcRequest\",\n        \"description\": \"Body for ``POST /lsp/request``.\\n\\n``method`` + ``params`` follow the Language Server Protocol spec\\n(textDocument/hover, textDocument/definition, textDocument/references,\\ntextDocument/completion, textDocument/rename, textDocument/signatureHelp,\\ntextDocument/documentSymbol, \\u2026).\\n\\n**Phase 3 additions** \\u2014 abort + debounce semantics:\\n\\n- ``request_id`` (optional client uuid) \\u2014 correlation id for the\\n  companion ``POST /lsp/cancel`` endpoint. When omitted, the daemon\\n  mints one and returns it in the response.\\n- ``supersede_previous`` (default ``true``) \\u2014 auto-cancel any\\n  in-flight request for the same ``(session, path, method)`` triple\\n  when it's a keystroke-driven method (completion, hover,\\n  signatureHelp). Set ``false`` on user-initiated references / rename\\n  so the result always lands.\"\n      },\n      \"NotificationCheckRequest\": {\n        \"properties\": {\n          \"session_id\": {\n            \"type\": \"string\",\n            \"title\": \"Session Id\"\n          }\n        },\n        \"type\": \"object\",\n        \"required\": [\n          \"session_id\"\n        ],\n        \"title\": \"NotificationCheckRequest\"\n      },\n      \"NotificationPrefs\": {\n        \"properties\": {\n          \"events\": {\n            \"additionalProperties\": {\n              \"items\": {\n                \"type\": \"string\"\n              },\n              \"type\": \"array\"\n            }