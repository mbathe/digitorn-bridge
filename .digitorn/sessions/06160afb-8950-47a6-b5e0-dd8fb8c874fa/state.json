 Remove the entire payload (prompt + metadata + all files) for a session.\n}\n", "language": "text", "size": 328, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.1852922, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.0934024}, "bruno/digitorn-api-full/apps/DELETE api apps -app_id background-sessions -bg_session_id.bru": {"content": "meta {\n  name: delete_background_session\n  type: http\n  seq: 130\n}\n\ndelete {\n  url: {{base_url}}/api/apps/{{app_id}}/background-sessions/{{bg_session_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Delete a background session. Stops receiving triggers.\n}\n", "language": "text", "size": 295, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.1935868, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.0934024}, "bruno/digitorn-api-full/apps/DELETE api apps -app_id background-tasks -task_id.bru": {"content": "meta {\n  name: cancel_background_task_app\n  type: http\n  seq: 133\n}\n\ndelete {\n  url: {{base_url}}/api/apps/{{app_id}}/background-tasks/{{task_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Cancel a running background task.\n}\n", "language": "text", "size": 266, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.1974704, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1020055}, "bruno/digitorn-api-full/apps/DELETE api apps -app_id mcp -server_id oauth-token.bru": {"content": "meta {\n  name: revoke_mcp_oauth\n  type: http\n  seq: 134\n}\n\ndelete {\n  url: {{base_url}}/api/apps/{{app_id}}/mcp/{{mcp_server_id}}/oauth-token\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Revoke an MCP server's OAuth token — disconnect and delete from DB.\n  \n  The server entry is kept in the pool (with status reset) so /connect\n  can re-authorize later.\n}\n", "language": "text", "size": 395, "lines": 23, "operation": "disk_sync", "updated_at": 1778628122.1974704, "validation": "approved", "baseline_lines": 22, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1034913}, "bruno/digitorn-api-full/apps/DELETE api apps -app_id preview-server proxy -path-path.bru": {"content": "meta {\n  name: preview_server_proxy\n  type: http\n  seq: 135\n}\n\ndelete {\n  url: {{base_url}}/api/apps/{{app_id}}/preview-server/proxy/{{path:path}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Reverse-proxy HTTP traffic to the app's dev server.\n  \n  Flutter points an iframe at ``/api/apps/{app_id}/preview-server/proxy/``\n  to render the dev UI inside the Digitorn admin panel. HMR websockets\n  use the matching ``/preview-server/ws/{path:path}`` upgrade route.\n}\n", "language": "text", "size": 502, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.1974704, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1045043}, "bruno/digitorn-api-full/apps/DELETE api apps -app_id quota user -user_id.bru": {"content": "meta {\n  name: remove_user_quota\n  type: http\n  seq: 137\n}\n\ndelete {\n  url: {{base_url}}/api/apps/{{app_id}}/quota/user/{{user_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Remove custom quota for a user (reverts to app default).\n}\n", "language": "text", "size": 274, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.2142074, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1045043}, "bruno/digitorn-api-full/apps/DELETE api apps -app_id quota.bru": {"content": "meta {\n  name: remove_app_quota\n  type: http\n  seq: 136\n}\n\ndelete {\n  url: {{base_url}}/api/apps/{{app_id}}/quota\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Remove custom rate limit (reverts to global default).\n}\n", "language": "text", "size": 253, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.2191188, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1045043}, "bruno/digitorn-api-full/apps/DELETE api apps -app_id secrets -key.bru": {"content": "meta {\n  name: delete_secret\n  type: http\n  seq: 138\n}\n\ndelete {\n  url: {{base_url}}/api/apps/{{app_id}}/secrets/{{key}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Delete a secret.\n}\n", "language": "text", "size": 223, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.2221596, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1045043}, "bruno/digitorn-api-full/apps/DELETE api apps -app_id sessions -session_id queue -entry_id.bru": {"content": "meta {\n  name: cancel_queued_message\n  type: http\n  seq: 140\n}\n\ndelete {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/queue/{{entry_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Cancel a queued (not yet running) message. Running messages must\n  be aborted via ``POST /abort``.\n}\n", "language": "text", "size": 340, "lines": 21, "operation": "disk_sync", "updated_at": 1778628122.224974, "validation": "approved", "baseline_lines": 20, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1045043}, "bruno/digitorn-api-full/apps/DELETE api apps -app_id sessions -session_id.bru": {"content": "meta {\n  name: delete_session\n  type: http\n  seq: 139\n}\n\ndelete {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Delete a session and its history.\n}\n", "language": "text", "size": 249, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.2306106, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1045043}, "bruno/digitorn-api-full/apps/DELETE api apps -app_id watchers -watcher_id.bru": {"content": "meta {\n  name: stop_watcher\n  type: http\n  seq: 141\n}\n\ndelete {\n  url: {{base_url}}/api/apps/{{app_id}}/watchers/{{watcher_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Stop and remove a watcher.\n}\n", "language": "text", "size": 240, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.2357001, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1118424}, "bruno/digitorn-api-full/apps/DELETE api apps -app_id.bru": {"content": "meta {\n  name: delete_app\n  type: http\n  seq: 129\n}\n\ndelete {\n  url: {{base_url}}/api/apps/{{app_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  undeploy_only: \n  delete_history: \n  scope: \n}\n\ndocs {\n  Delete a scoped app install — scope-aware removal.\n  \n  **Multi-tenant scoping**:\n  \n  - Default: the caller's JWT ``user_id`` is used. If the caller has\n    a user-scoped install of ``app_id`` it is deleted; otherwise the\n    system install is the target. Bob's install is never touched\n    when Alice deletes.\n  - ``?scope=system`` (admin): force removal of the system install\n    even when a user install exists.\n  - ``?scope=user`` (admin w/ impersonation): target the caller's\n    user install explicitly.\n  \n  **Destructiveness**:\n  \n  - ``?undeploy_only=true``: stops in memory only; data preserved.\n    Prefer ``POST /disable`` for user-facing pause.\n  - ``?delete_history=false``: wipes app definition + bundles + disk\n    for this scope but keeps sessions / messages / activations for\n    audit. Not reversible (bundle gone).\n  - Default (``delete_history=true``): total removal of this scope.\n  \n  Built-in apps cannot be deleted.\n}\n", "language": "text", "size": 1194, "lines": 48, "operation": "disk_sync", "updated_at": 1778628122.2367296, "validation": "approved", "baseline_lines": 47, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.113443}, "bruno/digitorn-api-full/apps/folder.bru": {"content": "meta {\n  name: apps\n  seq: 80\n}\n", "language": "text", "size": 32, "lines": 5, "operation": "disk_sync", "updated_at": 1778628122.2367296, "validation": "approved", "baseline_lines": 4, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2752144}, "bruno/digitorn-api-full/apps/GET api apps -app_id activations -activation_id artifacts.bru": {"content": "meta {\n  name: get_activation_artifacts\n  type: http\n  seq: 9\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/activations/{{activation_id}}/artifacts\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  List every artifact (file) produced by an activation.\n  \n  An artifact is a file-writing tool call (``filesystem.write``,\n  ``filesystem.edit``, ``notebook.*``, ``spreadsheet.*``, ``pdf.*``,\n  ``presentation.*``) that succeeded. The background runtime emits a\n  dedicated ``artifact`` event for each of these at activation time,\n  so this route just reads the already-persisted rows.\n  \n  Response::\n  \n      {\n        \"success\": true,\n        \"data\": {\n          \"activation_id\": \"...\",\n          \"count\": 2,\n          \"artifacts\": [\n            {\n              \"sequence\": 7,\n              \"timestamp\": \"2026-04-13T10:35:44.783Z\",\n              \"path\": \"/workspace/out/report.pdf\",\n              \"action\": \"pdf.create\",\n              \"size_bytes\": 124567\n            },\n            ...\n          ]\n        }\n      }\n  \n  The Flutter dashboard drawer uses this endpoint to populate its\n  \"Artifacts\" section. Click on an artifact opens the viewer\n  registered for that file type (CSV, PDF, Notebook, …).\n}\n", "language": "text", "size": 1241, "lines": 50, "operation": "disk_sync", "updated_at": 1778628122.2367296, "validation": "approved", "baseline_lines": 49, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1145284}, "bruno/digitorn-api-full/apps/GET api apps -app_id activations -activation_id events.bru": {"content": "meta {\n  name: get_activation_events\n  type: http\n  seq: 10\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/activations/{{activation_id}}/events\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  event_type: \n}\n\ndocs {\n  Return the full timeline of events for an activation.\n  \n  Events are ordered by ``sequence`` (monotonically assigned when\n  each event was recorded) so the frontend can render them without\n  worrying about wall-clock ties. Every event has the shape::\n  \n      {\n        \"id\": \"abcd...\",\n        \"sequence\": 7,\n        \"timestamp\": \"2026-04-13T10:35:44.102Z\",\n        \"event_type\": \"tool_call\",\n        \"data\": {\n           \"call_id\": \"call_xyz\",\n           \"name\": \"filesystem.read\",\n           \"params\": {\"file_path\": \"/data/news.json\"},\n           \"success\": true,\n           \"error\": \"\",\n           \"result_preview\": {...}\n        }\n      }\n  \n  Known ``event_type`` values currently emitted by the background\n  runtime: ``tool_call``, ``thinking``, ``channel_sent``,\n  ``artifact``, ``turn_start``, ``turn_end``.\n  \n  Pass ``?event_type=tool_call`` (or any of the above) to filter.\n}\n", "language": "text", "size": 1151, "lines": 49, "operation": "disk_sync", "updated_at": 1778628122.2538214, "validation": "approved", "baseline_lines": 48, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1156309}, "bruno/digitorn-api-full/apps/GET api apps -app_id activations -activation_id.bru": {"content": "meta {\n  name: get_activation\n  type: http\n  seq: 8\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/activations/{{activation_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Get full details of a single activation.\n  \n  Includes message, response, tool calls, timing, tokens.\n}\n", "language": "text", "size": 318, "lines": 22, "operation": "disk_sync", "updated_at": 1778628122.2538214, "validation": "approved", "baseline_lines": 21, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.117242}, "bruno/digitorn-api-full/apps/GET api apps -app_id activations stats.bru": {"content": "meta {\n  name: activation_stats\n  type: http\n  seq: 7\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/activations/stats\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Get aggregated activation statistics.\n  \n  Returns: total count, success rate, avg duration, total tokens, total cost.\n}\n", "language": "text", "size": 325, "lines": 22, "operation": "disk_sync", "updated_at": 1778628122.2538214, "validation": "approved", "baseline_lines": 21, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1183813}, "bruno/digitorn-api-full/apps/GET api apps -app_id activations.bru": {"content": "meta {\n  name: list_activations\n  type: http\n  seq: 6\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/activations\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  limit: \n  offset: \n  trigger_id: \n  status: \n}\n\ndocs {\n  List activation history for a background app.\n  \n  Returns a paginated list of trigger activations with timing, result,\n  and token usage. Filter by trigger_id or status (running/completed/failed).\n}\n", "language": "text", "size": 463, "lines": 30, "operation": "disk_sync", "updated_at": 1778628122.268634, "validation": "approved", "baseline_lines": 29, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1195414}, "bruno/digitorn-api-full/apps/GET api apps -app_id approvals.bru": {"content": "meta {\n  name: list_approvals\n  type: http\n  seq: 11\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/approvals\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  List pending approval requests for an app.\n}\n", "language": "text", "size": 240, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.2711415, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1275349}, "bruno/digitorn-api-full/apps/GET api apps -app_id artifacts -event_id download.bru": {"content": "meta {\n  name: download_artifact\n  type: http\n  seq: 12\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/artifacts/{{event_id}}/download\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Stream an artifact file to the client.\n  \n  The ``event_id`` MUST be the id of an ``ActivationEvent`` row with\n  ``event_type='artifact'`` — in other words, a file that was\n  previously recorded by the background runtime when a tool wrote it\n  to disk. This is enforced strictly to prevent any form of path\n  injection: the client never passes a filesystem path, it passes an\n  opaque id that the daemon resolves to a path it already knows and\n  trusted at recording time.\n  \n  Security pipeline:\n  \n  1. Look up the event by id.\n  2. Verify the event belongs to an activation of this ``app_id``\n     (cross-app lookup is blocked).\n  3. Verify the event_type is ``artifact``.\n  4. Read the path from the event's ``data.path``.\n  5. Verify the file exists, is a regular file (not a dir/symlink to\n     a dir), and is within the size limit.\n  6. Stream it with the right Content-Type.\n  \n  A failure at any step returns 404 with a generic message — the\n  client should never be able to tell the difference between \"path\n  doesn't exist\", \"not an artifact\", and \"doesn't belong to this app\"\n  because those distinctions leak info about other users' data.\n}\n", "language": "text", "size": 1374, "lines": 44, "operation": "disk_sync", "updated_at": 1778628122.2711415, "validation": "approved", "baseline_lines": 43, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1291552}, "bruno/digitorn-api-full/apps/GET api apps -app_id assets -asset_path-path.bru": {"content": "meta {\n  name: get_app_asset\n  type: http\n  seq: 13\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/assets/{{asset_path:path}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Serve any file from an installed app's directory.\n  \n  Use this to fetch README.md, CHANGELOG.md, skill files, images,\n  or any other companion file declared in the package dir.\n  \n  Guarded against path traversal — the resolved path must stay\n  inside the app's install directory. Hidden files under\n  ``.digitorn/`` are explicitly denied (they're daemon-managed\n  state, not author content).\n}\n", "language": "text", "size": 607, "lines": 28, "operation": "disk_sync", "updated_at": 1778628122.283909, "validation": "approved", "baseline_lines": 27, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1302183}, "bruno/digitorn-api-full/apps/GET api apps -app_id background-sessions -bg_session_id payload.bru": {"content": "meta {\n  name: get_background_session_payload\n  type: http\n  seq: 16\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/background-sessions/{{bg_session_id}}/payload\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Return the full payload (prompt + metadata + files) for a session.\n  \n  Also returns a ``validation`` block describing whether the payload\n  satisfies the app's declared ``payload_schema`` — the dashboard uses\n  this to decide whether to enable the \"Activate\" button.\n}\n", "language": "text", "size": 517, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.2846413, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1318107}, "bruno/digitorn-api-full/apps/GET api apps -app_id background-sessions -bg_session_id.bru": {"content": "meta {\n  name: get_background_session\n  type: http\n  seq: 15\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/background-sessions/{{bg_session_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Get a single background session with its params and routing keys.\n}\n", "language": "text", "size": 299, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.2846413, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1328871}, "bruno/digitorn-api-full/apps/GET api apps -app_id background-sessions.bru": {"content": "meta {\n  name: list_background_sessions\n  type: http\n  seq: 14\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/background-sessions\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  limit: \n  offset: \n}\n\ndocs {\n  List background sessions for the authenticated user.\n}\n", "language": "text", "size": 309, "lines": 25, "operation": "disk_sync", "updated_at": 1778628122.2958243, "validation": "approved", "baseline_lines": 24, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.133961}, "bruno/digitorn-api-full/apps/GET api apps -app_id background-tasks -task_id.bru": {"content": "meta {\n  name: get_background_task\n  type: http\n  seq: 18\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/background-tasks/{{task_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Get status and result of a background task.\n}\n", "language": "text", "size": 265, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.3008451, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1351407}, "bruno/digitorn-api-full/apps/GET api apps -app_id background-tasks.bru": {"content": "meta {\n  name: list_background_tasks_app\n  type: http\n  seq: 17\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/background-tasks\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  List all background tasks (running + completed).\n}\n", "language": "text", "size": 264, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.3014677, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1356885}, "bruno/digitorn-api-full/apps/GET api apps -app_id channels health.bru": {"content": "meta {\n  name: channels_health\n  type: http\n  seq: 19\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/channels/health\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Return the live health of every channel registered for an app.\n  \n  Walks the ``ChannelRegistry`` of the deployed app, calls\n  ``health_check()`` on each instance and returns a structured dict\n  the Flutter dashboard can render as a status badge per channel.\n  \n  Response::\n  \n      {\n        \"success\": true,\n        \"data\": {\n          \"app_id\": \"newsletter-digest\",\n          \"channel_count\": 3,\n          \"channels\": {\n            \"email\": {\n              \"status\": \"ok\",\n              \"latency_ms\": 124.5,\n              \"last_error\": null,\n              \"last_success_at\": \"2026-04-13T10:35:45Z\",\n              \"deliveries_total\": 12,\n              \"deliveries_failed\": 0,\n              \"details\": {\"smtp_host\": \"smtp.sendgrid.net\"}\n            },\n            \"slack\": {\"status\": \"ok\", ...},\n            \"failing_webhook\": {\n              \"status\": \"down\",\n              \"last_error\": \"HTTP 503 Service Unavailable\",\n              ...\n            }\n          }\n        }\n      }\n  \n  Status values: ``ok`` (happy path), ``degraded`` (working but\n  flaky — retries needed), ``down`` (last attempt failed and the\n  channel is considered unreachable). The dashboard maps each to a\n  dot color.\n}\n", "language": "text", "size": 1401, "lines": 56, "operation": "disk_sync", "updated_at": 1778628122.3059525, "validation": "approved", "baseline_lines": 55, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1356885}, "bruno/digitorn-api-full/apps/GET api apps -app_id check-update.bru": {"content": "meta {\n  name: check_update\n  type: http\n  seq: 20\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/check-update\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Report whether an updated version of the installed app is available.\n  \n  Only built-in apps currently support this — the wheel ships a\n  possibly-newer version of each builtin and the registry tracks the\n  installed hash. Hub and git sources will support this in v2.\n}\n", "language": "text", "size": 466, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.3159475, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1356885}, "bruno/digitorn-api-full/apps/GET api apps -app_id deploy-status.bru": {"content": "meta {\n  name: get_deploy_status\n  type: http\n  seq: 21\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/deploy-status\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Return the last known deploy outcome for an app.\n  \n  BUG-080: POST ``/deploy`` used to return ``status:\"deploying\"``\n  and silently drop the error if the background deploy failed — the\n  client had no way to distinguish \"still running\" from \"failed\".\n  This route surfaces the stored error (if any) so the caller can\n  show a meaningful message.\n  \n  Shape::\n  \n      { \"deployed\": true, \"app_id\": \"...\", \"error\": null }\n      { \"deployed\": false, \"app_id\": \"...\", \"error\": \"...\", \"traceback\": \"...\" }\n}\n", "language": "text", "size": 707, "lines": 31, "operation": "disk_sync", "updated_at": 1778628122.3182173, "validation": "approved", "baseline_lines": 30, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1356885}, "bruno/digitorn-api-full/apps/GET api apps -app_id diagnostics.bru": {"content": "meta {\n  name: app_diagnostics\n  type: http\n  seq: 22\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/diagnostics\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Run diagnostics checks for a deployed app.\n}\n", "language": "text", "size": 243, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.3214028, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1356885}, "bruno/digitorn-api-full/apps/GET api apps -app_id errors.bru": {"content": "meta {\n  name: app_errors\n  type: http\n  seq: 23\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/errors\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  limit: \n}\n\ndocs {\n  Get recent failed activations with error details.\n}\n", "language": "text", "size": 268, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.325942, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1356885}, "bruno/digitorn-api-full/apps/GET api apps -app_id files.bru": {"content": "meta {\n  name: list_app_files\n  type: http\n  seq: 24\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/files\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  subdir: \n}\n\ndocs {\n  List files available in a deployed app's companion directory.\n  \n  Lets the Flutter client discover what assets / skills / prompts\n  ship with an app without guessing filenames. ``subdir`` narrows\n  the listing to a subdirectory (e.g. ``?subdir=skills`` or\n  ``?subdir=assets``). Empty = root.\n  \n  Returns a shallow listing (one directory level) — call again\n  with a subdir query to drill down.\n}\n", "language": "text", "size": 619, "lines": 32, "operation": "disk_sync", "updated_at": 1778628122.3308358, "validation": "approved", "baseline_lines": 31, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1356885}, "bruno/digitorn-api-full/apps/GET api apps -app_id icon.bru": {"content": "meta {\n  name: get_app_icon\n  type: http\n  seq: 25\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/icon\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Stream the icon file declared by an installed app's manifest.\n}\n", "language": "text", "size": 252, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.3346617, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1356885}, "bruno/digitorn-api-full/apps/GET api apps -app_id index.bru": {"content": "meta {\n  name: get_app_index\n  type: http\n  seq: 26\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/index\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Get full tool index structure for the app.\n  \n  Returns all categories, tools, aliases, and metadata.\n  Useful for SDK clients to build local caches or UI.\n}\n", "language": "text", "size": 348, "lines": 23, "operation": "disk_sync", "updated_at": 1778628122.3346617, "validation": "approved", "baseline_lines": 22, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1453104}, "bruno/digitorn-api-full/apps/GET api apps -app_id mcp pending-oauth.bru": {"content": "meta {\n  name: list_pending_oauth\n  type: http\n  seq: 27\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/mcp/pending-oauth\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  List MCP servers that need OAuth authorization (no valid token yet).\n}\n", "language": "text", "size": 278, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.3346617, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1453104}, "bruno/digitorn-api-full/apps/GET api apps -app_id notifications active.bru": {"content": "meta {\n  name: has_active_bg_tasks\n  type: http\n  seq: 28\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/notifications/active\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Quick check if any background tasks are active for this app.\n  \n  Returns ``active: false`` (not 404) when the app is not deployed,\n  since this endpoint is polled continuously by the CLI — a 404 would\n  spam the server logs with useless error entries.\n}\n", "language": "text", "size": 466, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.3471773, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1453104}, "bruno/digitorn-api-full/apps/GET api apps -app_id oauth authorize.bru": {"content": "meta {\n  name: oauth_authorize\n  type: http\n  seq: 29\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/oauth/authorize\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  server_id: \n  session_id: \n}\n\ndocs {\n  Start an OAuth2 authorization flow for an MCP server.\n  \n  Returns the authorization URL the user should open in their browser.\n}\n", "language": "text", "size": 379, "lines": 27, "operation": "disk_sync", "updated_at": 1778628122.3513153, "validation": "approved", "baseline_lines": 26, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1453104}, "bruno/digitorn-api-full/apps/GET api apps -app_id oauth callback.bru": {"content": "meta {\n  name: oauth_callback\n  type: http\n  seq: 30\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/oauth/callback\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  code: \n  state: \n}\n\ndocs {\n  OAuth2 callback endpoint — exchanges authorization code for tokens.\n  \n  This is the redirect_uri that the OAuth provider redirects to after\n  the user authorizes. Exchanges the code for tokens and stores them.\n}\n", "language": "text", "size": 450, "lines": 28, "operation": "disk_sync", "updated_at": 1778628122.3513153, "validation": "approved", "baseline_lines": 27, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1453104}, "bruno/digitorn-api-full/apps/GET api apps -app_id payload-schema.bru": {"content": "meta {\n  name: get_app_payload_schema\n  type: http\n  seq: 31\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/payload-schema\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Return the declarative payload schema for a background app.\n  \n  The Flutter dashboard calls this once per app to render a typed\n  form (instead of a generic key/value editor) and to know which\n  fields/files are required before a session can be activated.\n  \n  Returns ``data: null`` when the app has no schema declared — the\n  dashboard should fall back to the free-form editor in that case.\n}\n", "language": "text", "size": 604, "lines": 27, "operation": "disk_sync", "updated_at": 1778628122.3513153, "validation": "approved", "baseline_lines": 26, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1453104}, "bruno/digitorn-api-full/apps/GET api apps -app_id preview -buffer_key-path.bru": {"content": "meta {\n  name: preview_buffer\n  type: http\n  seq: 35\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/preview/{{buffer_key:path}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Serve the app's static preview (web/dist/).\n  \n  When ``buffer_key`` is empty (e.g. ``/preview/?session_id=...``), serves\n  the static dist bundle so the Flutter client can load the app's web UI\n  in an iframe at ``/api/apps/{app_id}/preview/``.\n  \n  Query params:\n      session_id: Forwarded to the static dist's index.html.\n}\n", "language": "text", "size": 541, "lines": 27, "operation": "disk_sync", "updated_at": 1778628122.3629274, "validation": "approved", "baseline_lines": 26, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1522572}, "bruno/digitorn-api-full/apps/GET api apps -app_id preview-server logs.bru": {"content": "meta {\n  name: preview_server_logs\n  type: http\n  seq: 32\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/preview-server/logs\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  limit: \n}\n\ndocs {\n  Return the last ``limit`` log lines captured from the dev server.\n}\n", "language": "text", "size": 306, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.3682292, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1522572}, "bruno/digitorn-api-full/apps/GET api apps -app_id preview-server proxy -path-path.bru": {"content": "meta {\n  name: preview_server_proxy\n  type: http\n  seq: 33\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/preview-server/proxy/{{path:path}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Reverse-proxy HTTP traffic to the app's dev server.\n  \n  Flutter points an iframe at ``/api/apps/{app_id}/preview-server/proxy/``\n  to render the dev UI inside the Digitorn admin panel. HMR websockets\n  use the matching ``/preview-server/ws/{path:path}`` upgrade route.\n}\n", "language": "text", "size": 498, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.3722425, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1522572}, "bruno/digitorn-api-full/apps/GET api apps -app_id preview-server status.bru": {"content": "meta {\n  name: preview_server_status\n  type: http\n  seq: 34\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/preview-server/status\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Return the current state of an app's preview dev server.\n  \n  Response shape matches :meth:`PreviewManager.status().as_dict()` with\n  the tailing log buffer. Flutter polls (or opens an SSE stream) to\n  reflect the status in the admin panel.\n  \n  When the app ships a pre-built ``web/dist/`` (production mode) the\n  endpoint reports ``enabled: true`` + ``state: \"running\"`` even if\n  no Vite dev server is alive — the proxy will serve the static\n  bundle directly. This makes the Flutter client display the iframe\n  instead of \"no preview block declared\".\n}\n", "language": "text", "size": 771, "lines": 30, "operation": "disk_sync", "updated_at": 1778628122.3722425, "validation": "approved", "baseline_lines": 29, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1574862}, "bruno/digitorn-api-full/apps/GET api apps -app_id quota user -user_id.bru": {"content": "meta {\n  name: get_user_quota\n  type: http\n  seq: 37\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/quota/user/{{user_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Get rate limit usage for a specific user on an app.\n}\n", "language": "text", "size": 262, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.3722425, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1595702}, "bruno/digitorn-api-full/apps/GET api apps -app_id quota.bru": {"content": "meta {\n  name: get_app_quota\n  type: http\n  seq: 36\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/quota\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Get current rate limit usage for an app.\n}\n", "language": "text", "size": 233, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.3850656, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1605852}, "bruno/digitorn-api-full/apps/GET api apps -app_id required-secrets.bru": {"content": "meta {\n  name: required_secrets\n  type: http\n  seq: 38\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/required-secrets\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  List the secrets the app's YAML REQUIRES and their current status.\n  \n  Returns everything the UI needs to render a \"manage credentials\"\n  screen for an app with multiple providers:\n  \n  - ``key``       : the secret name (e.g. ``ANTHROPIC_API_KEY``)\n  - ``used_by``   : list of dotted YAML paths where the secret is\n                    referenced — so the UI can group by agent/module\n                    or at least show \"this key is used in 2 places\"\n  - ``is_set``    : ``true`` if the secret is already defined in\n                    ``SecretStore`` or matches an env var on the daemon\n  - ``reference_type``: ``\"env\"`` or ``\"secret\"`` depending on the\n                    template style (``{{env.X}}`` vs ``{{secret.X}}``)\n  \n  The response also includes:\n  \n  - ``missing_count`` : how many required secrets have no value yet\n  - ``unused_keys``   : secrets stored in SecretStore that are NOT\n                       referenced by the current YAML (orphans from\n                       an old version of the app — the UI can offer\n                       to clean them up)\n  \n  This route reads from the app's **current bundle** on disk — so the\n  list reflects the deployed version, not the live memory state (they\n  should match, but if someone fiddled with secrets manually the\n  ``is_set`` column will reveal the drift).\n}\n", "language": "text", "size": 1534, "lines": 45, "operation": "disk_sync", "updated_at": 1778628122.3850656, "validation": "approved", "baseline_lines": 44, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1605852}, "bruno/digitorn-api-full/apps/GET api apps -app_id secrets -key.bru": {"content": "meta {\n  name: check_secret\n  type: http\n  seq: 40\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/secrets/{{key}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Check if a secret exists (value is never returned).\n}\n", "language": "text", "size": 253, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.3850656, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1605852}, "bruno/digitorn-api-full/apps/GET api apps -app_id secrets.bru": {"content": "meta {\n  name: list_secrets\n  type: http\n  seq: 39\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/secrets\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  List secret key names for an app (values are never returned).\n}\n", "language": "text", "size": 255, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.402367, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1605852}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id active-ops.bru": {"content": "meta {\n  name: list_active_ops\n  type: http\n  seq: 44\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/active-ops\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  List non-terminal operations for a session.\n  \n  This is the reconnect probe. Every event the daemon emits carries\n  ``{op_id, op_type, op_state}`` (see :mod:`digitorn.core.events.envelope`),\n  so the current state of any in-flight tool / sub-agent / approval /\n  compaction / turn can be reconstructed by grouping ``session_events``\n  rows by ``op_id`` and keeping the latest. This route does that\n  group-by server-side and returns ONLY the ops whose latest\n  ``op_state`` is still non-terminal (``pending``, ``running``,\n  ``waiting_approval``).\n  \n  Typical client flow after a reconnect::\n  \n      # 1. replay everything since last known seq (gives the turn\n      #    timeline for rendering bubbles, tool chips, thinking, …)\n      GET /sessions/{sid}/events?since_seq=<last>\n  \n      # 2. ask the server what's still alive right now\n      GET /sessions/{sid}/active-ops\n      → [{op_id, op_type, op_state, started_at, last_ts, ...}, ...]\n  \n  Without (2), a client that disconnected DURING a long tool call\n  has to guess. With (2), the spinner is restored instantly.\n}\n", "language": "text", "size": 1297, "lines": 42, "operation": "disk_sync", "updated_at": 1778628122.4043787, "validation": "approved", "baseline_lines": 41, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1605852}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id context-breakdown.bru": {"content": "meta {\n  name: get_context_breakdown\n  type: http\n  seq: 45\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/context-breakdown\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Debug: what's eating the session's context window right now.\n  \n  Returns a token-estimate per injection surface:\n  \n  - ``system_prompt`` — the full prompt the LLM sees (identity, tool\n    instructions, behavioral guidelines, setup_summary, skills,\n    module sections).\n  - ``tools_schema`` — JSON schema of every tool (in-schema tokens).\n  - ``messages`` — everything in ``ConversationSession.messages``\n    (system + user + assistant + tool).\n  - ``memory_injected`` — the memory module's rendered prompt\n    section (goal, todos, facts).\n  - ``setup_summary`` — setup step outputs injected at bootstrap.\n  - ``skills`` — skill .md content concatenated.\n  - ``total`` — sum matching what ``_call_llm`` actually sends.\n  \n  Use this when hitting context overflows to identify the offender.\n}\n", "language": "text", "size": 1029, "lines": 36, "operation": "disk_sync", "updated_at": 1778628122.4043787, "validation": "approved", "baseline_lines": 35, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1664767}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id events.bru": {"content": "meta {\n  name: list_session_events\n  type: http\n  seq: 46\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/events\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  since_seq: \n  since_ts: \n  limit: \n}\n\ndocs {\n  Fetch the persistent event log for a session.\n  \n  Unlike the in-memory ring buffer (which covers only the last N events\n  per user), this endpoint reads from the ``session_events`` DB table\n  that captures every meaningful event (hooks, tool calls, message\n  lifecycle, errors, agent spawns, …) with timestamp + seq. Useful\n  when:\n  \n  - The Flutter client reopens a session older than the ring buffer.\n  - A new device joins and needs the full history.\n  - Audit / compliance needs a provable turn-by-turn trace.\n  \n  Token-level events are NOT logged (reconstructed from persisted\n  message content). Everything else IS.\n  \n  ``since_seq`` or ``since_ts`` filter to only events after the watermark.\n  \n  **Relationship to Socket.IO ``join_session``**\n  \n  The Socket.IO join flow pushes three distinct groups of events:\n  \n  1. *Durable replay* — the same ``session_events`` rows this HTTP\n     route returns (identical shape, identical filter).\n  2. *Preview/workspace hydration* — ``preview:snapshot``,\n     ``workspace:snapshot`` emitted once at join time from the\n     in-memory preview module (NOT persisted to ``session_events``).\n  3. *Bootstrap side-channels* — occasional channel/widget snapshots.\n  \n  So ``count(/events) <= count(socket events)``: if the two numbers\n  disagree, the difference is hydration, not a missing durable row.\n  To verify parity, compare only the envelopes whose ``seq`` is set.\n  \n  Events are scoped to the caller's ``user_id`` — an admin querying\n  another user's session gets nothing here (same rule as Socket.IO).\n}\n", "language": "text", "size": 1837, "lines": 59, "operation": "disk_sync", "updated_at": 1778628122.4043787, "validation": "approved", "baseline_lines": 58, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1664767}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id export.bru": {"content": "meta {\n  name: export_session\n  type: http\n  seq: 47\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/export\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  format: \n}\n\ndocs {\n  Export a session as Markdown (or other formats).\n  \n  Produces a clean document with all conversation turns, tool calls,\n  and results. Suitable for sharing, archiving, or documentation.\n}\n", "language": "text", "size": 434, "lines": 27, "operation": "disk_sync", "updated_at": 1778628122.417334, "validation": "approved", "baseline_lines": 26, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1697671}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id history.bru": {"content": "meta {\n  name: get_session_history\n  type: http\n  seq: 48\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/history\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  include_system: \n}\n\ndocs {\n  Get full conversation history for a session.\n  \n  Returns all messages (system, user, assistant) in order.\n  Useful for SDK clients to restore context or display history.\n  \n  Args:\n      include_system: If True, include raw system messages (behavior directives,\n          violations, etc.). Default False — only user/assistant/tool.\n          Used by the dev testing SDK to inspect behavior enforcement.\n}\n", "language": "text", "size": 666, "lines": 32, "operation": "disk_sync", "updated_at": 1778628122.4258766, "validation": "approved", "baseline_lines": 31, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1697671}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id images -image_id.bru": {"content": "meta {\n  name: get_session_image\n  type: http\n  seq: 49\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/images/{{image_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Serve a session image by ID. Returns raw image bytes.\n}\n", "language": "text", "size": 288, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.4367757, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1697671}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id memory.bru": {"content": "meta {\n  name: get_session_memory\n  type: http\n  seq: 50\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/memory\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Get the current memory state for a session (goal, todos, facts).\n  \n  Lighter than full history — only the working memory snapshot.\n}\n", "language": "text", "size": 354, "lines": 22, "operation": "disk_sync", "updated_at": 1778628122.4367757, "validation": "approved", "baseline_lines": 21, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1697671}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id preview.bru": {"content": "meta {\n  name: get_session_preview\n  type: http\n  seq: 51\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/preview\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Get the current preview snapshot for a session.\n  \n  Returns the full preview state: scalar state map, all resource\n  channels, and the event ring buffer. Clients call this on connect\n  (or reconnect) to hydrate the UI without replaying every event.\n}\n", "language": "text", "size": 474, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.4458795, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1752436}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id queue.bru": {"content": "meta {\n  name: list_session_queue\n  type: http\n  seq: 52\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/queue\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  include_finished: \n}\n\ndocs {\n  List pending + running messages for this session.\n  \n  Use ``include_finished=true`` to also see recently completed /\n  failed / cancelled entries (kept briefly for tracking).\n}\n", "language": "text", "size": 436, "lines": 27, "operation": "disk_sync", "updated_at": 1778628122.4511998, "validation": "approved", "baseline_lines": 26, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.17684}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id tasks.bru": {"content": "meta {\n  name: list_background_tasks\n  type: http\n  seq: 53\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/tasks\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  List all background shell tasks for a session.\n  \n  Returns running and recently finished tasks with their status,\n  command, pid, uptime, and output line counts.\n}\n", "language": "text", "size": 387, "lines": 23, "operation": "disk_sync", "updated_at": 1778628122.4511998, "validation": "approved", "baseline_lines": 22, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.17684}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id workspace code-snapshot.bru": {"content": "meta {\n  name: get_code_snapshot\n  type: http\n  seq: 55\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/code-snapshot\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  File tree + metadata for the code editor — NO content.\n  \n  Preview module is preferred (it carries live validation / pending-diff\n  metadata). For apps without preview we fall back to listing files on\n  disk in the session workspace so the explorer still renders.\n}\n", "language": "text", "size": 503, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.4641395, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.17684}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id workspace export.bru": {"content": "meta {\n  name: export_session_workspace\n  type: http\n  seq: 56\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/export\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Export the full workspace snapshot as a portable JSON object.\n  \n  The returned payload can be POSTed to ``/workspace/import`` on any\n  session of the same app (or ``/workspace/fork`` to create a new one).\n  Suitable for \"Save a copy\", cross-user hand-off, or project\n  templates.\n}\n", "language": "text", "size": 519, "lines": 25, "operation": "disk_sync", "updated_at": 1778628122.4678423, "validation": "approved", "baseline_lines": 24, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.17684}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id workspace files -file_path-path history.bru": {"content": "meta {\n  name: file_history_endpoint\n  type: http\n  seq: 58\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/files/{{file_path:path}}/history\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  History of baseline revisions for a file — latest first.\n  \n  Must be declared BEFORE the ``/files/{file_path:path}`` catch-all,\n  otherwise FastAPI's first-match routing consumes the ``/history``\n  suffix as part of file_path and the request returns 404.\n}\n", "language": "text", "size": 517, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.4728243, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.17684}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id workspace files -file_path-path.bru": {"content": "meta {\n  name: get_file_content\n  type: http\n  seq: 57\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/files/{{file_path:path}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  include_baseline: \n}\n\ndocs {\n  Fetch the full content of a single workspace file (lazy-loaded).\n  \n  Works for apps with or without the ``preview`` module — if preview is\n  loaded, we serve from its in-memory resources (current live state).\n  Otherwise we fall back to reading the file directly from the session\n  workspace on disk (apps that only use ``filesystem``/``workspace``\n  without streaming preview events still need to serve their files).\n  \n  With ``include_baseline=true`` the response also includes the\n  last-approved baseline content + a pending unified diff — used by the\n  diff viewer when the user clicks \"review changes\".\n}\n", "language": "text", "size": 898, "lines": 34, "operation": "disk_sync", "updated_at": 1778628122.4728243, "validation": "approved", "baseline_lines": 33, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.17684}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id workspace preview-snapshot.bru": {"content": "meta {\n  name: get_preview_snapshot\n  type: http\n  seq: 59\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/preview-snapshot\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Lightweight snapshot for the preview pane — state + non-files channels.\n  \n  Returns: ``{state, resources: {<channel>: {...}} (without \"files\"), seq}``.\n  Use this to render the live preview canvas without pulling file content.\n}\n", "language": "text", "size": 472, "lines": 23, "operation": "disk_sync", "updated_at": 1778628122.4839242, "validation": "approved", "baseline_lines": 22, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.17684}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id workspace.bru": {"content": "meta {\n  name: get_session_workspace\n  type: http\n  seq: 54\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Full workspace snapshot for a session — durable + in-memory state merged.\n  \n  Returns everything the client needs to re-render the session view\n  identically on reopen:\n  \n  - ``workspace`` / ``workspace_mode`` — physical workspace dir (if any)\n  - ``render_mode`` / ``entry_file`` — from the top-level ``workspace:`` YAML\n  - ``snapshot`` — the live preview state tree (``state`` map, ``resources``\n    channels, last ``seq``). Hydrated from DB on first read after a\n    daemon restart, then live-updated by every tool call.\n  - ``git`` — git status of the physical workspace (if present)\n}\n", "language": "text", "size": 819, "lines": 30, "operation": "disk_sync", "updated_at": 1778628122.4856718, "validation": "approved", "baseline_lines": 29, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.17684}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions -session_id.bru": {"content": "meta {\n  name: get_session\n  type: http\n  seq: 43\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Get session status — metadata, live metrics, context pressure.\n  \n  Single endpoint for clients to get the full session state on load.\n  All numbers come from the SessionMetrics counters (populated by\n  agent_loop during execution) — no estimation or speculation.\n}\n", "language": "text", "size": 472, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.4856718, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.17684}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions search.bru": {"content": "meta {\n  name: search_sessions\n  type: http\n  seq: 42\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/search\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  q: \n  limit: \n  offset: \n}\n\ndocs {\n  Search across all sessions — matches title and message content.\n  \n  Returns sessions ranked by relevance (title match > recent message match).\n}\n", "language": "text", "size": 393, "lines": 28, "operation": "disk_sync", "updated_at": 1778628122.4968987, "validation": "approved", "baseline_lines": 27, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.17684}, "bruno/digitorn-api-full/apps/GET api apps -app_id sessions.bru": {"content": "meta {\n  name: list_sessions\n  type: http\n  seq: 41\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  limit: \n  offset: \n}\n\ndocs {\n  List sessions for an app with pagination.\n  \n  Query params:\n      limit:  max sessions to return (default 50, max 200, 0 = all)\n      offset: skip first N sessions (for pagination)\n  \n  Response includes ``total`` for the frontend to know if there are more.\n}\n", "language": "text", "size": 493, "lines": 31, "operation": "disk_sync", "updated_at": 1778628122.501454, "validation": "approved", "baseline_lines": 30, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.17684}, "bruno/digitorn-api-full/apps/GET api apps -app_id status.bru": {"content": "meta {\n  name: app_status\n  type: http\n  seq: 60\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/status\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Hero-stats endpoint for the Flutter background app dashboard.\n  \n  One round-trip returns everything the top of the dashboard needs:\n  \n  - ``live``          → current run state (``running`` / ``idle``) +\n                        number of activations in status='running'\n  - ``stats``         → all-time aggregated stats (same as\n                        ``/activations/stats``) so the UI doesn't have\n                        to chain two requests on page load\n  - ``hourly``        → the 24-hour sparkline bucket list, one row per\n                        hour, oldest first, including empty hours\n  - ``trend_24h``     → total runs + failed runs in the last 24 h\n                        (convenience aggregate on top of ``hourly``)\n  - ``triggers_summary`` → light summary of trigger + channel state so\n                        the dashboard header can show \"2 triggers · 3\n                        channels active\" without a second call to\n                        ``/triggers``\n  \n  This is what the dashboard should call at page load and whenever\n  the user hits the ↻ refresh button. Everything else (activation\n  list, trigger details, channel details) is lazy-loaded on demand.\n}\n", "language": "text", "size": 1371, "lines": 40, "operation": "disk_sync", "updated_at": 1778628122.501454, "validation": "approved", "baseline_lines": 39, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.17684}, "bruno/digitorn-api-full/apps/GET api apps -app_id tools -tool_name-path.bru": {"content": "meta {\n  name: get_tool_schema\n  type: http\n  seq: 64\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/tools/{{tool_name:path}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Get full schema for a tool by qualified name (e.g. filesystem.read).\n  \n  Returns parameters, description, examples, aliases, side effects.\n}\n", "language": "text", "size": 353, "lines": 22, "operation": "disk_sync", "updated_at": 1778628122.5129173, "validation": "approved", "baseline_lines": 21, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.17684}, "bruno/digitorn-api-full/apps/GET api apps -app_id tools categories -category.bru": {"content": "meta {\n  name: browse_tool_category\n  type: http\n  seq: 62\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/tools/categories/{{category}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  page: \n}\n\ndocs {\n  Browse tools in a category (paginated).\n}\n", "language": "text", "size": 290, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.5173173, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.192196}, "bruno/digitorn-api-full/apps/GET api apps -app_id tools categories.bru": {"content": "meta {\n  name: list_tool_categories\n  type: http\n  seq: 61\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/tools/categories\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  List all tool categories (modules) with tool counts.\n}\n", "language": "text", "size": 263, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.5181952, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1936452}, "bruno/digitorn-api-full/apps/GET api apps -app_id tools search.bru": {"content": "meta {\n  name: search_tools\n  type: http\n  seq: 63\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/tools/search\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  query: \n  max_results: \n}\n\ndocs {\n  Semantic + keyword search over all tools available to the app.\n  \n  Returns ranked results with scores, descriptions, and parameter schemas.\n}\n", "language": "text", "size": 383, "lines": 27, "operation": "disk_sync", "updated_at": 1778628122.5258136, "validation": "approved", "baseline_lines": 26, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1936452}, "bruno/digitorn-api-full/apps/GET api apps -app_id triggers.bru": {"content": "meta {\n  name: app_triggers\n  type: http\n  seq: 65\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/triggers\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Get the status of all triggers and channels for a background app.\n  \n  Shows configured triggers, active listeners, last activation times,\n  and any errors. Useful for monitoring background apps.\n}\n", "language": "text", "size": 390, "lines": 23, "operation": "disk_sync", "updated_at": 1778628122.528978, "validation": "approved", "baseline_lines": 22, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1936452}, "bruno/digitorn-api-full/apps/GET api apps -app_id ui-config.bru": {"content": "meta {\n  name: get_app_ui_config\n  type: http\n  seq: 66\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/ui-config\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Return ONLY the client-UI-relevant config flags for an app.\n  \n  Safe to call from any authenticated user — it strictly allow-lists\n  fields that are safe to expose to a frontend (booleans, render\n  modes, layout hints). Never leaks prompts, secrets, api_keys,\n  webhook URLs, hook logic, or capability grants.\n  \n  Rationale: the Flutter / web client needs to adapt its UI based on\n  per-app config (``auto_approve`` → hide approve buttons;\n  ``render_mode`` → canvas vs iframe; ``preview.enabled`` → show\n  web preview pane). Previous proposal was to return the full YAML\n  via ``?include_yaml=true`` — that was a leak (system_prompts,\n  inline api_keys, internal webhook paths). This endpoint exposes\n  only the narrow subset the UI cares about.\n}\n", "language": "text", "size": 949, "lines": 33, "operation": "disk_sync", "updated_at": 1778628122.533979, "validation": "approved", "baseline_lines": 32, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1936452}, "bruno/digitorn-api-full/apps/GET api apps -app_id watchers -watcher_id.bru": {"content": "meta {\n  name: get_watcher\n  type: http\n  seq: 68\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/watchers/{{watcher_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Get watcher status, metrics, and recent history.\n}\n", "language": "text", "size": 257, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.535209, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1936452}, "bruno/digitorn-api-full/apps/GET api apps -app_id watchers.bru": {"content": "meta {\n  name: list_watchers\n  type: http\n  seq: 67\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/watchers\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  List all watchers (running + paused).\n}\n", "language": "text", "size": 233, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.535209, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.1992278}, "bruno/digitorn-api-full/apps/GET api apps -app_id widgets data -binding stream.bru": {"content": "meta {\n  name: stream_widget_data\n  type: http\n  seq: 71\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/widgets/data/{{binding}}/stream\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  SSE bridge for ``type: stream`` data sources.\n  \n  The widget's ``data: { live_metrics: { type: stream, url: ... } }``\n  block declares an upstream URL serving SSE. The daemon proxies\n  each frame to the client so the dashboard updates live without\n  a full re-fetch.\n  \n  Two upstream contracts are supported:\n  \n  1. **SSE upstream** — the URL serves ``text/event-stream``. The\n     daemon parses ``data:`` lines and forwards them.\n  2. **HTTP poll upstream** — the URL serves JSON. The daemon\n     polls every ``poll`` seconds (from the data spec) and emits\n     a frame per response.\n  \n  Reducer hint (``replace`` / ``append`` / ``merge``) is sent in\n  the first frame so the client knows how to integrate updates.\n}\n", "language": "text", "size": 943, "lines": 36, "operation": "disk_sync", "updated_at": 1778628122.5472147, "validation": "approved", "baseline_lines": 35, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2003343}, "bruno/digitorn-api-full/apps/GET api apps -app_id widgets data -binding.bru": {"content": "meta {\n  name: get_widget_data\n  type: http\n  seq: 70\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/widgets/data/{{binding}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Resolve and return one named data binding from the app's widgets.\n  \n  The widget tree references data via ``items: '{{sources}}'`` etc.\n  Each name maps to an entry under the zone's ``data:`` block:\n  \n  .. code-block:: yaml\n  \n      widgets:\n        chat_side:\n          data:\n            sources:\n              type: http\n              url: /rag/sources\n              poll: 10s\n  \n  The client calls ``GET /api/apps/{id}/widgets/data/sources`` to\n  hydrate the binding. Supported source types:\n  \n  - ``http``    — HTTP request (relative to daemon, app-scoped)\n  - ``tool``    — invoke a module action with args\n  - ``static``  — return the value verbatim\n  - ``stream``  — opens an SSE stream (delegated to the SSE route;\n                  this endpoint just returns a placeholder)\n  - ``local``   — client-side only, returns the default value\n  \n  Query params (any) are forwarded to HTTP source requests as the\n  request query string, and to tool source as additional args.\n}\n", "language": "text", "size": 1193, "lines": 46, "operation": "disk_sync", "updated_at": 1778628122.5510747, "validation": "approved", "baseline_lines": 45, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2003343}, "bruno/digitorn-api-full/apps/GET api apps -app_id widgets upload -user_id -sid -file_id -filename.bru": {"content": "meta {\n  name: widgets_download\n  type: http\n  seq: 72\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/widgets/upload/{{user_id}}/{{sid}}/{{file_id}}/notes.md\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Serve a previously uploaded file back to the client.\n  \n  Per-user scoped: only the owning user (or admin) can read it.\n}\n", "language": "text", "size": 365, "lines": 22, "operation": "disk_sync", "updated_at": 1778628122.5559556, "validation": "approved", "baseline_lines": 21, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2003343}, "bruno/digitorn-api-full/apps/GET api apps -app_id widgets validate.bru": {"content": "meta {\n  name: validate_widgets\n  type: http\n  seq: 73\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/widgets/validate\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Lint endpoint — recompiles the widgets block and returns errors.\n  \n  Used by the builder UI for live validation. Read-only — does not\n  redeploy the app.\n}\n", "language": "text", "size": 361, "lines": 23, "operation": "disk_sync", "updated_at": 1778628122.5605872, "validation": "approved", "baseline_lines": 22, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2003343}, "bruno/digitorn-api-full/apps/GET api apps -app_id widgets.bru": {"content": "meta {\n  name: get_widgets\n  type: http\n  seq: 69\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}/widgets\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Return the app's compiled widgets tree.\n  \n  Flutter calls this once on app open to render Z2 (chat_side) and\n  Z3 (workspace_tabs). Z1 (inline) and Z4 (modals) are addressable\n  by name via SSE / open_modal actions.\n}\n", "language": "text", "size": 409, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.5605872, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2003343}, "bruno/digitorn-api-full/apps/GET api apps -app_id.bru": {"content": "meta {\n  name: get_app\n  type: http\n  seq: 5\n}\n\nget {\n  url: {{base_url}}/api/apps/{{app_id}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nvars:pre-request {\n  app_id: digitorn-code\n}\n\ndocs {\n  Get unified details of an installed app — runtime + installation.\n  \n  Resolution:\n    1. If the app is deployed, return its full runtime summary\n       enriched with install metadata (version, is_builtin,\n       installed_at, install_status) and ``drift`` from the package\n       registry. ``runtime_status = \"running\"``.\n    2. Else, if the app has a registry row but isn't deployed, return\n       the install metadata with ``runtime_status`` set to\n       ``not_deployed`` or ``broken`` depending on its install_status.\n    3. Else, 404 / 503 (warming up) via ``_raise_not_deployed``.\n  \n  Disabled apps are not returned here; use\n  ``GET /api/apps?include_disabled=true`` as admin to see them.\n}\n", "language": "text", "size": 923, "lines": 37, "operation": "disk_sync", "updated_at": 1778628122.567916, "validation": "approved", "baseline_lines": 36, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2047484}, "bruno/digitorn-api-full/apps/GET api apps.bru": {"content": "meta {\n  name: list_apps\n  type: http\n  seq: 2\n}\n\nget {\n  url: {{base_url}}/api/apps\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  include_disabled: \n  include_installed: \n}\n\ndocs {\n  List apps visible to the caller — unified view.\n  \n  Merges three sources so the Flutter client has a single endpoint:\n  \n  1. Currently deployed apps (``AppManager._deployed`` — in memory).\n  2. Disabled apps (when ``include_disabled=true``, admin-only wide mode).\n  3. Installed packages that are NOT deployed (broken, never-deployed,\n     or uninstalled-in-progress). Included by default, disable with\n     ``include_installed=false``.\n  \n  Each entry now carries:\n    - ``runtime_status``: ``running`` | ``disabled`` | ``broken`` | ``not_deployed``\n    - ``install_status``: from the package registry (``installed``, ``broken``, …)\n    - ``version``, ``is_builtin``, ``is_default``, ``installed_at``\n    - ``deploy_error``: last deploy failure text (or None)\n  \n  This replaces the previous split between ``/api/apps`` (runtime only)\n  and the removed ``/api/packages`` (installation catalog). The Hub's\n  \"Installed\" tab should call this with default params; the sidebar\n  \"Running\" filter applies ``runtime_status == \"running\"`` client-side.\n}\n", "language": "text", "size": 1279, "lines": 44, "operation": "disk_sync", "updated_at": 1778628122.5737565, "validation": "approved", "baseline_lines": 43, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.206757}, "bruno/digitorn-api-full/apps/PATCH api apps -app_id preview-server proxy -path-path.bru": {"content": "meta {\n  name: preview_server_proxy\n  type: http\n  seq: 122\n}\n\npatch {\n  url: {{base_url}}/api/apps/{{app_id}}/preview-server/proxy/{{path:path}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Reverse-proxy HTTP traffic to the app's dev server.\n  \n  Flutter points an iframe at ``/api/apps/{app_id}/preview-server/proxy/``\n  to render the dev UI inside the Digitorn admin panel. HMR websockets\n  use the matching ``/preview-server/ws/{path:path}`` upgrade route.\n}\n", "language": "text", "size": 501, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.5793471, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.206757}, "bruno/digitorn-api-full/apps/POST api apps -app_id approve.bru": {"content": "meta {\n  name: resolve_approval\n  type: http\n  seq: 77\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/approve\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"request_id\": \"{{request_id}}\",\n    \"approved\": true,\n    \"message\": \"{{message}}\",\n    \"response\": \"\",\n    \"answer\": \"\",\n    \"value\": \"\",\n    \"reply\": \"\",\n    \"user_response\": \"\"\n  }\n}\n\ndocs {\n  Approve or deny a pending approval request.\n}\n", "language": "text", "size": 449, "lines": 33, "operation": "disk_sync", "updated_at": 1778628122.5858092, "validation": "approved", "baseline_lines": 32, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2085078}, "bruno/digitorn-api-full/apps/POST api apps -app_id background-sessions -bg_session_id pause.bru": {"content": "meta {\n  name: pause_background_session\n  type: http\n  seq: 79\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/background-sessions/{{bg_session_id}}/pause\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Pause a background session — triggers will skip it.\n}\n", "language": "text", "size": 294, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.5858092, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2101674}, "bruno/digitorn-api-full/apps/POST api apps -app_id background-sessions -bg_session_id payload files.bru": {"content": "meta {\n  name: upload_background_session_payload_file\n  type: http\n  seq: 80\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/background-sessions/{{bg_session_id}}/payload/files\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"file\": \"\"\n  }\n}\n\ndocs {\n  Attach a file to a session payload (multipart upload).\n  \n  The file bytes are stored on disk under\n  ``~/.digitorn/apps/<app_id>/sessions/<sid>/payload/`` and an entry\n  is added to the payload's ``files`` list so the injection layer can\n  surface its path to the agent at trigger time.\n}\n", "language": "text", "size": 590, "lines": 31, "operation": "disk_sync", "updated_at": 1778628122.5953002, "validation": "approved", "baseline_lines": 30, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2101674}, "bruno/digitorn-api-full/apps/POST api apps -app_id background-sessions -bg_session_id resume.bru": {"content": "meta {\n  name: resume_background_session\n  type: http\n  seq: 81\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/background-sessions/{{bg_session_id}}/resume\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Resume a paused background session.\n}\n", "language": "text", "size": 280, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.6011827, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2101674}, "bruno/digitorn-api-full/apps/POST api apps -app_id background-sessions.bru": {"content": "meta {\n  name: create_background_session\n  type: http\n  seq: 78\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/background-sessions\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"name\": \"{{draft_name}}\",\n    \"params\": {},\n    \"routing_keys\": {},\n    \"workspace\": \"\"\n  }\n}\n\ndocs {\n  Create a new background session for the authenticated user.\n  \n  In multi mode, each user can create multiple sessions with custom params\n  (e.g. different CVs, different configs). In mono mode, this is a no-op —\n  the session is auto-created on first trigger.\n}\n", "language": "text", "size": 595, "lines": 33, "operation": "disk_sync", "updated_at": 1778628122.6011827, "validation": "approved", "baseline_lines": 32, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2101674}, "bruno/digitorn-api-full/apps/POST api apps -app_id background-tasks -task_id wait.bru": {"content": "meta {\n  name: wait_background_task\n  type: http\n  seq: 83\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/background-tasks/{{task_id}}/wait\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"timeout\": 60.0\n  }\n}\n\ndocs {\n  Wait for a background task to complete (with timeout).\n}\n", "language": "text", "size": 326, "lines": 26, "operation": "disk_sync", "updated_at": 1778628122.6011827, "validation": "approved", "baseline_lines": 25, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2101674}, "bruno/digitorn-api-full/apps/POST api apps -app_id background-tasks.bru": {"content": "meta {\n  name: launch_background_task\n  type: http\n  seq: 82\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/background-tasks\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"tool\": \"\",\n    \"params\": {}\n  }\n}\n\ndocs {\n  Launch a tool as a background task.\n  \n  The tool runs asynchronously. Poll status via GET or subscribe\n  to the session via Socket.IO for completion events.\n  \n  Returns the task_id for tracking.\n}\n", "language": "text", "size": 466, "lines": 32, "operation": "disk_sync", "updated_at": 1778628122.6111507, "validation": "approved", "baseline_lines": 31, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2101674}, "bruno/digitorn-api-full/apps/POST api apps -app_id disable.bru": {"content": "meta {\n  name: disable_app\n  type: http\n  seq: 84\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/disable\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  scope: \n}\n\nbody:json {\n  {}\n}\n\ndocs {\n  Disable a scoped app install — hide it + refuse interaction.\n  \n  Scope resolution mirrors DELETE: the caller's JWT targets their\n  own user install by default. Admins can pass ``?scope=system`` to\n  disable the system install instead.\n  \n  Built-in apps cannot be disabled.\n}\n", "language": "text", "size": 516, "lines": 34, "operation": "disk_sync", "updated_at": 1778628122.6178885, "validation": "approved", "baseline_lines": 33, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2101674}, "bruno/digitorn-api-full/apps/POST api apps -app_id enable.bru": {"content": "meta {\n  name: enable_app\n  type: http\n  seq: 85\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/enable\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  scope: \n  user_id: \n}\n\ndocs {\n  Re-enable a disabled app (ADMIN ONLY) and redeploy it.\n  \n  Scope-aware: when ``?scope=user&user_id=<uid>`` is supplied the\n  admin re-enables that user's install. Otherwise the system\n  install is targeted. Fails if the bundle was wiped.\n}\n", "language": "text", "size": 470, "lines": 29, "operation": "disk_sync", "updated_at": 1778628122.6178885, "validation": "approved", "baseline_lines": 28, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2101674}, "bruno/digitorn-api-full/apps/POST api apps -app_id interact.bru": {"content": "meta {\n  name: interact_widget\n  type: http\n  seq: 86\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/interact\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"module_id\": \"\",\n    \"widget\": \"\",\n    \"action\": \"\",\n    \"state\": {}\n  }\n}\n\ndocs {\n  Handle a bidirectional widget interaction from the frontend.\n  \n  Routes the action to the module that owns the widget via the service bus.\n  The module processes the action and can update state, which triggers\n  SSE events back to the frontend for live UI updates.\n  \n  The module must implement a `widget_interact(widget, action, state)` method.\n}\n", "language": "text", "size": 642, "lines": 35, "operation": "disk_sync", "updated_at": 1778628122.6267862, "validation": "approved", "baseline_lines": 34, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2101674}, "bruno/digitorn-api-full/apps/POST api apps -app_id mcp -server_id oauth-token.bru": {"content": "meta {\n  name: inject_oauth_token\n  type: http\n  seq: 87\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/mcp/{{mcp_server_id}}/oauth-token\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"access_token\": \"{{access_token}}\",\n    \"token_type\": \"bearer\",\n    \"refresh_token\": \"{{refresh_token}}\",\n    \"expires_in\": 0,\n    \"scope\": \"\"\n  }\n}\n\ndocs {\n  Inject an OAuth token into an MCP server and persist it in DB.\n  \n  Used by the CLI after completing a local OAuth flow.\n}\n", "language": "text", "size": 517, "lines": 32, "operation": "disk_sync", "updated_at": 1778628122.6267862, "validation": "approved", "baseline_lines": 31, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2101674}, "bruno/digitorn-api-full/apps/POST api apps -app_id notifications.bru": {"content": "meta {\n  name: check_notifications\n  type: http\n  seq: 88\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/notifications\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"session_id\": \"{{session_id}}\"\n  }\n}\n\ndocs {\n  Check for background task notifications and stream an agent response if any.\n  \n  Returns SSE stream identical to chat/stream if notifications exist,\n  or an empty 204 response if nothing is pending.\n}\n", "language": "text", "size": 465, "lines": 29, "operation": "disk_sync", "updated_at": 1778628122.635036, "validation": "approved", "baseline_lines": 28, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2101674}, "bruno/digitorn-api-full/apps/POST api apps -app_id pipeline.bru": {"content": "meta {\n  name: run_pipeline\n  type: http\n  seq: 89\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/pipeline\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"input\": \"\",\n    \"steps\": []\n  }\n}\n\ndocs {\n  Execute a pipeline of app calls.\n  \n  If the app has a pipeline defined in YAML, uses that.\n  Otherwise, uses the steps provided in the request body.\n}\n", "language": "text", "size": 401, "lines": 30, "operation": "disk_sync", "updated_at": 1778628122.635036, "validation": "approved", "baseline_lines": 29, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2101674}, "bruno/digitorn-api-full/apps/POST api apps -app_id preview-server proxy -path-path.bru": {"content": "meta {\n  name: preview_server_proxy\n  type: http\n  seq: 90\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/preview-server/proxy/{{path:path}}\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Reverse-proxy HTTP traffic to the app's dev server.\n  \n  Flutter points an iframe at ``/api/apps/{app_id}/preview-server/proxy/``\n  to render the dev UI inside the Digitorn admin panel. HMR websockets\n  use the matching ``/preview-server/ws/{path:path}`` upgrade route.\n}\n", "language": "text", "size": 499, "lines": 24, "operation": "disk_sync", "updated_at": 1778628122.643244, "validation": "approved", "baseline_lines": 23, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2224452}, "bruno/digitorn-api-full/apps/POST api apps -app_id preview-server restart.bru": {"content": "meta {\n  name: preview_server_restart\n  type: http\n  seq: 91\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/preview-server/restart\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Restart the dev server (stop + start). Resets the crash budget.\n}\n", "language": "text", "size": 283, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.643244, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2241843}, "bruno/digitorn-api-full/apps/POST api apps -app_id reload.bru": {"content": "meta {\n  name: reload_app\n  type: http\n  seq: 92\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/reload\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Hot-reload a deployed app from its current bundle.\n  \n  Use this after updating a secret (e.g. rotating an API key) or when\n  you want to force the in-memory instance to pick up persistent\n  changes without restarting the whole daemon.\n  \n  What it does:\n    - Re-reads the app's frozen bundle from disk\n    - Re-reads the current secrets from the secret store\n    - Stops the running in-memory instance (drops active sessions)\n    - Rebuilds the app with the fresh secrets and puts it back in\n      the pool of deployed apps\n  \n  What it does NOT do:\n    - Does not modify any DB row (Application, AppBundle, AppProfile)\n    - Does not change the bundle on disk\n    - Does not bump the version\n  \n  Permission: ``apps:deploy`` (same as deploy, because reload is\n  functionally a redeploy of the same content).\n}\n", "language": "text", "size": 1002, "lines": 39, "operation": "disk_sync", "updated_at": 1778628122.6512656, "validation": "approved", "baseline_lines": 38, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2241843}, "bruno/digitorn-api-full/apps/POST api apps -app_id run.bru": {"content": "meta {\n  name: run_app\n  type: http\n  seq: 93\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/run\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"input\": \"\",\n    \"input_type\": \"text\"\n  }\n}\n\ndocs {\n  Run a deployed one-shot app.\n  \n  Returns the agent's response. Only works for one_shot mode apps.\n  For conversation mode, use WebSocket/Socket.IO.\n}\n", "language": "text", "size": 399, "lines": 30, "operation": "disk_sync", "updated_at": 1778628122.656885, "validation": "approved", "baseline_lines": 29, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2241843}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id abort.bru": {"content": "meta {\n  name: abort_session_turn\n  type: http\n  seq: 94\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/abort\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nparams:query {\n  purge_queue: \n}\n\ndocs {\n  Abort the currently running agent turn for a session.\n  \n  **Default behavior**: cancels only the currently running turn. The\n  rest of the message queue is **preserved** and the dispatcher\n  picks up the next message automatically — the user gets\n  ``message_started`` for ``next_correlation_id`` within seconds.\n  \n  ``?purge_queue=true`` drops every queued message along with the\n  abort — use when the user clicks \"Stop everything\" rather than\n  \"Skip this message\".\n  \n  The session state (messages, memory, tool calls) is preserved up\n  to the interruption point. Orphaned tool_calls get synthetic error\n  results on the next message so the LLM resumes cleanly.\n  \n  Safe to call even if no turn is running (returns success with\n  was_active=false).\n}\n", "language": "text", "size": 1012, "lines": 40, "operation": "disk_sync", "updated_at": 1778628122.656885, "validation": "approved", "baseline_lines": 39, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2278023}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id compact.bru": {"content": "meta {\n  name: compact_session\n  type: http\n  seq: 95\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/compact\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Compact the context window for a session (truncate old messages).\n}\n", "language": "text", "size": 287, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.6671765, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2278023}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id fork.bru": {"content": "meta {\n  name: fork_session\n  type: http\n  seq: 96\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/fork\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Fork a session — create a new session with the same message history.\n}\n", "language": "text", "size": 284, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.6680272, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2309134}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id lsp cancel.bru": {"content": "meta {\n  name: lsp_rpc_cancel\n  type: http\n  seq: 97\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/lsp/cancel\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"request_id\": \"{{request_id}}\"\n  }\n}\n\ndocs {\n  Cancel an in-flight LSP request by ``request_id``.\n  \n  Safe to call on already-completed requests (returns ``cancelled:\n  false, already_done: true``). Returns ``request not found`` if the\n  id never existed or was already cleaned up.\n  \n  Typical UX: Monaco fires an abort token on a completion request,\n  the client catches it and hits this endpoint with the correlation\n  id it sent in the original /lsp/request call.\n}\n", "language": "text", "size": 703, "lines": 34, "operation": "disk_sync", "updated_at": 1778628122.6743515, "validation": "approved", "baseline_lines": 33, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2309134}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id lsp request.bru": {"content": "meta {\n  name: lsp_rpc_request\n  type: http\n  seq: 98\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/lsp/request\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"path\": \"\",\n    \"method\": \"\",\n    \"timeout_seconds\": 10.0,\n    \"request_id\": \"{{request_id}}\",\n    \"supersede_previous\": true\n  }\n}\n\ndocs {\n  Forward an LSP RPC to the language server backing the given file.\n  \n  This is the sole entry point clients (Monaco, ``useLspRequest`` Flutter\n  hook, custom tooling) use for hover / goto / references / completion /\n  rename / signature help. The daemon doesn't reshape payloads — LSP\n  spec semantics are the contract.\n  \n  Returns::\n  \n      {\"success\": true, \"data\": {\"server\": \"pyright\", \"method\": \"...\",\n                                  \"result\": <lsp response>}}\n  \n  Error responses map cleanly to HTTP semantics:\n  \n  - 404 — app not deployed or has no LSP module\n  - 400 — file extension has no registered server, or server not\n           installed, or method unsupported (protocol=compiler/linter)\n  - 504 — server responded with None (timeout)\n}\n", "language": "text", "size": 1134, "lines": 47, "operation": "disk_sync", "updated_at": 1778628122.6743515, "validation": "approved", "baseline_lines": 46, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2309134}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id messages.bru": {"content": "meta {\n  name: session_send_message\n  type: http\n  seq: 4\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/messages\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"message\": \"{{message}}\",\n    \"workspace\": \"\",\n    \"images\": [\n      {}\n    ],\n    \"queue_mode\": \"\",\n    \"client_message_id\": \"\"\n  }\n}\n\nvars:pre-request {\n  message: Bonjour, comment tu vas ?\n  app_id: digitorn-code\n}\n\nscript:post-response {\n  if (res.status >= 200 && res.status < 300 && res.body) {\n    if (res.body?.data?.correlation_id != null) bru.setEnvVar(\"last_correlation_id\", String(res.body?.data?.correlation_id));\n  }\n}\n\ndocs {\n  Send a message to a session. Events arrive via Socket.IO.\n  \n  **Queueing (Phase 3 — per-session FIFO queue)**\n  \n  When a turn is already running on this session, the message is\n  enqueued instead of failing with ``session_busy``. The dispatcher\n  picks the head of the queue as soon as the running turn finishes.\n  The queue is persisted across daemon restarts.\n  \n  ``queue_mode`` controls the response:\n  \n  - ``async`` (default, recommended) — returns 202 immediately with\n    ``{correlation_id, position, queue_depth}``. The client tracks the\n    message via SSE events ``message_queued``, ``message_started``,\n    ``message_done`` / ``message_cancelled``.\n  - ``wait`` — legacy: block until the turn finishes, return the\n    message data. Equivalent to the pre-queue behaviour for simple\n    clients.\n  \n  Over-capacity (``session.queue.max_depth``) returns 429 + a\n  ``queue_full`` event.\n}\n", "language": "text", "size": 1577, "lines": 63, "operation": "disk_sync", "updated_at": 1778628122.6853807, "validation": "approved", "baseline_lines": 62, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2340918}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id queue clear.bru": {"content": "meta {\n  name: clear_session_queue\n  type: http\n  seq: 99\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/queue/clear\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Cancel every queued (non-running) message for this session.\n}\n", "language": "text", "size": 289, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.6911497, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2340918}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id resume.bru": {"content": "meta {\n  name: resume_session\n  type: http\n  seq: 100\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/resume\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Resume an interrupted session automatically.\n  \n  When a session was interrupted (daemon crash, network loss, etc.),\n  the client calls this to trigger recovery WITHOUT the user typing\n  a message. The daemon:\n  \n  1. Detects orphaned tool_calls and injects synthetic error results\n  2. Sends a system message telling the LLM to continue\n  3. Triggers a new agent turn (async, events via Socket.IO)\n  \n  If the session is NOT interrupted or is currently active, returns\n  a no-op success response.\n  \n  The client flow on reconnect:\n      GET  /sessions/{sid}                   → check is_active + interrupted\n      Socket.IO join_session with since=N    → reconnect + replay missed events\n      POST /sessions/{sid}/resume            → auto-continue if interrupted\n}\n", "language": "text", "size": 986, "lines": 36, "operation": "disk_sync", "updated_at": 1778628122.6956751, "validation": "approved", "baseline_lines": 35, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2340918}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id tasks -task_id cancel.bru": {"content": "meta {\n  name: cancel_background_task\n  type: http\n  seq: 101\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/tasks/{{task_id}}/cancel\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Cancel a specific background shell task (user-initiated).\n  \n  Terminates the process, sends a 'cancelled' notification to the agent\n  so it knows the user stopped the task on next turn.\n}\n", "language": "text", "size": 433, "lines": 23, "operation": "disk_sync", "updated_at": 1778628122.701323, "validation": "approved", "baseline_lines": 22, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2340918}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id undo.bru": {"content": "meta {\n  name: undo_session\n  type: http\n  seq: 102\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/undo\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Undo the last file edit via filesystem checkpoints.\n}\n", "language": "text", "size": 268, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.70583, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.239871}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id workspace commit.bru": {"content": "meta {\n  name: commit_session_endpoint\n  type: http\n  seq: 103\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/commit\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"message\": \"{{message}}\",\n    \"files\": [\n      \"\"\n    ],\n    \"push\": false\n  }\n}\n\ndocs {\n  Commit approved files to git — one-shot ship to the session's repo.\n}\n", "language": "text", "size": 409, "lines": 30, "operation": "disk_sync", "updated_at": 1778628122.70583, "validation": "approved", "baseline_lines": 29, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2404535}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id workspace files approve-hunks.bru": {"content": "meta {\n  name: approve_file_hunks_endpoint\n  type: http\n  seq: 105\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/files/approve-hunks\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"path\": \"\"\n  }\n}\n\ndocs {\n  Partial approve — stage only selected hunks, leave the rest pending.\n}\n", "language": "text", "size": 363, "lines": 26, "operation": "disk_sync", "updated_at": 1778628122.714699, "validation": "approved", "baseline_lines": 25, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2404535}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id workspace files approve.bru": {"content": "meta {\n  name: approve_file_endpoint\n  type: http\n  seq: 104\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/files/approve\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"path\": \"\"\n  }\n}\n\ndocs {\n  Mark a file as approved — snapshot its current content as baseline.\n}\n", "language": "text", "size": 350, "lines": 26, "operation": "disk_sync", "updated_at": 1778628122.7179945, "validation": "approved", "baseline_lines": 25, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2404535}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id workspace files reject-hunks.bru": {"content": "meta {\n  name: reject_file_hunks_endpoint\n  type: http\n  seq: 107\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/files/reject-hunks\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"path\": \"\"\n  }\n}\n\ndocs {\n  Partial revert — undo only selected hunks, keep the rest pending.\n}\n", "language": "text", "size": 358, "lines": 26, "operation": "disk_sync", "updated_at": 1778628122.7179945, "validation": "approved", "baseline_lines": 25, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2404535}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id workspace files reject.bru": {"content": "meta {\n  name: reject_file_endpoint\n  type: http\n  seq: 106\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/files/reject\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"path\": \"\"\n  }\n}\n\ndocs {\n  Reject the pending changes — revert file to baseline or delete.\n}\n", "language": "text", "size": 344, "lines": 26, "operation": "disk_sync", "updated_at": 1778628122.7250369, "validation": "approved", "baseline_lines": 25, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2450273}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id workspace fork.bru": {"content": "meta {\n  name: fork_session_workspace\n  type: http\n  seq: 108\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/fork\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"target_session_id\": \"\",\n    \"title\": \"\"\n  }\n}\n\ndocs {\n  Fork a session's workspace into a brand new session.\n  \n  Creates a fresh session (new id, fresh chat history) and copies the\n  source workspace snapshot wholesale — so the user can keep editing\n  the same React app / slide deck / workspace without polluting the\n  conversation history.\n}\n", "language": "text", "size": 591, "lines": 32, "operation": "disk_sync", "updated_at": 1778628122.7304373, "validation": "approved", "baseline_lines": 31, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2450273}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id workspace git-status.bru": {"content": "meta {\n  name: refresh_git_status\n  type: http\n  seq: 109\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/git-status\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Trigger a git status refresh — emits `resource_patched` for every file.\n}\n", "language": "text", "size": 310, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.7368822, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2450273}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions -session_id workspace import.bru": {"content": "meta {\n  name: import_session_workspace\n  type: http\n  seq: 110\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions/{{session_id}}/workspace/import\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"replace\": true\n  }\n}\n\ndocs {\n  Import a snapshot into an existing session.\n  \n  Overwrites (``replace=True``) or merges (``replace=False``) the\n  current in-memory state and force-flushes to DB so reopening the\n  session yields the imported view.\n}\n", "language": "text", "size": 499, "lines": 30, "operation": "disk_sync", "updated_at": 1778628122.738895, "validation": "approved", "baseline_lines": 29, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2450273}, "bruno/digitorn-api-full/apps/POST api apps -app_id sessions.bru": {"content": "meta {\n  name: create_session\n  type: http\n  seq: 3\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/sessions\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"app_id\":\"digitorn_code\"\n  }\n}\n\nscript:post-response {\n  if (res.status >= 200 && res.status < 300 && res.body) {\n    if (res.body?.data?.session_id != null) bru.setEnvVar(\"session_id\", String(res.body?.data?.session_id));\n  }\n}\n\ndocs {\n  Create a new conversation session.\n  \n  Returns a server-generated session_id that the client uses for all\n  subsequent calls (/messages, /events, /history, /abort, etc.).\n  \n  The session is initialized empty — no messages, no workspace, unless\n  ``workspace_path`` is provided in the body. When set, the directory\n  must exist and be writable; the daemon will persist session state\n  inside ``{workspace_path}/.digitorn/sessions/{session_id}/``.\n}\n", "language": "text", "size": 894, "lines": 40, "operation": "disk_sync", "updated_at": 1778628122.738895, "validation": "approved", "baseline_lines": 39, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2504873}, "bruno/digitorn-api-full/apps/POST api apps -app_id tools -tool_name-path execute.bru": {"content": "meta {\n  name: execute_tool\n  type: http\n  seq: 111\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/tools/{{tool_name:path}}/execute\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"params\": {},\n    \"session_id\": \"{{session_id}}\"\n  }\n}\n\ndocs {\n  Execute a tool directly by qualified name.\n  \n  Bypasses the agent — runs the tool and returns the raw result.\n  Security policies (grant/approve/deny) still apply.\n}\n", "language": "text", "size": 461, "lines": 30, "operation": "disk_sync", "updated_at": 1778628122.738895, "validation": "approved", "baseline_lines": 29, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2504873}, "bruno/digitorn-api-full/apps/POST api apps -app_id triggers -trigger_id fire.bru": {"content": "meta {\n  name: fire_trigger\n  type: http\n  seq: 112\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/triggers/{{trigger_id}}/fire\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Manually fire a trigger (for testing/debugging).\n  \n  Activates the agent as if the trigger had fired naturally.\n  The activation is recorded in the history.\n}\n", "language": "text", "size": 374, "lines": 23, "operation": "disk_sync", "updated_at": 1778628122.750424, "validation": "approved", "baseline_lines": 22, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2524972}, "bruno/digitorn-api-full/apps/POST api apps -app_id triggers -trigger_id test.bru": {"content": "meta {\n  name: test_trigger\n  type: http\n  seq: 113\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/triggers/{{trigger_id}}/test\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {}\n}\n\ndocs {\n  Test a trigger with a custom payload (dry-run style).\n  \n  Fires the trigger synchronously and returns the agent's full response.\n  Useful for debugging webhook payloads.\n}\n", "language": "text", "size": 407, "lines": 27, "operation": "disk_sync", "updated_at": 1778628122.750424, "validation": "approved", "baseline_lines": 26, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2524972}, "bruno/digitorn-api-full/apps/POST api apps -app_id uninstall.bru": {"content": "meta {\n  name: uninstall_app\n  type: http\n  seq: 114\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/uninstall\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {}\n}\n\ndocs {\n  Uninstall an app — wipes disk + DB row + undeploys.\n  \n  Built-in apps refuse without ``force=true`` AND admin permission\n  (locked design D9). User data (workspaces, credentials, drafts) is\n  preserved.\n}\n", "language": "text", "size": 422, "lines": 28, "operation": "disk_sync", "updated_at": 1778628122.750424, "validation": "approved", "baseline_lines": 27, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.254506}, "bruno/digitorn-api-full/apps/POST api apps -app_id upgrade.bru": {"content": "meta {\n  name: upgrade_app\n  type: http\n  seq: 115\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/upgrade\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"source_type\": \"local\",\n    \"source_uri\": \"\",\n    \"accept_permissions\": false\n  }\n}\n\ndocs {\n  Upgrade an installed app to a new version.\n  \n  Same permissions consent flow as install. On compile/deploy\n  failure the InstallFlow rolls back to the previous version\n  automatically (locked design D8).\n}\n", "language": "text", "size": 504, "lines": 32, "operation": "disk_sync", "updated_at": 1778628122.7652998, "validation": "approved", "baseline_lines": 31, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2555134}, "bruno/digitorn-api-full/apps/POST api apps -app_id watchers -watcher_id pause.bru": {"content": "meta {\n  name: pause_watcher\n  type: http\n  seq: 117\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/watchers/{{watcher_id}}/pause\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Pause a running watcher (keeps history, skips checks).\n}\n", "language": "text", "size": 273, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.7676697, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2555134}, "bruno/digitorn-api-full/apps/POST api apps -app_id watchers -watcher_id resume.bru": {"content": "meta {\n  name: resume_watcher\n  type: http\n  seq: 118\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/watchers/{{watcher_id}}/resume\n  body: none\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\ndocs {\n  Resume a paused watcher.\n}\n", "language": "text", "size": 245, "lines": 20, "operation": "disk_sync", "updated_at": 1778628122.775279, "validation": "approved", "baseline_lines": 19, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2555134}, "bruno/digitorn-api-full/apps/POST api apps -app_id watchers.bru": {"content": "meta {\n  name: create_watcher\n  type: http\n  seq: 116\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/watchers\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"tool\": \"\",\n    \"params\": {},\n    \"interval\": 30.0,\n    \"label\": \"\",\n    \"notify_when\": \"on_change\",\n    \"notify_config\": {}\n  }\n}\n\ndocs {\n  Create a persistent watcher that periodically executes a tool.\n  \n  The watcher runs in the background and pushes notifications based\n  on the notify_when strategy. Returns the watcher_id for tracking.\n}\n", "language": "text", "size": 552, "lines": 34, "operation": "disk_sync", "updated_at": 1778628122.781234, "validation": "approved", "baseline_lines": 33, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2555134}, "bruno/digitorn-api-full/apps/POST api apps -app_id widgets action.bru": {"content": "meta {\n  name: widgets_action\n  type: http\n  seq: 119\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/widgets/action\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"widget_id\": \"\",\n    \"action_id\": \"\",\n    \"type\": \"\",\n    \"payload\": {},\n    \"form\": {},\n    \"state\": {},\n    \"session_id\": \"{{session_id}}\"\n  }\n}\n\ndocs {\n  Dispatch a user widget action.\n  \n  Action handling matrix:\n  \n  - ``tool``        → run the named tool through the agent loop\n  - ``http``        → execute an app-scoped HTTP call\n  - ``chat``        → inject the message into the session as a user turn\n  - ``set_state``   → mutate the per-session widget state map\n  - ``refresh``     → re-fetch the listed data bindings\n  - ``sequence``    → run multiple steps inside a single dispatch\n  - ``close`` / ``open_modal`` / ``open_workspace`` → effect echo\n    (the client handles the UI side; this just ACKs)\n  \n  The route returns ``{ok, effect}`` so the client can chain\n  follow-up actions (toast, refresh, navigation, …).\n}\n", "language": "text", "size": 1046, "lines": 46, "operation": "disk_sync", "updated_at": 1778628122.784648, "validation": "approved", "baseline_lines": 45, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2555134}, "bruno/digitorn-api-full/apps/POST api apps -app_id widgets upload.bru": {"content": "meta {\n  name: widgets_upload\n  type: http\n  seq: 120\n}\n\npost {\n  url: {{base_url}}/api/apps/{{app_id}}/widgets/upload\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"file\": \"\",\n    \"session_id\": \"{{session_id}}\",\n    \"binding\": \"\"\n  }\n}\n\ndocs {\n  Generic multipart upload endpoint for ``file_upload`` widgets.\n  \n  Stores the file under\n  ``~/.local/share/digitorn/uploads/{user_id}/{session_id}/{file_id}/{filename}``\n  and returns a ``{file_id, url, size, content_type}`` payload the\n  client can echo into the form value (so the next form submission\n  references the uploaded file by id, not by content).\n  \n  Apps that need custom upload handling (validation, virus scan,\n  indexing) can provide their own ``upload_to.url`` in the\n  ``file_upload`` primitive — the daemon only handles the generic\n  case when no custom URL is set.\n}\n", "language": "text", "size": 885, "lines": 39, "operation": "disk_sync", "updated_at": 1778628122.784648, "validation": "approved", "baseline_lines": 38, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2555134}, "bruno/digitorn-api-full/apps/POST api apps deploy upload.bru": {"content": "meta {\n  name: deploy_app_upload\n  type: http\n  seq: 74\n}\n\npost {\n  url: {{base_url}}/api/apps/deploy/upload\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"file\": \"\",\n    \"force\": false,\n    \"secrets\": \"\",\n    \"assets\": \"\",\n    \"scope\": \"system\"\n  }\n}\n\ndocs {\n  Deploy an app by uploading a YAML file + its referenced assets.\n  \n  An app is almost never a single YAML file — it also needs skill\n  markdown files, agent prompt files, and any other asset the YAML\n  references with a relative path. This endpoint accepts the YAML\n  itself AND a JSON-encoded dict of ``{relative_path: content}`` for\n  every companion asset. The daemon writes everything into a single\n  temporary directory so the compiler can resolve all relative paths\n  normally.\n  \n  Form fields:\n    - ``file``   : the YAML file (multipart upload, max 1 MB)\n    - ``force``  : optional, ``\"true\"`` to overwrite an existing deployment\n    - ``secrets``: optional, a JSON-encoded ``{\"KEY\": \"value\", ...}`` map\n                   of secrets that will be injected at compile time to\n                   resolve ``{{env.KEY}}`` references without relying on\n                   the daemon's environment.\n    - ``assets`` : optional, a JSON-encoded ``{rel_path: content}`` map\n                   of every companion file referenced by the YAML\n                   (skills/*.md, agent prompts, etc). Paths MUST be\n                   forward-slash relative paths, no absolute paths and\n                   no ``..`` segments — both are rejected for safety.\n                   Max 5 MB total across all assets.\n  \n  Example::\n  \n      POST /api/apps/deploy/upload\n      Content-Type: multipart/form-data\n      Authorization: Bearer <token>\n  \n      file    = <bytes of app.yaml>\n      force   = \"true\"\n      secrets = '{\"DEEPSEEK_API_KEY\": \"sk-...\"}'\n      assets  = '{\"skills/commit.md\": \"# Commit\\\\n...\",\n                  \"skills/review.md\": \"# Review\\\\n...\"}'\n}\n", "language": "text", "size": 1968, "lines": 64, "operation": "disk_sync", "updated_at": 1778628122.784648, "validation": "approved", "baseline_lines": 63, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2555134}, "bruno/digitorn-api-full/apps/POST api apps deploy.bru": {"content": "meta {\n  name: deploy_app\n  type: http\n  seq: 1\n}\n\npost {\n  url: {{base_url}}/api/apps/deploy\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"yaml_path\": \"{{yaml_path}}\",\n    \"force\": false,\n    \"secrets\": {}\n  }\n}\n\nscript:post-response {\n  if (res.status >= 200 && res.status < 300 && res.body) {\n    if (res.body?.data?.app_id != null) bru.setEnvVar(\"app_id\", String(res.body?.data?.app_id));\n  }\n}\n\ndocs {\n  Deploy an app from a YAML file path.\n  \n  The YAML file must be accessible from the daemon's filesystem.\n  \n  Two modes:\n  - sync=true (default for backward compat): waits for deploy, returns result\n  - sync=false: returns 202 immediately, deploy runs in background.\n    Poll GET /api/apps/{app_id} to check when it's ready.\n}\n", "language": "text", "size": 785, "lines": 41, "operation": "disk_sync", "updated_at": 1778628122.7971847, "validation": "approved", "baseline_lines": 40, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions": 0, "insertions_pending": 0, "deletions_pending": 0, "unified_diff_pending": "", "disk_mtime": 1777240761.2555134}, "bruno/digitorn-api-full/apps/POST api apps install.bru": {"content": "meta {\n  name: install_app\n  type: http\n  seq: 75\n}\n\npost {\n  url: {{base_url}}/api/apps/install\n  body: json\n  auth: bearer\n}\n\nauth:bearer {\n  token: {{access_token}}\n}\n\nbody:json {\n  {\n    \"source_type\": \"\",\n    \"source_uri\": \"\",\n    \"source\": \"\",\n    \"force\": false,\n    \"accept_permissions\": false,\n    \"link_mode\": \"copy\",\n    \"scope\": \"user\"\n  }\n}\n\ndocs {\n  Install a new app from one of the 4 supported sources.\n  \n  First call (without ``accept_permissions``) returns ``409`` with\n  the permissions payload so the client can show a consent dialog.\n  Second call (with ``accept_permissions=true``) actually installs.\n  \n  Hub and git sources return 501 in v1 — their fetch implementations\n  are stubs.\n}\n", "language": "text", "size": 711, "lines": 39, "operation": "disk_sync", "updated_at": 1778628122.801256, "validation": "approved", "baseline_lines": 38, "insertions": 0, "deletions": 0, "total_insertions": 0, "total_deletions":