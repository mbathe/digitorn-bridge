{
  "permissions": {
    "allow": [
      "Bash(python -m pytest tests/test_database_cache.py tests/test_database_security.py -x -q)",
      "Bash(digitorn app deploy --force examples/ollama-chat.yaml)",
      "Bash(python -c \":*)",
      "PowerShell(py -3.12 c:/tmp/test_imports.py)"
    ],
    "deny": [
      "Bash(git stash*)",
      "Bash(git reset*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout --hard*)",
      "Bash(git clean*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git branch -D*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git tag -d*)",
      "Bash(git update-ref*)"
    ],
    "additionalDirectories": [
      "/home/paul/.digitorn/state"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-destructive-git.js"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "neon@claude-plugins-official": true,
    "prisma@claude-plugins-official": true
  }
}
