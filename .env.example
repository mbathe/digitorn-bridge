# ── Digitorn Configuration ────────────────────────────────────────────────────

# LLM Provider API Keys (set the ones you use)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Server
DIGITORN_HOST=127.0.0.1
DIGITORN_PORT=8340

# Key-Value Backend (optional — defaults to local DiskCache)
# DIGITORN_KV_BACKEND=redis://localhost:6379/0

# CORS Origins (comma-separated, for web frontend)
# DIGITORN_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Digitorn Hub (remote service for publishing/searching/installing packages)
# Empty URL disables hub integration. Use http://127.0.0.1:8001 for local dev.
# DIGITORN_HUB__URL=https://hub.digitorn.io
# DIGITORN_HUB__VERIFY_SSL=true
# DIGITORN_HUB__TIMEOUT_SECONDS=60
